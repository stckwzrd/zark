// Calls: free functions, generics, methods, static methods, union constructors, function pointers.

import "gen_expr.zk";

str recv_name(Type* t) {
    if (t.k == .Strct) { return t.si.decl.name };
    if (t.k == .Enm) { return t.ei.decl.name };
    return "";
}

bool te_mentions(TypeExpr* te, str[] names) {
    match te.k {
        .Name => {
            if (contains_str(names, te.name)) { return true; }
            for (auto x : te.args) { if (te_mentions(x, names)) { return true; } }
            return false;
        }
        .Ptr, .Slice, .Errun, .Array => return te_mentions(te.elem, names);
        .Func => {
            for (auto x : te.args) { if (te_mentions(x, names)) { return true; } }
            if (te.ret != null) { return te_mentions(te.ret, names); }
            return false;
        }
    }
    return false;
}

bool all_bound(str[] tps, Env env) {
    for (auto tp : tps) { if (!env.has(tp)) { return false; } }
    return true;
}

!TypeExpr* Gen::expr_to_type_expr(Expr* e) {
    if (e.k == .Ident) {
        const auto t = this->a.create<TypeExpr>()?;
        t.k = .Name;
        t.name = e.name;
        t.args = List<TypeExpr*>::init(this->a);
        return t;
    }
    if (e.k == .Index) {
        if (e.op != .lt) { this->err(e.line); eprintln("type arguments are written with '<...>', as in 'List<i64>'"); return error.CompileFailed; }
        const auto base = this->expr_to_type_expr(e.l)?;
        if (base == null) { return null; }
        const auto t = this->a.create<TypeExpr>()?;
        t.k = .Name;
        t.name = base.name;
        t.args = List<TypeExpr*>::init(this->a);
        for (auto x : e.args) {
            const auto at = this->expr_to_type_expr(x)?;
            if (at == null) { return null; }
            t.args.push(at)?;
        }
        return t;
    }
    if (e.k == .Unary && e.op == .star) {
        const auto inner = this->expr_to_type_expr(e.l)?;
        if (inner == null) { return null; }
        const auto t = this->a.create<TypeExpr>()?;
        t.k = .Ptr;
        t.elem = inner;
        t.args = List<TypeExpr*>::init(this->a);
        return t;
    }
    if (e.k == .Unary && e.op == .bang) {
        const auto inner = this->expr_to_type_expr(e.l)?;
        if (inner == null) { return null; }
        const auto t = this->a.create<TypeExpr>()?;
        t.k = .Errun;
        t.elem = inner;
        t.args = List<TypeExpr*>::init(this->a);
        return t;
    }
    return null;
}

/// is `e` syntactically naming a type? (`Point`, `List[i32]`, `Self`)
bool Gen::names_type(Expr* e) {
    if (e.k == .Ident) {
        if (this->has_var(e.name)) { return false; }
        return this->structs.has(e.name) || this->enums.has(e.name) || this->aliases.has(e.name) || (e.name == "Self" && this->env.has("Self"));
    }
    if (e.k == .Index) {
        return e.l.k == .Ident && !this->has_var(e.l.name) && this->structs.has(e.l.name);
    }
    return false;
}

!List<Type*> Gen::type_args(List<Expr*> args, i64 line) {
    auto out = List<Type*>::init(this->a);
    for (auto x : args) {
        const auto te = this->expr_to_type_expr(x)?;
        if (te == null) { this->err(line); eprintln("expected a type argument"); return error.CompileFailed; }
        out.push(this->resolve_type_at(te, line)?)?;
    }
    return out;
}

!Value Gen::gen_call(Expr* e, Type* expected) {
    const auto callee = e.l;
    if (callee.k == .Ident && !this->has_var(callee.name)) {
        const auto name = callee.name;
        if (this->is_builtin(name) && !this->fns.has(name)) { return this->gen_builtin(name, e.args, e.line); }
        if (this->fns.has(name)) { return this->call_decl(this->fns.get(name)?, this->new_env()?, null, e.args, this->no_types(), expected, e.line); }
        if (this->structs.has(name) && !this->consts.has(name)) { return this->gen_construct(e); }
        if (!this->consts.has(name)) {
            const auto mf = this->member_method(callee)?;
            if (mf != null) { return this->gen_field_call(mf, e.args, this->no_types(), expected, e.line); }
            const auto vt = this->vec_type(name)?;
            if (vt != null) { return this->gen_vec_ctor(vt, e); }
        }
        if (!this->consts.has(name)) { this->err(e.line); eprintln("unknown function '{name}'{this->hint(name, this->visible_names())}"); return error.CompileFailed; }
    }
    if (callee.k == .Index && (callee.l.k == .Ident || callee.l.k == .Field)) {
        if (callee.op != .lt) { this->err(e.line); eprintln("type arguments are written with '<...>', as in 'max<i64>(a, b)'"); return error.CompileFailed; }
        if (callee.l.k == .Ident && callee.l.name == "asm" && !this->fns.has("asm")) { return this->gen_asm(this->type_args(callee.args, e.line)?, e.args, e.line); }
        if (callee.l.k == .Field) {
            const auto targs = this->type_args(callee.args, e.line)?;
            return this->gen_field_call(callee.l, e.args, targs, expected, e.line);
        }
        if (this->fns.has(callee.l.name)) {
            const auto targs = this->type_args(callee.args, e.line)?;
            return this->call_decl(this->fns.get(callee.l.name)?, this->new_env()?, null, e.args, targs, expected, e.line);
        }
    }
    if (callee.k == .Field) { return this->gen_field_call(callee, e.args, this->no_types(), expected, e.line) };
    if (callee.k == .EnumLit) {
        const auto t = variant_target(lit_target(expected), callee.name);
        if (t == null) { this->err(e.line); eprintln("cannot infer union type for '.{callee.name}(...)'"); return error.CompileFailed; }
        if (!is_union(t)) { this->err(e.line); eprintln("'.{callee.name}(...)' used where '{this->type_name(t)?}' is expected"); return error.CompileFailed; }
        if (e.args.len != 1) { this->err(e.line); eprintln("a union variant takes exactly one payload"); return error.CompileFailed; }
        return this->make_union(t, callee.name, e.args.get(0), e.line);
    }
    const auto fv = this->gen_expr(callee, null)?;
    return this->call_indirect(fv, e.args, e.line);
}

!Value Gen::gen_field_call(Expr* f, List<Expr*> args, List<Type*> explicit, Type* expected, i64 line) {
    if (this->names_type(f.l)) {
        const auto t = this->type_from_expr(f.l, expected, f.name, line)?;
        if (is_union(t) && field_index(t.si, f.name) >= 0) {
            if (args.len != 1) { this->err(line); eprintln("a union variant takes exactly one payload"); return error.CompileFailed; }
            return this->make_union(t, f.name, args.get(0), line);
        }
        const auto rname = recv_name(t);
        if (rname.len == 0) { this->err(line); eprintln("'{this->type_name(t)?}' has no methods"); return error.CompileFailed; }
        auto kb = this->sb();
        sprint(&kb, "{rname}.{f.name}")?;
        if (!this->methods.has(kb.slice())) { this->err(line); eprintln("'{this->type_name(t)?}' has no method '{f.name}'"); return error.CompileFailed; }
        const auto md = this->methods.get(kb.slice())?;
        const auto env = this->recv_env(md, t)?;
        return this->call_decl(md, env, null, args, explicit, expected, line);
    }
    auto recv = this->gen_addr(f.l)?;
    if (recv.ty.k == .Ptr && recv_name(recv.ty.elem).len > 0) { recv = this->deref_agg(recv)?; }
    const auto rname = recv_name(recv.ty);
    if (rname.len == 0) { this->err(line); eprintln("'{this->type_name(recv.ty)?}' has no methods"); return error.CompileFailed; }
    auto kb = this->sb();
    sprint(&kb, "{rname}.{f.name}")?;
    if (this->methods.has(kb.slice())) {
        const auto md = this->methods.get(kb.slice())?;
        if (this->const_this && !md.is_const && (recv.imm || (f.l.k == .Ident && f.l.name == "this"))) {
            this->err(line);
            eprintln("'{f.name}' is not const, so a const method cannot call it");
            return error.CompileFailed;
        }
        const auto rv = this->call_method(md, recv, args, explicit, expected, line)?;
        if (md.params.len > 0 && md.params.get(0).move) { this->move_mark(f.l, md.name, line)?; }
        if (md.invalidates || md.borrows) {
            const auto rp = this->place_key(f.l)?;
            if (rp.len > 0) {
                const auto rn = this->place_name(f.l);
                if (md.invalidates) { this->invalidate(rp, rn, md.name, line)?; }
                if (md.borrows) {
                    this->bor_field = f;
                    this->bor_ptr = rp;
                    this->bor_name = rn;
                }
            }
        }
        return rv;
    }
    if (recv.ty.k == .Strct && !recv.ty.si.decl.is_union) {
        const auto idx = field_index(recv.ty.si, f.name);
        if (idx >= 0) {
            const auto fty = recv.ty.si.fields.get(idx).ty;
            if (fty.k == .Func || fty.k == .Closure) {
                const auto fp = this->gep_field(recv.ty, recv.v, idx)?;
                const auto fv = this->load(fty, fp)?;
                return this->call_indirect(fv, args, line);
            }
        }
    }
    this->err(line); eprintln("'{this->type_name(recv.ty)?}' has no method '{f.name}'");
    return error.CompileFailed;
}

!List<Value> Gen::indirect_args(Type* sig, List<Expr*> args) {
    auto vals = List<Value>::init(this->a);
    for (auto [i, x] : args) {
        const auto pt = sig.params.get(i);
        vals.push(this->coerce(this->gen_expr(x, pt)?, pt, x.line)?)?;
        this->copy_moves(x, pt, "", "the call", x.line)?;
    }
    return vals;
}

!Value Gen::call_closure(Value fv, List<Value> vals) {
    const auto sig = fv.ty;
    const auto target = this->extract(fv, 0, this->t_ptr_u8)?.v;
    auto argtxt = this->sb();
    sprint(&argtxt, "ptr {this->extract(fv, 1, this->t_ptr_u8)?.v}")?;
    for (auto v : vals) {
        argtxt.append(", ")?;
        sprint(&argtxt, "{this->llty(v.ty)?} {v.v}")?;
    }
    if (sig.ret.k == .Void) {
        sprint(this->ins()?, "  call void {target}({argtxt.slice()})\n")?;
        return Value{ .ty = this->t_void, .v = "" };
    }
    const auto t = this->tmp()?;
    sprint(this->ins()?, "  {t} = call {this->llty(sig.ret)?} {target}({argtxt.slice()})\n")?;
    return Value{ .ty = sig.ret, .v = t };
}

!Value Gen::call_c_indirect(str target, Type* sig, List<Value> vals) {
    const auto modes = this->c_modes(sig.params.slice(), sig.ret)?;
    const auto sret = is_c_agg(sig.ret) && this->classify_c(sig.ret)?.memory;
    auto argtxt = this->sb();
    for (auto [i, v] : vals) {
        if (i < modes.len && modes.get(i) == 3) { continue; }
        if (argtxt.len > 0) { argtxt.append(", ")?; }
        if (i < modes.len && modes.get(i) != 0) {
            argtxt.append(this->c_arg(v, modes.get(i))?)?;
        } else {
            auto ea = c_ext(v.ty);
            sprint(&argtxt, "{this->llty(v.ty)?}{ea} {v.v}")?;
        }
    }
    if (this->is_empty_c(sig.ret)?) {
        sprint(this->ins()?, "  call ccc void {target}({argtxt.slice()})\n")?;
        const auto slot = this->alloca(sig.ret, "cempty")?;
        return this->load(sig.ret, slot);
    }
    if (sret) {
        const auto slot = this->alloca(sig.ret, "csret")?;
        auto full = this->sb();
        sprint(&full, "ptr sret({this->llty(sig.ret)?}) align {max(this->align_of(sig.ret)?, 8 as u64)} {slot}")?;
        if (argtxt.len > 0) { sprint(&full, ", {argtxt.slice()}")?; }
        sprint(this->ins()?, "  call ccc void {target}({full.slice()})\n")?;
        return this->load(sig.ret, slot);
    }
    if (is_c_agg(sig.ret)) {
        const auto c = this->classify_c(sig.ret)?;
        const auto rt = this->c_ret_ty(sig.ret)?;
        const auto r = this->tmp()?;
        sprint(this->ins()?, "  {r} = call ccc {rt} {target}({argtxt.slice()})\n")?;
        if (c_arch == 1) {
            const auto ab = this->a64_buf(sig.ret)?;
            sprint(this->ins()?, "  store {rt} {r}, ptr {ab}\n")?;
            return this->load(sig.ret, ab);
        }
        const auto buf = this->c_buf()?;
        if (c.words == 1) {
            sprint(this->ins()?, "  store {rt} {r}, ptr {buf}\n")?;
        } else {
            for (auto w : 0..2) {
                auto cls = c.c0;
                if (w == 1) { cls = c.c1; }
                const auto part = this->tmp()?;
                sprint(this->ins()?, "  {part} = extractvalue {rt} {r}, {w}\n")?;
                const auto dst = this->c_half(buf, w)?;
                sprint(this->ins()?, "  store {cword_ty(cls)} {part}, ptr {dst}\n")?;
            }
        }
        return this->load(sig.ret, buf);
    }
    if (sig.ret.k == .Void) {
        sprint(this->ins()?, "  call ccc void {target}({argtxt.slice()})\n")?;
        return Value{ .ty = this->t_void, .v = "" };
    }
    const auto rt = this->c_ret_ty(sig.ret)?;
    const auto t = this->tmp()?;
    sprint(this->ins()?, "  {t} = call ccc {rt} {target}({argtxt.slice()})\n")?;
    return Value{ .ty = sig.ret, .v = t };
}

!Value Gen::call_indirect(Value fv, List<Expr*> args, i64 line) {
    if (fv.ty.k != .Func && fv.ty.k != .Closure) { this->err(line); eprintln("'{this->type_name(fv.ty)?}' is not callable"); return error.CompileFailed };
    const auto sig = fv.ty;
    if (args.len != sig.params.len) { this->err(line); eprintln("function pointer expects {sig.params.len} argument(s), got {args.len}"); return error.CompileFailed; }
    const auto vals = this->indirect_args(sig, args)?;
    if (sig.k == .Closure) { return this->call_closure(fv, vals); }
    return this->call_c_indirect(fv.v, sig, vals);
}

!Env Gen::recv_env(FnDecl* md, Type* t) {
    const auto env = this->new_env()?;
    env.put("Self", t)?;
    if (t.k == .Strct) {
        const auto args = t.si.args;
        if (md.receiver_params.len != args.len) { this->err(md.line); eprintln("out-of-class method of '{t.si.decl.name}' must list {args.len} type parameter(s)"); return error.CompileFailed; }
        for (auto [i, tp] : md.receiver_params) { env.put(tp, args.get(i))?; }
    }
    return env;
}

!Value Gen::call_method(FnDecl* md, Addr recv, List<Expr*> args, List<Type*> explicit, Type* expected, i64 line) {
    const auto env = this->recv_env(md, recv.ty)?;
    if (md.params.len == 0) { this->err(line); eprintln("'{md.name}' is a static method; call it as Type.{md.name}()"); return error.CompileFailed; }
    return this->call_decl(md, env, &recv, args, explicit, expected, line);
}

!void Gen::unify(TypeExpr* te, Type* actual, str[] tps, Env env) {
    match te.k {
        .Name => {
            if (te.args.len == 0) {
                if (contains_str(tps, te.name) && !env.has(te.name)) { env.put(te.name, actual)?; }
                return;
            }
            if (actual.k == .Strct && actual.si.decl.name == te.name) {
                for (auto [i, x] : te.args) { if (i < actual.si.args.len) { this->unify(x, actual.si.args.get(i), tps, env)?; } }
            }
        }
        .Ptr => { if (actual.k == .Ptr) { this->unify(te.elem, actual.elem, tps, env)? } }
        .Slice => { if (actual.k == .Slice) { this->unify(te.elem, actual.elem, tps, env)? } }
        .Errun => { if (actual.k == .Errun) { this->unify(te.elem, actual.elem, tps, env)? } }
        .Array => { if (actual.k == .Array) { this->unify(te.elem, actual.elem, tps, env)? } }
        .Func => {
            if ((actual.k == .Func || actual.k == .Closure) && actual.params.len == te.args.len) {
                for (auto [i, x] : te.args) { this->unify(x, actual.params.get(i), tps, env)?; }
                if (te.ret != null) { this->unify(te.ret, actual.ret, tps, env)?; }
            }
        }
    }
}

!Value Gen::call_decl(FnDecl* decl, Env base_env, Addr* recv, List<Expr*> args, List<Type*> explicit, Type* expected, i64 line) {
    auto off = 0;
    if (recv != null) { off = 1; }
    const auto np = decl.params.len;
    if (np == 0) { return this->call_decl_core(decl, base_env, recv, args, explicit, expected, line); }
    const auto lt = decl.params.get(np - 1).ty;
    if (lt.k != .Name || lt.name != "Fmt" || lt.args.len != 0) { return this->call_decl_core(decl, base_env, recv, args, explicit, expected, line); }
    const auto nfixed = np - off - 1;
    if (args.len < nfixed) { this->err(line); eprintln("'{decl.name}' expects at least {nfixed} argument(s)"); return error.CompileFailed; }
    auto first = Value{ .ty = null, .v = "" };
    if (args.len == nfixed + 1 && args.get(nfixed).k != .Interp && args.get(nfixed).k != .StrLit) {
        first = this->gen_expr(args.get(nfixed), null)?;
        if (first.ty.k == .Strct && first.ty.si.decl.name == "Fmt") {
            auto na = List<Expr*>::init(this->a);
            for (auto i : 0..nfixed) { na.push(args.get(i))?; }
            na.push(this->mk_pre(first, line)?)?;
            return this->call_decl_core(decl, base_env, recv, na, explicit, expected, line);
        }
    }
    const auto fv = this->gen_fmt(args.slice(), nfixed, first)?;
    auto na = List<Expr*>::init(this->a);
    for (auto i : 0..nfixed) { na.push(args.get(i))?; }
    na.push(this->mk_pre(fv, line)?)?;
    return this->call_decl_core(decl, base_env, recv, na, explicit, expected, line);
}

!Value Gen::call_decl_core(FnDecl* decl, Env base_env, Addr* recv, List<Expr*> args, List<Type*> explicit, Type* expected, i64 line) {
    auto off = 0;
    if (recv != null) { off = 1; }
    if (!decl.variadic && args.len + off != decl.params.len) { this->err(line); eprintln("'{decl.name}' expects {decl.params.len - off} argument(s), got {args.len}"); return error.CompileFailed; }
    if (decl.variadic && args.len + off < decl.params.len) { this->err(line); eprintln("'{decl.name}' expects at least {decl.params.len - off} argument(s)"); return error.CompileFailed; }

    const auto env = this->copy_env(base_env)?;
    const auto tps = decl.type_params;
    if (explicit.len > 0) {
        if (explicit.len != tps.len) { this->err(line); eprintln("'{decl.name}' expects {tps.len} type argument(s)"); return error.CompileFailed; }
        for (auto [i, tp] : tps) { env.put(tp, explicit.get(i))?; }
    }

    auto vals = List<Value>::init(this->a);
    auto have = List<bool>::init(this->a);
    for (auto _i : 0..args.len) {
        vals.push(Value{ .ty = null, .v = "" })?;
        have.push(false)?;
    }
    // pass 1: non-literal args (to infer generics)
    for (auto [i, x] : args) {
        const auto pi = i + off;
        if (pi >= decl.params.len) { continue; }
        const auto pte = decl.params.get(pi).ty;
        const auto generic = te_mentions(pte, tps.slice());
        if (generic && !all_bound(tps.slice(), env) && is_literal(x)) { continue; }
        Type* exp = null;
        if (!generic || all_bound(tps.slice(), env)) { exp = this->resolve_type(pte, env)?; }
        const auto v = this->gen_expr(x, exp)?;
        vals.set(i, v);
        have.set(i, true);
        if (generic) { this->unify(pte, v.ty, tps.slice(), env)?; }
    }
    // pass 2: literals, now with known types
    for (auto [i, x] : args) {
        if (have.get(i)) { continue; }
        const auto pi = i + off;
        if (pi >= decl.params.len) { continue; }
        const auto pte = decl.params.get(pi).ty;
        Type* exp = null;
        if (all_bound(tps.slice(), env)) { exp = this->resolve_type(pte, env)?; }
        const auto v = this->gen_expr(x, exp)?;
        vals.set(i, v);
        have.set(i, true);
        this->unify(pte, v.ty, tps.slice(), env)?;
    }
    if (recv != null) {
        const auto pte = decl.params.get(0).ty;
        if (pte.k == .Ptr) { this->unify(pte.elem, recv.ty, tps.slice(), env)? } else { this->unify(pte, recv.ty, tps.slice(), env)?; }
    }
    if (!all_bound(tps.slice(), env) && decl.ret != null && expected != null) { this->unify(decl.ret, expected, tps.slice(), env)?; }
    if (!all_bound(tps.slice(), env)) { this->infer_from_poll(tps.slice(), env)?; }
    if (!all_bound(tps.slice(), env)) { this->err(line); eprintln("cannot infer type parameters of '{decl.name}'"); return error.CompileFailed; }

    auto targs = List<Type*>::init(this->a);
    for (auto tp : tps) { targs.push(env.get(tp)?)?; }
    this->check_constraints(decl.name, tps.slice(), decl.constraints.slice(), targs.slice(), line)?;
    const auto fi = this->inst_fn(decl, env, targs)?;
    this->move_args(decl, args.slice(), off, line)?;
    this->copy_args(fi.decl, fi.params, args.slice(), off, line)?;

    auto argtxt = this->sb();
    auto cmodes = List<i64>::init(this->a);
    if (recv != null) {
        const auto pt = fi.params.get(0);
        if (pt.k == .Ptr) {
            sprint(&argtxt, "ptr {recv.v}")?;
        } else {
            const auto rv = this->load(recv.ty, recv.v)?;
            const auto cv = this->coerce(rv, pt, line)?;
            sprint(&argtxt, "{this->llty(pt)?} {cv.v}")?;
        }
    }
    for (auto [i, x] : args) {
        const auto pi = i + off;
        if (!have.get(i)) {
            Type* exp = null;
            if (x.k == .StrLit) { exp = this->t_ptr_u8 };
            vals.set(i, this->gen_expr(x, exp)?);
        }
        auto v = vals.get(i);
        if (pi < fi.params.len) { v = this->coerce(v, fi.params.get(pi), x.line)?; } else { v = this->c_promote(v, x.line)?; }
        vals.set(i, v);
    }
    if (decl.is_extern) {
        auto tys = List<Type*>::init(this->a);
        for (auto p : fi.params) { tys.push(p)?; }
        for (auto [i, v] : vals) { if (i + off >= fi.params.len) { tys.push(v.ty)?; } }
        cmodes = this->c_modes(tys.slice(), fi.ret)?;
    }
    for (auto [i, x] : args) {
        const auto pi = i + off;
        const auto v = vals.get(i);
        if (decl.is_extern && pi < cmodes.len && cmodes.get(pi) == 3) { continue; }
        if (argtxt.len > 0) { argtxt.append(", ")?; }
        if (decl.is_extern && pi < cmodes.len && cmodes.get(pi) != 0) {
            argtxt.append(this->c_arg(v, cmodes.get(pi))?)?;
        } else {
            auto ea = "";
            if (decl.is_extern) { ea = c_ext(v.ty); }
            sprint(&argtxt, "{this->llty(v.ty)?}{ea} {v.v}")?;
        }
    }
    auto vsig = "";
    if (decl.is_extern && decl.variadic) { vsig = this->c_vsig(fi.params, fi.ret, cmodes)?; }
    if (decl.is_extern && this->is_empty_c(fi.ret)?) {
        sprint(this->ins()?, "  call void{vsig} @{fi.llname}({argtxt.slice()})\n")?;
        const auto slot = this->alloca(fi.ret, "cempty")?;
        return this->load(fi.ret, slot);
    }
    if (decl.is_extern && is_c_agg(fi.ret)) {
        // a struct coming back from C: in registers, or through a hidden pointer
        const auto c = this->classify_c(fi.ret)?;
        if (c.memory) {
            const auto slot = this->alloca(fi.ret, "csret")?;
            auto full = this->sb();
            sprint(&full, "ptr sret({this->llty(fi.ret)?}) align {max(this->align_of(fi.ret)?, 8 as u64)} {slot}")?;
            if (argtxt.len > 0) { sprint(&full, ", {argtxt.slice()}")?; }
            sprint(this->ins()?, "  call void{vsig} @{fi.llname}({full.slice()})\n")?;
            return this->load(fi.ret, slot);
        }
        const auto rt = this->c_ret_ty(fi.ret)?;
        const auto r = this->tmp()?;
        sprint(this->ins()?, "  {r} = call ccc {rt}{vsig} @{fi.llname}({argtxt.slice()})\n")?;
        if (c_arch == 1) {
            const auto ab = this->a64_buf(fi.ret)?;
            sprint(this->ins()?, "  store {rt} {r}, ptr {ab}\n")?;
            return this->load(fi.ret, ab);
        }
        const auto buf = this->c_buf()?;
        if (c.words == 1) {
            sprint(this->ins()?, "  store {rt} {r}, ptr {buf}\n")?;
        } else {
            for (auto w : 0..2) {
                auto cls = c.c0;
                if (w == 1) { cls = c.c1; }
                const auto part = this->tmp()?;
                sprint(this->ins()?, "  {part} = extractvalue {rt} {r}, {w}\n")?;
                const auto dst = this->c_half(buf, w)?;
                sprint(this->ins()?, "  store {cword_ty(cls)} {part}, ptr {dst}\n")?;
            }
        }
        return this->load(fi.ret, buf);
    }

    auto rty = this->llty(fi.ret)?;
    if (decl.is_extern && !is_c_agg(fi.ret)) { rty = this->c_ret_ty(fi.ret)?; }
    auto fnty = rty;
    if (decl.variadic) {
        auto ft = this->sb();
        if (decl.is_extern) {
            sprint(&ft, "{rty}{vsig}")?;
        } else {
            sprint(&ft, "{rty} (")?;
            for (auto [i, p] : fi.params) {
                if (i > 0) { ft.append(", ")?; }
                ft.append(this->llty(p)?)?;
            }
            if (fi.params.len > 0) { ft.append(", ...)")?; } else { ft.append("...)")?; }
        }
        fnty = ft.slice();
    }
    if (fi.ret.k == .Void) {
        sprint(this->ins()?, "  call {fnty} @{fi.llname}({argtxt.slice()})\n")?;
        return Value{ .ty = this->t_void, .v = "" };
    }
    const auto t = this->tmp()?;
    sprint(this->ins()?, "  {t} = call {fnty} @{fi.llname}({argtxt.slice()})\n")?;
    return Value{ .ty = fi.ret, .v = t };
}

!Value Gen::c_promote(Value v, i64 line) {
    if (v.ty.k == .Int && v.ty.bits < 32) {
        if (v.ty.signed) { return this->cast(v, this->t_i32, line); }
        return this->cast(v, this->mk_int(32, false)?, line);
    }
    if (v.ty.k == .Bool) { return this->cast(v, this->t_i32, line) };
    if (v.ty.k == .Float && v.ty.bits == 32) { return this->cast(v, this->t_f64, line); }
    if (v.ty.k == .Slice) { this->err(line); eprintln("slices cannot be passed to C varargs; pass .ptr (and .len) explicitly"); return error.CompileFailed };
    if (v.ty.k == .Array) { this->err(line); eprintln("arrays cannot be passed to C varargs; pass a pointer to the first element"); return error.CompileFailed };
    if (v.ty.k == .Null) { return Value{ .ty = this->t_ptr_u8, .v = "null" } };
    return v;
}

/// a bare call `name(...)` inside a method means this->name(...) when the struct has such a method
/// and no free function of that name exists
!Expr* Gen::member_method(Expr* e) {
    if (this->cur == null || this->cur.decl.receiver.len == 0 || !this->has_var("this")) { return null; }
    const auto tv = this->lookup_var("this")?;
    auto t = tv.ty;
    if (t.k == .Ptr) { t = t.elem };
    if (t.k != .Strct) { return null; }
    auto kb = this->sb();
    sprint(&kb, "{recv_name(t)}.{e.name}")?;
    if (!this->methods.has(kb.slice())) { return null; }
    const auto th = this->a.create<Expr>()?;
    th.k = .Ident;
    th.name = "this";
    th.line = e.line;
    th.off = e.off;
    const auto f = this->a.create<Expr>()?;
    f.k = .Field;
    f.l = th;
    f.name = e.name;
    f.line = e.line;
    f.off = e.off;
    f.name_off = e.off;
    return f;
}

// ------------------------------------------------------------------ C ABI (System V x86-64) for extern functions
// A struct passed to or returned from C is split like clang does it: up to 16 bytes travel in
// one or two registers (each eightbyte is INTEGER, or SSE when it holds only floats), larger
// ones are copied onto the stack (byval) or returned through a hidden pointer (sret).

i64 c_arch = 0;
bool c_apple = false;

struct CClass {
    bool memory;
    i64 words;
    i64 c0;        // 0 = unused, 1 = INTEGER, 2 = SSE
    i64 c1;
    u64 hfa;
    i64 n;
}

bool is_c_agg(Type* t) { return t.k == .Strct || t.k == .Slice || t.k == .Closure || t.k == .Errun; }

bool c_has_vec(Type* t) {
    if (t.k == .Array) { return t.vec || c_has_vec(t.elem); }
    if (t.k == .Errun) { return c_has_vec(t.elem); }
    if (t.k == .Strct) {
        for (auto f : t.si.fields) { if (c_has_vec(f.ty)) { return true; } }
    }
    return false;
}

!void Gen::c_vec(Type* t, i64 line) {
    if (is_c_agg(t) && c_has_vec(t)) {
        this->err(line); eprintln("vectors inside a struct passed to or from C are not supported");
        return error.CompileFailed;
    }
    if (t.k == .Func) { return this->c_vecs(t.params.slice(), t.ret, line); }
    if (t.k != .Array || !t.vec) { return; }
    const auto size = this->size_of(t)?;
    if (size == 16 || (size == 8 && c_arch == 1)) { return; }
    auto ok = "16-byte";
    if (c_arch == 1) { ok = "8- and 16-byte"; }
    this->err(line); eprintln("'{this->type_name(t)?}' cannot be passed to or from C on this target; only {ok} vectors can");
    return error.CompileFailed;
}

!void Gen::c_vecs(Type*[] params, Type* ret, i64 line) {
    this->c_vec(ret, line)?;
    for (auto p : params) { this->c_vec(p, line)?; }
}

void cword(CClass* c, u64 off, u64 size, i64 cls) {
    if (size == 0) { return; }
    const auto w0 = off / 8;
    const auto w1 = (off + size - 1) / 8;
    if (w0 != w1 || w1 > 1) {
        c.memory = true;
        return;
    }
    if (w0 == 0) {
        if (cls == 1 || c.c0 == 0) { c.c0 = cls; }
    } else {
        if (cls == 1 || c.c1 == 0) { c.c1 = cls; }
    }
}

!void Gen::cmark(Type* t, u64 off, CClass* c) {
    match t.k {
        .Strct => {
            if (t.si.decl.is_union) {
                cword(c, off, 4, 1);
                for (auto f : t.si.fields) { this->cmark(f.ty, off + 8, c)?; }
                return;
            }
            u64 o = 0;
            for (auto f : t.si.fields) {
                if (!t.si.decl.packed) {
                    const auto al = this->align_of(f.ty)?;
                    o = (o + al - 1) / al * al;
                }
                this->cmark(f.ty, off + o, c)?;
                o += this->size_of(f.ty)?;
            }
        }
        .Array => {
            const auto es = this->size_of(t.elem)?;
            for (auto i : 0..t.len as i64) { this->cmark(t.elem, off + (i as u64) * es, c)?; }
        }
        .Slice, .Closure => {
            cword(c, off, 8, 1);
            cword(c, off + 8, 8, 1);
        }
        .Errun => {
            const auto n = this->size_of(t)?;
            auto o = 0 as u64;
            while (o < n) {
                cword(c, off + o, min(8 as u64, n - o), 1);
                o += 8;
            }
        }
        .Float => cword(c, off, this->size_of(t)?, 2);
        .Void => {}
        _ => cword(c, off, this->size_of(t)?, 1);
    }
}

!bool Gen::hfa(Type* t, CClass* c) {
    match t.k {
        .Float => {
            const auto size = this->size_of(t)?;
            if (c.hfa != 0 && c.hfa != size) { return false; }
            c.hfa = size;
            c.n += 1;
            return c.n <= 4;
        }
        .Array => {
            if (t.vec || t.len == 0) { return false; }
            for (auto _i : 0..t.len as i64) { if (!this->hfa(t.elem, c)?) { return false; } }
            return true;
        }
        .Strct => {
            if (t.si.decl.is_union) { return false; }
            const auto size = this->size_of(t)?;
            if (size == 0) { return true; }
            const auto n0 = c.n;
            for (auto f : t.si.fields) { if (!this->hfa(f.ty, c)?) { return false; } }
            return c.hfa != 0 && ((c.n - n0) as u64) * c.hfa == size;
        }
    }
    return false;
}

!CClass Gen::classify_a64(Type* t) {
    auto c = CClass{};
    const auto size = this->size_of(t)?;
    if (size == 0) { return c; }
    c.words = 1;
    if (this->hfa(t, &c)? && c.n > 0 && (c.n as u64) * c.hfa == size) { return c; }
    c.hfa = 0;
    c.n = 0;
    c.memory = size > 16;
    return c;
}

!u64 Gen::a64_align(Type* t) {
    if (c_apple || t.k != .Strct || t.si.decl.is_union || t.si.decl.packed) { return this->align_of(t); }
    u64 m = 1;
    for (auto f : t.si.fields) { m = max(m, this->align_of(f.ty)?); }
    return m;
}

!str Gen::a64_ty(Type* t) {
    const auto c = this->classify_a64(t)?;
    auto b = this->sb();
    if (c.hfa == 4) {
        sprint(&b, "[{c.n} x float]")?;
    } else if (c.hfa == 8) {
        sprint(&b, "[{c.n} x double]")?;
    } else if (this->a64_align(t)? >= 16) {
        b.append("i128")?;
    } else if (this->size_of(t)? <= 8) {
        b.append("i64")?;
    } else {
        b.append("[2 x i64]")?;
    }
    return b.slice();
}

!str Gen::a64_ret(Type* t) {
    const auto c = this->classify_a64(t)?;
    auto b = this->sb();
    if (c.hfa != 0) {
        b.append("{{ ")?;
        for (auto i : 0..c.n) {
            if (i > 0) { b.append(", ")?; }
            if (c.hfa == 4) { b.append("float")?; } else { b.append("double")?; }
        }
        b.append(" }")?;
        return b.slice();
    }
    const auto size = this->size_of(t)?;
    if (size <= 8) {
        sprint(&b, "i{size * 8}")?;
    } else if (this->align_of(t)? >= 16) {
        b.append("i128")?;
    } else {
        b.append("[2 x i64]")?;
    }
    return b.slice();
}

!str Gen::a64_buf(Type* t) {
    auto ta = t;
    if (this->align_of(t)? <= 8) {
        ta = this->mk_elem(.Array, this->t_i64)?;
        ta.len = max(2 as u64, (this->size_of(t)? + 7) / 8);
    }
    const auto buf = this->alloca(ta, "cabi")?;
    sprint(this->ins()?, "  store {this->llty(ta)?} zeroinitializer, ptr {buf}\n")?;
    return buf;
}

bool c_small(Type* t) { return t.k == .Bool || (t.k == .Int && t.bits < 32); }

!CClass Gen::classify_c(Type* t) {
    if (c_arch == 1) { return this->classify_a64(t); }
    auto c = CClass{};
    const auto size = this->size_of(t)?;
    if (size == 0) {
        c.words = 0;
        return c;
    }
    if (size > 16) {
        c.memory = true;
        return c;
    }
    this->cmark(t, 0, &c)?;
    c.words = ((size + 7) / 8) as i64;
    return c;
}

str cword_ty(i64 cls) {
    if (cls == 2) { return "double"; }
    return "i64";
}

str c_ext(Type* t) {
    if (c_arch == 1 && !c_apple) { return ""; }
    if (t.k == .Bool) { return " zeroext"; }
    if (t.k == .Int && t.bits < 32) {
        if (t.signed) { return " signext"; }
        return " zeroext";
    }
    return "";
}

str c_ret_ext(Type* t) {
    if (c_arch == 1 && !c_apple) { return ""; }
    if (t.k == .Bool) { return "zeroext "; }
    if (t.k == .Int && t.bits < 32) {
        if (t.signed) { return "signext "; }
        return "zeroext ";
    }
    return "";
}

/// how each parameter of a C function travels: 0 = as itself, 1 = split into registers,
/// 2 = in memory (byval). A struct that does not fit into the registers that are left goes
/// to memory as a whole, as the ABI says, so the registers are counted here like clang does.
!List<i64> Gen::c_modes(Type*[] params, Type* ret) {
    auto modes = List<i64>::init(this->a);
    if (c_arch == 1) {
        for (auto p : params) {
            if (!is_c_agg(p)) {
                modes.push(0)?;
                continue;
            }
            const auto c = this->classify_c(p)?;
            if (c.words == 0) { modes.push(3)?; } else if (c.memory) { modes.push(2)?; } else { modes.push(1)?; }
        }
        return modes;
    }
    auto ints = 6;
    auto sses = 8;
    if (is_c_agg(ret) && this->classify_c(ret)?.memory) { ints -= 1; }
    for (auto p : params) {
        if (!is_c_agg(p)) {
            if (p.k == .Float || (p.k == .Array && p.vec)) { if (sses > 0) { sses -= 1; } } else if (ints > 0) { ints -= 1; }
            modes.push(0)?;
            continue;
        }
        const auto c = this->classify_c(p)?;
        if (c.memory) {
            modes.push(2)?;
            continue;
        }
        if (c.words == 0) {
            modes.push(3)?;
            continue;
        }
        auto ni = 0;
        auto ns = 0;
        if (c.c0 == 2) { ns += 1; } else { ni += 1; }
        if (c.words == 2) { if (c.c1 == 2) { ns += 1; } else { ni += 1; } }
        if (ni <= ints && ns <= sses) {
            ints -= ni;
            sses -= ns;
            modes.push(1)?;
        } else {
            modes.push(2)?;
        }
    }
    return modes;
}

/// the parameter types a C function sees for one Zark parameter
!str Gen::c_param_ty(Type* t, i64 mode) {
    if (mode == 3) { return ""; }
    if (mode == 0) {
        auto b = this->sb();
        b.append(this->llty(t)?)?;
        b.append(c_ext(t))?;
        return b.slice();
    }
    if (c_arch == 1) {
        if (mode == 2) { return "ptr"; }
        auto b = this->sb();
        b.append(this->a64_ty(t)?)?;
        const auto c = this->classify_c(t)?;
        if (c.hfa != 0 && !c_apple) {
            auto al = 8;
            if (this->a64_align(t)? >= 16) { al = 16; }
            sprint(&b, " alignstack({al})")?;
        }
        return b.slice();
    }
    const auto c = this->classify_c(t)?;
    auto b = this->sb();
    if (mode == 2) {
        sprint(&b, "ptr byval({this->llty(t)?}) align {max(this->align_of(t)?, 8 as u64)}")?;
    } else if (c.words == 1) {
        b.append(cword_ty(c.c0))?;
    } else {
        sprint(&b, "{cword_ty(c.c0)}, {cword_ty(c.c1)}")?;
    }
    return b.slice();
}

/// the return type a C function declares for a Zark result ("void" when it goes through sret)
!str Gen::c_ret_ty(Type* t) {
    if (is_c_agg(t) && this->classify_c(t)?.words == 0) { return "void"; }
    if (!is_c_agg(t)) {
        auto b = this->sb();
        b.append(c_ret_ext(t))?;
        b.append(this->llty(t)?)?;
        return b.slice();
    }
    const auto c = this->classify_c(t)?;
    if (c.memory) { return "void"; }
    if (c_arch == 1) { return this->a64_ret(t); }
    if (c.words == 1) { return cword_ty(c.c0); }
    auto b = this->sb();
    sprint(&b, "{{ {cword_ty(c.c0)}, {cword_ty(c.c1)} }")?;
    return b.slice();
}

!str Gen::c_vsig(List<Type*> params, Type* ret, List<i64> modes) {
    auto b = this->sb();
    b.append(" (")?;
    auto n = 0;
    if (is_c_agg(ret) && this->classify_c(ret)?.memory) {
        b.append("ptr")?;
        n += 1;
    }
    for (auto [i, p] : params) {
        const auto m = modes.get(i);
        if (m == 3) { continue; }
        if (n > 0) { b.append(", ")?; }
        if (m == 0) {
            b.append(this->llty(p)?)?;
        } else if (m == 2) {
            b.append("ptr")?;
        } else if (c_arch == 1) {
            b.append(this->a64_ty(p)?)?;
        } else {
            b.append(this->c_param_ty(p, 1)?)?;
        }
        n += 1;
    }
    if (n > 0) { b.append(", ")?; }
    b.append("...)")?;
    return b.slice();
}

/// a 16-byte, zeroed scratch buffer
!str Gen::c_buf() {
    const auto t2 = this->mk_elem(.Array, this->t_i64)?;
    t2.len = 2;
    const auto buf = this->alloca(t2, "cabi")?;
    sprint(this->ins()?, "  store [2 x i64] zeroinitializer, ptr {buf}\n")?;
    return buf;
}

!str Gen::c_half(str buf, i64 w) {
    if (w == 0) { return buf; }
    const auto p = this->tmp()?;
    sprint(this->ins()?, "  {p} = getelementptr i8, ptr {buf}, i64 8\n")?;
    return p;
}

!bool Gen::is_empty_c(Type* t) {
    if (!is_c_agg(t)) { return false; }
    const auto c = this->classify_c(t)?;
    return !c.memory && c.words == 0;
}

bool Gen::sig_needs_c(Type*[] params, Type* ret) {
    if (is_c_agg(ret)) { return true; }
    for (auto p : params) { if (is_c_agg(p)) { return true; } }
    if (c_arch == 1 && c_apple) {
        if (c_small(ret)) { return true; }
        for (auto p : params) { if (c_small(p)) { return true; } }
    }
    return false;
}

!str Gen::func_ptr(FnInst* fi) {
    if (fi.decl.is_extern || fi.is_closure) { return fi.llname; }
    if (!this->sig_needs_c(fi.params.slice(), fi.ret)) { return fi.llname; }
    if (!fi.needs_thunk) {
        fi.needs_thunk = true;
        auto b = this->sb();
        sprint(&b, "{fi.llname}$c")?;
        fi.cabi = b.slice();
        this->c_thunks.push(fi)?;
    }
    if (fi.cabi.len == 0) { return fi.llname; }
    return fi.cabi;
}

!void Gen::gen_c_thunk(FnInst* fi) {
    const auto sv_body = this->body;
    const auto sv_allocas = this->allocas;
    const auto sv_ntmp = this->ntmp;
    const auto sv_nlbl = this->nlbl;
    const auto sv_dbg = this->dbg;
    const auto sv_last = this->last_line;
    const auto sv_term = this->terminated;
    const auto sv_af = this->af;
    this->body = this->sb();
    this->allocas = this->sb();
    this->ntmp = 0;
    this->nlbl = 0;
    this->dbg = false;
    this->last_line = 0;
    this->terminated = false;
    this->af = null;
    defer this->body = sv_body;
    defer this->allocas = sv_allocas;
    defer this->ntmp = sv_ntmp;
    defer this->nlbl = sv_nlbl;
    defer this->dbg = sv_dbg;
    defer this->last_line = sv_last;
    defer this->terminated = sv_term;
    defer this->af = sv_af;

    const auto ret = fi.ret;
    const auto params = fi.params;
    const auto modes = this->c_modes(params.slice(), ret)?;
    const auto sret = is_c_agg(ret) && this->classify_c(ret)?.memory;
    auto hdr = this->sb();
    auto linkage = "internal ";
    if (fi.decl.is_export) { linkage = ""; }
    sprint(&hdr, "define {linkage}ccc {this->c_ret_ty(ret)?} @{fi.cabi}(")?;
    auto first = true;
    if (sret) {
        sprint(&hdr, "ptr sret({this->llty(ret)?}) align {max(this->align_of(ret)?, 8 as u64)} %c.sret")?;
        first = false;
    }
    auto phys = List<str>::init(this->a);
    auto starts = List<i64>::init(this->a);
    for (auto [i, p] : params) {
        const auto m = modes.get(i);
        starts.push(phys.len)?;
        if (m == 3) { continue; }
        if (m == 0) {
            if (!first) { hdr.append(", ")?; }
            sprint(&hdr, "{this->c_param_ty(p, 0)?} %c{i}")?;
            auto nb = this->sb();
            sprint(&nb, "%c{i}")?;
            phys.push(nb.slice())?;
            first = false;
        } else if (m == 2) {
            if (!first) { hdr.append(", ")?; }
            sprint(&hdr, "{this->c_param_ty(p, 2)?} %c{i}")?;
            auto nb = this->sb();
            sprint(&nb, "%c{i}")?;
            phys.push(nb.slice())?;
            first = false;
        } else if (c_arch == 1) {
            if (!first) { hdr.append(", ")?; }
            sprint(&hdr, "{this->c_param_ty(p, 1)?} %c{i}.0")?;
            auto nb = this->sb();
            sprint(&nb, "%c{i}.0")?;
            phys.push(nb.slice())?;
            first = false;
        } else {
            const auto c = this->classify_c(p)?;
            for (auto w : 0..c.words) {
                auto cls = c.c0;
                if (w == 1) { cls = c.c1; }
                if (!first) { hdr.append(", ")?; }
                sprint(&hdr, "{cword_ty(cls)} %c{i}.{w}")?;
                auto nb = this->sb();
                sprint(&nb, "%c{i}.{w}")?;
                phys.push(nb.slice())?;
                first = false;
            }
        }
    }
    hdr.append(") {{\nentry:\n")?;

    auto vals = List<str>::init(this->a);
    for (auto [i, p] : params) {
        const auto m = modes.get(i);
        const auto st = starts.get(i);
        if (m == 3) {
            vals.push("zeroinitializer")?;
        } else if (m == 0) {
            vals.push(phys.get(st))?;
        } else if (m == 2) {
            const auto v = this->load(p, phys.get(st))?;
            vals.push(v.v)?;
        } else if (c_arch == 1) {
            const auto ab = this->a64_buf(p)?;
            sprint(this->ins()?, "  store {this->a64_ty(p)?} {phys.get(st)}, ptr {ab}\n")?;
            const auto v = this->load(p, ab)?;
            vals.push(v.v)?;
        } else {
            const auto c = this->classify_c(p)?;
            const auto buf = this->c_buf()?;
            for (auto w : 0..c.words) {
                auto cls = c.c0;
                if (w == 1) { cls = c.c1; }
                auto ty = this->t_i64;
                if (cls == 2) { ty = this->t_f64; }
                this->store(Value{ .ty = ty, .v = phys.get(st + w) }, this->c_half(buf, w)?)?;
            }
            const auto v = this->load(p, buf)?;
            vals.push(v.v)?;
        }
    }

    auto cargs = this->sb();
    for (auto [i, p] : params) {
        if (i > 0) { cargs.append(", ")?; }
        sprint(&cargs, "{this->llty(p)?} {vals.get(i)}")?;
    }

    if (ret.k == .Void) {
        sprint(this->ins()?, "  call void @{fi.llname}({cargs.slice()})\n")?;
        sprint(this->ins()?, "  ret void\n")?;
    } else if (this->is_empty_c(ret)?) {
        sprint(this->ins()?, "  call {this->llty(ret)?} @{fi.llname}({cargs.slice()})\n")?;
        sprint(this->ins()?, "  ret void\n")?;
    } else if (sret) {
        const auto r = this->tmp()?;
        sprint(this->ins()?, "  {r} = call {this->llty(ret)?} @{fi.llname}({cargs.slice()})\n")?;
        sprint(this->ins()?, "  store {this->llty(ret)?} {r}, ptr %c.sret\n")?;
        sprint(this->ins()?, "  ret void\n")?;
    } else if (is_c_agg(ret) && c_arch == 1) {
        const auto r = this->tmp()?;
        sprint(this->ins()?, "  {r} = call {this->llty(ret)?} @{fi.llname}({cargs.slice()})\n")?;
        const auto ab = this->a64_buf(ret)?;
        this->store(Value{ .ty = ret, .v = r }, ab)?;
        const auto rt = this->c_ret_ty(ret)?;
        const auto w = this->tmp()?;
        sprint(this->ins()?, "  {w} = load {rt}, ptr {ab}\n")?;
        sprint(this->ins()?, "  ret {rt} {w}\n")?;
    } else if (is_c_agg(ret)) {
        const auto r = this->tmp()?;
        sprint(this->ins()?, "  {r} = call {this->llty(ret)?} @{fi.llname}({cargs.slice()})\n")?;
        const auto c = this->classify_c(ret)?;
        const auto buf = this->c_buf()?;
        this->store(Value{ .ty = ret, .v = r }, buf)?;
        const auto rt = this->c_ret_ty(ret)?;
        if (c.words == 1) {
            auto ty = this->t_i64;
            if (c.c0 == 2) { ty = this->t_f64; }
            const auto w0 = this->load(ty, buf)?;
            sprint(this->ins()?, "  ret {rt} {w0.v}\n")?;
        } else {
            auto t0 = this->t_i64;
            if (c.c0 == 2) { t0 = this->t_f64; }
            auto t1 = this->t_i64;
            if (c.c1 == 2) { t1 = this->t_f64; }
            const auto w0 = this->load(t0, buf)?;
            const auto w1 = this->load(t1, this->c_half(buf, 1)?)?;
            const auto a0 = this->tmp()?;
            sprint(this->ins()?, "  {a0} = insertvalue {rt} undef, {cword_ty(c.c0)} {w0.v}, 0\n")?;
            const auto a1 = this->tmp()?;
            sprint(this->ins()?, "  {a1} = insertvalue {rt} {a0}, {cword_ty(c.c1)} {w1.v}, 1\n")?;
            sprint(this->ins()?, "  ret {rt} {a1}\n")?;
        }
    } else {
        const auto r = this->tmp()?;
        sprint(this->ins()?, "  {r} = call {this->llty(ret)?} @{fi.llname}({cargs.slice()})\n")?;
        sprint(this->ins()?, "  ret {this->llty(ret)?} {r}\n")?;
    }

    const auto w = &this->funcs_out;
    w.append(hdr.slice())?;
    w.append(this->allocas.slice())?;
    w.append(this->body.slice())?;
    w.append("}\n\n")?;
}

/// the argument text for passing the value `v` of a struct type to C
!str Gen::c_arg(Value v, i64 mode) {
    if (c_arch == 1) {
        auto b = this->sb();
        if (mode == 2) {
            const auto slot = this->alloca(v.ty, "cbyval")?;
            this->store(v, slot)?;
            sprint(&b, "ptr {slot}")?;
            return b.slice();
        }
        const auto ab = this->a64_buf(v.ty)?;
        this->store(v, ab)?;
        const auto part = this->tmp()?;
        sprint(this->ins()?, "  {part} = load {this->a64_ty(v.ty)?}, ptr {ab}\n")?;
        sprint(&b, "{this->c_param_ty(v.ty, 1)?} {part}")?;
        return b.slice();
    }
    const auto c = this->classify_c(v.ty)?;
    auto b = this->sb();
    if (mode == 2) {
        const auto slot = this->alloca(v.ty, "cbyval")?;
        this->store(v, slot)?;
        sprint(&b, "ptr byval({this->llty(v.ty)?}) align {max(this->align_of(v.ty)?, 8 as u64)} {slot}")?;
        return b.slice();
    }
    const auto buf = this->c_buf()?;
    this->store(v, buf)?;
    for (auto w : 0..c.words) {
        auto cls = c.c0;
        if (w == 1) { cls = c.c1; }
        auto ty = this->t_i64;
        if (cls == 2) { ty = this->t_f64; }
        const auto part = this->load(ty, this->c_half(buf, w)?)?;
        if (w > 0) { b.append(", ")?; }
        sprint(&b, "{cword_ty(cls)} {part.v}")?;
    }
    return b.slice();
}
