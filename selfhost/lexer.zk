// Zark lexer, written in Zark. Mirrors src/lexer.zig token for token.

import "diag.zk";

enum Tag {
    eof, ident, int_lit, float_lit, str_lit, char_lit,
    semi, lparen, rparen, lbrace, rbrace, lbracket, rbracket,
    comma, dot, dotdot, ellipsis, colon, fat_arrow,
    plus, minus, star, slash, percent, amp, pipe, caret, tilde, bang, question,
    eq, eqeq, neq, lt, le, gt, ge, shl, shr, andand, oror,
    plus_eq, minus_eq, star_eq, slash_eq, percent_eq, plus_wrap, minus_wrap, star_wrap,
    pipe_eq, amp_eq, caret_eq, shl_eq, shr_eq, plusplus, minusminus, coloncolon, arrow,
    kw_fn, kw_const, kw_if, kw_else, kw_while, kw_for,
    kw_return, kw_break, kw_continue, kw_struct, kw_enum, kw_extern,
    kw_export, kw_defer, kw_errdefer, kw_error, kw_catch, kw_true, kw_false,
    kw_null, kw_as, kw_import, kw_match, kw_sizeof, kw_alignof, kw_union, kw_type, kw_is,
    kw_template, kw_static,
}

struct Token {
    Tag tag;
    str text;
    i64 line;
    i64 off;
}

Tag keyword(str s) {
    match s {
        "fn" => return .kw_fn;
        "const" => return .kw_const;
        "if" => return .kw_if;
        "else" => return .kw_else;
        "while" => return .kw_while;
        "for" => return .kw_for;
        "return" => return .kw_return;
        "break" => return .kw_break;
        "continue" => return .kw_continue;
        "struct" => return .kw_struct;
        "enum" => return .kw_enum;
        "extern" => return .kw_extern;
        "export" => return .kw_export;
        "defer" => return .kw_defer;
        "errdefer" => return .kw_errdefer;
        "error" => return .kw_error;
        "catch" => return .kw_catch;
        "true" => return .kw_true;
        "false" => return .kw_false;
        "null", "nullptr" => return .kw_null;
        "template" => return .kw_template;
        "static" => return .kw_static;
        "as" => return .kw_as;
        "import" => return .kw_import;
        "match" => return .kw_match;
        "sizeof" => return .kw_sizeof;
        "alignof" => return .kw_alignof;
        "union" => return .kw_union;
        "type" => return .kw_type;
        "is" => return .kw_is;
    }
    return .ident;
}

bool ends_statement(Tag t) {
    match t {
        .ident, .int_lit, .float_lit, .str_lit, .char_lit, .rparen, .rbracket, .rbrace,
        .kw_return, .kw_break, .kw_continue, .question, .kw_true, .kw_false, .kw_null, .plusplus, .minusminus => return true;
    }
    return false;
}

/// longest operator at the start of `s`; .eof if none
struct Op { Tag tag; i64 len; }

Op operator(str s) {
    if (s.len >= 3 && s[0..3] == "...") { return Op{ .tag = .ellipsis, .len = 3 } }
    if (s.len >= 3 && s[0..3] == "<<=") { return Op{ .tag = .shl_eq, .len = 3 } }
    if (s.len >= 3 && s[0..3] == ">>=") { return Op{ .tag = .shr_eq, .len = 3 } }
    if (s.len >= 2) {
        match s[0..2] {
            ".." => return Op{ .tag = .dotdot, .len = 2 };
            "=>" => return Op{ .tag = .fat_arrow, .len = 2 };
            "==" => return Op{ .tag = .eqeq, .len = 2 };
            "!=" => return Op{ .tag = .neq, .len = 2 };
            "<=" => return Op{ .tag = .le, .len = 2 };
            ">=" => return Op{ .tag = .ge, .len = 2 };
            "<<" => return Op{ .tag = .shl, .len = 2 };
            ">>" => return Op{ .tag = .shr, .len = 2 };
            "&&" => return Op{ .tag = .andand, .len = 2 };
            "||" => return Op{ .tag = .oror, .len = 2 };
            "+%" => return Op{ .tag = .plus_wrap, .len = 2 };
            "-%" => return Op{ .tag = .minus_wrap, .len = 2 };
            "*%" => return Op{ .tag = .star_wrap, .len = 2 };
            "+=" => return Op{ .tag = .plus_eq, .len = 2 };
            "-=" => return Op{ .tag = .minus_eq, .len = 2 };
            "*=" => return Op{ .tag = .star_eq, .len = 2 };
            "/=" => return Op{ .tag = .slash_eq, .len = 2 };
            "%=" => return Op{ .tag = .percent_eq, .len = 2 };
            "|=" => return Op{ .tag = .pipe_eq, .len = 2 };
            "&=" => return Op{ .tag = .amp_eq, .len = 2 };
            "^=" => return Op{ .tag = .caret_eq, .len = 2 };
            "++" => return Op{ .tag = .plusplus, .len = 2 };
            "--" => return Op{ .tag = .minusminus, .len = 2 };
            "::" => return Op{ .tag = .coloncolon, .len = 2 };
            "->" => return Op{ .tag = .arrow, .len = 2 };
        }
    }
    Tag t = .eof;
    match s[0] {
        '(' => t = .lparen;
        ')' => t = .rparen;
        '{' => t = .lbrace;
        '}' => t = .rbrace;
        '[' => t = .lbracket;
        ']' => t = .rbracket;
        ',' => t = .comma;
        '.' => t = .dot;
        ':' => t = .colon;
        ';' => t = .semi;
        '+' => t = .plus;
        '-' => t = .minus;
        '*' => t = .star;
        '/' => t = .slash;
        '%' => t = .percent;
        '&' => t = .amp;
        '|' => t = .pipe;
        '^' => t = .caret;
        '~' => t = .tilde;
        '!' => t = .bang;
        '?' => t = .question;
        '=' => t = .eq;
        '<' => t = .lt;
        '>' => t = .gt;
    }
    return Op{ .tag = t, .len = 1 };
}

struct Lexer {
    str src;
    str file;
    i64 i;
    i64 line;
    i64 depth;
    List<Token> toks;

    !void emit(Tag tag, str text) {
        auto off = this->i;
        const auto base = this->src.ptr as u64;
        const auto p = text.ptr as u64;
        if (p >= base && p < base + (this->src.len as u64)) { off = (p - base) as i64; }
        this->toks.push(Token{ .tag = tag, .text = text, .line = this->line, .off = off })?;
    }

    !void fail(str msg) {
        eprintln("{this->file}:{this->line}: error: {msg}");
        show_source(this->file, this->line, this->i);
        return error.LexFailed;
    }

    u8 peek(i64 k) {
        if (this->i + k < this->src.len) { return this->src[this->i + k]; }
        return 0;
    }

    !void number() {
        const auto src = this->src;
        const auto start = this->i;
        auto is_float = false;
        if (src[this->i] == '0' && (this->peek(1) == 'x' || this->peek(1) == 'b' || this->peek(1) == 'o')) {
            this->i += 2;
            while (this->i < src.len && (is_alnum(src[this->i]) || src[this->i] == '_')) { this->i += 1; }
        } else {
            while (this->i < src.len && (is_digit(src[this->i]) || src[this->i] == '_')) { this->i += 1; }
            if (this->i + 1 < src.len && src[this->i] == '.' && is_digit(src[this->i + 1])) {
                is_float = true;
                this->i += 1;
                while (this->i < src.len && (is_digit(src[this->i]) || src[this->i] == '_')) { this->i += 1; }
            }
            if (this->i < src.len && (src[this->i] == 'e' || src[this->i] == 'E')) {
                is_float = true;
                this->i += 1;
                if (this->i < src.len && (src[this->i] == '+' || src[this->i] == '-')) { this->i += 1; }
                while (this->i < src.len && is_digit(src[this->i])) { this->i += 1; }
            }
        }
        if (is_float) { this->emit(.float_lit, src[start..this->i])?; } else { this->emit(.int_lit, src[start..this->i])?; }
    }

    !void string() {
        const auto src = this->src;
        const auto start = this->i;
        this->i += 1;
        auto bdepth = 0; // inside {interpolation}
        while (this->i < src.len && !(src[this->i] == '"' && bdepth == 0)) {
            const auto c = src[this->i];
            if (c == '\\') {
                this->i += 2;
                continue;
            }
            if (c == '{' && this->peek(1) == '{' && bdepth == 0) {
                this->i += 2;
                continue;
            }
            if (c == '{') { bdepth += 1; }
            if (c == '}' && bdepth > 0) { bdepth -= 1; }
            if (c == '"' && bdepth > 0) {
                this->i += 1;
                while (this->i < src.len && src[this->i] != '"') {
                    if (src[this->i] == '\\') { this->i += 1; }
                    this->i += 1;
                }
            }
            if (this->i < src.len && src[this->i] == '\n') { this->line += 1; }
            this->i += 1;
        }
        if (this->i >= src.len) { this->fail("unterminated string")?; }
        this->i += 1;
        this->emit(.str_lit, src[start + 1..this->i - 1])?;
    }

    !void run() {
        const auto src = this->src;
        while (this->i < src.len) {
            const auto c = src[this->i];
            if (c == '\n') {
                this->line += 1;
                this->i += 1;
                continue;
            }
            if (c == ' ' || c == '\t' || c == '\r') {
                this->i += 1;
                continue;
            }
            if (c == '/' && this->peek(1) == '/') {
                while (this->i < src.len && src[this->i] != '\n') { this->i += 1; }
                continue;
            }
            if (c == '/' && this->peek(1) == '*') {
                this->i += 2;
                while (this->i + 1 < src.len && !(src[this->i] == '*' && src[this->i + 1] == '/')) {
                    if (src[this->i] == '\n') { this->line += 1; }
                    this->i += 1;
                }
                this->i += 2;
                continue;
            }
            if (is_alpha(c) || c == '_') {
                const auto start = this->i;
                while (this->i < src.len && (is_alnum(src[this->i]) || src[this->i] == '_')) { this->i += 1; }
                const auto text = src[start..this->i];
                this->emit(keyword(text), text)?;
                continue;
            }
            if (is_digit(c)) {
                this->number()?;
                continue;
            }
            if (c == '"') {
                this->string()?;
                continue;
            }
            if (c == '\'') {
                const auto start = this->i;
                this->i += 1;
                if (this->i < src.len && src[this->i] == '\\') { this->i += 1; }
                this->i += 1;
                if (this->i >= src.len || src[this->i] != '\'') { this->fail("bad char literal")?; }
                this->i += 1;
                this->emit(.char_lit, src[start + 1..this->i - 1])?;
                continue;
            }
            const auto op = operator(src[this->i..]);
            if (op.tag == .eof) {
                auto ce = this->i + 1;
                while (ce < src.len && (src[ce] & 0xC0) == 0x80) { ce += 1; }
                eprintln("{this->file}:{this->line}: error: unexpected character '{src[this->i..ce]}'");
                show_source(this->file, this->line, this->i);
                return error.LexFailed;
            }
            this->emit(op.tag, src[this->i..this->i + op.len])?;
            match op.tag {
                .lparen, .lbracket => this->depth += 1;
                .rparen, .rbracket => this->depth -= 1;
            }
            this->i += op.len;
        }
        this->emit(.eof, "")?;
    }
}

!List<Token> tokenize(Allocator a, str src, str file) {
    // a first line starting with "#!" is a shebang (`#!/usr/bin/env -S zark run`): skipped
    auto start = 0;
    if (src.len >= 2 && src[0] == '#' && src[1] == '!') {
        while (start < src.len && src[start] != '\n') { start += 1; }
    }
    auto lx = Lexer{ .src = src, .file = file, .i = start, .line = 1, .depth = 0, .toks = List<Token>::init(a) };
    lx.run()?;
    return lx.toks;
}
