// Native backend: our LLVM IR subset -> x86-64 machine code -> ELF .o (no LLVM involved).
// Strategy: every SSA value lives in a stack slot; each instruction loads operands into scratch
// registers, computes, and stores the result. Calls follow the System V AMD64 ABI for scalars;
// aggregates are passed by pointer and returned through a hidden sret pointer.

import "x64.vibe";

enum LK { I, F32, F64, P, V, S, A }

struct LT {
    LK k;
    i64 bits;
    i64 size;
    i64 align;
    List<LT*> fields;
    List<i64> offs;
    i64 n;
    LT* elem;
}

bool is_agg(LT* t) { return t.k == .S || t.k == .A; }
bool is_flt(LT* t) { return t.k == .F32 || t.k == .F64; }

// ------------------------------------------------------------------ line cursor
struct Cur { str s; i64 i;
    void ws() { while (this->i < this->s.len && this->s[this->i] == ' ') { this->i += 1; } }
    u8 peek() {
        if (this->i < this->s.len) { return this->s[this->i]; }
        return 0;
    }
    bool eat(u8 c) {
        this->ws();
        if (this->peek() == c) {
            this->i += 1;
            return true;
        }
        return false;
    }
    bool eat_word(str w) {
        this->ws();
        if (this->i + w.len <= this->s.len && this->s[this->i..this->i + w.len] == w) {
            const auto after = this->i + w.len;
            if (after == this->s.len || !(is_alnum(this->s[after]) || this->s[after] == '_' || this->s[after] == '.')) {
                this->i = after;
                return true;
            }
        }
        return false;
    }
    str word() {
        this->ws();
        const auto st = this->i;
        while (this->i < this->s.len) {
            const auto c = this->s[this->i];
            if (c == ' ' || c == ',' || c == '(' || c == ')' || c == ']' || c == '}') { break; }
            this->i += 1;
        }
        return this->s[st..this->i];
    }
    /// operand text up to a top-level ',' ')' ']' or end
    str value() {
        this->ws();
        const auto st = this->i;
        auto d = 0;
        while (this->i < this->s.len) {
            const auto c = this->s[this->i];
            if (c == '"') {
                this->i += 1;
                while (this->i < this->s.len && this->s[this->i] != '"') { this->i += 1; }
            } else if (c == '{' || c == '[' || c == '(') {
                d += 1;
            } else if (c == '}' || c == ']' || c == ')') {
                if (d == 0) { break; }
                d -= 1;
            } else if (c == ',' && d == 0) {
                break;
            }
            this->i += 1;
        }
        auto e = this->i;
        while (e > st && this->s[e - 1] == ' ') { e -= 1; }
        return this->s[st..e];
    }
    str label() {
        // "label %name"
        _ = this->eat_word("label");
        this->ws();
        if (this->peek() == '%') { this->i += 1; }
        return this->word();
    }
}

// ------------------------------------------------------------------ instructions
struct Arg { LT* ty; str v; i64 id1; }
struct PhiIn { str v; str pred; }

struct Ins {
    str op;
    str dest;
    LT* ty;       // result type / main operand type
    LT* ty2;      // cast target, store value type...
    str a;
    str b;
    str c;
    LT* tb;       // type of b (insertvalue elem, select)
    str pred;
    i64 n;
    List<Arg> args;     // call args, gep indices
    List<PhiIn> phis;
    str l1;
    str l2;
    str callee;
    bool variadic;
    i64 nfixed;
    i64 rd;
    i64 ra;
    i64 id1;
    i64 ia1;
    i64 ib1;
    i64 ic1;
    i64 cl1;
}

struct Block { str label; List<Ins*> ins; }
struct AggIn { LT* ty; i64 dst; i64 ptr; }
struct Iv { str name; i64 start; i64 end; i64 w; i64 reg; bool alloca; bool bad; i64 alias; bool nocall; }
struct LoopR { i64 s; i64 e; }
struct Save { i64 reg; i64 off; }

struct Native {
    Allocator a;
    ObjFile obj;
    Map<LT*> named;
    LT* t_i1;
    LT* t_i8;
    LT* t_i32;
    LT* t_i64;
    LT* t_ptr;
    LT* t_void;
    LT* t_f32;
    LT* t_f64;
    // per function
    Map<i64> slot;
    Map<i64> allocas;
    i64 frame;
    i64 sret_slot;
    i64 nlocal;
    str fname;
    List<i64> ivreg;
    List<Iv> ivs;
    List<i64> byn;
    Map<i64> idxm;
    Ins* cur;
    Map<i64> fused;
    Map<i64> lazy;
    str next;
    List<Save> saved;

    !LT* basic(LK k, i64 size) {
        const auto t = this->a.create[LT]()?;
        t.k = k;
        t.size = size;
        t.align = max(size, 1);
        return t;
    }
    !LT* int_t(i64 bits) {
        auto size = bits / 8;
        if (bits == 1) { size = 1; }
        const auto t = this->basic(.I, size)?;
        t.bits = bits;
        return t;
    }

    !LT* ty(Cur* c) {
        c.ws();
        const auto ch = c.peek();
        if (ch == '{') {
            c.i += 1;
            const auto t = this->basic(.S, 0)?;
            t.fields = List[*LT].init(this->a);
            t.offs = List<i64>::init(this->a);
            while (true) {
                c.ws();
                if (c.peek() == '}') {
                    c.i += 1;
                    break;
                }
                t.fields.push(this->ty(c)?)?;
                _ = c.eat(',');
            }
            this->layout(t);
            return t;
        }
        if (ch == '[') {
            c.i += 1;
            c.ws();
            const auto n = parse_num(c.word());
            _ = c.eat_word("x");
            const auto el = this->ty(c)?;
            _ = c.eat(']');
            const auto t = this->basic(.A, el.size * n)?;
            t.n = n;
            t.elem = el;
            t.align = el.align;
            return t;
        }
        if (ch == '%') {
            c.i += 2;   // %"
            const auto st = c.i;
            while (c.peek() != '"') { c.i += 1; }
            const auto name = c.s[st..c.i];
            c.i += 1;
            return this->named.get(name) catch {
                eprintln("native: unknown type %\"{name}\"");
                return error.CompileFailed;
            }
        }
        const auto w = c.word();
        match w {
            "i1" => return this->t_i1;
            "i8" => return this->t_i8;
            "i16" => return this->int_t(16);
            "i32" => return this->t_i32;
            "i64" => return this->t_i64;
            "ptr" => return this->t_ptr;
            "void" => return this->t_void;
            "float" => return this->t_f32;
            "double" => return this->t_f64;
        }
        eprintln("native: unknown type '{w}'");
        return error.CompileFailed;
    }

    void layout(LT* t) {
        auto off = 0;
        auto al = 1;
        for (auto f : t.fields) {
            off = align_up(off, f.align);
            t.offs.push(off) catch {}
            off += f.size;
            al = max(al, f.align);
        }
        t.size = align_up(off, al);
        t.align = al;
    }

    /// byte offset + type of aggregate element `idx`
    Arg elem_at(LT* t, i64 idx) {
        if (t.k == .S) { return Arg{ .ty = t.fields.get(idx), .v = "", .id1 = 0 } }
        return Arg{ .ty = t.elem, .v = "", .id1 = 0 };
    };
    i64 elem_off(LT* t, i64 idx) {
        if (t.k == .S) { return t.offs.get(idx); }
        return t.elem.size * idx;
    }

    // ------------------------------------------------------------------ module
    !void compile_module(str ir) {
        auto lines = List<str>::init(this->a);
        auto st = 0;
        for (auto [i, ch] : ir) {
            if (ch == '\n') {
                lines.push(ir[st..i])?;
                st = i + 1;
            }
        }
        if (st < ir.len) { lines.push(ir[st..])?; }
        auto i = 0;
        while (i < lines.len) {
            const auto ln = lines.get(i);
            if (ln.len == 0 || ln[0] == ';') {
                i += 1;
                continue;
            }
            if (str_starts_with(ln, "%\"")) {
                const auto q = str_find_byte(ln[2..], '"') + 2;
                const auto name = ln[2..q];
                auto c = Cur{ .s = ln, .i = q + 1 };
                _ = c.eat('=');
                _ = c.eat_word("type");
                this->named.put(name, this->ty(&c)?)?;
            } else if (ln[0] == '@') {
                this->global(ln) catch |e| {
                    eprintln("native: cannot parse global: {ln}");
                    return e;
                }
            } else if (str_starts_with(ln, "define ")) {
                auto j = i + 1;
                while (j < lines.len && lines.get(j) != "}") { j += 1; }
                this->function(ln, lines.slice()[i + 1..j])?;
                i = j;
            }
            i += 1;
        }
    }

    !void global(str ln) {
        const auto sp = str_find_byte(ln, ' ');
        const auto name = ln[1..sp];
        auto c = Cur{ .s = ln, .i = sp };
        _ = c.eat('=');
        const auto private = c.eat_word("private");
        _ = c.eat_word("unnamed_addr");
        auto is_const = false;
        if (c.eat_word("constant")) { is_const = true; } else { _ = c.eat_word("global"); }
        const auto t = this->ty(&c)?;
        c.ws();
        const auto init = c.s[c.i..];
        auto buf = &this->obj.data;
        auto sec = SEC_DATA;
        const auto has_ptrs = str_find_byte(init, '@') >= 0;
        if (is_const && !has_ptrs) {
            buf = &this->obj.rodata;
            sec = SEC_RODATA;
        }
        align_buf(buf, t.align)?;
        const auto off = buf.len;
        for (auto _k : 0..t.size) { buf.push(0)?; }
        this->const_bytes(t, init, buf, off, sec == SEC_DATA)?;
        this->obj.define(name, sec, off, t.size, !private, false)?;
    }

    /// write the constant `v` of type `t` into buf[off..]
    !void const_bytes(LT* t, str v, List<u8>*buf, i64 off, bool relocs) {
        if (v == "zeroinitializer" || v == "undef" || v == "null") { return; }
        if (t.k == .A && v.len > 1 && v[0] == 'c' && v[1] == '"') {
            auto i = 2;
            auto o = off;
            while (i < v.len && v[i] != '"') {
                if (v[i] == '\\') {
                    buf.items[o] = (parse_int_radix(v[i + 1..i + 3], 16) catch 0) as u8;
                    i += 3;
                } else {
                    buf.items[o] = v[i];
                    i += 1;
                }
                o += 1;
            }
            return;
        }
        if (is_agg(t)) {
            // { T v, T v } or [T v, T v]
            auto c = Cur{ .s = v, .i = 1 };
            auto k = 0;
            while (k < t.n || (t.k == .S && k < t.fields.len)) {
                const auto et = this->ty(&c)?;
                const auto ev = c.value();
                this->const_bytes(et, ev, buf, off + this->elem_off(t, k), relocs)?;
                _ = c.eat(',');
                k += 1;
            }
            return;
        }
        if (v[0] == '@') {
            if (!relocs) { eprintln("native: pointer in read-only data"); return error.CompileFailed; }
            this->obj.data_relocs.push(Reloc{ .off = off, .sym = v[1..], .kind = R_X86_64_64, .addend = 0 })?;
            return;
        }
        auto bits = parse_num(v);
        if (t.k == .F32) { bits = f32_bits_of_hex(v); }
        for (auto k : 0..t.size) { buf.items[off + k] = ((bits >> (k * 8)) & 0xff) as u8; }
    }

    // ------------------------------------------------------------------ frame
    i64 new_slot(i64 size, i64 align) {
        this->frame = align_up(this->frame + max(size, 1), max(align, 8));
        return 0 - this->frame;
    }

    !void def_slot(str name, LT* t) {
        this->slot.put(name, this->new_slot(align_up(t.size, 8), t.align))?;
    }

    i64 loc(str name) {
        return this->slot.get(name) catch 0;
    }

    i64 reg_of(str name) {
        const auto i = this->idx_get(&this->ivs, name);
        if (i < 0) { return -1; }
        return this->rg(i + 1);
    }

    i64 idx_key(str name) {
        const auto n = name.len;
        if (n < 3 || name[0] != '%' || (name[1] != 't' && name[1] != 'v')) { return -1; }
        auto i = n;
        auto k = 0;
        auto m = 1;
        while (i > 2 && name[i - 1] >= '0' && name[i - 1] <= '9') {
            k += ((name[i - 1] - '0') as i64) * m;
            m *= 10;
            i -= 1;
            if (n - i > 7) { return -1; }
        }
        if (i == n) { return -1; }
        return k;
    }

    !void idx_put(str name, i64 i) {
        const auto k = this->idx_key(name);
        if (k >= 0) {
            while (this->byn.len <= k) { this->byn.push(-1)?; }
            if (this->byn.items[k] < 0) {
                this->byn.items[k] = i;
                return;
            }
        }
        this->idxm.put(name, i)?;
    }

    i64 idx_get(List<Iv>*ivs, str name) {
        const auto k = this->idx_key(name);
        if (k >= 0 && k < this->byn.len) {
            const auto i = this->byn.items[k];
            if (i >= 0 && ivs.items[i].name == name) { return i; }
        }
        return this->idxm.get(name) catch -1;
    }

    i64 rg(i64 id1) {
        if (id1 == 0) { return -1; }
        const auto r = this->ivreg.items[id1 - 1];
        if (r >= 64) { return -1; }
        return r;
    }

    i64 rgv(i64 id1) {
        if (id1 == 0) { return -1; }
        const auto r = this->ivreg.items[id1 - 1];
        if (r >= 64) { return r - 64; }
        return -1;
    }

    i64 opreg(str v) {
        const auto i = this->cur;
        if (v.ptr == i.a.ptr) { return this->rg(i.ia1); }
        if (v.ptr == i.b.ptr) { return this->rg(i.ib1); }
        if (v.ptr == i.c.ptr) { return this->rg(i.ic1); }
        if (v.ptr == i.callee.ptr) { return this->rg(i.cl1); }
        for (auto ar : i.args) {
            if (v.ptr == ar.v.ptr) { return this->rg(ar.id1); }
        }
        return this->reg_of(v);
    }

    !i64 src_reg(i64 scratch, LT* t, str v, bool sign) {
        if (v[0] == '%') {
            const auto r = this->opreg(v);
            if (r >= 0) { return r; }
        }
        this->load_mem(scratch, t, v, sign)?;
        return scratch;
    }

    i64 dreg(Ins* ins) {
        if (ins.rd >= 0) { return ins.rd; }
        return RAX;
    }

    bool is_imm(LT* t, str v) {
        if (t.size != 8 || t.k == .F64 || v.len == 0 || v[0] == '%' || v[0] == '@') { return false; }
        const auto n = parse_num(v);
        return n >= -2147483648 && n <= 2147483647;
    }

    i64 cc_of(str pred) {
        match pred {
            "eq" => return CC_E;
            "ne" => return CC_NE;
            "slt" => return CC_L;
            "sle" => return CC_LE;
            "sgt" => return CC_G;
            "sge" => return CC_GE;
            "ult" => return CC_B;
            "ule" => return CC_BE;
            "ugt" => return CC_A;
            "uge" => return CC_AE;
        }
        return CC_E;
    }

    !void cmp_ins(Ins* ins) {
        const auto asm = &this->obj.text;
        const auto signed = ins.pred[0] == 's';
        const auto ra = this->src_reg(RAX, ins.ty2, ins.a, signed)?;
        if (this->is_imm(ins.ty2, ins.b)) {
            asm.alu_imm(7, ra, parse_num(ins.b))?;
        } else {
            const auto rb = this->src_reg(RCX, ins.ty2, ins.b, signed)?;
            asm.cmp(ra, rb)?;
        }
    }

    !void cmp_br(Ins* ins, Ins* br) {
        const auto asm = &this->obj.text;
        this->cmp_ins(ins)?;
        const auto cc = this->cc_of(ins.pred);
        if (br.l1 == this->next) {
            asm.jcc(cc ^ 1, br.l2)?;
        } else {
            asm.jcc(cc, br.l1)?;
            if (br.l2 != this->next) { asm.jmp(br.l2)?; }
        }
    }

    void bump(Map<i64>*m, str name) {
        if (name.len == 0 || name[0] != '%' || !m.has(name)) { return; }
        const auto e = &m.entries[m.__find(name)];
        e.value += 1;
    }

    i64 note(List<Iv>*ivs, str name, i64 pos, i64 w, bool access) {
        if (name.len == 0 || name[0] != '%') { return 0; }
        const auto i = this->idx_get(ivs, name);
        if (i < 0) { return 0; }
        const auto iv = &ivs.items[i];
        if (iv.alloca && !access) { iv.bad = true; }
        if (pos < iv.start) { iv.start = pos; }
        if (pos > iv.end) { iv.end = pos; }
        iv.w += w;
        return i + 1;
    }

    !void alloc_regs(List<Arg> params, List<Block> blocks) {
        this->byn.len = 0;
        this->idxm = Map<i64>::init(this->a);
        this->saved = List<Save>::init(this->a);
        auto bidx = Map<i64>::init(this->a);
        auto bstart = List<i64>::init(this->a);
        auto bend = List<i64>::init(this->a);
        auto total = 0;
        for (auto [bi, blk] : blocks) {
            bidx.put(blk.label, bi)?;
            bstart.push(total)?;
            total += blk.ins.len;
            bend.push(total - 1)?;
        }

        auto cc = List<i64>::init(this->a);
        cc.push(0)?;
        auto loops = List<LoopR>::init(this->a);
        for (auto [bi, blk] : blocks) {
            if (blk.ins.len == 0) { continue; }
            const auto t = blk.ins.get(blk.ins.len - 1);
            if (t.op != "br") { continue; }
            const auto targets = [t.l1, t.l2];
            for (auto tl : targets) {
                if (tl.len == 0 || !bidx.has(tl)) { continue; }
                const auto ti = bidx.get(tl)?;
                if (ti > bi) { continue; }
                loops.push(LoopR{ .s = bstart.get(ti), .e = bend.get(bi) })?;
            }
        }
        auto depth = List<i64>::init(this->a);
        if (loops.len > 0) {
            for (auto _k : 0..total) { depth.push(0)?; }
            for (auto lp : loops) {
                for (auto q : lp.s..lp.e + 1) { depth.items[q] += 1; }
            }
        }

        auto ivs = List<Iv>::init(this->a);
        for (auto p : params) {
            if (is_agg(p.ty) || p.ty.size != 8) { continue; }
            this->idx_put(p.v, ivs.len)?;
            ivs.push(Iv{ .name = p.v, .start = -1, .end = -1, .w = 0, .reg = -1, .alloca = false, .bad = false, .alias = -1, .nocall = false })?;
        }
        auto pos = 0;
        for (auto blk : blocks) {
            for (auto ins : blk.ins) {
                if (ins.dest.len > 0 && !is_agg(ins.ty) && ins.ty.size == 8) {
                    if (ins.op == "alloca") {
                        ins.id1 = ivs.len + 1;
                        this->idx_put(ins.dest, ivs.len)?;
                        ivs.push(Iv{ .name = ins.dest, .start = total + 1, .end = -2, .w = 0, .reg = -1, .alloca = true, .bad = false, .alias = -1, .nocall = false })?;
                    } else if (ins.op != "phi" && ins.op != "insertvalue") {
                        ins.id1 = ivs.len + 1;
                        this->idx_put(ins.dest, ivs.len)?;
                        ivs.push(Iv{ .name = ins.dest, .start = pos, .end = pos, .w = 1, .reg = -1, .alloca = false, .bad = false, .alias = -1, .nocall = false })?;
                    }
                }
                pos += 1;
            }
        }

        pos = 0;
        for (auto blk : blocks) {
            for (auto ins : blk.ins) {
                auto w = 1;
                if (loops.len > 0) {
                    for (auto _k : 0..min(depth.get(pos), 4)) { w *= 10; }
                }
                const auto op = ins.op;
                auto ncall = cc.get(cc.len - 1);
                if (op.len == 4 && ((op[0] == 'c' && op[1] == 'a') || (op[0] == 'f' && op[1] == 'r'))) { ncall += 1; }
                cc.push(ncall)?;
                auto access = false;
                if (op == "load") { access = !is_agg(ins.ty) && ins.ty.size == 8; }
                if (op == "store") { access = !is_agg(ins.ty2) && ins.ty2.size == 8; }
                if (ins.a.len > 0) { ins.ia1 = this->note(&ivs, ins.a, pos, w, access && (op == "load" || op == "store")); }
                if (ins.b.len > 0) { ins.ib1 = this->note(&ivs, ins.b, pos, w, false); }
                if (ins.c.len > 0) { ins.ic1 = this->note(&ivs, ins.c, pos, w, false); }
                if (ins.callee.len > 0) { ins.cl1 = this->note(&ivs, ins.callee, pos, w, false); }
                for (auto ai : 0..ins.args.len) {
                    const auto ar = &ins.args.items[ai];
                    ar.id1 = this->note(&ivs, ar.v, pos, w, false);
                }
                for (auto pi : ins.phis) {
                    if (bidx.has(pi.pred)) { _ = this->note(&ivs, pi.v, bend.get(bidx.get(pi.pred)?), w, false); }
                }
                pos += 1;
            }
        }

        if (loops.len > 0) {
            auto multi = List<i64>::init(this->a);
            auto bof = List<i64>::init(this->a);
            for (auto [bi, blk] : blocks) {
                for (auto _q : 0..blk.ins.len) { bof.push(bi)?; }
            }
            for (auto k : 0..ivs.len) {
                const auto iv = &ivs.items[k];
                if (iv.start > iv.end) { continue; }
                if (iv.end > bend.get(bof.get(max(iv.start, 0)))) { multi.push(k)?; }
            }
            auto changed = true;
            while (changed) {
                changed = false;
                for (auto lp : loops) {
                    for (auto mk : multi) {
                        const auto iv = &ivs.items[mk];
                        if (iv.start < lp.s && iv.end >= lp.s && iv.end < lp.e) {
                            iv.end = lp.e;
                            changed = true;
                        }
                    }
                }
            }
        }

        pos = 0;
        for (auto [bi, blk] : blocks) {
            for (auto [k, ins] : blk.ins) {
                if (ins.op == "load" && ins.ia1 > 0 && ins.id1 > 0) {
                    const auto vi = ins.ia1 - 1;
                    const auto ti = ins.id1 - 1;
                    const auto v = &ivs.items[vi];
                    const auto t = &ivs.items[ti];
                    if (v.alloca && !v.bad && v.start <= v.end && !t.alloca && t.end <= bend.get(bi) && t.end - pos <= 24) {
                        auto clean = true;
                        for (auto q : k + 1..t.end - bstart.get(bi)) {
                            const auto o = blk.ins.get(q);
                            if (o.op == "store" && o.a == ins.a) { clean = false; }
                        }
                        if (clean) {
                            t.alias = vi;
                            if (t.end > v.end) { v.end = t.end; }
                            v.w += t.w;
                        }
                    }
                }
                pos += 1;
            }
        }
        for (auto k : 0..ivs.len) {
            const auto iv = &ivs.items[k];
            if (iv.start >= 0 && iv.start <= iv.end) { iv.nocall = cc.get(iv.end + 1) - cc.get(iv.start + 1) == 0; }
        }
        this->scan(&ivs, total)?;
        this->ivs = ivs;

        auto seen = 0;
        this->ivreg.len = 0;
        for (auto k : 0..ivs.len) {
            this->ivreg.push(-1)?;
            const auto iv = &ivs.items[k];
            auto reg = iv.reg;
            if (iv.alias >= 0) { reg = ivs.items[iv.alias].reg; }
            if (reg < 0) { continue; }
            if (iv.alloca) { this->ivreg.items[k] = reg + 64; } else { this->ivreg.items[k] = reg; }
            if (reg != R8 && reg != R9 && (seen & (1 << reg)) == 0) {
                seen = seen | (1 << reg);
                this->saved.push(Save{ .reg = reg, .off = this->new_slot(8, 8) })?;
            }
        }
    }

    !void scan(List<Iv>*ivs, i64 total) {
        auto head = List<i64>::init(this->a);
        for (auto _k : 0..total + 2) { head.push(-1)?; }
        auto nxt = List<i64>::init(this->a);
        for (auto k : 0..ivs.len) {
            nxt.push(-1)?;
            const auto iv = &ivs.items[k];
            iv.reg = -1;
            if (iv.bad || iv.start > iv.end || iv.alias >= 0) { continue; }
            nxt.items[k] = head.get(iv.start + 1);
            head.items[iv.start + 1] = k;
        }

        const auto pool = [RBX, R12, R13, R14, R15, R8, R9];
        auto active = List<i64>::init(this->a);
        auto busy = 0;
        for (auto s : 0..total + 2) {
            auto k = head.get(s);
            while (k >= 0) {
                const auto cur = &ivs.items[k];
                auto j = 0;
                while (j < active.len) {
                    if (ivs.items[active.get(j)].end < cur.start) {
                        busy = busy ^ (1 << ivs.items[active.get(j)].reg);
                        active.items[j] = active.get(active.len - 1);
                        active.len -= 1;
                    } else {
                        j += 1;
                    }
                }
                auto free = -1;
                auto np = 5;
                if (cur.nocall) { np = 7; }
                for (auto t : 0..np) {
                    auto ri = t;
                    if (cur.nocall) { ri = (t + 5) % 7; }
                    if ((busy & (1 << pool[ri])) == 0) {
                        free = pool[ri];
                        break;
                    }
                }
                if (free >= 0) {
                    cur.reg = free;
                    busy = busy | (1 << free);
                    active.push(k)?;
                } else {
                    auto vi = -1;
                    for (auto j2 : 0..active.len) {
                        const auto o = &ivs.items[active.get(j2)];
                        if (o.reg >= 8 && o.reg < 10 && !cur.nocall) { continue; }
                        if (vi < 0 || o.w < ivs.items[active.get(vi)].w) { vi = j2; }
                    }
                    if (vi >= 0 && ivs.items[active.get(vi)].w < cur.w) {
                        const auto victim = &ivs.items[active.get(vi)];
                        cur.reg = victim.reg;
                        victim.reg = -1;
                        active.items[vi] = k;
                    }
                }
                k = nxt.get(k);
            }
        }
    }

    // ------------------------------------------------------------------ function
    !void function(str hdr, str[] body) {
        const auto asm = &this->obj.text;
        this->slot = Map<i64>::init(this->a);
        this->allocas = Map<i64>::init(this->a);
        this->frame = 0;
        this->sret_slot = 0;
        // header: define [internal ]RET @name(T %a.0, ...) {
        auto c = Cur{ .s = hdr, .i = 7 };
        const auto internal = c.eat_word("internal");
        const auto ret = this->ty(&c)?;
        c.ws();
        c.i += 1; // @
        const auto st = c.i;
        while (c.peek() != '(') { c.i += 1; }
        const auto name = c.s[st..c.i];
        this->fname = name;
        c.i += 1;
        auto params = List<Arg>::init(this->a);
        while (!c.eat(')')) {
            const auto pt = this->ty(&c)?;
            c.ws();
            const auto pn = c.value();
            params.push(Arg{ .ty = pt, .v = pn, .id1 = 0 })?;
            _ = c.eat(',');
        }

        // pass 1: parse instructions, allocate slots
        auto blocks = List<Block>::init(this->a);
        auto phis_of = Map<List<Ins*>>::init(this->a);   // block label -> phis
        if (is_agg(ret)) { this->sret_slot = this->new_slot(8, 8); }
        for (auto ln : body) {
            if (ln.len == 0) { continue; }
            if (ln[0] != ' ') {
                blocks.push(Block{ .label = ln[0..ln.len - 1], .ins = List<Ins*>::init(this->a) })?;
                continue;
            }
            const auto ins = this->parse_ins(ln) catch |e| {
                eprintln("native: cannot parse in {name}: {ln}");
                return e;
            }
            blocks.items[blocks.len - 1].ins.push(ins)?;
            if (ins.op == "phi") {
                const auto bl = blocks.get(blocks.len - 1).label;
                if (!phis_of.has(bl)) { phis_of.put(bl, List<Ins*>::init(this->a))?; }
                const auto e = &phis_of.entries[phis_of.__find(bl)];
                e.value.push(ins)?;
            }
        }

        this->alloc_regs(params, blocks)?;
        for (auto p : params) {
            if (this->reg_of(p.v) < 0) { this->def_slot(p.v, p.ty)?; }
        }
        for (auto blk : blocks) {
            for (auto ins : blk.ins) {
                ins.ra = -1;
                if (ins.op == "alloca") {
                    ins.rd = this->rgv(ins.id1);
                } else {
                    ins.rd = this->rg(ins.id1);
                    if (ins.op == "load" || ins.op == "store") { ins.ra = this->rgv(ins.ia1); }
                }
                if (ins.rd >= 0) { continue; }
                if (ins.op == "alloca") {
                    this->allocas.put(ins.dest, this->new_slot(ins.ty.size, ins.ty.align))?;
                } else if (ins.dest.len > 0) {
                    this->def_slot(ins.dest, ins.ty)?;
                }
            }
        }

        // prologue
        const auto start = asm.pos();
        asm.b(0x55)?;                         // push rbp
        asm.mov_rr(RBP, RSP)?;                // mov rbp, rsp
        asm.rex(true, 0, RSP, false)?;        // sub rsp, imm32 (patched)
        asm.b(0x81)?;
        asm.b(0xEC)?;
        const auto frame_patch = asm.pos();
        asm.d32(0)?;
        for (auto sv : this->saved) { asm.st(sv.reg, RBP, sv.off, 8)?; }
        this->prologue(params, ret)?;

        this->fused = Map<i64>::init(this->a);
        this->lazy = Map<i64>::init(this->a);
        auto cmps = Map<i64>::init(this->a);
        auto runs = Map<i64>::init(this->a);
        auto lsrc = Map<i64>::init(this->a);
        for (auto blk : blocks) {
            for (auto [k, ins] : blk.ins) {
                if (k + 1 >= blk.ins.len) { continue; }
                if (ins.op == "icmp") {
                    const auto br = blk.ins.get(k + 1);
                    if (br.op == "br" && br.c == ins.dest && !phis_of.has(br.l1) && !phis_of.has(br.l2)) { cmps.put(ins.dest, 0)?; }
                } else if (ins.op == "load" && is_agg(ins.ty) && this->allocas.has(ins.a)) {
                    auto j = k + 1;
                    while (j < blk.ins.len && blk.ins.get(j).op == "extractvalue" && blk.ins.get(j).a == ins.dest) { j += 1; }
                    if (j > k + 1) {
                        cmps.put(ins.dest, 0)?;
                        runs.put(ins.dest, j - k - 1)?;
                        lsrc.put(ins.dest, this->allocas.get(ins.a)?)?;
                    }
                }
            }
        }
        if (cmps.len > 0) {
            for (auto blk : blocks) {
                for (auto ins : blk.ins) {
                    this->bump(&cmps, ins.a);
                    this->bump(&cmps, ins.b);
                    this->bump(&cmps, ins.c);
                    this->bump(&cmps, ins.callee);
                    for (auto ar : ins.args) { this->bump(&cmps, ar.v); }
                    for (auto pi : ins.phis) { this->bump(&cmps, pi.v); }
                }
            }
            for (auto e : cmps.entries) {
                if (!e.used) { continue; }
                if (runs.has(e.key)) {
                    if (e.value == runs.get(e.key)?) { this->lazy.put(e.key, lsrc.get(e.key)?)?; }
                } else if (e.value == 1) {
                    this->fused.put(e.key, 1)?;
                }
            }
        }

        // pass 2: code
        for (auto [bi, blk] : blocks) {
            asm.bind(blk.label)?;
            this->next = "";
            if (bi + 1 < blocks.len) { this->next = blocks.get(bi + 1).label; }
            auto k = 0;
            while (k < blk.ins.len) {
                const auto ins = blk.ins.get(k);
                this->cur = ins;
                if (ins.op == "icmp" && this->fused.has(ins.dest) && k + 1 < blk.ins.len) {
                    this->cmp_br(ins, blk.ins.get(k + 1))?;
                    break;
                }
                const auto is_term = ins.op == "br" || ins.op == "ret" || ins.op == "unreachable";
                if (ins.op == "br") { this->phi_moves(blk.label, ins, &phis_of)?; }
                this->emit_ins(ins, ret)?;
                if (is_term) { break; }
                k += 1;
            }
        }
        patch_u32(&asm.code, frame_patch, align_up(this->frame, 16));
        asm.resolve_fixups()?;
        this->obj.define(name, SEC_TEXT, start, asm.pos() - start, !internal, true)?;
    }

    !void prologue(List<Arg> params, LT* ret) {
        const auto asm = &this->obj.text;
        const auto iregs = [RDI, RSI, RDX, RCX, R8, R9];
        auto ni = 0;
        auto nf = 0;
        auto nstack = 0;
        if (is_agg(ret)) {
            asm.st(RDI, RBP, this->sret_slot, 8)?;
            ni = 1;
        }
        // phase A: spill registers (aggregate params arrive as pointers)
        auto agg_in = List<AggIn>::init(this->a);
        for (auto p : params) {
            const auto off = this->loc(p.v);
            const auto pr = this->reg_of(p.v);
            if (is_flt(p.ty) && nf < 8) {
                if (pr >= 0) {
                    asm.movq_r_x(pr, nf, true)?;
                } else {
                    asm.movq_r_x(R10, nf, true)?;
                    asm.st(R10, RBP, off, p.ty.size)?;
                }
                nf += 1;
            } else if (!is_flt(p.ty) && ni < 6) {
                if (pr >= 0) {
                    asm.mov_rr(pr, iregs[ni])?;
                } else if (is_agg(p.ty)) {
                    const auto tmp = this->new_slot(8, 8);
                    asm.st(iregs[ni], RBP, tmp, 8)?;
                    agg_in.push(AggIn{ .ty = p.ty, .dst = off, .ptr = tmp })?;
                } else {
                    asm.st(iregs[ni], RBP, off, max(p.ty.size, 1))?;
                }
                ni += 1;
            } else {
                // stack-passed: [rbp + 16 + 8*k]
                const auto soff = 16 + 8 * nstack;
                nstack += 1;
                if (is_agg(p.ty)) {
                    asm.ld(R11, RBP, soff, 8, false)?;
                    this->copy(RBP, off, R11, 0, p.ty.size)?;
                } else if (pr >= 0) {
                    asm.ld(pr, RBP, soff, 8, false)?;
                } else {
                    asm.ld(R10, RBP, soff, 8, false)?;
                    asm.st(R10, RBP, off, max(p.ty.size, 1))?;
                }
            }
        }
        // phase B: copy aggregates from their incoming pointers
        for (auto x : agg_in) {
            asm.ld(R11, RBP, x.ptr, 8, false)?;
            this->copy(RBP, x.dst, R11, 0, x.ty.size)?;
        }
    }

    // ------------------------------------------------------------------ parsing one instruction
    !Ins* new_ins() {
        const auto i = this->a.create<Ins>()?;
        i.args = List<Arg>::init(this->a);
        i.phis = List<PhiIn>::init(this->a);
        return i;
    };

    !Ins* parse_ins(str ln) {
        const auto ins = this->new_ins()?;
        auto c = Cur{ .s = ln, .i = 0 };
        c.ws();
        if (c.peek() == '%') {
            const auto st = c.i;
            while (c.peek() != ' ') { c.i += 1; }
            ins.dest = c.s[st..c.i];
            _ = c.eat('=');
        }
        ins.op = c.word();
        const auto op = ins.op;
        if (op == "alloca") {
            ins.ty = this->ty(&c)?;
        } else if (op == "load") {
            ins.ty = this->ty(&c)?;
            _ = c.eat(',');
            _ = this->ty(&c)?;
            ins.a = c.value();
        } else if (op == "store") {
            ins.ty2 = this->ty(&c)?;
            ins.b = c.value();
            _ = c.eat(',');
            _ = this->ty(&c)?;
            ins.a = c.value();
        } else if (op == "getelementptr") {
            ins.ty2 = this->ty(&c)?;
            _ = c.eat(',');
            _ = this->ty(&c)?;
            ins.a = c.value();
            while (c.eat(',')) {
                const auto it = this->ty(&c)?;
                ins.args.push(Arg{ .ty = it, .v = c.value(), .id1 = 0 })?;
            }
            ins.ty = this->t_ptr;
        } else if (op == "icmp" || op == "fcmp") {
            ins.pred = c.word();
            ins.ty2 = this->ty(&c)?;
            ins.a = c.value();
            _ = c.eat(',');
            ins.b = c.value();
            ins.ty = this->t_i1;
        } else if (op == "fneg") {
            ins.ty = this->ty(&c)?;
            ins.a = c.value();
        } else if (op == "select") {
            _ = this->ty(&c)?;
            ins.c = c.value();
            _ = c.eat(',');
            ins.ty = this->ty(&c)?;
            ins.a = c.value();
            _ = c.eat(',');
            _ = this->ty(&c)?;
            ins.b = c.value();
        } else if (op == "extractvalue") {
            ins.ty2 = this->ty(&c)?;
            ins.a = c.value();
            _ = c.eat(',');
            ins.n = parse_num(c.value());
            ins.ty = this->elem_at(ins.ty2, ins.n).ty;
        } else if (op == "insertvalue") {
            ins.ty = this->ty(&c)?;
            ins.a = c.value();
            _ = c.eat(',');
            ins.tb = this->ty(&c)?;
            ins.b = c.value();
            _ = c.eat(',');
            ins.n = parse_num(c.value());
        } else if (op == "phi") {
            ins.ty = this->ty(&c)?;
            while (c.eat('[')) {
                const auto v = c.value();
                _ = c.eat(',');
                c.ws();
                c.i += 1; // %
                const auto pl = c.value();
                _ = c.eat(']');
                ins.phis.push(PhiIn{ .v = v, .pred = pl })?;
                _ = c.eat(',');
            }
        } else if (op == "call") {
            ins.ty = this->ty(&c)?;
            c.ws();
            if (c.peek() == '(') {
                c.i += 1;
                auto nf = 0;
                while (!c.eat(')')) {
                    if (c.eat_word("...")) {
                        ins.variadic = true;
                    } else {
                        _ = this->ty(&c)?;
                        nf += 1;
                    }
                    _ = c.eat(',');
                }
                ins.nfixed = nf;
            }
            c.ws();
            const auto st = c.i;
            while (c.peek() != '(') { c.i += 1; }
            ins.callee = c.s[st..c.i];
            c.i += 1;
            while (!c.eat(')')) {
                const auto at = this->ty(&c)?;
                ins.args.push(Arg{ .ty = at, .v = c.value(), .id1 = 0 })?;
                _ = c.eat(',');
            }
            if (ins.ty.k == .V) { ins.dest = ""; }
        } else if (op == "br") {
            c.ws();
            if (c.eat_word("label")) {
                c.ws();
                c.i += 1;
                ins.l1 = c.word();
            } else {
                _ = this->ty(&c)?;
                ins.c = c.value();
                _ = c.eat(',');
                ins.l1 = c.label();
                _ = c.eat(',');
                ins.l2 = c.label();
            }
        } else if (op == "ret") {
            ins.ty = this->ty(&c)?;
            if (ins.ty.k != .V) { ins.a = c.value(); }
        } else if (op == "unreachable") {
        } else if (op == "trunc" || op == "zext" || op == "sext" || op == "sitofp" || op == "uitofp" || op == "fptosi" || op == "fptoui" || op == "fpext" || op == "fptrunc" || op == "ptrtoint" || op == "inttoptr" || op == "bitcast") {
            ins.ty2 = this->ty(&c)?;
            ins.a = c.word();
            _ = c.eat_word("to");
            ins.ty = this->ty(&c)?;
        } else {
            // binary: op T a, b
            ins.ty = this->ty(&c)?;
            ins.a = c.value();
            _ = c.eat(',');
            ins.b = c.value();
        }
        return ins;
    };

    // ------------------------------------------------------------------ operand access
    /// load a scalar operand into `reg` (sign-extended if `sign`)
    !void load_op(i64 reg, LT* t, str v, bool sign) {
        if (v[0] == '%') {
            const auto vr = this->opreg(v);
            if (vr >= 0) {
                if (vr != reg) { this->obj.text.mov_rr(reg, vr)?; }
                return;
            }
        }
        this->load_mem(reg, t, v, sign)?;
    }

    !void load_mem(i64 reg, LT* t, str v, bool sign) {
        const auto asm = &this->obj.text;
        const auto c0 = v[0];
        if (c0 == '%') {
            const auto so = this->slot.get(v) catch 1;
            if (so != 1) {
                auto size = t.size;
                if (t.k == .P || is_agg(t)) { size = 8; }
                asm.ld(reg, RBP, so, max(size, 1), sign && t.k == .I)?;
                return;
            }
            const auto ao = this->allocas.get(v) catch 1;
            if (ao == 1) { eprintln("native: unknown value {v} in {this->fname}"); return error.CompileFailed; }
            asm.lea(reg, RBP, ao)?;
            return;
        }
        if (c0 == '@') {
            asm.lea_sym(reg, v[1..])?;
            return;
        }
        auto bits = parse_num(v);
        if (t.k == .F32 && v.len > 2 && v[1] == 'x') { bits = f32_bits_of_hex(v); }
        if (t.k == .I && sign && t.bits < 64 && t.bits > 1) {
            const auto sh = 64 - t.bits;
            bits = (bits << sh) >> sh;
        }
        asm.mov_imm(reg, bits)?;
    }

    /// memory location of an aggregate operand (materializing constants into a scratch slot)
    !i64 agg_loc(LT* t, str v) {
        if (this->lazy.len > 0 && v[0] == '%' && this->lazy.has(v)) { return this->lazy.get(v)?; }
        if (v[0] == '%' && this->slot.has(v)) { return this->slot.get(v); }
        const auto tmp = this->new_slot(align_up(t.size, 8), t.align);
        this->put(t, v, RBP, tmp)?;
        return tmp;
    }

    /// write operand `v` of type `t` to [base+disp] (base must not be r10/rsi/rdi/rcx)
    !void put(LT* t, str v, i64 base, i64 disp) {
        const auto asm = &this->obj.text;
        if (!is_agg(t)) {
            const auto r = this->src_reg(R10, t, v, false)?;
            asm.st(r, base, disp, max(t.size, 1))?;
            return;
        }
        if (v == "undef" || v == "poison") { return; }
        if (v == "zeroinitializer") {
            this->zero(base, disp, t.size)?;
            return;
        }
        if (v[0] == '%') {
            this->copy(base, disp, RBP, this->loc(v), t.size)?;
            return;
        }
        // constant aggregate: { T v, T v } / [T v, ...]
        auto c = Cur{ .s = v, .i = 1 };
        auto k = 0;
        while (k < t.n || (t.k == .S && k < t.fields.len)) {
            const auto et = this->ty(&c)?;
            const auto ev = c.value();
            this->put(et, ev, base, disp + this->elem_off(t, k))?;
            _ = c.eat(',');
            k += 1;
        }
    }

    !void zero(i64 base, i64 disp, i64 size) {
        const auto asm = &this->obj.text;
        asm.xor_(R10, R10)?;
        auto o = 0;
        while (o + 8 <= size) {
            asm.st(R10, base, disp + o, 8)?;
            o += 8;
        }
        while (o < size) {
            asm.st(R10, base, disp + o, 1)?;
            o += 1;
        }
    }

    /// memcpy [db+dd] <- [sb+sd], n bytes (clobbers r10; rsi/rdi/rcx for large copies)
    !void copy(i64 db, i64 dd, i64 sb, i64 sd, i64 n) {
        const auto asm = &this->obj.text;
        if (n > 64) {
            asm.lea(RSI, sb, sd)?;
            asm.lea(RDI, db, dd)?;
            asm.mov_imm(RCX, n)?;
            asm.b(0xF3)?;
            asm.b(0xA4)?;   // rep movsb
            return;
        }
        auto o = 0;
        while (o < n) {
            auto w = 8;
            while (o + w > n) { w = w / 2; }
            asm.ld(R10, sb, sd + o, w, false)?;
            asm.st(R10, db, dd + o, w)?;
            o += w;
        }
    }

    !void store_res(Ins* ins, i64 reg) {
        const auto dr = ins.rd;
        if (dr >= 0) {
            if (dr != reg) { this->obj.text.mov_rr(dr, reg)?; }
            return;
        }
        this->obj.text.st(reg, RBP, this->loc(ins.dest), max(ins.ty.size, 1))?;
    }

    // ------------------------------------------------------------------ phis
    !void phi_moves(str from, Ins* br, Map<List<Ins*>> *phis_of) {
        this->phi_moves_to(from, br.l1, phis_of)?;
        if (br.l2.len > 0 && br.l2 != br.l1) { this->phi_moves_to(from, br.l2, phis_of)?; }
    }

    !void phi_moves_to(str from, str to, Map<List<Ins*>> *phis_of) {
        if (!phis_of.has(to)) { return; }
        const auto list = phis_of.get(to)?;
        for (auto p : list) {
            for (auto inc : p.phis) {
                if (inc.pred == from) { this->put(p.ty, inc.v, RBP, this->loc(p.dest))?; }
            }
        }
    }

    // ------------------------------------------------------------------ instruction selection
    !void emit_ins(Ins* ins, LT* ret) {
        const auto asm = &this->obj.text;
        const auto op = ins.op;
        if (op == "alloca" || op == "phi") { return; }
        if (op == "load") {
            if (this->lazy.len > 0 && is_agg(ins.ty) && this->lazy.has(ins.dest)) { return; }
            const auto rd = ins.rd;
            const auto ra = ins.ra;
            auto ao = 1;
            if (ra < 0 && ins.a[0] == '%') { ao = this->allocas.get(ins.a) catch 1; }
            if (ra >= 0) {
                if (rd < 0) {
                    asm.st(ra, RBP, this->loc(ins.dest), 8)?;
                } else if (rd != ra) {
                    asm.mov_rr(rd, ra)?;
                }
            } else if (ao != 1) {
                if (rd >= 0) {
                    asm.ld(rd, RBP, ao, 8, false)?;
                } else {
                    this->copy(RBP, this->loc(ins.dest), RBP, ao, ins.ty.size)?;
                }
            } else {
                const auto pb = this->src_reg(R11, this->t_ptr, ins.a, false)?;
                if (rd >= 0) {
                    asm.ld(rd, pb, 0, 8, false)?;
                } else {
                    this->copy(RBP, this->loc(ins.dest), pb, 0, ins.ty.size)?;
                }
            }
            return;
        }
        if (op == "store") {
            const auto ra = ins.ra;
            auto ao = 1;
            if (ra < 0 && ins.a[0] == '%') { ao = this->allocas.get(ins.a) catch 1; }
            if (ra >= 0) {
                this->load_op(ra, ins.ty2, ins.b, false)?;
            } else if (ao != 1) {
                this->put(ins.ty2, ins.b, RBP, ao)?;
            } else {
                const auto pb = this->src_reg(R11, this->t_ptr, ins.a, false)?;
                this->put(ins.ty2, ins.b, pb, 0)?;
            }
            return;
        }
        if (op == "getelementptr") {
            const auto acc = this->dreg(ins);
            this->load_op(acc, this->t_ptr, ins.a, false)?;
            auto t = ins.ty2;
            for (auto [k, ix] : ins.args) {
                const auto isconst = ix.v[0] != '%';
                auto esz = t.size;
                if (k > 0 && t.k == .S) {
                    const auto fi = parse_num(ix.v);
                    const auto o = t.offs.get(fi);
                    if (o != 0) { asm.add_imm(acc, o)?; }
                    t = t.fields.get(fi);
                    continue;
                }
                if (k > 0) {
                    t = t.elem;
                    esz = t.size;
                }
                if (isconst) {
                    const auto n = parse_num(ix.v);
                    if (n != 0) { asm.add_imm(acc, n * esz)?; }
                } else {
                    const auto ri = this->src_reg(RCX, ix.ty, ix.v, true)?;
                    if (esz == 1) {
                        asm.add(acc, ri)?;
                    } else {
                        asm.imul_rri(RCX, ri, esz)?;
                        asm.add(acc, RCX)?;
                    }
                }
            }
            this->store_res(ins, acc)?;
            return;
        }
        if (op == "extractvalue") {
            const auto src = this->agg_loc(ins.ty2, ins.a)? + this->elem_off(ins.ty2, ins.n);
            if (ins.rd >= 0) {
                asm.ld(ins.rd, RBP, src, 8, false)?;
            } else {
                this->copy(RBP, this->loc(ins.dest), RBP, src, ins.ty.size)?;
            }
            return;
        }
        if (op == "insertvalue") {
            const auto d = this->loc(ins.dest);
            this->put(ins.ty, ins.a, RBP, d)?;
            this->put(ins.tb, ins.b, RBP, d + this->elem_off(ins.ty, ins.n))?;
            return;
        }
        if (op == "icmp") {
            this->cmp_ins(ins)?;
            asm.setcc(this->cc_of(ins.pred), RAX)?;
            this->store_res(ins, RAX)?;
            return;
        }
        if (op == "fcmp") {
            const auto dbl = ins.ty2.k == .F64;
            asm.movq_x_r(0, this->src_reg(RAX, ins.ty2, ins.a, false)?, dbl)?;
            asm.movq_x_r(1, this->src_reg(RAX, ins.ty2, ins.b, false)?, dbl)?;
            auto p = -1;
            if (dbl) { p = 0x66; }
            const auto pr = ins.pred;
            if (pr == "olt" || pr == "ole") {
                asm.sse(p, 0x0F2E, 1, 0)?;   // ucomis b, a
                if (pr == "olt") { asm.setcc(CC_A, RAX)?; } else { asm.setcc(CC_AE, RAX)?; }
            } else {
                asm.sse(p, 0x0F2E, 0, 1)?;   // ucomis a, b
                if (pr == "oeq") {
                    asm.setcc(CC_E, RAX)?;
                    asm.setcc(CC_NP, RCX)?;
                    asm.and_(RAX, RCX)?;
                } else if (pr == "une") {
                    asm.setcc(CC_NE, RAX)?;
                    asm.setcc(CC_P, RCX)?;
                    asm.or_(RAX, RCX)?;
                } else if (pr == "ogt") {
                    asm.setcc(CC_A, RAX)?;
                } else {
                    asm.setcc(CC_AE, RAX)?;
                }
            }
            this->store_res(ins, RAX)?;
            return;
        }
        if (op == "br") {
            if (ins.c.len == 0) {
                if (ins.l1 != this->next) { asm.jmp(ins.l1)?; }
                return;
            }
            this->load_op(RAX, this->t_i1, ins.c, false)?;
            asm.test(RAX, RAX)?;
            if (ins.l1 == this->next) {
                asm.jcc(CC_E, ins.l2)?;
            } else {
                asm.jcc(CC_NE, ins.l1)?;
                if (ins.l2 != this->next) { asm.jmp(ins.l2)?; }
            }
            return;
        }
        if (op == "ret") {
            if (ins.ty.k != .V) {
                if (is_agg(ins.ty)) {
                    asm.ld(R11, RBP, this->sret_slot, 8, false)?;
                    this->put(ins.ty, ins.a, R11, 0)?;
                    asm.mov_rr(RAX, R11)?;
                } else if (is_flt(ins.ty)) {
                    this->load_op(RAX, ins.ty, ins.a, false)?;
                    asm.movq_x_r(0, RAX, ins.ty.k == .F64)?;
                } else {
                    this->load_op(RAX, ins.ty, ins.a, false)?;
                }
            }
            for (auto sv : this->saved) { asm.ld(sv.reg, RBP, sv.off, 8, false)?; }
            asm.mov_rr(RSP, RBP)?;
            asm.b(0x5D)?;   // pop rbp
            asm.b(0xC3)?;   // ret
            return;
        }
        if (op == "unreachable") {
            asm.b(0x0F)?;
            asm.b(0x0B)?;
            return;
        }
        if (op == "call") { return this->emit_call(ins); }
        if (op == "select") {
            this->load_op(RAX, ins.ty, ins.a, false)?;
            this->load_op(RCX, ins.ty, ins.b, false)?;
            this->load_op(RDX, this->t_i1, ins.c, false)?;
            asm.test(RDX, RDX)?;
            asm.cmov(CC_E, RAX, RCX)?;
            this->store_res(ins, RAX)?;
            return;
        }
        if (op == "fneg") {
            this->load_op(RAX, ins.ty, ins.a, false)?;
            if (ins.ty.k == .F64) { asm.mov_imm(RCX, 0 - 0x7fffffffffffffff - 1)?; } else { asm.mov_imm(RCX, 0x80000000)?; }
            asm.xor_(RAX, RCX)?;
            this->store_res(ins, RAX)?;
            return;
        }
        if (this->emit_cast(ins)?) { return; }
        this->emit_binop(ins)?;
    }

    !bool emit_cast(Ins* ins) {
        const auto asm = &this->obj.text;
        const auto op = ins.op;
        if (op == "trunc" || op == "zext" || op == "ptrtoint" || op == "inttoptr" || op == "bitcast") {
            const auto acc = this->dreg(ins);
            this->load_op(acc, ins.ty2, ins.a, false)?;
            if (ins.ty.k == .I && ins.ty.bits == 1) { asm.alu_imm(4, acc, 1)?; }
            this->store_res(ins, acc)?;
            return true;
        }
        if (op == "sext") {
            const auto acc = this->dreg(ins);
            this->load_op(acc, ins.ty2, ins.a, true)?;
            this->store_res(ins, acc)?;
            return true;
        }
        if (op == "sitofp" || op == "uitofp") {
            const auto dbl = ins.ty.k == .F64;
            this->load_op(RAX, ins.ty2, ins.a, op == "sitofp")?;
            if (op == "uitofp" && ins.ty2.bits == 64) {
                // values >= 2^63: halve (keeping the low bit), convert, double
                const auto lbig = this->local_label()?;
                const auto ldone = this->local_label()?;
                asm.test(RAX, RAX)?;
                asm.jcc(CC_S, lbig)?;
                asm.cvtsi2f(dbl, 0, RAX)?;
                asm.jmp(ldone)?;
                asm.bind(lbig)?;
                asm.mov_rr(RCX, RAX)?;
                asm.mov_imm(RDX, 1)?;
                asm.and_(RCX, RDX)?;
                asm.mov_imm(RDX, 1)?;
                asm.shift_cl_imm1(RAX)?;
                asm.or_(RAX, RCX)?;
                asm.cvtsi2f(dbl, 0, RAX)?;
                auto p = 0xF3;
                if (dbl) { p = 0xF2; }
                asm.sse(p, 0x0F58, 0, 0)?;
                asm.bind(ldone)?;
            } else {
                asm.cvtsi2f(dbl, 0, RAX)?;
            }
            asm.movq_r_x(RAX, 0, dbl)?;
            this->store_res(ins, RAX)?;
            return true;
        }
        if (op == "fptosi" || op == "fptoui") {
            const auto dbl = ins.ty2.k == .F64;
            this->load_op(RAX, ins.ty2, ins.a, false)?;
            asm.movq_x_r(0, RAX, dbl)?;
            asm.cvttf2si(dbl, RAX, 0)?;
            this->store_res(ins, RAX)?;
            return true;
        }
        if (op == "fpext" || op == "fptrunc") {
            const auto from_dbl = ins.ty2.k == .F64;
            this->load_op(RAX, ins.ty2, ins.a, false)?;
            asm.movq_x_r(0, RAX, from_dbl)?;
            if (op == "fpext") { asm.sse(0xF3, 0x0F5A, 0, 0)?; } else { asm.sse(0xF2, 0x0F5A, 0, 0)?; }
            asm.movq_r_x(RAX, 0, !from_dbl)?;
            this->store_res(ins, RAX)?;
            return true;
        }
        return false;
    }

    !str local_label() {
        this->nlocal += 1;
        auto b = List<u8>::init(this->a);
        sprint(&b, ".L{this->nlocal}")?;
        return b.slice();
    }

    !void emit_binop(Ins* ins) {
        const auto asm = &this->obj.text;
        const auto op = ins.op;
        const auto t = ins.ty;
        if (is_flt(t)) {
            const auto dbl = t.k == .F64;
            if (op == "frem") {
                asm.movq_x_r(0, this->src_reg(RAX, t, ins.a, false)?, dbl)?;
                asm.movq_x_r(1, this->src_reg(RAX, t, ins.b, false)?, dbl)?;
                if (dbl) { asm.call_sym("fmod")?; } else { asm.call_sym("fmodf")?; }
                asm.movq_r_x(RAX, 0, dbl)?;
                this->store_res(ins, RAX)?;
                return;
            }
            auto sop = 0;
            match op {
                "fadd" => sop = 0x0F58;
                "fmul" => sop = 0x0F59;
                "fsub" => sop = 0x0F5C;
                "fdiv" => sop = 0x0F5E;
            }
            if (sop == 0) { eprintln("native: unsupported float op '{op}'"); return error.CompileFailed; }
            asm.movq_x_r(0, this->src_reg(RAX, t, ins.a, false)?, dbl)?;
            asm.movq_x_r(1, this->src_reg(RAX, t, ins.b, false)?, dbl)?;
            auto p = 0xF3;
            if (dbl) { p = 0xF2; }
            asm.sse(p, sop, 0, 1)?;
            const auto acc = this->dreg(ins);
            asm.movq_r_x(acc, 0, dbl)?;
            this->store_res(ins, acc)?;
            return;
        }
        const auto signed = op == "sdiv" || op == "srem" || op == "ashr";
        const auto acc = this->dreg(ins);
        auto alu = -1;
        match op {
            "add" => alu = 0;
            "or" => alu = 1;
            "and" => alu = 4;
            "sub" => alu = 5;
            "xor" => alu = 6;
        }
        if (alu >= 0 || op == "mul") {
            this->load_op(acc, t, ins.a, false)?;
            if (this->is_imm(t, ins.b)) {
                if (op == "mul") { asm.imul_rri(acc, acc, parse_num(ins.b))?; } else { asm.alu_imm(alu, acc, parse_num(ins.b))?; }
            } else {
                const auto rb = this->src_reg(RCX, t, ins.b, false)?;
                match op {
                    "add" => asm.add(acc, rb)?;
                    "sub" => asm.sub(acc, rb)?;
                    "mul" => asm.imul(acc, rb)?;
                    "and" => asm.and_(acc, rb)?;
                    "or" => asm.or_(acc, rb)?;
                    _ => asm.xor_(acc, rb)?;
                }
            }
            this->store_res(ins, acc)?;
            return;
        }
        if ((op == "shl" || op == "lshr" || op == "ashr") && this->is_imm(t, ins.b)) {
            this->load_op(acc, t, ins.a, signed)?;
            auto n = 4;
            if (op == "lshr") { n = 5; }
            if (op == "ashr") { n = 7; }
            asm.shift_imm(n, acc, parse_num(ins.b) & 63)?;
            this->store_res(ins, acc)?;
            return;
        }
        this->load_op(RAX, t, ins.a, signed)?;
        const auto rb = this->src_reg(RCX, t, ins.b, signed)?;
        if (rb != RCX && (op == "shl" || op == "lshr" || op == "ashr")) { asm.mov_rr(RCX, rb)?; }
        match op {
            "shl" => asm.shift_cl(4, RAX)?;
            "lshr" => asm.shift_cl(5, RAX)?;
            "ashr" => asm.shift_cl(7, RAX)?;
            "sdiv", "srem" => {
                asm.cqo()?;
                asm.grp3(7, rb)?;
                if (op == "srem") { asm.mov_rr(RAX, RDX)?; }
            }
            "udiv", "urem" => {
                asm.xor_(RDX, RDX)?;
                asm.grp3(6, rb)?;
                if (op == "urem") { asm.mov_rr(RAX, RDX)?; }
            }
            _ => {
                eprintln("native: unsupported instruction '{op}'");
                return error.CompileFailed;
            }
        }
        this->store_res(ins, RAX)?;
    }

    // ------------------------------------------------------------------ calls
    !void emit_call(Ins* ins) {
        const auto asm = &this->obj.text;
        auto callee = ins.callee;
        auto nargs = ins.args.len;
        if (callee == "@llvm.memset.p0.i64") {
            callee = "@memset";
            nargs = 3;
        }
        const auto iregs = [RDI, RSI, RDX, RCX, R8, R9];
        const auto sret = is_agg(ins.ty);
        // classify
        auto kind = List<i64>::init(this->a);   // 0 = int reg, 1 = sse reg, 2 = stack
        auto regno = List<i64>::init(this->a);
        auto ni = 0;
        if (sret) { ni = 1; }
        auto nf = 0;
        auto nstack = 0;
        for (auto k : 0..nargs) {
            const auto at = ins.args.get(k).ty;
            if (is_flt(at) && nf < 8) {
                kind.push(1)?;
                regno.push(nf)?;
                nf += 1;
            } else if (!is_flt(at) && ni < 6) {
                kind.push(0)?;
                regno.push(iregs[ni])?;
                ni += 1;
            } else {
                kind.push(2)?;
                regno.push(nstack)?;
                nstack += 1;
            }
        }
        // aggregate constants need memory before we start filling registers
        auto locs = List<i64>::init(this->a);
        for (auto k : 0..nargs) {
            const auto ar = ins.args.get(k);
            if (is_agg(ar.ty)) { locs.push(this->agg_loc(ar.ty, ar.v)?)?; } else { locs.push(0)?; }
        }
        const auto stack_bytes = align_up(nstack * 8, 16);
        if (stack_bytes > 0) {
            asm.mov_imm(R10, stack_bytes)?;
            asm.sub(RSP, R10)?;
        }
        for (auto k : 0..nargs) {
            if (kind.get(k) != 2) { continue; }
            const auto ar = ins.args.get(k);
            if (is_agg(ar.ty)) { asm.lea(R10, RBP, locs.get(k))?; } else { this->load_op(R10, ar.ty, ar.v, ar.ty.k == .I)?; }
            asm.st(R10, RSP, 8 * regno.get(k), 8)?;
        }
        for (auto k : 0..nargs) {
            const auto ar = ins.args.get(k);
            if (kind.get(k) == 1) {
                this->load_op(R10, ar.ty, ar.v, false)?;
                asm.movq_x_r(regno.get(k), R10, ar.ty.k == .F64)?;
            } else if (kind.get(k) == 0) {
                if (is_agg(ar.ty)) {
                    asm.lea(regno.get(k), RBP, locs.get(k))?;
                } else {
                    // C ABI: small ints are extended by the callee's expectation; extend signed for safety
                    this->load_op(regno.get(k), ar.ty, ar.v, ar.ty.k == .I && ar.ty.bits > 1)?;
                }
            }
        }
        if (sret) { asm.lea(RDI, RBP, this->loc(ins.dest))?; }
        if (callee[0] == '%') {
            this->load_op(R11, this->t_ptr, callee, false)?;
            if (ins.variadic) { asm.mov_imm(RAX, nf)?; }
            asm.call_reg(R11)?;
        } else {
            if (ins.variadic) { asm.mov_imm(RAX, nf)?; }
            asm.call_sym(callee[1..])?;
        }
        if (stack_bytes > 0) {
            asm.mov_imm(R10, stack_bytes)?;
            asm.add(RSP, R10)?;
        }
        if (ins.dest.len > 0 && !sret) {
            if (is_flt(ins.ty)) {
                asm.movq_r_x(RAX, 0, ins.ty.k == .F64)?;
            }
            this->store_res(ins, RAX)?;
        }
    }
}

!Native* new_native(Allocator a) {
    const auto n = a.create<Native>()?;
    n.a = a;
    n.obj = new_obj(a);
    n.named = Map[*LT].init(a);
    n.t_i1 = n.int_t(1)?;
    n.t_i8 = n.int_t(8)?;
    n.t_i32 = n.int_t(32)?;
    n.t_i64 = n.int_t(64)?;
    n.byn = List<i64>::init(a);
    n.ivreg = List<i64>::init(a);
    n.t_ptr = n.basic(.P, 8)?;
    n.t_void = n.basic(.V, 0)?;
    n.t_f32 = n.basic(.F32, 4)?;
    n.t_f64 = n.basic(.F64, 8)?;
    return n;
};

i64 align_up(i64 x, i64 a) {
    if (a <= 1) { return x; }
    return (x + a - 1) / a * a;
}

i64 parse_num(str s) {
    if (s == "true") { return 1; }
    if (s == "false" || s == "null" || s == "zeroinitializer" || s == "undef" || s == "poison") { return 0; }
    if (s.len > 2 && s[0] == '0' && s[1] == 'x') { return (parse_int_radix(s[2..], 16) catch 0) as i64; }
    if (s.len > 0 && s[0] == '-') { return 0 - (parse_int_radix(s[1..], 10) catch 0) as i64; }
    return (parse_int_radix(s, 10) catch 0) as i64;
}

i64 f32_bits_of_hex(str s) {
    // LLVM writes float constants as the bits of the equivalent double
    const auto d = f64_from_bits(parse_num(s) as u64);
    f32 f = d as f32;
    return (*(&f as *u32)) as i64;
}

!void Asm::shift_cl_imm1(i64 r) {
    // shr r, 1
    this->rex(true, 0, r, false)?;
    this->b(0xD1)?;
    this->b(0xE8 | (r & 7))?;
}

/// compile a whole IR module to an ELF object file
!void native_compile(Allocator a, str ir, str out_path) {
    const auto n = new_native(a)?;
    n.compile_module(ir)?;
    n.obj.write(out_path)?;
}
