import "gen_move.zk";

struct CtVal { str name; Type* ty; str content; i64 mode; }

bool Gen::ct_plain(Type* t) {
    if (t.k == .Int || t.k == .Float || t.k == .Bool || t.k == .Enm) { return true; }
    if (t.k == .Array) { return this->ct_plain(t.elem); }
    if (t.k == .Strct) {
        for (auto f : t.si.fields) { if (!this->ct_plain(f.ty)) { return false; } }
        return true;
    }
    return false;
}

!Type* Gen::ct_type(Expr* e) {
    const auto saved_body = this->body.len;
    const auto saved_allocas = this->allocas.len;
    const auto saved_ntmp = this->ntmp;
    const auto saved_nlbl = this->nlbl;
    const auto saved_label = this->cur_label;
    const auto saved_term = this->terminated;
    const auto saved_moved = this->snap();
    const auto saved_scopes = this->scopes;
    const auto saved_env = this->env;
    const auto saved_loops = this->loops;
    const auto saved_colds = this->colds_copy()?;
    auto saved_slots = 0;
    if (this->af != null) { saved_slots = this->af.slots.len; }
    defer {
        if (this->af != null) {
            this->af.slots.len = saved_slots;
            this->af.frame.si.fields.len = saved_slots;
        }
        this->body.len = saved_body;
        this->allocas.len = saved_allocas;
        this->ntmp = saved_ntmp;
        this->nlbl = saved_nlbl;
        this->cur_label = saved_label;
        this->terminated = saved_term;
        this->restore_state(saved_moved);
        this->scopes = saved_scopes;
        this->env = saved_env;
        this->loops = saved_loops;
        this->colds = saved_colds;
    }
    this->scopes = List<Scope>::init(this->a);
    this->fact_gen += 1;
    this->facts = Map<Fact>::init(this->a);
    this->escaped = Map<bool>::init(this->a);
    this->blk_parents = List<i64>::init(this->a);
    this->blk = 0;
    this->loops = List<Loop>::init(this->a);
    this->push_scope()?;
    this->env = this->new_env()?;
    const auto v = this->gen_expr(e.l, null)?;
    return v.ty;
}

extern i32 unlink(u8* path);
extern i32 getpid();

void ct_remove(str path) {
    u8[4096] pb;
    const auto p = to_cstr(pb[..], path) catch { return; };
    _ = unlink(p);
}

bool Gen::ct_in_chain(str key) {
    auto start = 0;
    const auto ch = this->ct_chain;
    for (auto i : 0..ch.len + 1) {
        if (i == ch.len || ch[i] == '|') {
            if (ch[start..i] == key) { return true; }
            start = i + 1;
        }
    }
    return false;
}

!str Gen::ct_child_chain() {
    auto b = this->sb();
    b.append(this->ct_chain)?;
    if (this->ct_key.len > 0) {
        if (b.len > 0) { b.append("|")?; }
        b.append(this->ct_key)?;
    }
    return b.slice();
}

!CtVal* Gen::ct_eval(Expr* e) {
    const auto key = e.name;
    if (this->ct_cache.has(key)) { return this->ct_cache.get(key)?; }
    if (key.len == 0 || key == this->ct_key || this->ct_in_chain(key)) {
        this->err(e.line);
        eprintln("this comptime expression needs its own value, directly or through another comptime expression, so it cannot be evaluated");
        return error.CompileFailed;
    }
    if (this->ct_chain.len > 0 && str_count(this->ct_chain, "|") >= 16) {
        this->err(e.line);
        eprintln("comptime expressions are nested more than 16 levels deep");
        return error.CompileFailed;
    }
    const auto ty = this->ct_type(e)?;
    auto mode = 0;
    auto mode_name = "plain";
    if (ty.k == .Void) {
        mode = 1;
        mode_name = "void";
    } else if (is_str(ty)) {
        mode = 2;
        mode_name = "str";
    } else if (!this->ct_plain(ty)) {
        this->err(e.line);
        eprintln("a comptime value must be a number, bool, enum, str, or an array or struct of those; '{this->type_name(ty)?}' is not");
        return error.CompileFailed;
    }
    this->nct += 1;
    auto cv = this->a.create<CtVal>()?;
    cv.ty = ty;
    cv.mode = mode;
    if (this->self_path.len == 0) {
        if (mode == 0) {
            const auto zsz = this->size_of(ty)?;
            auto zb = this->sb();
            for (auto _k : 0..(zsz as i64)) { zb.push(0)?; }
            cv.content = zb.slice();
        }
    } else {
        _ = mkdir(".zark-cache", 493);
        auto ob = this->sb();
        sprint(&ob, ".zark-cache/ct{getpid()}-{this->nct}.out")?;
        auto xb = this->sb();
        sprint(&xb, ".zark-cache/ct{getpid()}-{this->nct}.exe")?;
        ct_remove(ob.slice());
        auto args = List<str>::init(this->a);
        args.append([this->self_path, "run", this->test_root])?;
        args.append(this->ct_extras.slice())?;
        auto cfg = this->sb();
        sprint(&cfg, "{cfg_encode()}")?;
        args.append(["--ct-cfg", cfg.slice()])?;
        args.append(["-o", xb.slice(), "--ct-key", key, "--ct-mode", mode_name, "--ct-out", ob.slice(), "--ct-chain", this->ct_child_chain()?])?;
        const auto code = run(this->a, args.slice())?;
        ct_remove(xb.slice());
        if (code != 0) {
            ct_remove(ob.slice());
            this->err(e.line);
            eprintln("the comptime expression failed (exit code {code}); it runs at compile time and may use functions and constants, but not variables");
            return error.CompileFailed;
        }
        if (mode != 1) {
            cv.content = read_file(this->a, ob.slice()) catch {
                this->err(e.line);
                eprintln("the comptime expression produced no result");
                return error.CompileFailed;
            };
            ct_remove(ob.slice());
        }
    }
    if (mode == 0) {
        const auto sz = this->size_of(ty)?;
        if (cv.content.len as u64 != sz) {
            this->err(e.line);
            eprintln("the comptime result has {cv.content.len} bytes, expected {sz}");
            return error.CompileFailed;
        }
        const auto al = max(this->align_of(ty)?, 8 as u64);
        auto nb = this->sb();
        sprint(&nb, "@ct.{this->nct}")?;
        cv.name = nb.slice();
        sprint(&this->globals_out, "{cv.name} = private unnamed_addr constant [{cv.content.len} x i8] c\"")?;
        const auto w = &this->globals_out;
        for (auto c : cv.content) { sprint(w, "\\{c:02X}")?; }
        sprint(w, "\", align {al}\n")?;
    }
    this->ct_cache.put(key, cv)?;
    return cv;
}

!void Gen::ct_check(Expr* c) {
    const auto cv = this->ct_eval(c)?;
    if (cv.mode != 1) {
        this->err(c.line);
        eprintln("a top-level comptime must be a statement that returns nothing, like `comptime assert(...);`; this one produces a value (did you forget `assert`?)");
        return error.CompileFailed;
    }
}

!Value Gen::gen_comptime(Expr* e, Type* expected) {
    const auto cv = this->ct_eval(e)?;
    if (cv.mode == 1) { return Value{ .ty = this->t_void, .v = "" }; }
    if (cv.mode == 2) {
        const auto s = this->a.create<Expr>()?;
        s.k = .StrLit;
        s.name = cv.content;
        s.line = e.line;
        s.off = e.off;
        return this->gen_expr(s, expected);
    }
    return this->load(cv.ty, cv.name);
}

!Addr Gen::ct_addr(Expr* e) {
    const auto cv = this->ct_eval(e)?;
    if (cv.mode != 0) { return this->spill(this->gen_comptime(e, null)?); }
    return Addr{ .ty = cv.ty, .v = cv.name, .imm = true };
}

!void Gen::install_ct_main() {
    if (!this->cts.has(this->ct_key)) {
        eprintln("error: comptime expression {this->ct_key} not found (comptime inside string interpolation is not supported)");
        return error.CompileFailed;
    }
    const auto ce = this->cts.get(this->ct_key)?;
    const auto st = this->a.create<Stmt>()?;
    st.k = .ExprS;
    st.line = ce.line;
    st.off = ce.off;
    if (this->ct_mode == "void") {
        st.e = ce.l;
    } else {
        const auto call = this->a.create<Expr>()?;
        call.k = .Call;
        call.line = ce.line;
        call.off = ce.off;
        const auto callee = this->a.create<Expr>()?;
        callee.k = .Ident;
        callee.line = ce.line;
        callee.off = ce.off;
        callee.name = "__ct_emit";
        if (this->ct_mode == "str") { callee.name = "__ct_emit_str"; }
        const auto path = this->a.create<Expr>()?;
        path.k = .StrLit;
        path.line = ce.line;
        path.off = ce.off;
        path.name = this->ct_out;
        call.l = callee;
        call.args = List<Expr*>::init(this->a);
        call.args.push(path)?;
        call.args.push(ce.l)?;
        st.e = call;
    }
    const auto body = this->a.create<Stmt>()?;
    body.k = .Block;
    body.line = ce.line;
    body.off = ce.off;
    body.stmts = List<Stmt*>::init(this->a);
    body.stmts.push(st)?;
    const auto f = this->a.create<FnDecl>()?;
    *f = FnDecl{
        .name = "main", .type_params = List<str>::init(this->a), .constraints = List<str>::init(this->a), .params = List<Param>::init(this->a),
        .ret = null, .body = body, .line = ce.line, .file = this->test_root, .receiver_params = List<str>::init(this->a)
    };
    this->fns.put("main", f)?;
}
