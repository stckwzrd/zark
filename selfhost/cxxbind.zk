import "cbind.zk";
import "json.zk";
import "cbuild.zk";
import "std/fs" as fs;
import "std/os" as os;
import "std/path" as path;

const auto CX_TODO = "C++ declaration not bound yet";

bool cx_todo(str why) {
    return why == CX_TODO || str_starts_with(why, "unknown type ") || str_starts_with(why, "uses unbound type ");
}

bool cx_is_header(str p) {
    return str_ends_with(p, ".hpp") || str_ends_with(p, ".hh") || str_ends_with(p, ".hxx") || str_ends_with(p, ".h++");
}

bool cx_c_std(str f) {
    return str_starts_with(f, "-std=") && !str_starts_with(f, "-std=c++") && !str_starts_with(f, "-std=gnu++");
}

!str cx_qual(Allocator a, str scope, str name) {
    if (scope.len == 0) { return name; }
    return str_concat(a, [scope, "::", name]);
}

!str cx_zname(Allocator a, str scope, str name) {
    if (scope.len == 0) { return name; }
    return str_concat(a, [scope, "_", name]);
}

str cx_up(str s) {
    const auto k = str_rfind(s, "::");
    if (k < 0) { return ""; }
    return s[0..k];
}

str cx_why(CType* t) {
    if (t.k == .Bad) { return t.name; }
    if (t.k == .Ptr || t.k == .Array || t.k == .Func) {
        const auto w = cx_why(t.elem);
        if (w.len > 0) { return w; }
    }
    if (t.k == .Func) {
        for (auto p : t.params.slice()) {
            const auto w = cx_why(p.ty);
            if (w.len > 0) { return w; }
        }
    }
    return "";
}

bool cx_bad(CType* t) { return cx_why(t).len > 0; }

bool cx_named(CType* t) {
    if (t.k == .Named) { return true; }
    if (t.k == .Ptr || t.k == .Array || t.k == .Func) {
        if (cx_named(t.elem)) { return true; }
    }
    if (t.k == .Func) {
        for (auto p : t.params.slice()) { if (cx_named(p.ty)) { return true; } }
    }
    return false;
}

!str cx_fnum(Allocator a, f64 v) {
    u8[40] buf;
    auto s = "";
    for (auto p : 1..18) {
        const auto n = snprintf(buf.ptr, 40, "%.*g", p as i32, v);
        s = buf[0..n as i64];
        if (parse_float(s)? == v) { break; }
    }
    if (str_find(s, ".") >= 0) { return str_concat(a, [s]); }
    auto e = str_find(s, "e");
    if (e < 0) { e = s.len; }
    return str_concat(a, [s[0..e], ".0", s[e..]]);
}

bool cx_cshape(CxWalk* w, CType* t) {
    if ((t.elem.k == .Ptr && t.elem.ref) || w.expand(t.elem).rec != null) { return false; }
    for (auto p : t.params.slice()) { if ((p.ty.k == .Ptr && p.ty.ref) || w.expand(p.ty).rec != null) { return false; } }
    return true;
}

str cx_lkey(str s) {
    auto t = s;
    if (str_ends_with(t, " (empty)")) { t = t[0..t.len - 8]; }
    for (auto k : ["struct ", "class ", "union "]) { if (str_starts_with(t, k)) { return t[k.len..]; } }
    return t;
}

struct CxFld { str name; Json* x; bool pub; bool bits; CType* ty; CxRec* sub; str init; str why; }

struct CxItem { str name; CType* ty; i64 off; i64 size; i64 align; str init; str label; bool base; }

struct CxBit { str name; CType* ty; str label; CDecl* get; CDecl* set; }

struct CxNote { str label; str why; }

struct CxEnt { i64 depth; i64 off; str text; }

struct CxLay { i64 size; i64 align; List<CxEnt> ents; }

struct CxRec {
    CDecl* d;
    str qn;
    str key;
    bool done;
    bool value;
    bool is_union;
    bool anon;
    bool flat;
    List<CxFld> flds;
    List<CxRec*> subs;
    List<str> pubs;
    List<CxItem> items;
    List<CxBit> bits;
    List<CxNote> notes;
    i64 size;
    i64 align;
    str why;
    str skip;
}

Json* cx_find(Json* n, str kind) {
    if (jstr(jget(n, "kind"), "") == kind) { return n; }
    const auto k = jget(n, "inner");
    for (auto i : 0..jlen(k)) {
        const auto r = cx_find(jat(k, i), kind);
        if (r != null) { return r; }
    }
    return null;
}

!CVal cx_int(str s) {
    if (s == "true" || s == "false") { return cb_bool(s == "true"); }
    if (str_starts_with(s, "-")) {
        const auto v = 0 -% (parse_int_radix(s[1..], 10)? as i64);
        return CVal{ .v = v, .w = !cb_fits(CVal{ .v = v }, 32, true) };
    }
    const auto u = parse_int_radix(s, 10)?;
    if (u > 0x7fffffffffffffff) { return CVal{ .v = u as i64, .u = true, .w = true }; }
    return CVal{ .v = u as i64, .w = u > 0x7fffffff };
}

!List<str> cx_toks(Allocator a, str s) {
    auto out = List<str>::init(a);
    auto i = 0;
    while (i < s.len) {
        const auto c = s[i];
        if (c == ' ') {
            i += 1;
            continue;
        }
        auto j = i + 1;
        if (cb_ident_char(c) || c == ':') {
            while (j < s.len && (cb_ident_char(s[j]) || s[j] == ':')) { j += 1; }
        } else if (str_starts_with(s[i..], "&&")) {
            j = i + 2;
        } else if (str_starts_with(s[i..], "...")) {
            j = i + 3;
        }
        out.push(s[i..j])?;
        i = j;
    }
    return out;
}

struct CxType {
    CxWalk* w;
    List<str> toks;
    i64 i;
    str scope;

    str peek() {
        if (this->i < this->toks.len) { return this->toks.get(this->i); }
        return "";
    }
    bool eat(str s) {
        if (this->peek() != s) { return false; }
        this->i += 1;
        return true;
    }
    !CType* mk(CK k) {
        const auto t = this->w.a.create<CType>()?;
        t.k = k;
        return t;
    }
    !CType* bad() {
        const auto t = this->mk(.Bad)?;
        t.name = CX_TODO;
        return t;
    }
    !CType* ptr(CType* e) {
        const auto t = this->mk(.Ptr)?;
        t.elem = e;
        return t;
    }

    !CType* full() {
        const auto t = this->ty()?;
        if (this->i != this->toks.len) { return this->bad(); }
        return t;
    }

    !CType* ty() {
        const auto b = this->base()?;
        return this->decl(b);
    }

    !CType* leaf(CK k, str cxx) {
        const auto t = this->mk(k)?;
        t.cxx = cxx;
        return t;
    }

    !CType* base() {
        auto nlong = 0;
        auto nshort = 0;
        auto nsigned = 0;
        auto nunsigned = 0;
        auto base = "";
        auto konst = false;
        auto vol = false;
        CType* named = null;
        while (true) {
            const auto t = this->peek();
            if (t == "const") {
                konst = true;
            } else if (t == "volatile") {
                vol = true;
            } else if (t == "struct" || t == "class" || t == "union" || t == "enum" || t == "typename") {
            } else if (t == "long") {
                nlong += 1;
            } else if (t == "short") {
                nshort += 1;
            } else if (t == "signed") {
                nsigned += 1;
            } else if (t == "unsigned") {
                nunsigned += 1;
            } else if (t == "void" || t == "char" || t == "int" || t == "float" || t == "double" || t == "bool") {
                base = t;
            } else if (t == "wchar_t" || t == "char8_t" || t == "char16_t" || t == "char32_t" || t == "__int128" || t == "__int128_t" || t == "__uint128_t" || t == "nullptr_t" || t == "std::nullptr_t") {
                named = this->w.badt(str_concat(this->w.a, ["type '", t, "' is not supported yet"])?)?;
            } else if (t == "decltype") {
                named = this->w.badt("decltype types are not supported yet")?;
                auto depth = 0;
                while (this->i + 1 < this->toks.len) {
                    this->i += 1;
                    const auto x = this->peek();
                    if (x == "(") { depth += 1; }
                    if (x == ")") {
                        depth -= 1;
                        if (depth == 0) { break; }
                    }
                }
            } else if (t.len > 0 && (cb_ident_char(t[0]) || t[0] == ':') && named == null && base.len == 0 && nlong + nshort + nsigned + nunsigned == 0) {
                if (t == "auto") {
                    named = this->mk(.Bad)?;
                    named.name = "deduced return type";
                } else {
                    named = this->w.lookup(t, this->scope)?;
                }
            } else {
                break;
            }
            this->i += 1;
        }
        if (this->eat("<")) {
            auto depth = 1;
            auto par = 0;
            while (depth > 0 && this->i < this->toks.len) {
                const auto t = this->peek();
                this->i += 1;
                if (t == "(") {
                    par += 1;
                } else if (t == ")") {
                    par -= 1;
                } else if (par == 0 && t == "<") {
                    depth += 1;
                } else if (par == 0 && t == ">") {
                    depth -= 1;
                }
            }
            if (str_starts_with(this->peek(), "::")) { this->i += 1; }
            return this->bad();
        }
        auto r = named;
        if (r == null) { r = this->builtin(base, nlong, nshort, nsigned, nunsigned)?; }
        r.konst = konst;
        r.vol = vol;
        return r;
    }

    !CType* builtin(str base, i64 nlong, i64 nshort, i64 nsigned, i64 nunsigned) {
        if (base == "void") { return this->leaf(.Void, base); }
        if (base == "bool") { return this->leaf(.Bool, base); }
        if (base == "float" || base == "double") {
            if (nlong > 0) { return this->w.badt("type 'long double' is not supported yet"); }
            const auto t = this->leaf(.Float, base)?;
            t.width = 32;
            if (base == "double") { t.width = 64; }
            return t;
        }
        if (base.len == 0 && nlong + nshort + nsigned + nunsigned == 0) { return this->bad(); }
        auto sb = List<u8>::init(this->w.a);
        if (nunsigned > 0) { sprint(&sb, "unsigned ")?; }
        if (nsigned > 0 && base == "char") { sprint(&sb, "signed ")?; }
        if (nshort > 0) { sprint(&sb, "short ")?; }
        for (auto j : 0..nlong) { sprint(&sb, "long ")?; }
        if (base == "char") {
            sprint(&sb, "char ")?;
        } else if (nshort + nlong == 0) {
            sprint(&sb, "int ")?;
        }
        const auto t = this->leaf(.Int, sb.slice()[0..sb.len - 1])?;
        t.signed = nunsigned == 0;
        t.width = 32;
        if (base == "char") {
            t.width = 8;
            t.signed = nsigned > 0 || (nunsigned == 0 && !this->w.uchar);
            t.plain = nsigned + nunsigned == 0;
        } else if (nshort > 0) {
            t.width = 16;
        } else if (nlong > 0) {
            t.width = 64;
        }
        return t;
    }

    !CType* decl(CType* b) {
        auto t = b;
        while (true) {
            const auto p = this->peek();
            if (p == "*") {
                t = this->ptr(t)?;
            } else if (p == "&" || p == "&&") {
                t = this->ptr(t)?;
                t.ref = true;
                t.rvalue = p == "&&";
            } else if (p == "const") {
                t.konst = true;
            } else if (p == "volatile") {
                t.vol = true;
            } else if (p != "__restrict" && p != "restrict") {
                break;
            }
            this->i += 1;
        }
        if (this->peek() == "(" && this->i + 1 < this->toks.len) {
            const auto n = this->toks.get(this->i + 1);
            if (n == "*" || n == "&" || n == "&&") {
                const auto open = this->i;
                auto depth = 0;
                while (this->i < this->toks.len) {
                    const auto x = this->peek();
                    this->i += 1;
                    if (x == "(") { depth += 1; }
                    if (x == ")") {
                        depth -= 1;
                        if (depth == 0) { break; }
                    }
                }
                if (depth != 0) { return this->bad(); }
                const auto outer = this->suffix(t)?;
                const auto end = this->i;
                this->i = open + 1;
                const auto r = this->decl(outer)?;
                if (!this->eat(")")) { return this->bad(); }
                this->i = end;
                return r;
            }
        }
        return this->suffix(t);
    }

    !CType* suffix(CType* t) {
        if (this->eat("(")) {
            const auto f = this->mk(.Func)?;
            f.elem = t;
            f.params = List<CField>::init(this->w.a);
            if (!this->eat(")")) {
                while (true) {
                    if (this->eat("...")) {
                        f.varargs = true;
                    } else {
                        f.params.push(CField{ .ty = this->ty()? })?;
                    }
                    if (this->eat(")")) { break; }
                    if (!this->eat(",")) { return this->bad(); }
                }
            }
            while (true) {
                if (this->eat("const")) {
                    f.konst = true;
                } else if (this->eat("volatile")) {
                    f.vol = true;
                } else if (this->eat("&")) {
                    f.ref = true;
                } else if (this->eat("&&")) {
                    f.ref = true;
                    f.rvalue = true;
                } else if (this->eat("noexcept")) {
                    f.noexc = true;
                    if (this->eat("(")) {
                        f.noexc = this->eat("true");
                        if (!f.noexc && !this->eat("false")) { return this->bad(); }
                        if (!this->eat(")")) { return this->bad(); }
                    }
                } else if (this->eat("throw")) {
                    if (!this->eat("(") || !this->eat(")")) { return this->bad(); }
                    f.noexc = true;
                } else {
                    break;
                }
            }
            if (this->peek() == "-" && this->i + 1 < this->toks.len && this->toks.get(this->i + 1) == ">") {
                this->i += 2;
                f.elem = this->ty()?;
            }
            return f;
        }
        auto dims = List<i64>::init(this->w.a);
        while (this->eat("[")) {
            auto n = -1;
            if (!this->eat("]")) {
                n = (parse_int_radix(this->peek(), 10) catch { return this->bad(); }) as i64;
                this->i += 1;
                if (!this->eat("]")) { return this->bad(); }
            }
            dims.push(n)?;
        }
        auto r = t;
        auto k = dims.len - 1;
        while (k >= 0) {
            const auto x = this->mk(.Array)?;
            x.elem = r;
            x.n = dims.get(k);
            r = x;
            k -= 1;
        }
        return r;
    }
}

struct CxWalk {
    Allocator a;
    str cur;
    str stub;
    List<str> sys;
    List<CDecl*> decls;
    Map<CType*> typedefs;
    Map<str> names;
    Map<CType*> anon;
    Map<CVal> vals;
    Map<f64> fvals;
    Map<List<str>> bases;
    Map<bool> declared;
    Map<str> tid;
    Map<str> byid;
    Map<str> zq;
    Map<CDecl*> zd;
    Map<bool> bad;
    Map<CxRec*> recs;
    Map<CxRec*> zrec;
    Map<CxRec*> anonr;
    List<CxRec*> rlist;
    Map<CxLay*> lays;
    bool uchar;
    bool short_enums;

    void at(Json* l) {
        const auto f = jstr(jget(l, "file"), "");
        if (f.len > 0) { this->cur = f; }
    }

    void loc(Json* l) {
        const auto s = jget(l, "spellingLoc");
        const auto e = jget(l, "expansionLoc");
        if (s == null && e == null) {
            this->at(l);
            return;
        }
        this->at(s);
        this->at(e);
    }

    str locs(Json* n) {
        this->loc(jget(n, "loc"));
        const auto f = this->cur;
        const auto r = jget(n, "range");
        this->loc(jget(r, "begin"));
        this->loc(jget(r, "end"));
        return f;
    }

    void scan(Json* n) {
        _ = this->locs(n);
        this->kids(n);
    }

    void kids(Json* n) {
        const auto k = jget(n, "inner");
        for (auto i : 0..jlen(k)) { this->scan(jat(k, i)); }
    }

    bool rel(str f) {
        if (f.len == 0 || f == this->stub) { return false; }
        for (auto d : this->sys.slice()) {
            if (f.len > d.len && str_starts_with(f, d) && f[d.len] == '/') { return false; }
        }
        return true;
    }

    !CDecl* decl(CDK k, str name) {
        const auto d = this->a.create<CDecl>()?;
        d.k = k;
        d.name = name;
        d.rel = true;
        d.seq = this->decls.len;
        d.fields = List<CField>::init(this->a);
        d.subs = List<CDecl*>::init(this->a);
        this->decls.push(d)?;
        return d;
    }

    !void skip(str name, str why) {
        const auto d = this->decl(.Skip, name)?;
        d.reason = why;
    }

    !CType* named(str name) {
        const auto t = this->a.create<CType>()?;
        t.k = .Named;
        t.name = name;
        return t;
    }

    !CType* badt(str why) {
        const auto t = this->a.create<CType>()?;
        t.k = .Bad;
        t.name = why;
        return t;
    }

    !CType* lookup(str name, str scope) {
        auto n = name;
        auto s = scope;
        if (str_starts_with(n, "::")) {
            n = n[2..];
            s = "";
        }
        while (true) {
            const auto q = this->find(s, n)?;
            if (q.len > 0) {
                const auto z = this->names.get_or(q, "");
                if (z.len == 0) { return this->badt(str_concat(this->a, ["uses unbound type '", q, "'"])?); }
                if (this->bad.has(z)) { return this->badt(str_concat(this->a, ["uses skipped ", q])?); }
                const auto t = this->named(z)?;
                t.cxx = q;
                const auto r = this->zrec.get_or(z, null);
                if (r != null && r.d != null && r.d.name == z) {
                    t.rec = r.d;
                    t.tag = 1;
                    t.cxx = r.qn;
                }
                return t;
            }
            if (s.len == 0) { break; }
            s = cx_up(s);
        }
        if (str_starts_with(n, "std::")) { n = n[5..]; }
        if (cb_known(n).len > 0) {
            const auto t = this->named(n)?;
            t.cxx = name;
            return t;
        }
        return this->badt(str_concat(this->a, ["unknown type '", name, "'"])?);
    }

    !str find(str s, str n) {
        const auto q = cx_qual(this->a, s, n)?;
        if (this->names.has(q) || this->declared.has(q)) { return q; }
        const auto k = str_find(n, "::");
        if (k > 0) {
            const auto c = cx_qual(this->a, s, n[0..k])?;
            if (this->declared.has(c) || this->bases.has(c)) {
                const auto r = this->find(c, n[k + 2..])?;
                if (r.len > 0) { return r; }
                return q;
            }
        }
        for (auto b : this->bases.get_or(s, List<str>{}).slice()) {
            if (b == "?") { return q; }
            const auto r = this->find(b, n)?;
            if (r.len > 0) { return r; }
        }
        return "";
    }

    !void declare(Json* x, str kind, str scope) {
        auto name = jstr(jget(x, "name"), "");
        if (kind == "UsingShadowDecl") { name = jstr(jget(jget(x, "target"), "name"), ""); }
        if (name.len == 0 || name == "std" || jget(x, "parentDeclContextId") != null) { return; }
        if (kind == "CXXRecordDecl" && jbool(jget(x, "isImplicit"), false)) { return; }
        for (auto q : ["CXXRecordDecl", "EnumDecl", "TypedefDecl", "TypeAliasDecl", "ClassTemplateDecl", "TypeAliasTemplateDecl", "NamespaceDecl", "NamespaceAliasDecl", "UsingShadowDecl"]) {
            if (kind == q) { return this->declared.put(cx_qual(this->a, scope, name)?, true); }
        }
    }

    !bool claim(str zn, str qn) {
        const auto o = this->zq.get_or(zn, "");
        if (o.len == 0) { this->zq.put(zn, qn)?; }
        if (o.len == 0 || o == qn) { return true; }
        if (!this->bad.has(zn)) {
            this->bad.put(zn, true)?;
            const auto d = this->zd.get_or(zn, null);
            if (d != null) { d.rel = false; }
            this->skip(o, "name clash")?;
        }
        this->names.put(qn, zn)?;
        this->skip(qn, "name clash")?;
        return false;
    }

    !void record_bases(Json* x, str scope, str qn) {
        auto l = List<str>::init(this->a);
        const auto bs = jget(x, "bases");
        for (auto i : 0..jlen(bs)) {
            const auto b = jat(bs, i);
            auto n = jstr(jget(jget(b, "type"), "qualType"), "");
            auto s = scope;
            if (str_starts_with(n, "::")) {
                n = n[2..];
                s = "";
            }
            while (true) {
                const auto q = cx_qual(this->a, s, n)?;
                if (this->bases.has(q)) {
                    l.push(q)?;
                    break;
                }
                if (s.len == 0) {
                    l.push("?")?;
                    break;
                }
                s = cx_up(s);
            }
        }
        if (l.len > 0 || !this->bases.has(qn)) { this->bases.put(qn, l)?; }
    }

    !CType* parse(str s, str scope) {
        auto p = CxType{ .w = this, .toks = cx_toks(this->a, s)?, .scope = scope };
        return p.full();
    }

    !CType* type_of(Json* ty, str scope) {
        const auto q = jstr(jget(ty, "qualType"), "");
        const auto t = this->parse(q, scope)?;
        const auto d = jstr(jget(ty, "desugaredQualType"), "");
        const auto why = cx_why(t);
        const auto id = jstr(jget(ty, "typeAliasDeclId"), "");
        if (why.len > 0) {
            if (d.len == 0 || !cx_todo(why)) { return t; }
            const auto at = this->byid.get_or(id, "");
            if (t.k == .Bad && at.len > 0) {
                const auto r = this->lookup(str_concat(this->a, ["::", at])?, "")?;
                r.konst = str_starts_with(q, "const ");
                return r;
            }
            const auto dt = this->parse(d, scope)?;
            if (cx_named(dt) || cx_bad(dt)) { return t; }
            return dt;
        }
        auto ok = id.len == 0 || (t.k == .Named && (this->tid.get_or(t.cxx, "") == id || cb_known(t.name).len > 0));
        if (ok && d.len > 0) {
            const auto dt = this->parse(d, scope)?;
            ok = cx_bad(dt) || cx_named(dt) || this->same(t, dt)?;
        }
        if (!ok) { return this->badt(str_concat(this->a, ["cannot resolve type '", q, "'"])?); }
        return t;
    }

    !CType* scalar(CType* t) {
        const auto x = this->expand(t);
        const auto k = cb_known(x.name);
        if (x.k != .Named || k.len == 0) { return x; }
        const auto r = this->a.create<CType>()?;
        r.k = .Int;
        r.signed = k[0] == 'i';
        r.width = 64;
        if (k != "usize") { r.width = parse_int_radix(k[1..], 10)? as i64; }
        return r;
    }

    !bool same(CType* x0, CType* y0) {
        const auto x = this->scalar(x0)?;
        const auto y = this->scalar(y0)?;
        if (x.k != y.k) { return false; }
        if (x.k == .Int) { return x.width == y.width && x.signed == y.signed; }
        if (x.k == .Float) { return x.width == y.width; }
        if (x.k == .Named) { return x.name == y.name; }
        if (x.k == .Ptr) { return x.ref == y.ref && x.rvalue == y.rvalue && this->same(x.elem, y.elem)?; }
        if (x.k == .Array) { return x.n == y.n && this->same(x.elem, y.elem)?; }
        if (x.k == .Func) {
            if (x.params.len != y.params.len || x.varargs != y.varargs || !this->same(x.elem, y.elem)?) { return false; }
            for (auto [i, p] : x.params.slice()) { if (!this->same(p.ty, y.params.get(i).ty)?) { return false; } }
        }
        return true;
    }

    !CType* btype(Json* ty, str scope) {
        auto s = jstr(jget(ty, "desugaredQualType"), "");
        if (s.len == 0) { s = jstr(jget(ty, "qualType"), ""); }
        return this->expand(this->parse(s, scope)?);
    }

    CType* expand(CType* t) {
        auto x = t;
        while (x.k == .Named) {
            const auto n = this->typedefs.get_or(x.name, null);
            if (n == null) { return x; }
            x = n;
        }
        return x;
    }

    !CVal eval(Json* n, str sc) {
        const auto k = jstr(jget(n, "kind"), "");
        const auto kids = jget(n, "inner");
        auto v = CVal{ .v = 0 };
        if (k == "ConstantExpr" && jget(n, "value") != null) {
            v = cx_int(jstr(jget(n, "value"), ""))?;
        } else if (k == "IntegerLiteral") {
            v = cx_int(jstr(jget(n, "value"), ""))?;
        } else if (k == "CharacterLiteral") {
            v = CVal{ .v = jint(jget(n, "value"), 0) };
        } else if (k == "CXXBoolLiteralExpr") {
            v = cb_bool(jbool(jget(n, "value"), false));
        } else if (k == "ParenExpr" || k == "ConstantExpr" || k == "ImplicitCastExpr" || k == "CStyleCastExpr" || k == "CXXStaticCastExpr" || k == "CXXFunctionalCastExpr" || (k == "InitListExpr" && jlen(kids) == 1)) {
            v = this->eval(jat(kids, 0), sc)?;
        } else if (k == "UnaryOperator") {
            const auto x = this->eval(jat(kids, 0), sc)?;
            const auto op = jstr(jget(n, "opcode"), "");
            if (op == "-") {
                v = cb_neg(x)?;
            } else if (op == "+") {
                v = x;
            } else if (op == "~") {
                v = cb_norm(~x.v, x.u, x.w);
            } else if (op == "!") {
                v = cb_bool(x.v == 0);
            } else {
                return error.ParseFailed;
            }
        } else if (k == "BinaryOperator") {
            v = cb_bin(jstr(jget(n, "opcode"), ""), this->eval(jat(kids, 0), sc)?, this->eval(jat(kids, 1), sc)?)?;
        } else if (k == "ConditionalOperator") {
            if (this->eval(jat(kids, 0), sc)?.v != 0) { v = this->eval(jat(kids, 1), sc)?; } else { v = this->eval(jat(kids, 2), sc)?; }
        } else if (k == "DeclRefExpr") {
            const auto id = jstr(jget(jget(n, "referencedDecl"), "id"), "");
            if (!this->vals.has(id)) { return error.ParseFailed; }
            v = this->vals.get(id)?;
        } else {
            return error.ParseFailed;
        }
        const auto t = this->btype(jget(n, "type"), sc)?;
        if (t.k == .Int) { return cb_cast(v, t.width, t.signed); }
        if (t.k == .Bool) { return cb_bool(v.v != 0); }
        if (k == "ConstantExpr" && jget(n, "value") != null) { return v; }
        return error.ParseFailed;
    }

    !f64 evalf(Json* n, str sc) {
        const auto k = jstr(jget(n, "kind"), "");
        const auto kids = jget(n, "inner");
        const auto t = this->btype(jget(n, "type"), sc)?;
        if (t.k != .Float) { return error.ParseFailed; }
        auto v = 0.0;
        if (k == "FloatingLiteral") {
            v = parse_float(jstr(jget(n, "value"), ""))?;
        } else if (jstr(jget(n, "castKind"), "") == "IntegralToFloating") {
            const auto x = this->eval(jat(kids, 0), sc)?;
            if (t.width == 32 && x.u) {
                v = ((x.v as u64) as f32) as f64;
            } else if (t.width == 32) {
                v = (x.v as f32) as f64;
            } else if (x.u) {
                v = (x.v as u64) as f64;
            } else {
                v = x.v as f64;
            }
        } else if (k == "ParenExpr" || k == "ConstantExpr" || k == "ImplicitCastExpr" || k == "CStyleCastExpr" || k == "CXXStaticCastExpr" || k == "CXXFunctionalCastExpr" || (k == "InitListExpr" && jlen(kids) == 1)) {
            v = this->evalf(jat(kids, 0), sc)?;
        } else if (k == "UnaryOperator" && jstr(jget(n, "opcode"), "") == "-") {
            const auto x = this->evalf(jat(kids, 0), sc)?;
            v = -x;
        } else if (k == "DeclRefExpr") {
            const auto id = jstr(jget(jget(n, "referencedDecl"), "id"), "");
            if (!this->fvals.has(id)) { return error.ParseFailed; }
            v = this->fvals.get(id)?;
        } else {
            return error.ParseFailed;
        }
        if (t.width == 32) { v = (v as f32) as f64; }
        return v;
    }

    !void walk(Json* n, str scope, str zs, bool c, bool cls, bool pub0) {
        const auto k = jget(n, "inner");
        auto pub = pub0;
        for (auto i : 0..jlen(k)) {
            const auto x = jat(k, i);
            const auto kind = jstr(jget(x, "kind"), "");
            const auto f = this->locs(x);
            if (this->rel(f)) { this->declare(x, kind, scope)?; }
            if (kind == "AccessSpecDecl") { pub = jstr(jget(x, "access"), "") == "public"; }
            if (kind == "UsingShadowDecl" && pub && this->rel(f)) { this->alias(x, scope)?; }
            if (f == this->stub && kind == "EnumDecl") { this->uchar = jstr(jget(cx_find(x, "ConstantExpr"), "value"), "") == "false"; }
            if (!pub || !this->rel(f) || jbool(jget(x, "isImplicit"), false)) {
                this->kids(x);
                continue;
            }
            this->one(x, kind, scope, zs, c, cls)?;
        }
    }

    !void one(Json* x, str kind, str scope, str zs, bool c, bool cls) {
        const auto name = jstr(jget(x, "name"), "");
        const auto qn = cx_qual(this->a, scope, name)?;
        const auto zn = cx_zname(this->a, zs, name)?;
        if (kind == "NamespaceDecl") {
            if (name.len == 0) { return this->walk(x, scope, zs, c, false, true); }
            return this->walk(x, qn, zn, c, false, true);
        }
        if (kind == "LinkageSpecDecl") { return this->walk(x, scope, zs, jstr(jget(x, "language"), "") == "C", false, true); }
        const auto out = jget(x, "parentDeclContextId") != null;
        const auto meth = kind == "CXXMethodDecl" || kind == "CXXConversionDecl" || kind == "CXXConstructorDecl" || kind == "CXXDestructorDecl";
        if (out && (meth || kind == "VarDecl")) { return this->kids(x); }
        if (meth) {
            this->kids(x);
            if (jbool(jget(x, "explicitlyDeleted"), false)) { return; }
            if (kind == "CXXConstructorDecl") { return this->skip(qn, "constructors are not bound yet"); }
            if (kind == "CXXDestructorDecl") { return this->skip(qn, "destructors are not bound yet"); }
            return this->skip(qn, "methods are not bound yet");
        }
        if (kind == "EnumDecl" && out) {
            const auto p = this->byid.get_or(jstr(jget(x, "previousDecl"), ""), "");
            if (p.len == 0) {
                this->kids(x);
                return this->skip(name, "enum defined outside its scope");
            }
            const auto s = cx_up(p);
            const auto z = str_replace(this->a, s, "::", "_")?;
            return this->enum_decl(x, s, name, p, cx_zname(this->a, z, name)?, z);
        }
        if (kind == "CXXRecordDecl" && out) {
            const auto p = this->byid.get_or(jstr(jget(x, "previousDecl"), ""), "");
            const auto r = this->recs.get_or(p, null);
            if (r == null) {
                this->kids(x);
                return this->skip(name, "class defined outside its scope");
            }
            return this->record(x, r, cx_up(p));
        }
        if (kind == "CXXRecordDecl" && name.len > 0) {
            const auto r = this->rec_decl(x, qn, zn)?;
            if (r == null) { return this->kids(x); }
            return this->record(x, r, scope);
        }
        if (kind == "CXXRecordDecl") {
            if (!cls && jbool(jget(x, "completeDefinition"), false)) {
                const auto r = this->newrec("")?;
                this->define(x, r, scope)?;
                this->anonr.put(jstr(jget(x, "id"), ""), r)?;
            }
            return this->kids(x);
        }
        if (kind == "EnumDecl") { return this->enum_decl(x, scope, name, qn, zn, zs); }
        if (kind == "TypedefDecl" || kind == "TypeAliasDecl") { return this->typedef_decl(x, scope, qn, zn); }
        if (kind == "VarDecl") { return this->var_decl(x, scope, qn, zn, cls); }
        if (kind == "FunctionDecl") { return this->func(x, scope, name, c); }
        this->kids(x);
        if (cls && kind == "FunctionTemplateDecl") { return this->skip(qn, "member templates are not bound"); }
        if (cls || name.len == 0) { return; }
        for (auto q : ["UsingDecl", "UsingShadowDecl", "UsingDirectiveDecl", "UsingEnumDecl", "NamespaceAliasDecl", "StaticAssertDecl", "EmptyDecl"]) {
            if (kind == q) { return; }
        }
        if (kind == "FunctionTemplateDecl") { return this->skip(qn, "function templates are not bound yet"); }
        if (kind == "ClassTemplateDecl") { return this->skip(qn, "class templates are not bound yet"); }
        this->skip(qn, CX_TODO)?;
    }

    !CxRec* newrec(str qn) {
        const auto r = this->a.create<CxRec>()?;
        r.qn = qn;
        r.key = qn;
        r.flds = List<CxFld>::init(this->a);
        r.subs = List<CxRec*>::init(this->a);
        r.pubs = List<str>::init(this->a);
        r.items = List<CxItem>::init(this->a);
        r.bits = List<CxBit>::init(this->a);
        r.notes = List<CxNote>::init(this->a);
        return r;
    }

    !CxRec* rec_decl(Json* x, str qn, str zn) {
        auto r = this->recs.get_or(qn, null);
        if (r == null) {
            if (!this->claim(zn, qn)?) { return null; }
            r = this->newrec(qn)?;
            r.d = this->decl(.Struct, zn)?;
            r.d.cxx = qn;
            r.d.cx = r;
            this->recs.put(qn, r)?;
            this->zrec.put(zn, r)?;
            this->names.put(qn, zn)?;
            this->zd.put(zn, r.d)?;
        }
        this->byid.put(jstr(jget(x, "id"), ""), qn)?;
        return r;
    }

    !void record(Json* x, CxRec* r, str outer) {
        this->record_bases(x, outer, r.qn)?;
        this->walk(x, r.qn, r.d.name, false, true, jstr(jget(x, "tagUsed"), "") != "class")?;
        if (jbool(jget(x, "completeDefinition"), false) && !r.done) {
            const auto bs = jget(x, "bases");
            for (auto i : 0..jlen(bs)) {
                const auto b = jat(bs, i);
                if (jstr(jget(b, "access"), "") != "public" || jbool(jget(b, "isVirtual"), false)) { continue; }
                const auto t = this->expand(this->type_of(jget(b, "type"), outer)?);
                if (t.k == .Named && t.rec != null) { r.pubs.push(t.rec.cx.qn)?; }
            }
            this->define(x, r, r.qn)?;
            r.d.complete = true;
            r.d.is_union = r.is_union;
            this->rlist.push(r)?;
            const auto old = this->a.create<CDecl>()?;
            old.k = .Var;
            old.seq = r.d.seq;
            this->decls.items[r.d.seq] = old;
            this->decls.push(r.d)?;
        }
    }

    !void define(Json* x, CxRec* r, str scope) {
        r.done = true;
        r.is_union = jstr(jget(x, "tagUsed"), "") == "union";
        const auto dd = jget(x, "definitionData");
        r.value = jbool(jget(dd, "isTriviallyCopyable"), false) && !jbool(jget(dd, "isAbstract"), false);
        auto pub = jstr(jget(x, "tagUsed"), "") != "class";
        CxRec* last = null;
        const auto k = jget(x, "inner");
        for (auto i : 0..jlen(k)) {
            const auto c = jat(k, i);
            const auto kind = jstr(jget(c, "kind"), "");
            if (kind == "AccessSpecDecl") { pub = jstr(jget(c, "access"), "") == "public"; }
            if (kind == "CXXRecordDecl" && jstr(jget(c, "name"), "").len == 0 && jbool(jget(c, "completeDefinition"), false)) {
                last = null;
                if (pub) {
                    last = this->newrec(r.qn)?;
                    last.anon = true;
                    last.d = this->a.create<CDecl>()?;
                    last.d.k = .Struct;
                    last.d.rel = true;
                    last.d.complete = true;
                    last.d.fields = List<CField>::init(this->a);
                    last.d.subs = List<CDecl*>::init(this->a);
                    last.d.cx = last;
                    this->define(c, last, scope)?;
                    last.d.is_union = last.is_union;
                    r.subs.push(last)?;
                }
            }
            if (kind != "FieldDecl") { continue; }
            auto f = CxFld{ .name = jstr(jget(c, "name"), ""), .x = c, .pub = pub, .bits = jbool(jget(c, "isBitfield"), false) };
            const auto q = jstr(jget(jget(c, "type"), "qualType"), "");
            if (pub && last != null && str_ends_with(q, ")") && (str_find(q, "(anonymous ") >= 0 || str_find(q, "(unnamed ") >= 0)) {
                f.sub = last;
            } else if (pub) {
                f.ty = this->type_of(jget(c, "type"), scope)?;
                this->init(&f, scope)?;
            }
            r.flds.push(f)?;
        }
    }

    !void init(CxFld* f, str scope) {
        if (!jbool(jget(f.x, "hasInClassInitializer"), false) || cx_bad(f.ty)) { return; }
        Json* e = null;
        const auto k = jget(f.x, "inner");
        for (auto i : 0..jlen(k)) { if (!str_ends_with(jstr(jget(jat(k, i), "kind"), ""), "Attr")) { e = jat(k, i); } }
        const auto t = this->scalar(f.ty)?;
        if (e == null || f.bits) { return; }
        if (t.k == .Ptr && cx_find(e, "CXXNullPtrLiteralExpr") != null) { return; }
        if (t.k == .Float) {
            const auto v = this->evalf(e, scope) catch {
                f.why = "not a constant";
                return;
            };
            f.init = cx_fnum(this->a, v)?;
            return;
        }
        if (t.k == .Int || t.k == .Bool) {
            const auto v = this->eval(e, scope) catch {
                f.why = "not a constant";
                return;
            };
            if (t.k == .Bool && v.v != 0) {
                f.init = "true";
            } else if (t.k == .Bool) {
                f.init = "false";
            } else {
                f.init = cb_num(this->a, v)?;
            }
            return;
        }
        f.why = "not a constant";
    }

    !void layouts(str header, str from_dir, List<str> cflags) {
        if (this->rlist.len == 0) { return; }
        auto sb = List<u8>::init(this->a);
        sprint(&sb, ".zark-cache/cbind/lay-{os::pid()}.cpp")?;
        const auto stub = sb.slice();
        auto body = List<u8>::init(this->a);
        sprint(&body, "#pragma clang diagnostic ignored \"-Weverything\"\n#include \"{header}\"\n")?;
        for (auto [i, r] : this->rlist.slice()) { sprint(&body, "typedef char zark_layout_{i}[sizeof({r.qn})];\n")?; }
        write_file(stub, body.slice())?;
        auto argv = List<str>::init(this->a);
        argv.append(["clang++", "-fsyntax-only", "-Xclang", "-fdump-record-layouts", "-iquote", from_dir])?;
        argv.append(cflags.slice())?;
        argv.append(["-x", "c++", stub])?;
        const auto r = os::exec(this->a, argv.slice()) catch |e| {
            drop(stub);
            eprintln("error: cannot run clang++: {e}");
            return error.CompileFailed;
        };
        drop(stub);
        if (r.code != 0) {
            eprint(r.err);
            return error.CompileFailed;
        }
        auto state = 0;
        auto key = "";
        CxLay* cur = null;
        auto it = str_lines(r.out);
        while (it.next()) {
            const auto ln = it.line;
            if (str_starts_with(ln, "*** Dumping AST Record Layout")) {
                state = 1;
                continue;
            }
            const auto bar = str_find(ln, "|");
            if (state == 0 || bar < 0) { continue; }
            const auto left = str_trim(ln[0..bar]);
            const auto rest = ln[bar + 1..];
            const auto t = str_trim(rest);
            if (state == 1) {
                cur = this->a.create<CxLay>()?;
                cur.ents = List<CxEnt>::init(this->a);
                key = cx_lkey(t);
                state = 2;
                continue;
            }
            if (str_starts_with(t, "[sizeof=")) {
                cur.size = cb_num_after(t, "sizeof=");
                cur.align = cb_num_after(t, " align=");
                if (!this->lays.has(key)) { this->lays.put(key, cur)?; }
                state = 0;
                continue;
            }
            auto n = 0;
            while (n < rest.len && rest[n] == ' ') { n += 1; }
            auto o = left;
            const auto colon = str_find(o, ":");
            if (colon >= 0) { o = o[0..colon]; }
            cur.ents.push(CxEnt{ .depth = (n - 1) / 2, .off = parse_int(o)? as i64, .text = t })?;
        }
    }

    !void note(CxRec* r, str label, str why) {
        r.notes.push(CxNote{ .label = label, .why = why })?;
    }

    !CSize sz(CType* t0) {
        const auto t = this->scalar(t0)?;
        match t.k {
            .Int, .Float => { return CSize{ .size = t.width / 8, .align = t.width / 8 }; }
            .Bool => { return CSize{ .size = 1, .align = 1 }; }
            .Ptr => { return CSize{ .size = 8, .align = 8 }; }
            .Array => {
                const auto e = this->sz(t.elem)?;
                if (e.size < 0 || t.n < 0) { return CSize{ .size = -1 }; }
                return CSize{ .size = e.size * t.n, .align = e.align };
            }
            .Named => {
                if (t.rec != null) {
                    const auto l = this->lays.get_or(t.rec.cx.key, null);
                    if (l != null) { return CSize{ .size = l.size, .align = l.align }; }
                }
            }
        }
        return CSize{ .size = -1 };
    }

    !void bitfield(CxRec* r, CxFld f, str label) {
        if (r.anon || r.is_union) {
            auto why = "bitfield";
            if (r.anon) { why = "bitfield in anonymous record"; }
            return this->note(r, str_concat(this->a, [r.qn, ".", f.name])?, why);
        }
        const auto w = cx_why(f.ty);
        if (w.len > 0) { return this->note(r, label, w); }
        const auto x = this->scalar(f.ty)?;
        if (x.k != .Int && x.k != .Bool) { return this->note(r, label, "bitfield type"); }
        const auto g = this->decl(.Var, label)?;
        g.rel = false;
        const auto s = this->decl(.Var, label)?;
        s.rel = false;
        r.bits.push(CxBit{ .name = f.name, .ty = f.ty, .label = label, .get = g, .set = s })?;
    }

    !void flat(CxRec* r) {
        if (r.flat) { return; }
        r.flat = true;
        const auto l = this->lays.get_or(r.key, null);
        if (l == null) {
            r.skip = "layout not found";
            return;
        }
        r.size = l.size;
        r.align = l.align;
        auto fi = 0;
        for (auto e : l.ents.slice()) {
            if (e.depth != 1) { continue; }
            auto t = e.text;
            if (str_ends_with(t, " (empty)")) { t = t[0..t.len - 8]; }
            if (str_ends_with(t, " (base)") || str_ends_with(t, " (primary base)")) {
                const auto b = this->recs.get_or(cx_lkey(t[0..str_rfind(t, " (")]), null);
                if (b == null || b.d == null || r.pubs.index_of(b.qn) < 0) { continue; }
                this->flat(b)?;
                if (b.skip.len > 0 || b.why.len > 0) { continue; }
                for (auto it : b.items.slice()) {
                    if (it.name == "__vptr" && e.off + it.off != 0) { continue; }
                    auto c = it;
                    c.off += e.off;
                    c.base = true;
                    r.items.push(c)?;
                }
                continue;
            }
            if (str_ends_with(t, " (virtual base)")) { continue; }
            if (str_ends_with(t, " vtable pointer)")) {
                if (e.off == 0) {
                    const auto v = this->a.create<CType>()?;
                    v.k = .Void;
                    r.items.push(CxItem{ .name = "__vptr", .ty = cx_ptr(this->a, v)?, .size = 8, .align = 8 })?;
                }
                continue;
            }
            if (fi >= r.flds.len) {
                fi = -1;
                break;
            }
            const auto f = r.flds.get(fi);
            fi += 1;
            if (!f.pub || (f.name.len == 0 && f.sub == null)) { continue; }
            const auto label = cx_qual(this->a, r.qn, f.name)?;
            if (f.bits) {
                this->bitfield(r, f, label)?;
                continue;
            }
            auto ty = f.ty;
            auto name = f.name;
            if (f.sub != null) {
                const auto s = f.sub;
                s.qn = r.qn;
                s.key = cx_lkey(t);
                if (f.name.len > 0) { s.key = cx_lkey(t[0..t.len - f.name.len - 1]); }
                this->flat(s)?;
                ty = this->named("")?;
                ty.rec = s.d;
                ty.tag = 1;
                if (name.len == 0) {
                    auto nb = List<u8>::init(this->a);
                    sprint(&nb, "__anon{r.subs.index_of(s)}")?;
                    name = nb.slice();
                }
            } else {
                const auto why = cx_why(ty);
                if (why.len > 0) {
                    this->note(r, label, why)?;
                    continue;
                }
                if (ty.k == .Ptr && ty.ref) {
                    this->note(r, label, "reference member")?;
                    continue;
                }
            }
            const auto z = this->sz(ty)?;
            if (z.size < 0) {
                this->note(r, label, "layout not found")?;
                continue;
            }
            if (f.why.len > 0) { this->note(r, str_concat(this->a, [label, " default"])?, f.why)?; }
            r.items.push(CxItem{ .name = name, .ty = ty, .off = e.off, .size = z.size, .align = z.align, .init = f.init, .label = label })?;
        }
        if (fi != r.flds.len) {
            r.why = "layout not found";
            return;
        }
        if (r.is_union) {
            if (!r.value) { r.why = "union with non-trivial members"; }
            return;
        }
        const auto n = r.items.len;
        for (auto i : 1..n) {
            auto j = i;
            while (j > 0 && r.items.items[j - 1].off > r.items.items[j].off) {
                const auto x = r.items.items[j];
                r.items.items[j] = r.items.items[j - 1];
                r.items.items[j - 1] = x;
                j -= 1;
            }
        }
        auto own = Map<bool>::init(this->a);
        auto inh = Map<i64>::init(this->a);
        for (auto it : r.items.slice()) {
            if (it.base) { inh.put(it.name, inh.get_or(it.name, 0) + 1)?; } else { own.put(it.name, true)?; }
        }
        auto out = List<CxItem>::init(this->a);
        for (auto it : r.items.slice()) {
            if (it.base && (own.has(it.name) || inh.get_or(it.name, 0) > 1)) { continue; }
            if (out.len > 0) {
                const auto p = out.last()?;
                if (it.off < p.off + p.size) {
                    if (it.size > p.size) {
                        this->note(r, p.label, "overlapping member")?;
                        out.items[out.len - 1] = it;
                    } else {
                        this->note(r, it.label, "overlapping member")?;
                    }
                    continue;
                }
            }
            out.push(it)?;
        }
        r.items = out;
        for (auto it : r.items.slice()) { if (it.off % it.align != 0 || it.align > r.align) { r.why = "packed"; } }
    }

    !void alias(Json* x, str scope) {
        const auto g = jget(x, "target");
        const auto q = this->byid.get_or(jstr(jget(g, "id"), ""), "");
        if (q.len == 0) { return; }
        const auto n = cx_qual(this->a, scope, jstr(jget(g, "name"), ""))?;
        this->names.put(n, this->names.get_or(q, ""))?;
        const auto t = this->tid.get_or(q, "");
        if (t.len > 0) { this->tid.put(n, t)?; }
    }

    !void enum_decl(Json* x, str scope, str name, str qn, str zn, str zs) {
        const auto id = jstr(jget(x, "id"), "");
        const auto scoped = jget(x, "scopedEnumTag") != null;
        CType* fixed = null;
        const auto fu = jget(x, "fixedUnderlyingType");
        if (fu != null) { fixed = this->btype(fu, scope)?; }
        auto names = List<str>::init(this->a);
        auto ids = List<str>::init(this->a);
        auto vals = List<CVal>::init(this->a);
        auto why = "";
        auto v = CVal{ .v = 0 };
        const auto k = jget(x, "inner");
        for (auto i : 0..jlen(k)) {
            const auto e = jat(k, i);
            _ = this->locs(e);
            this->kids(e);
            if (jstr(jget(e, "kind"), "") != "EnumConstantDecl") { continue; }
            names.push(jstr(jget(e, "name"), ""))?;
            ids.push(jstr(jget(e, "id"), ""))?;
            const auto ce = cx_find(e, "ConstantExpr");
            if (ce != null) {
                if (fixed == null || fixed.k == .Int) {
                    v = this->eval(ce, scope) catch {
                        why = "enum value not evaluated";
                        continue;
                    };
                }
            } else if (jlen(jget(e, "inner")) > 0) {
                why = "enum value not evaluated";
            } else if (names.len > 1) {
                v = cb_next(v)?;
            }
            if (fixed != null) {
                v = cb_cast(v, fixed.width, fixed.signed);
            } else if (cb_fits(v, 32, true)) {
                v = cb_cast(v, 32, true);
            }
            vals.push(v)?;
        }
        auto label = qn;
        if (name.len == 0) { label = names.last() catch "?"; }
        if (fixed != null && fixed.k != .Int) { why = "enum with fixed underlying type"; }
        if (why.len > 0) { return this->skip(label, why); }
        auto t = fixed;
        if (t == null) {
            auto p = CParser{ .a = this->a };
            t = p.enum_type(vals, this->short_enums)?;
        }
        if (t.k == .Bad) { return this->skip(label, t.name); }
        if (t.plain) {
            const auto u = this->a.create<CType>()?;
            *u = *t;
            u.plain = false;
            t = u;
        }
        if (name.len > 0 && this->zq.get_or(zn, "") == qn) {
            this->byid.put(id, qn)?;
        } else if (name.len > 0) {
            if (this->claim(zn, qn)?) {
                const auto d = this->decl(.Enum, zn)?;
                d.ty = t;
                d.cxx = qn;
                this->zd.put(zn, d)?;
                this->typedefs.put(zn, t)?;
                this->names.put(qn, zn)?;
                this->byid.put(id, qn)?;
            }
        } else {
            this->anon.put(id, t)?;
        }
        for (auto [i, n] : names.slice()) {
            auto cv = vals.get(i);
            if (fixed == null && !cb_fits(cv, 32, true)) { cv = cb_cast(cv, t.width, t.signed && !t.c_unsigned); }
            this->vals.put(ids.get(i), cv)?;
            auto cz = cx_zname(this->a, zs, n)?;
            if (scoped) { cz = cx_zname(this->a, zn, n)?; }
            const auto d = this->decl(.Const, cz)?;
            d.body = cb_num(this->a, cv)?;
            if (cb_big(cv)) {
                d.ty = this->a.create<CType>()?;
                d.ty.k = .Int;
                d.ty.width = 64;
            }
        }
    }

    CType* anon_of(Json* x) {
        auto c = jat(jget(x, "inner"), 0);
        while (jstr(jget(c, "kind"), "") == "ElaboratedType") { c = jat(jget(c, "inner"), 0); }
        if (jstr(jget(c, "kind"), "") != "EnumType") { return null; }
        return this->anon.get_or(jstr(jget(jget(c, "decl"), "id"), ""), null);
    }

    CxRec* anon_rec(Json* x) {
        auto c = jat(jget(x, "inner"), 0);
        while (jstr(jget(c, "kind"), "") == "ElaboratedType") { c = jat(jget(c, "inner"), 0); }
        if (jstr(jget(c, "kind"), "") != "RecordType") { return null; }
        return this->anonr.get_or(jstr(jget(jget(c, "decl"), "id"), ""), null);
    }

    !void typedef_decl(Json* x, str scope, str qn, str zn) {
        this->kids(x);
        const auto ar = this->anon_rec(x);
        if (ar != null && ar.d == null) {
            if (!this->claim(zn, qn)?) { return; }
            ar.qn = qn;
            ar.key = qn;
            ar.d = this->decl(.Struct, zn)?;
            ar.d.cxx = qn;
            ar.d.cx = ar;
            ar.d.complete = true;
            ar.d.is_union = ar.is_union;
            this->recs.put(qn, ar)?;
            this->zrec.put(zn, ar)?;
            this->names.put(qn, zn)?;
            this->zd.put(zn, ar.d)?;
            const auto id = jstr(jget(x, "id"), "");
            this->byid.put(id, qn)?;
            this->tid.put(qn, id)?;
            return this->rlist.push(ar);
        }
        auto t = this->anon_of(x);
        if (t == null) { t = this->type_of(jget(x, "type"), scope)?; }
        if (t.k == .Bad) { return this->skip(qn, t.name); }
        if (!this->claim(zn, qn)?) { return; }
        const auto d = this->decl(.Typedef, zn)?;
        d.ty = t;
        d.cxx = qn;
        this->zd.put(zn, d)?;
        this->typedefs.put(zn, t)?;
        this->names.put(qn, zn)?;
        const auto id = jstr(jget(x, "id"), "");
        this->byid.put(id, qn)?;
        this->tid.put(qn, id)?;
    }

    !void var_decl(Json* x, str scope, str qn, str zn, bool cls) {
        this->kids(x);
        const auto ty = jget(x, "type");
        const auto t = this->btype(ty, scope)?;
        const auto q = jstr(jget(ty, "qualType"), "");
        const auto k = jget(x, "inner");
        Json* init = null;
        for (auto i : 0..jlen(k)) { if (!str_ends_with(jstr(jget(jat(k, i), "kind"), ""), "Attr")) { init = jat(k, i); } }
        const auto konst = jbool(jget(x, "constexpr"), false) || str_starts_with(q, "const ");
        if (init == null || jstr(jget(x, "init"), "").len == 0 || !konst || (t.k != .Int && t.k != .Float && t.k != .Bool)) {
            return this->skip(qn, "variables are not bound yet");
        }
        const auto id = jstr(jget(x, "id"), "");
        auto body = "";
        if (t.k == .Float) {
            const auto f = this->evalf(init, scope) catch { return this->skip(qn, "not a constant"); };
            if (f - f != 0.0) { return this->skip(qn, "not a constant"); }
            this->fvals.put(id, f)?;
            body = cx_fnum(this->a, f)?;
        } else {
            const auto v = this->eval(init, scope) catch { return this->skip(qn, "not a constant"); };
            this->vals.put(id, v)?;
            if (t.k == .Bool) {
                body = "false";
                if (v.v != 0) { body = "true"; }
            } else {
                body = cb_num(this->a, v)?;
            }
            if (cb_big(v)) {
                const auto d = this->decl(.Const, zn)?;
                d.body = body;
                d.ty = this->a.create<CType>()?;
                d.ty.k = .Int;
                d.ty.width = 64;
                return;
            }
        }
        const auto d = this->decl(.Const, zn)?;
        d.body = body;
    }

    !void func(Json* x, str scope, str name, bool c) {
        this->kids(x);
        if (jbool(jget(x, "explicitlyDeleted"), false) || jget(x, "previousDecl") != null) { return; }
        const auto qn = cx_qual(this->a, scope, name)?;
        auto label = qn;
        if (c) { label = name; }
        if (str_starts_with(name, "operator\"\"")) { return this->skip(label, "user-defined literals are not bound"); }
        if (str_starts_with(name, "operator") && (name.len == 8 || !cb_ident_char(name[8]))) { return this->skip(label, "operator functions are not bound yet"); }
        const auto t = this->type_of(jget(x, "type"), scope)?;
        if (t.k == .Bad) { return this->skip(label, t.name); }
        if (t.k != .Func) { return this->skip(label, CX_TODO); }
        const auto k = jget(x, "inner");
        auto n = 0;
        for (auto i : 0..jlen(k)) {
            const auto p = jat(k, i);
            if (jstr(jget(p, "kind"), "") != "ParmVarDecl" || n >= t.params.len) { continue; }
            t.params.items[n].name = jstr(jget(p, "name"), "");
            t.params.items[n].ty = this->type_of(jget(p, "type"), scope)?;
            n += 1;
        }
        const auto d = this->decl(.Func, label)?;
        d.ty = t;
        d.cxx = qn;
        d.is_extern = c && !jbool(jget(x, "inline"), false) && !jbool(jget(x, "constexpr"), false) && jstr(jget(x, "storageClass"), "") != "static" && cx_cshape(this, t);
        if (t.varargs && !d.is_extern) { d.reason = "variadic C++ functions are not bound yet"; }
    }
}

bool cx_exc = true;

!str cx_spell(Allocator a, CType* t, str inner) {
    auto b = List<u8>::init(a);
    match t.k {
        .Ptr => {
            if (t.ref && t.rvalue) {
                sprint(&b, "&&")?;
            } else if (t.ref) {
                sprint(&b, "&")?;
            } else {
                sprint(&b, "*")?;
            }
            if (t.konst) { sprint(&b, " const")?; }
            if (t.vol) { sprint(&b, " volatile")?; }
            if (inner.len > 0 && (t.konst || t.vol)) { sprint(&b, " ")?; }
            sprint(&b, "{inner}")?;
            auto s = b.slice();
            if (t.elem.k == .Func || t.elem.k == .Array) { s = str_concat(a, ["(", s, ")"])?; }
            return cx_spell(a, t.elem, s);
        }
        .Array => {
            sprint(&b, "{inner}[")?;
            if (t.n >= 0) { sprint(&b, "{t.n}")?; }
            sprint(&b, "]")?;
            return cx_spell(a, t.elem, b.slice());
        }
        .Func => {
            sprint(&b, "{inner}(")?;
            for (auto [i, p] : t.params.slice()) {
                if (i > 0) { sprint(&b, ", ")?; }
                const auto ps = cx_spell(a, p.ty, "")?;
                sprint(&b, "{ps}")?;
            }
            if (t.varargs && t.params.len > 0) { sprint(&b, ", ")?; }
            if (t.varargs) { sprint(&b, "...")?; }
            sprint(&b, ")")?;
            if (t.konst) { sprint(&b, " const")?; }
            if (t.vol) { sprint(&b, " volatile")?; }
            if (t.ref && t.rvalue) {
                sprint(&b, " &&")?;
            } else if (t.ref) {
                sprint(&b, " &")?;
            }
            if (t.noexc) { sprint(&b, " noexcept")?; }
            return cx_spell(a, t.elem, b.slice());
        }
    }
    if (t.konst) { sprint(&b, "const ")?; }
    if (t.vol) { sprint(&b, "volatile ")?; }
    sprint(&b, "{t.cxx}")?;
    if (inner.len > 0) { sprint(&b, " {inner}")?; }
    return b.slice();
}

str cx_byval(CDecl* r) {
    if (!r.complete) { return "incomplete class by value"; }
    if (!r.cx.value) { return "non-trivial class by value is not bound yet"; }
    return "";
}

bool cx_scalar(CEmit* e, CType* t) {
    auto x = t;
    while (x.k == .Named && cb_known(x.name).len == 0) {
        x = e.typedefs.get_or(x.name, null);
        if (x == null) { return false; }
    }
    return x.k == .Named || x.k == .Int || x.k == .Float || x.k == .Bool || (x.k == .Ptr && !x.ref);
}

!CType* cx_ptr(Allocator a, CType* t) {
    const auto p = a.create<CType>()?;
    p.k = .Ptr;
    p.elem = t;
    return p;
}

!void cx_shim(CEmit* e, CDecl* d) {
    if (d.reason.len > 0) { return e.warn(d.name, d.reason); }
    const auto a = e.a;
    const auto f = d.ty;
    auto sb = List<u8>::init(a);
    sprint(&sb, "zark_cxx_{e.hid}_{d.seq}")?;
    const auto sn = sb.slice();
    auto zp = List<u8>::init(a);
    auto xp = List<u8>::init(a);
    auto za = List<u8>::init(a);
    auto cp = List<u8>::init(a);
    auto ca = List<u8>::init(a);
    auto why = "";
    for (auto [i, p] : f.params.slice()) {
        if (i > 0) {
            sprint(&zp, ", ")?;
            sprint(&xp, ", ")?;
            sprint(&za, ", ")?;
            sprint(&cp, ", ")?;
            sprint(&ca, ", ")?;
        }
        auto an = List<u8>::init(a);
        sprint(&an, "a{i}")?;
        auto zn = cb_pname(a, f.params.slice(), i)?;
        if (p.name.len > 0) { zn = e.ename(p.name)?; }
        auto st = p.ty;
        CType* xt = null;
        auto arg = an.slice();
        auto pass = zn;
        const auto pr = e.rec_of(p.ty);
        if (pr != null && pr.cx != null) {
            if (why.len == 0) { why = cx_byval(pr); }
            xt = cx_ptr(a, p.ty)?;
            pass = str_concat(a, ["&", zn])?;
            arg = str_concat(a, ["*", arg])?;
        } else if (p.ty.k == .Ptr && p.ty.ref) {
            const auto er = e.rec_of(p.ty.elem);
            const auto vr = er != null && er.cx != null && cx_byval(er).len == 0;
            if ((p.ty.rvalue || p.ty.elem.konst) && !(f.elem.k == .Ptr && f.elem.ref) && (cx_scalar(e, p.ty.elem) || vr)) {
                st = p.ty.elem;
                if (vr) {
                    xt = cx_ptr(a, p.ty.elem)?;
                    pass = str_concat(a, ["&", zn])?;
                    arg = str_concat(a, ["*", arg])?;
                }
            } else {
                st = cx_ptr(a, p.ty.elem)?;
                arg = str_concat(a, ["*", arg])?;
            }
            if (p.ty.rvalue) {
                const auto rt = cx_spell(a, p.ty.elem, "&&")?;
                arg = str_concat(a, ["static_cast<", rt, ">(", arg, ")"])?;
            }
        }
        if (xt == null) { xt = st; }
        e.ty(&zp, st)?;
        sprint(&zp, " {zn}")?;
        e.ty(&xp, xt)?;
        sprint(&xp, " {zn}")?;
        sprint(&za, "{pass}")?;
        const auto cs = cx_spell(a, xt, an.slice())?;
        sprint(&cp, "{cs}")?;
        sprint(&ca, "{arg}")?;
    }
    auto rt = f.elem;
    auto ret = "return ";
    auto pre = "";
    auto post = "";
    if (rt.k == .Void) { ret = ""; }
    auto cret = ret;
    const auto rr = e.rec_of(rt);
    const auto out = rr != null && rr.cx != null;
    if (out) {
        if (why.len == 0) { why = cx_byval(rr); }
        cret = "";
        pre = "auto &&v = ";
        post = "; __builtin_memcpy((void*)r, (const void*)&v, sizeof(v))";
    }
    if (why.len > 0) { return e.warn(d.name, why); }
    if (rt.k == .Ptr && rt.ref) {
        pre = "&";
        if (rt.rvalue) {
            cret = "";
            pre = "auto &&r = ";
            post = "; return &r";
        }
        rt = cx_ptr(a, rt.elem)?;
    }
    auto zr = List<u8>::init(a);
    e.ty(&zr, rt)?;
    if (e.why.len > 0) { return e.warn(d.name, e.why); }
    const auto k = str_rfind(d.name, "::");
    auto zs = "";
    auto path = e.ename(d.name)?;
    auto stat = "";
    if (k >= 0) {
        zs = e.ename(str_replace(a, d.name[0..k], "::", "_")?)?;
        path = str_concat(a, [zs, "::", e.ename(d.name[k + 2..])?])?;
        stat = "static ";
    }
    if (e.bad.has(path) || e.done.has(path)) {
        e.bad.put(path, true)?;
        return e.warn(d.name, "name clash");
    }
    if (zs.len > 0 && e.done.get_or(zs, 0) != 7) {
        if (e.done.has(zs)) { return e.warn(d.name, "name clash"); }
        auto sl = List<u8>::init(a);
        sprint(&sl, "struct {zs} {{ }}")?;
        _ = e.line(zs, 7, sl.slice())?;
    }
    const auto zrs = zr.slice();
    const auto zps = zp.slice();
    const auto xps = xp.slice();
    const auto zas = za.slice();
    auto zt = List<u8>::init(a);
    auto cps = cp.slice();
    auto def = "";
    if (out) {
        auto sep = "";
        if (f.params.len > 0) { sep = ", "; }
        sprint(&zt, "extern void {sn}({xps}{sep}{zrs}* __r);\n{stat}{zrs} {path}({zps}) {{ {zrs} __r; {sn}({zas}{sep}&__r); return __r; }}")?;
        const auto rc = a.create<CType>()?;
        *rc = *rt;
        rc.konst = false;
        cps = str_concat(a, [cps, sep, cx_spell(a, cx_ptr(a, rc)?, "r")?])?;
        def = str_concat(a, ["void ", sn, "(", cps, ")"])?;
    } else {
        sprint(&zt, "extern {zrs} {sn}({xps});\n{stat}{zrs} {path}({zps}) {{ {ret}{sn}({zas}); }}")?;
        def = cx_spell(a, rt, str_concat(a, [sn, "(", cps, ")"])?)?;
    }
    if (!e.line(path, 3, zt.slice())?) { return; }
    const auto cas = ca.slice();
    const auto fp = cx_spell(a, f, "(*)")?;
    sprint(&e.c, "#if !defined(ZARK_PICK) || defined(ZARK_USE_{e.hid}_{d.seq})\nextern \"C\" {def} {{\n    (void)static_cast<{fp}>(&{d.cxx});\n")?;
    if (cx_exc && !f.noexc) {
        sprint(&e.c, "    try {{\n        {cret}{pre}{d.cxx}({cas}){post};\n    }} catch (...) {{\n        zark_cxx_fail(\"{d.cxx}\");\n    }}\n")?;
    } else {
        sprint(&e.c, "    {cret}{pre}{d.cxx}({cas}){post};\n")?;
    }
    e.c.append("}\n#endif\n")?;
}

!void cx_record(CEmit* e, CDecl* d) {
    const auto a = e.a;
    const auto r = d.cx;
    if (r.skip.len > 0) {
        e.warn(r.qn, r.skip)?;
        e.bad.put(d.name, true)?;
        return;
    }
    if (!e.claim(d.name, 1)?) { return; }
    const auto zr = e.ename(d.name)?;
    if (!d.complete) {
        auto b = List<u8>::init(a);
        sprint(&b, "struct {zr} {{ }}")?;
        _ = e.line(d.name, 1, b.slice())?;
        return;
    }
    const auto saved = e.cur;
    defer e.cur = saved;
    for (auto [i, s] : r.subs.slice()) {
        auto nb = List<u8>::init(a);
        sprint(&nb, "{d.name}__anon{i}")?;
        s.d.name = nb.slice();
        e.why = "";
        cx_record(e, s.d)?;
    }
    e.cur = d.name;
    for (auto n : r.notes.slice()) { e.warn(n.label, n.why)?; }
    auto ext = List<u8>::init(a);
    auto body = List<u8>::init(a);
    auto c = List<u8>::init(a);
    auto al = 1;
    if (r.is_union || r.why.len > 0) {
        const auto w = min(r.align, 8);
        auto el = "u8";
        if (w == 2) { el = "u16"; }
        if (w == 4) { el = "u32"; }
        if (w == 8) { el = "u64"; }
        al = r.align;
        sprint(&body, "{el}[{r.size / w}] storage; ")?;
    }
    if (r.is_union && r.why.len == 0) {
        for (auto it : r.items.slice()) {
            e.why = "";
            auto pb = List<u8>::init(a);
            e.ty(&pb, cx_ptr(a, it.ty)?)?;
            if (e.why.len > 0) {
                e.warn(it.label, e.why)?;
                continue;
            }
            sprint(&body, "{pb.slice()} as_{it.name}() {{ void* p = this; return p; }} ")?;
        }
    }
    if (!r.is_union && r.why.len == 0) {
        auto o = 0;
        auto np = 0;
        auto used = Map<bool>::init(a);
        for (auto it : r.items.slice()) {
            e.why = "";
            auto tb = List<u8>::init(a);
            e.ty(&tb, it.ty)?;
            if (e.why.len > 0) {
                e.warn(it.label, e.why)?;
                continue;
            }
            const auto fname = e.ename(it.name)?;
            if (used.has(fname)) {
                e.warn(it.label, "name clash")?;
                continue;
            }
            used.put(fname, true)?;
            if (it.off > o) {
                sprint(&body, "u8[{it.off - o}] __pad{np}; ")?;
                np += 1;
            }
            sprint(&body, "{tb.slice()} {fname}")?;
            if (it.init.len > 0) { sprint(&body, " = {it.init}")?; }
            sprint(&body, "; ")?;
            o = it.off + it.size;
            al = max(al, it.align);
        }
        if (o < r.size) { sprint(&body, "u8[{r.size - o}] __pad{np}; ")?; }
    }
    for (auto bf : r.bits.slice()) {
        if (bf.get.reason.len > 0 || bf.set.reason.len > 0) {
            e.warn(bf.label, str_concat(a, [bf.get.reason, bf.set.reason])?)?;
            continue;
        }
        e.why = "";
        auto tb = List<u8>::init(a);
        e.ty(&tb, bf.ty)?;
        if (e.why.len > 0) {
            e.warn(bf.label, e.why)?;
            continue;
        }
        const auto zt = tb.slice();
        const auto ct = cx_spell(a, bf.ty, "")?;
        auto gb = List<u8>::init(a);
        sprint(&gb, "zark_cxx_{e.hid}_{bf.get.seq}")?;
        auto sb = List<u8>::init(a);
        sprint(&sb, "zark_cxx_{e.hid}_{bf.set.seq}")?;
        const auto g = gb.slice();
        const auto st = sb.slice();
        sprint(&ext, "extern {zt} {g}({zr}* p);\nextern void {st}({zr}* p, {zt} v);\n")?;
        sprint(&body, "{zt} get_{bf.name}() {{ return {g}(this); }} void set_{bf.name}({zt} v) {{ {st}(this, v); }} ")?;
        sprint(&c, "#if !defined(ZARK_PICK) || defined(ZARK_USE_{e.hid}_{bf.get.seq})\nextern \"C\" {ct} {g}({r.qn}* p) {{\n    return p->{bf.name};\n}}\n#endif\n")?;
        sprint(&c, "#if !defined(ZARK_PICK) || defined(ZARK_USE_{e.hid}_{bf.set.seq})\nextern \"C\" void {st}({r.qn}* p, {ct} v) {{\n    p->{bf.name} = v;\n}}\n#endif\n")?;
    }
    e.why = "";
    if (al < r.align || r.align > 8) { sprint(&ext, "align({r.align}) ")?; }
    sprint(&ext, "struct {zr} {{ {body.slice()}}}")?;
    if (!e.line(d.name, 1, ext.slice())?) { return; }
    e.c.append(c.slice())?;
    if (r.why.len > 0) { e.note(r.qn, r.why)?; }
}

!CEmit cx_emit(Allocator a, CxWalk* w, str hid) {
    auto e = CEmit{ .a = a, .macs = Map<CMac*>::init(a), .cxn = Map<str>::init(a), .bad = w.bad, .relabeled = Map<bool>::init(a), .defined = Map<bool>::init(a), .typedefs = w.typedefs, .records = Map<CDecl*>::init(a), .consts = Map<str>::init(a), .fwd = Map<CDecl*>::init(a), .seen_td = Map<bool>::init(a), .hid = hid };
    for (auto d : w.decls.slice()) { if (d.k != .Func && d.cxx.len > 0) { e.cxn.put(d.name, d.cxx)?; } }
    e.run(w.decls)?;
    return e;
}

!str cx_cpp(Allocator a, str abs, CEmit* e) {
    if (e.c.len == 0) { return ""; }
    auto b = List<u8>::init(a);
    sprint(&b, "#pragma GCC diagnostic ignored \"-Wignored-qualifiers\"\n#pragma GCC diagnostic ignored \"-Wdeprecated-declarations\"\n")?;
    if (cx_exc) { sprint(&b, "#include <cstdio>\n#include <cstdlib>\n#include <exception>\n")?; }
    sprint(&b, "#include \"{abs}\"\n#pragma clang diagnostic ignored \"-Weverything\"\n")?;
    if (cx_exc) {
        sprint(&b, "[[noreturn]] static inline void zark_cxx_fail(const char *f) {{\n    fflush(stdout);\n    try {{\n        throw;\n    }} catch (const std::exception &e) {{\n        fprintf(stderr, \"zark: uncaught C++ exception in %s: %s\\n\", f, e.what());\n    }} catch (...) {{\n        fprintf(stderr, \"zark: uncaught C++ exception in %s\\n\", f);\n    }}\n    abort();\n}}\n")?;
    }
    const auto c = e.c.slice();
    sprint(&b, "{c}")?;
    return b.slice();
}

!i64 cx_check(Allocator a, CxWalk* w, str hid, str text, List<str> flags, str from_dir) {
    auto pb = List<u8>::init(a);
    sprint(&pb, ".zark-cache/cbind/check-{os::pid()}.cpp")?;
    const auto p = pb.slice();
    write_file(p, text)?;
    auto argv = List<str>::init(a);
    argv.append(["clang++", "-fsyntax-only", "-ferror-limit=0", "-iquote", from_dir])?;
    argv.append(flags.slice())?;
    argv.push("-w")?;
    argv.append(["-x", "c++", p])?;
    const auto r = os::exec(a, argv.slice()) catch |err| {
        drop(p);
        eprintln("error: cannot run clang++: {err}");
        return error.CompileFailed;
    };
    drop(p);
    if (r.code == 0) { return -1; }
    const auto guard = str_concat(a, ["#if !defined(ZARK_PICK) || defined(ZARK_USE_", hid, "_"])?;
    auto shim = List<i64>::init(a);
    auto cur = -1;
    auto lines = str_lines(text);
    while (lines.next()) {
        const auto l = lines.line;
        if (str_starts_with(l, guard)) { cur = parse_int_radix(l[guard.len..l.len - 1], 10)? as i64; }
        shim.push(cur)?;
        if (l == "#endif") { cur = -1; }
    }
    const auto at = str_concat(a, [p, ":"])?;
    auto n = 0;
    auto pend = "";
    auto it = str_lines(r.err);
    while (it.next()) {
        const auto l = it.line;
        const auto ek = str_find(l, ": error: ");
        if (!str_starts_with(l, at)) {
            if (ek >= 0) { pend = l[ek + 9..]; }
            continue;
        }
        const auto rest = l[at.len..];
        const auto c = str_find(rest, ":");
        if (c < 0) { continue; }
        const auto ln = parse_int_radix(rest[0..c], 10) catch { continue; };
        if (ln < 1 || (ln as i64) > shim.len) { continue; }
        auto msg = "";
        if (ek >= 0) {
            msg = l[ek + 9..];
        } else if (pend.len > 0 && str_find(l, ": note: ") >= 0) {
            msg = pend;
        } else {
            continue;
        }
        pend = "";
        const auto seq = shim.get((ln as i64) - 1);
        if (seq < 0) { continue; }
        const auto d = w.decls.get(seq);
        if (d.reason.len > 0) { continue; }
        d.reason = str_concat(a, ["shim does not compile: ", msg])?;
        n += 1;
    }
    if (n == 0) {
        eprint(r.err);
        return error.CompileFailed;
    }
    return n;
}

!CBind cxxbind_header(Allocator a, str header, str from_dir, List<str> flags) {
    const auto dir = ".zark-cache/cbind";
    fs::make_dirs(dir)?;
    auto sb = List<u8>::init(a);
    sprint(&sb, "{dir}/stub-{os::pid()}.cpp")?;
    const auto stub = sb.slice();
    const auto dep = str_concat(a, [stub, ".d"])?;
    auto body = List<u8>::init(a);
    sprint(&body, "#pragma clang diagnostic push\n#pragma clang diagnostic ignored \"-Weverything\"\nenum zark_char_sign {{ zark_char_v = (char)-1 < 0 }};\n#pragma clang diagnostic pop\n#include \"{header}\"\n")?;
    write_file(stub, body.slice())?;
    auto cflags = List<str>::init(a);
    for (auto f : flags.slice()) { if (!cx_c_std(f)) { cflags.push(f)?; } }
    auto argv = List<str>::init(a);
    argv.append(["clang++", "-fsyntax-only", "-Xclang", "-skip-function-bodies", "-Xclang", "-ast-dump=json", "-H", "-MD", "-MF", dep, "-iquote", from_dir])?;
    argv.append(cflags.slice())?;
    argv.append(["-x", "c++", stub])?;
    const auto r = os::exec(a, argv.slice()) catch |e| {
        drop(stub);
        eprintln("error: cannot run clang++: {e}");
        return error.CompileFailed;
    };
    drop(stub);
    const auto dtext = cb_text(a, dep)?;
    drop(dep);
    auto inc = Map<str>::init(a);
    auto chain = List<str>::init(a);
    chain.push(stub)?;
    auto msgs = List<u8>::init(a);
    auto lines = str_lines(r.err);
    while (lines.next()) {
        const auto l = lines.line;
        auto n = 0;
        while (n < l.len && l[n] == '.') { n += 1; }
        if (n == 0 || n >= l.len || l[n] != ' ' || n > chain.len) {
            sprint(&msgs, "{l}\n")?;
            continue;
        }
        const auto f = l[n + 1..];
        chain.truncate(n);
        const auto p = path::absolute(a, f) catch f;
        if (!inc.has(p)) { inc.put(p, chain.get(n - 1))?; }
        chain.push(f)?;
    }
    if (r.code != 0) {
        eprint(msgs.slice());
        return error.CompileFailed;
    }
    const auto root = json_parse(a, r.out, 1024) catch {
        eprintln("error: cannot read the clang++ AST of {header}: nested deeper than 1024 levels");
        return error.CompileFailed;
    };
    auto sflags = List<str>::init(a);
    for (auto f : cflags.slice()) { if (!str_starts_with(f, "-I")) { sflags.push(f)?; } }
    auto w = CxWalk{ .a = a, .stub = stub, .sys = cb_sys_dirs(a, sflags, true)?, .decls = List<CDecl*>::init(a), .typedefs = Map<CType*>::init(a), .names = Map<str>::init(a), .anon = Map<CType*>::init(a), .vals = Map<CVal>::init(a), .fvals = Map<f64>::init(a), .bases = Map<List<str>>::init(a), .declared = Map<bool>::init(a), .tid = Map<str>::init(a), .byid = Map<str>::init(a), .zq = Map<str>::init(a), .zd = Map<CDecl*>::init(a), .bad = Map<bool>::init(a), .recs = Map<CxRec*>::init(a), .zrec = Map<CxRec*>::init(a), .anonr = Map<CxRec*>::init(a), .rlist = List<CxRec*>::init(a), .lays = Map<CxLay*>::init(a) };
    cx_exc = true;
    for (auto f : flags.slice()) {
        if (f == "-fshort-enums") { w.short_enums = true; }
        if (f == "-fno-short-enums") { w.short_enums = false; }
        if (f == "-fno-exceptions" || f == "-fno-cxx-exceptions") { cx_exc = false; }
        if (f == "-fexceptions" || f == "-fcxx-exceptions") { cx_exc = true; }
    }
    w.walk(root, "", "", false, false, true)?;
    w.layouts(header, from_dir, cflags)?;
    for (auto r : w.rlist.slice()) { w.flat(r)?; }
    auto count = Map<i64>::init(a);
    for (auto d : w.decls.slice()) { if (d.k == .Func) { count.put(d.cxx, count.get_or(d.cxx, 0) + 1)?; } }
    for (auto d : w.decls.slice()) { if (d.k == .Func && count.get_or(d.cxx, 0) > 1) { d.reason = "overloads are not bound yet"; } }
    auto deps = List<str>::init(a);
    auto from = List<str>::init(a);
    for (auto d : dep_files(a, dtext)?) {
        if (d == stub) { continue; }
        deps.push(d)?;
        from.push(inc.get_or(path::absolute(a, d) catch d, stub))?;
    }
    auto abs = "";
    auto h = 0xcbf29ce484222325 as u64;
    if (deps.len > 0) {
        abs = path::absolute(a, deps.get(0))?;
        h = fnv64(fnv64(h, abs), read_file(a, deps.get(0))?);
    }
    for (auto f : flags.slice()) { h = fnv64(h, f); }
    auto hb = List<u8>::init(a);
    sprint(&hb, "{h:016x}")?;
    const auto hid = hb.slice();
    auto e = cx_emit(a, &w, hid)?;
    auto ic = cx_cpp(a, abs, &e)?;
    auto pass = 0;
    while (ic.len > 0) {
        const auto n = cx_check(a, &w, hid, ic, cflags, from_dir)?;
        if (n < 0) { break; }
        if (pass == 2) {
            eprintln("error: the C++ shims of {header} still do not compile");
            return error.CompileFailed;
        }
        pass += 1;
        e = cx_emit(a, &w, hid)?;
        ic = cx_cpp(a, abs, &e)?;
    }
    return CBind{ .zk = e.out.slice(), .inline_c = ic, .deps = deps, .from = from, .warnings = e.warnings };
}

!CBind cx_bind(Allocator a, str header, str from_dir, List<str> flags) {
    if (cx_is_header(header)) { return cxxbind_header(a, header, from_dir, flags); }
    return cbind_header(a, header, from_dir, flags);
}
