// Calls: free functions, generics, methods, static methods, union constructors, function pointers.

import "gen_expr.vibe";

str recv_name(Type* t) {
    if (t.k == .Strct) { return t.si.decl.name };
    if (t.k == .Enm) { return t.ei.decl.name };
    return "";
}

bool te_mentions(TypeExpr* te, List<str> names) {
    match te.k {
        .Name => {
            if (contains_str(names, te.name)) { return true; }
            for (auto x : te.args) { if (te_mentions(x, names)) { return true; } }
            return false;
        }
        .Ptr, .Slice, .Errun, .Array => return te_mentions(te.elem, names);
        .Func => {
            for (auto x : te.args) { if (te_mentions(x, names)) { return true; } }
            if (te.ret != null) { return te_mentions(te.ret, names); }
            return false;
        }
    }
    return false;
}

bool all_bound(List<str> tps, Env env) {
    for (auto tp : tps) { if (!env.has(tp)) { return false; } }
    return true;
}

!TypeExpr* Gen::expr_to_type_expr(Expr* e) {
    if (e.k == .Ident) {
        const auto t = this->a.create<TypeExpr>()?;
        t.k = .Name;
        t.name = e.name;
        t.args = List<TypeExpr*>::init(this->a);
        return t;
    }
    if (e.k == .Index) {
        if (e.op != .lt) { this->err(e.line); eprintln("type arguments are written with '<...>', as in 'List<i64>'"); return error.CompileFailed; }
        const auto base = this->expr_to_type_expr(e.l)?;
        if (base == null) { return null; }
        const auto t = this->a.create<TypeExpr>()?;
        t.k = .Name;
        t.name = base.name;
        t.args = List<TypeExpr*>::init(this->a);
        for (auto x : e.args) {
            const auto at = this->expr_to_type_expr(x)?;
            if (at == null) { return null; }
            t.args.push(at)?;
        }
        return t;
    }
    if (e.k == .Unary && e.op == .star) {
        const auto inner = this->expr_to_type_expr(e.l)?;
        if (inner == null) { return null; }
        const auto t = this->a.create<TypeExpr>()?;
        t.k = .Ptr;
        t.elem = inner;
        t.args = List<TypeExpr*>::init(this->a);
        return t;
    }
    return null;
}

/// is `e` syntactically naming a type? (`Point`, `List[i32]`, `Self`)
bool Gen::names_type(Expr* e) {
    if (e.k == .Ident) {
        if (this->has_var(e.name)) { return false; }
        return this->structs.has(e.name) || this->enums.has(e.name) || this->aliases.has(e.name) || (e.name == "Self" && this->env.has("Self"));
    }
    if (e.k == .Index) {
        return e.l.k == .Ident && !this->has_var(e.l.name) && this->structs.has(e.l.name);
    }
    return false;
}

!List<Type*> Gen::type_args(List<Expr*> args, i64 line) {
    auto out = List<Type*>::init(this->a);
    for (auto x : args) {
        const auto te = this->expr_to_type_expr(x)?;
        if (te == null) { this->err(line); eprintln("expected a type argument"); return error.CompileFailed; }
        out.push(this->resolve_type_at(te, line)?)?;
    }
    return out;
}

!Value Gen::gen_call(Expr* e, Type* expected) {
    const auto callee = e.l;
    if (callee.k == .Ident && !this->has_var(callee.name)) {
        const auto name = callee.name;
        if (this->is_builtin(name) && !this->fns.has(name)) { return this->gen_builtin(name, e.args, e.line); }
        if (this->fns.has(name)) { return this->call_decl(this->fns.get(name)?, this->new_env()?, null, e.args, this->no_types(), expected, e.line); }
        if (this->structs.has(name) && !this->consts.has(name)) { return this->gen_construct(e); }
        if (!this->consts.has(name)) {
            const auto mf = this->member_method(callee)?;
            if (mf != null) { return this->gen_field_call(mf, e.args, this->no_types(), expected, e.line); }
        }
        if (!this->consts.has(name)) { this->err(e.line); eprintln("unknown function '{name}'{this->hint(name, this->visible_names())}"); return error.CompileFailed; }
    }
    if (callee.k == .Index && (callee.l.k == .Ident || callee.l.k == .Field)) {
        if (callee.op != .lt) { this->err(e.line); eprintln("type arguments are written with '<...>', as in 'max<i64>(a, b)'"); return error.CompileFailed; }
        if (callee.l.k == .Ident && callee.l.name == "asm" && !this->fns.has("asm")) { return this->gen_asm(this->type_args(callee.args, e.line)?, e.args, e.line); }
        if (callee.l.k == .Field) {
            const auto targs = this->type_args(callee.args, e.line)?;
            return this->gen_field_call(callee.l, e.args, targs, expected, e.line);
        }
        if (this->fns.has(callee.l.name)) {
            const auto targs = this->type_args(callee.args, e.line)?;
            return this->call_decl(this->fns.get(callee.l.name)?, this->new_env()?, null, e.args, targs, expected, e.line);
        }
    }
    if (callee.k == .Field) { return this->gen_field_call(callee, e.args, this->no_types(), expected, e.line) };
    if (callee.k == .EnumLit) {
        const auto t = variant_target(lit_target(expected), callee.name);
        if (t == null) { this->err(e.line); eprintln("cannot infer union type for '.{callee.name}(...)'"); return error.CompileFailed; }
        if (!is_union(t)) { this->err(e.line); eprintln("'.{callee.name}(...)' used where '{this->type_name(t)?}' is expected"); return error.CompileFailed; }
        if (e.args.len != 1) { this->err(e.line); eprintln("a union variant takes exactly one payload"); return error.CompileFailed; }
        return this->make_union(t, callee.name, e.args.get(0), e.line);
    }
    const auto fv = this->gen_expr(callee, null)?;
    return this->call_indirect(fv, e.args, e.line);
}

!Value Gen::gen_field_call(Expr* f, List<Expr*> args, List<Type*> explicit, Type* expected, i64 line) {
    if (this->names_type(f.l)) {
        const auto t = this->type_from_expr(f.l, expected, f.name, line)?;
        if (is_union(t) && field_index(t.si, f.name) >= 0) {
            if (args.len != 1) { this->err(line); eprintln("a union variant takes exactly one payload"); return error.CompileFailed; }
            return this->make_union(t, f.name, args.get(0), line);
        }
        const auto rname = recv_name(t);
        if (rname.len == 0) { this->err(line); eprintln("'{this->type_name(t)?}' has no methods"); return error.CompileFailed; }
        auto kb = this->sb();
        sprint(&kb, "{rname}.{f.name}")?;
        if (!this->methods.has(kb.slice())) { this->err(line); eprintln("'{this->type_name(t)?}' has no method '{f.name}'"); return error.CompileFailed; }
        const auto md = this->methods.get(kb.slice())?;
        const auto env = this->recv_env(md, t)?;
        return this->call_decl(md, env, null, args, explicit, expected, line);
    }
    auto recv = this->gen_addr(f.l)?;
    if (recv.ty.k == .Ptr && recv_name(recv.ty.elem).len > 0) { recv = this->deref_agg(recv)?; }
    const auto rname = recv_name(recv.ty);
    if (rname.len == 0) { this->err(line); eprintln("'{this->type_name(recv.ty)?}' has no methods"); return error.CompileFailed; }
    auto kb = this->sb();
    sprint(&kb, "{rname}.{f.name}")?;
    if (this->methods.has(kb.slice())) {
        const auto md = this->methods.get(kb.slice())?;
        if (this->const_this && !md.is_const && (recv.imm || (f.l.k == .Ident && f.l.name == "this"))) {
            this->err(line);
            eprintln("'{f.name}' is not const, so a const method cannot call it");
            return error.CompileFailed;
        }
        return this->call_method(md, recv, args, explicit, expected, line);
    }
    if (recv.ty.k == .Strct && !recv.ty.si.decl.is_union) {
        const auto idx = field_index(recv.ty.si, f.name);
        if (idx >= 0) {
            const auto fty = recv.ty.si.fields.get(idx).ty;
            if (fty.k == .Func || fty.k == .Closure) {
                const auto fp = this->gep_field(recv.ty, recv.v, idx)?;
                const auto fv = this->load(fty, fp)?;
                return this->call_indirect(fv, args, line);
            }
        }
    }
    this->err(line); eprintln("'{this->type_name(recv.ty)?}' has no method '{f.name}'");
    return error.CompileFailed;
}

!Value Gen::call_indirect(Value fv, List<Expr*> args, i64 line) {
    if (fv.ty.k != .Func && fv.ty.k != .Closure) { this->err(line); eprintln("'{this->type_name(fv.ty)?}' is not callable"); return error.CompileFailed };
    const auto sig = fv.ty;
    if (args.len != sig.params.len) { this->err(line); eprintln("function pointer expects {sig.params.len} argument(s), got {args.len}"); return error.CompileFailed; }
    auto target = fv.v;
    auto argtxt = this->sb();
    if (sig.k == .Closure) {
        target = this->extract(fv, 0, this->t_ptr_u8)?.v;
        sprint(&argtxt, "ptr {this->extract(fv, 1, this->t_ptr_u8)?.v}")?;
    }
    for (auto [i, x] : args) {
        const auto pt = sig.params.get(i);
        const auto v = this->coerce(this->gen_expr(x, pt)?, pt, x.line)?;
        if (argtxt.len > 0) { argtxt.append(", ")?; }
        sprint(&argtxt, "{this->llty(v.ty)?} {v.v}")?;
    }
    if (sig.ret.k == .Void) {
        sprint(this->ins()?, "  call void {target}({argtxt.slice()})\n")?;
        return Value{ .ty = this->t_void, .v = "" };
    }
    const auto t = this->tmp()?;
    sprint(this->ins()?, "  {t} = call {this->llty(sig.ret)?} {target}({argtxt.slice()})\n")?;
    return Value{ .ty = sig.ret, .v = t };
}

!Env Gen::recv_env(FnDecl* md, Type* t) {
    const auto env = this->new_env()?;
    env.put("Self", t)?;
    if (t.k == .Strct) {
        const auto args = t.si.args;
        if (md.receiver_params.len != args.len) { this->err(md.line); eprintln("out-of-class method of '{t.si.decl.name}' must list {args.len} type parameter(s)"); return error.CompileFailed; }
        for (auto [i, tp] : md.receiver_params) { env.put(tp, args.get(i))?; }
    }
    return env;
}

!Value Gen::call_method(FnDecl* md, Addr recv, List<Expr*> args, List<Type*> explicit, Type* expected, i64 line) {
    const auto env = this->recv_env(md, recv.ty)?;
    if (md.params.len == 0) { this->err(line); eprintln("'{md.name}' is a static method; call it as Type.{md.name}()"); return error.CompileFailed; }
    return this->call_decl(md, env, &recv, args, explicit, expected, line);
}

!void Gen::unify(TypeExpr* te, Type* actual, List<str> tps, Env env) {
    match te.k {
        .Name => {
            if (te.args.len == 0) {
                if (contains_str(tps, te.name) && !env.has(te.name)) { env.put(te.name, actual)?; }
                return;
            }
            if (actual.k == .Strct && actual.si.decl.name == te.name) {
                for (auto [i, x] : te.args) { if (i < actual.si.args.len) { this->unify(x, actual.si.args.get(i), tps, env)?; } }
            }
        }
        .Ptr => { if (actual.k == .Ptr) { this->unify(te.elem, actual.elem, tps, env)? } }
        .Slice => { if (actual.k == .Slice) { this->unify(te.elem, actual.elem, tps, env)? } }
        .Errun => { if (actual.k == .Errun) { this->unify(te.elem, actual.elem, tps, env)? } }
        .Array => { if (actual.k == .Array) { this->unify(te.elem, actual.elem, tps, env)? } }
        .Func => {
            if ((actual.k == .Func || actual.k == .Closure) && actual.params.len == te.args.len) {
                for (auto [i, x] : te.args) { this->unify(x, actual.params.get(i), tps, env)?; }
                if (te.ret != null) { this->unify(te.ret, actual.ret, tps, env)?; }
            }
        }
    }
}

!Value Gen::call_decl(FnDecl* decl, Env base_env, Addr* recv, List<Expr*> args, List<Type*> explicit, Type* expected, i64 line) {
    auto off = 0;
    if (recv != null) { off = 1; }
    const auto np = decl.params.len;
    if (np == 0) { return this->call_decl_core(decl, base_env, recv, args, explicit, expected, line); }
    const auto lt = decl.params.get(np - 1).ty;
    if (lt.k != .Name || lt.name != "Fmt" || lt.args.len != 0) { return this->call_decl_core(decl, base_env, recv, args, explicit, expected, line); }
    const auto nfixed = np - off - 1;
    if (args.len < nfixed) { this->err(line); eprintln("'{decl.name}' expects at least {nfixed} argument(s)"); return error.CompileFailed; }
    auto first = Value{ .ty = null, .v = "" };
    if (args.len == nfixed + 1 && args.get(nfixed).k != .Interp && args.get(nfixed).k != .StrLit) {
        first = this->gen_expr(args.get(nfixed), null)?;
        if (first.ty.k == .Strct && first.ty.si.decl.name == "Fmt") {
            auto na = List<Expr*>::init(this->a);
            for (auto i : 0..nfixed) { na.push(args.get(i))?; }
            na.push(this->mk_pre(first, line)?)?;
            return this->call_decl_core(decl, base_env, recv, na, explicit, expected, line);
        }
    }
    const auto fv = this->gen_fmt(args, nfixed, first)?;
    auto na = List<Expr*>::init(this->a);
    for (auto i : 0..nfixed) { na.push(args.get(i))?; }
    na.push(this->mk_pre(fv, line)?)?;
    return this->call_decl_core(decl, base_env, recv, na, explicit, expected, line);
}

!Value Gen::call_decl_core(FnDecl* decl, Env base_env, Addr* recv, List<Expr*> args, List<Type*> explicit, Type* expected, i64 line) {
    auto off = 0;
    if (recv != null) { off = 1; }
    if (!decl.variadic && args.len + off != decl.params.len) { this->err(line); eprintln("'{decl.name}' expects {decl.params.len - off} argument(s), got {args.len}"); return error.CompileFailed; }
    if (decl.variadic && args.len + off < decl.params.len) { this->err(line); eprintln("'{decl.name}' expects at least {decl.params.len - off} argument(s)"); return error.CompileFailed; }

    const auto env = this->copy_env(base_env)?;
    const auto tps = decl.type_params;
    if (explicit.len > 0) {
        if (explicit.len != tps.len) { this->err(line); eprintln("'{decl.name}' expects {tps.len} type argument(s)"); return error.CompileFailed; }
        for (auto [i, tp] : tps) { env.put(tp, explicit.get(i))?; }
    }

    auto vals = List<Value>::init(this->a);
    auto have = List<bool>::init(this->a);
    for (auto _i : 0..args.len) {
        vals.push(Value{ .ty = null, .v = "" })?;
        have.push(false)?;
    }
    // pass 1: non-literal args (to infer generics)
    for (auto [i, x] : args) {
        const auto pi = i + off;
        if (pi >= decl.params.len) { continue; }
        const auto pte = decl.params.get(pi).ty;
        const auto generic = te_mentions(pte, tps);
        if (generic && !all_bound(tps, env) && is_literal(x)) { continue; }
        Type* exp = null;
        if (!generic || all_bound(tps, env)) { exp = this->resolve_type(pte, env)?; }
        const auto v = this->gen_expr(x, exp)?;
        vals.set(i, v);
        have.set(i, true);
        if (generic) { this->unify(pte, v.ty, tps, env)?; }
    }
    // pass 2: literals, now with known types
    for (auto [i, x] : args) {
        if (have.get(i)) { continue; }
        const auto pi = i + off;
        if (pi >= decl.params.len) { continue; }
        const auto pte = decl.params.get(pi).ty;
        Type* exp = null;
        if (all_bound(tps, env)) { exp = this->resolve_type(pte, env)?; }
        const auto v = this->gen_expr(x, exp)?;
        vals.set(i, v);
        have.set(i, true);
        this->unify(pte, v.ty, tps, env)?;
    }
    if (recv != null) {
        const auto pte = decl.params.get(0).ty;
        if (pte.k == .Ptr) { this->unify(pte.elem, recv.ty, tps, env)? } else { this->unify(pte, recv.ty, tps, env)?; }
    }
    if (!all_bound(tps, env) && decl.ret != null && expected != null) { this->unify(decl.ret, expected, tps, env)?; }
    if (!all_bound(tps, env)) { this->err(line); eprintln("cannot infer type parameters of '{decl.name}'"); return error.CompileFailed; }

    auto targs = List<Type*>::init(this->a);
    for (auto tp : tps) { targs.push(env.get(tp)?)?; }
    this->check_constraints(decl.name, tps, decl.constraints, targs, line)?;
    const auto fi = this->inst_fn(decl, env, targs)?;

    auto argtxt = this->sb();
    if (recv != null) {
        const auto pt = fi.params.get(0);
        if (pt.k == .Ptr) {
            sprint(&argtxt, "ptr {recv.v}")?;
        } else {
            const auto rv = this->load(recv.ty, recv.v)?;
            const auto cv = this->coerce(rv, pt, line)?;
            sprint(&argtxt, "{this->llty(pt)?} {cv.v}")?;
        }
    }
    for (auto [i, x] : args) {
        const auto pi = i + off;
        if (!have.get(i)) {
            Type* exp = null;
            if (x.k == .StrLit) { exp = this->t_ptr_u8 };
            vals.set(i, this->gen_expr(x, exp)?);
        }
        auto v = vals.get(i);
        if (pi < fi.params.len) { v = this->coerce(v, fi.params.get(pi), x.line)?; } else { v = this->c_promote(v, x.line)?; }
        if (argtxt.len > 0) { argtxt.append(", ")?; }
        sprint(&argtxt, "{this->llty(v.ty)?} {v.v}")?;
    }

    auto fnty = this->llty(fi.ret)?;
    if (decl.variadic) {
        auto ft = this->sb();
        sprint(&ft, "{this->llty(fi.ret)?} (")?;
        for (auto [i, p] : fi.params) {
            if (i > 0) { ft.append(", ")?; }
            ft.append(this->llty(p)?)?;
        }
        if (fi.params.len > 0) { ft.append(", ...)")?; } else { ft.append("...)")?; }
        fnty = ft.slice();
    }
    if (fi.ret.k == .Void) {
        sprint(this->ins()?, "  call {fnty} @{fi.llname}({argtxt.slice()})\n")?;
        return Value{ .ty = this->t_void, .v = "" };
    }
    const auto t = this->tmp()?;
    sprint(this->ins()?, "  {t} = call {fnty} @{fi.llname}({argtxt.slice()})\n")?;
    return Value{ .ty = fi.ret, .v = t };
}

!Value Gen::c_promote(Value v, i64 line) {
    if (v.ty.k == .Int && v.ty.bits < 32) {
        if (v.ty.signed) { return this->cast(v, this->t_i32, line); }
        return this->cast(v, this->mk_int(32, false)?, line);
    }
    if (v.ty.k == .Bool) { return this->cast(v, this->t_i32, line) };
    if (v.ty.k == .Float && v.ty.bits == 32) { return this->cast(v, this->t_f64, line); }
    if (v.ty.k == .Slice) { this->err(line); eprintln("slices cannot be passed to C varargs; pass .ptr (and .len) explicitly"); return error.CompileFailed };
    if (v.ty.k == .Null) { return Value{ .ty = this->t_ptr_u8, .v = "null" } };
    return v;
}

/// a bare call `name(...)` inside a method means this->name(...) when the struct has such a method
/// and no free function of that name exists
!Expr* Gen::member_method(Expr* e) {
    if (this->cur == null || this->cur.decl.receiver.len == 0 || !this->has_var("this")) { return null; }
    const auto tv = this->lookup_var("this")?;
    auto t = tv.ty;
    if (t.k == .Ptr) { t = t.elem };
    if (t.k != .Strct) { return null; }
    auto kb = this->sb();
    sprint(&kb, "{recv_name(t)}.{e.name}")?;
    if (!this->methods.has(kb.slice())) { return null; }
    const auto th = this->a.create<Expr>()?;
    th.k = .Ident;
    th.name = "this";
    th.line = e.line;
    th.off = e.off;
    const auto f = this->a.create<Expr>()?;
    f.k = .Field;
    f.l = th;
    f.name = e.name;
    f.line = e.line;
    f.off = e.off;
    f.name_off = e.off;
    return f;
}
