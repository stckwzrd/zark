// Projects: zark.toml, dependencies and `zark new`.
//
//   [package]
//   name = "app"
//   main = "src/main.zk"        # what `zark run` / `zark build` compile (default src/main.zk)
//   lib = "src/lib.zk"          # what `import "app"` loads in a project that depends on this one
//
//   [build]
//   sources = ["c/fast.c"]        # C/C++ files compiled and linked in
//   libs = ["ssl"]                # linked as -lssl
//   flags = ["-O"]                # default flags, the command line adds to them
//   out = "build/app"             # where `zark build` writes the program
//
//   [dependencies]
//   utils = { path = "../utils" }
//   json5 = { git = "https://github.com/someone/json5.zk", rev = "v1.2" }
//
// A dependency is imported by its name: `import "utils" as u;` loads its lib file and
// `import "utils/strings" as us;` a file next to it (paths are relative to the lib file's directory). Git dependencies are cloned into
// .zark/deps/<name> the first time they are needed.

import "loader.zk";
import "std/fs" as fs;
import "std/path" as path;
import "std/os" as os;

enum TomlKind { Str, Int, Bool, Array, Table }

struct TomlValue {
    TomlKind kind;
    str s;
    i64 n;
    bool b;
    List<TomlValue*> items;
    List<TomlEntry> entries;
}

struct TomlEntry { str key; TomlValue* value; }

struct TomlParser {
    str src;
    i64 i;
    i64 line;
    str file;
    Allocator a;

    !void fail(str msg) {
        eprintln("{this->file}:{this->line}: error: {msg}");
        return error.CompileFailed;
    }

    void skip_ws() {
        while (this->i < this->src.len && (this->src[this->i] == ' ' || this->src[this->i] == '\t' || this->src[this->i] == '\r')) { this->i += 1; }
    }

    /// whitespace, newlines and comments (inside arrays and between lines)
    void skip_all() {
        while (this->i < this->src.len) {
            const auto c = this->src[this->i];
            if (c == '#') {
                while (this->i < this->src.len && this->src[this->i] != '\n') { this->i += 1; }
            } else if (c == '\n') {
                this->line += 1;
                this->i += 1;
            } else if (c == ' ' || c == '\t' || c == '\r') {
                this->i += 1;
            } else {
                return;
            }
        }
    }

    !str key() {
        this->skip_ws();
        if (this->i < this->src.len && this->src[this->i] == '"') { return this->string(); }
        const auto start = this->i;
        while (this->i < this->src.len) {
            const auto c = this->src[this->i];
            if (!is_alnum(c) && c != '_' && c != '-' && c != '.') { break; }
            this->i += 1;
        }
        if (this->i == start) { this->fail("expected a key")?; }
        return this->src[start..this->i];
    }

    !str string() {
        const auto q = this->src[this->i];
        this->i += 1;
        auto out = List<u8>::init(this->a);
        while (true) {
            if (this->i >= this->src.len || this->src[this->i] == '\n') { this->fail("unterminated string")?; }
            const auto c = this->src[this->i];
            this->i += 1;
            if (c == q) { break; }
            if (c == '\\' && q == '"' && this->i < this->src.len) {
                const auto e = this->src[this->i];
                this->i += 1;
                match e {
                    'n' => out.push('\n')?;
                    't' => out.push('\t')?;
                    '"' => out.push('"')?;
                    '\\' => out.push('\\')?;
                    _ => this->fail("unknown escape in string")?;
                }
                continue;
            }
            out.push(c)?;
        }
        return out.slice();
    }

    !TomlValue* make(TomlKind k) {
        const auto v = this->a.create<TomlValue>()?;
        v.kind = k;
        v.items = List<TomlValue*>::init(this->a);
        v.entries = List<TomlEntry>::init(this->a);
        return v;
    }

    !TomlValue* value() {
        this->skip_ws();
        if (this->i >= this->src.len) { this->fail("expected a value")?; }
        const auto c = this->src[this->i];
        if (c == '"' || c == '\'') {
            const auto v = this->make(.Str)?;
            v.s = this->string()?;
            return v;
        }
        if (c == '[') {
            this->i += 1;
            const auto v = this->make(.Array)?;
            while (true) {
                this->skip_all();
                if (this->i < this->src.len && this->src[this->i] == ']') { this->i += 1; break; }
                v.items.push(this->value()?)?;
                this->skip_all();
                if (this->i < this->src.len && this->src[this->i] == ',') { this->i += 1; continue; }
                if (this->i < this->src.len && this->src[this->i] == ']') { this->i += 1; break; }
                this->fail("expected ',' or ']'")?;
            }
            return v;
        }
        if (c == '{') {
            this->i += 1;
            const auto v = this->make(.Table)?;
            while (true) {
                this->skip_ws();
                if (this->i < this->src.len && this->src[this->i] == '}') { this->i += 1; break; }
                const auto k = this->key()?;
                this->skip_ws();
                if (this->i >= this->src.len || this->src[this->i] != '=') { this->fail("expected '='")?; }
                this->i += 1;
                v.entries.push(TomlEntry{ .key = k, .value = this->value()? })?;
                this->skip_ws();
                if (this->i < this->src.len && this->src[this->i] == ',') { this->i += 1; continue; }
                if (this->i < this->src.len && this->src[this->i] == '}') { this->i += 1; break; }
                this->fail("expected ',' or '}'")?;
            }
            return v;
        }
        if (this->src[this->i..].len >= 4 && str_starts_with(this->src[this->i..], "true")) {
            this->i += 4;
            const auto v = this->make(.Bool)?;
            v.b = true;
            return v;
        }
        if (str_starts_with(this->src[this->i..], "false")) {
            this->i += 5;
            return this->make(.Bool);
        }
        const auto start = this->i;
        while (this->i < this->src.len && (is_digit(this->src[this->i]) || this->src[this->i] == '-' || this->src[this->i] == '_')) { this->i += 1; }
        if (this->i == start) { this->fail("expected a value")?; }
        const auto v = this->make(.Int)?;
        v.n = parse_int(this->src[start..this->i]) catch { this->fail("bad number")?; 0 };
        return v;
    }

    /// the whole file as one table whose entries are named "section.key"
    !TomlValue* document() {
        const auto doc = this->make(.Table)?;
        auto section = "";
        while (true) {
            this->skip_all();
            if (this->i >= this->src.len) { return doc; }
            if (this->src[this->i] == '[') {
                this->i += 1;
                section = this->key()?;
                this->skip_ws();
                if (this->i >= this->src.len || this->src[this->i] != ']') { this->fail("expected ']'")?; }
                this->i += 1;
                continue;
            }
            const auto k = this->key()?;
            this->skip_ws();
            if (this->i >= this->src.len || this->src[this->i] != '=') { this->fail("expected '=' after the key")?; }
            this->i += 1;
            const auto v = this->value()?;
            auto full = List<u8>::init(this->a);
            if (section.len > 0) { sprint(&full, "{section}.{k}")?; } else { full.append(k)?; }
            doc.entries.push(TomlEntry{ .key = full.slice(), .value = v })?;
            this->skip_ws();
            if (this->i < this->src.len && this->src[this->i] == '#') { continue; }
            if (this->i < this->src.len && this->src[this->i] != '\n') { this->fail("expected the end of the line")?; }
        }
        return doc;
    }
}

TomlValue* toml_get(TomlValue* t, str key) {
    for (auto e : t.entries) { if (e.key == key) { return e.value; } }
    return null;
}

!str toml_str(TomlValue* t, str key, str d, str file) {
    const auto v = toml_get(t, key);
    if (v == null) { return d; }
    if (!(v.kind is .Str)) {
        eprintln("{file}: error: '{key}' must be a string");
        return error.CompileFailed;
    }
    return v.s;
}

!void toml_strs(TomlValue* t, str key, List<str>* out, str file) {
    const auto v = toml_get(t, key);
    if (v == null) { return; }
    if (!(v.kind is .Array)) {
        eprintln("{file}: error: '{key}' must be a list of strings");
        return error.CompileFailed;
    }
    for (auto x : v.items) {
        if (!(x.kind is .Str)) {
            eprintln("{file}: error: '{key}' must be a list of strings");
            return error.CompileFailed;
        }
        out.push(x.s)?;
    }
}

struct Manifest {
    str dir;           // absolute
    str manifest;
    str name;
    str main;          // absolute
    str lib;           // absolute
    str out;
    List<str> sources; // absolute
    List<str> libs;
    List<str> flags;
    List<str> cflags;
    List<str> pkgs;
    List<str> lib_dirs; // absolute
}

/// the directory with a zark.toml, searching upward from `start`; "" when there is none
!str find_project(Allocator a, str start) {
    auto dir = path::absolute(a, start) catch { return ""; };
    while (true) {
        const auto m = path::join(a, [dir, "zark.toml"])?;
        if (fs::is_file(m)) { return dir; }
        if (dir == "/") { return ""; }
        dir = path::dir(dir);
    }
    return "";
}

!Manifest* load_project(Allocator a, str dir, bool fetch, i64 depth) {
    if (depth > 16) {
        eprintln("error: dependencies nest more than 16 levels (a cycle?)");
        return error.CompileFailed;
    }
    const auto manifest = path::join(a, [dir, "zark.toml"])?;
    const auto src = read_file(a, manifest) catch |e| {
        eprintln("error: cannot read '{manifest}': {e}");
        return error.CompileFailed;
    };
    auto tp = TomlParser{ .src = src, .line = 1, .file = manifest, .a = a };
    const auto doc = tp.document()?;
    const auto p = a.create<Manifest>()?;
    p.dir = dir;
    p.manifest = manifest;
    p.sources = List<str>::init(a);
    p.libs = List<str>::init(a);
    p.flags = List<str>::init(a);
    p.cflags = List<str>::init(a);
    p.pkgs = List<str>::init(a);
    p.lib_dirs = List<str>::init(a);
    p.name = toml_str(doc, "package.name", path::base(dir), manifest)?;
    p.main = path::join(a, [dir, toml_str(doc, "package.main", "src/main.zk", manifest)?])?;
    p.lib = path::join(a, [dir, toml_str(doc, "package.lib", "src/lib.zk", manifest)?])?;
    if (!fs::is_file(p.lib)) { p.lib = p.main; }
    const auto out = toml_str(doc, "build.out", "", manifest)?;
    if (out.len > 0) { p.out = path::join(a, [dir, out])?; }
    auto srcs = List<str>::init(a);
    toml_strs(doc, "build.sources", &srcs, manifest)?;
    for (auto s : srcs) { p.sources.push(path::join(a, [dir, s])?)?; }
    toml_strs(doc, "build.libs", &p.libs, manifest)?;
    toml_strs(doc, "build.flags", &p.flags, manifest)?;
    auto incs = List<str>::init(a);
    toml_strs(doc, "build.include", &incs, manifest)?;
    for (auto i : incs) {
        auto b = List<u8>::init(a);
        sprint(&b, "-I{path::join(a, [dir, i])?}")?;
        p.cflags.push(b.slice())?;
    }
    auto defs = List<str>::init(a);
    toml_strs(doc, "build.defines", &defs, manifest)?;
    for (auto d : defs) {
        auto b = List<u8>::init(a);
        sprint(&b, "-D{d}")?;
        p.cflags.push(b.slice())?;
    }
    const auto std_name = toml_str(doc, "build.std", "", manifest)?;
    if (std_name.len > 0) {
        auto b = List<u8>::init(a);
        sprint(&b, "-std={std_name}")?;
        p.cflags.push(b.slice())?;
    }
    toml_strs(doc, "build.cflags", &p.cflags, manifest)?;
    toml_strs(doc, "build.pkg-config", &p.pkgs, manifest)?;
    auto ldirs = List<str>::init(a);
    toml_strs(doc, "build.lib-dirs", &ldirs, manifest)?;
    for (auto d : ldirs) { p.lib_dirs.push(path::join(a, [dir, d])?)?; }
    for (auto e : doc.entries) {
        if (!str_starts_with(e.key, "dependencies.")) { continue; }
        const auto name = e.key[13..];
        const auto spec = e.value;
        auto ddir = "";
        if (spec.kind is .Str) {
            ddir = path::join(a, [dir, spec.s])?;
        } else if (spec.kind is .Table) {
            const auto local = toml_str(spec, "path", "", manifest)?;
            const auto git = toml_str(spec, "git", "", manifest)?;
            const auto rev = toml_str(spec, "rev", "", manifest)?;
            if (local.len > 0) {
                ddir = path::join(a, [dir, local])?;
            } else if (git.len > 0) {
                ddir = path::join(a, [dir, ".zark/deps", name])?;
                if (!fs::is_dir(ddir) && fetch) { fetch_git(a, name, git, rev, ddir)?; }
            } else {
                eprintln("{manifest}: error: dependency '{name}' needs `path` or `git`");
                return error.CompileFailed;
            }
        } else {
            eprintln("{manifest}: error: dependency '{name}' must be a table like {{ path = \"../x\" }");
            return error.CompileFailed;
        }
        if (!fs::is_dir(ddir)) {
            if (!fetch) { continue; }
            eprintln("{manifest}: error: dependency '{name}' not found at {ddir}");
            return error.CompileFailed;
        }
        if (fs::is_file(path::join(a, [ddir, "zark.toml"])?)) {
            const auto sub = load_project(a, ddir, fetch, depth + 1)?;
            register_dep(name, path::dir(sub.lib), sub.lib)?;
            for (auto s : sub.sources) { p.sources.push(s)?; }
            for (auto l : sub.libs) { p.libs.push(l)?; }
            for (auto c : sub.cflags) { p.cflags.push(c)?; }
            for (auto k : sub.pkgs) { p.pkgs.push(k)?; }
            for (auto d : sub.lib_dirs) { p.lib_dirs.push(d)?; }
        } else {
            auto lib = path::join(a, [ddir, "src/lib.zk"])?;
            if (!fs::is_file(lib)) { lib = path::join(a, [ddir, "lib.zk"])?; }
            register_dep(name, path::dir(lib), lib)?;
        }
    }
    return p;
}

!void fetch_git(Allocator a, str name, str url, str rev, str dir) {
    eprintln("fetching {name} from {url}");
    fs::make_dirs(path::dir(dir))?;
    auto argv = List<str>::init(a);
    argv.append(["git", "-c", "advice.detachedHead=false", "clone", "--quiet", "--depth", "1"])?;
    if (rev.len > 0) { argv.append(["--branch", rev])?; }
    argv.append([url, dir])?;
    const auto code = run(a, argv.slice())?;
    if (code != 0) {
        eprintln("error: could not clone {url}");
        return error.CompileFailed;
    }
}

!void pkg_flags(Allocator a, str pkg, List<str>* out) {
    const auto r = os::exec(a, ["pkg-config", "--cflags", "--libs", pkg]) catch |e| {
        if (e == error.ProgramNotFound) {
            eprintln("error: pkg-config is not installed (needed for '{pkg}')");
            return error.CompileFailed;
        }
        return e;
    };
    if (r.code != 0) {
        eprintln("error: pkg-config could not find package '{pkg}'");
        return error.CompileFailed;
    }
    auto it = str_fields(r.out);
    while (it.next()) { out.push(it.part)?; }
}

/// what a project adds to the command line for its C/C++ side: sources, libs, compile flags,
/// pkg-config results, library directories
!List<str> project_c_args(Allocator a, Manifest* p) {
    auto out = List<str>::init(a);
    for (auto s : p.sources) { out.push(s)?; }
    for (auto l : p.libs) {
        auto b = List<u8>::init(a);
        sprint(&b, "-l{l}")?;
        out.push(b.slice())?;
    }
    for (auto c : p.cflags) { out.push(c)?; }
    for (auto k : p.pkgs) { pkg_flags(a, k, &out)?; }
    for (auto d : p.lib_dirs) {
        auto b = List<u8>::init(a);
        sprint(&b, "-L{d}")?;
        out.push(b.slice())?;
    }
    return out;
}

/// the arguments `zark run/build/test` gets in a project: main file, sources, libs, flags,
/// then what was typed
!List<str> project_args(Allocator a, Manifest* p, str cmd, List<str> typed) {
    auto out = List<str>::init(a);
    out.push(p.main)?;
    out.append(project_c_args(a, p)?.slice())?;
    for (auto f : p.flags) { out.push(f)?; }
    auto has_o = false;
    for (auto t : typed) { if (t == "-o") { has_o = true; } }
    if (cmd == "build" && !has_o) {
        out.push("-o")?;
        if (p.out.len > 0) {
            fs::make_dirs(path::dir(p.out))?;
            out.push(p.out)?;
        } else {
            const auto bdir = path::join(a, [p.dir, "build"])?;
            fs::make_dirs(bdir)?;
            out.push(path::join(a, [bdir, p.name])?)?;
        }
    }
    out.append(typed.slice())?;
    return out;
}

/// `zark new NAME`: a project skeleton
!i32 scaffold_project(Allocator a, str name) {
    if (name.len == 0 || fs::exists(name)) {
        eprintln("error: '{name}' already exists");
        return 1;
    }
    fs::make_dirs(path::join(a, [name, "src"])?)?;
    auto t = List<u8>::init(a);
    sprint(&t, "[package]\nname = \"{path::base(name)}\"\nversion = \"0.1.0\"\nmain = \"src/main.zk\"\n\n[build]\n# sources = [\"c/helper.c\"]\n# libs = [\"m\"]\n# flags = [\"-O\"]\n\n[dependencies]\n# utils = {{ path = \"../utils\" }\n")?;
    write_file(path::join(a, [name, "zark.toml"])?, t.slice())?;
    write_file(path::join(a, [name, "src/main.zk"])?, "import \"std/args\" as args;\n\n!void main() {{\n    auto p = args::Parser::init(c_allocator(), \"app\", \"A new Zark program.\");\n    defer p.deinit();\n    p.option(\"name\", 'n', \"who to greet\", \"world\")?;\n    p.parse() catch |e| {{\n        if (e == error.Help) {{ return; }\n        return e;\n    };\n    println(\"Hello, {{p.get(\"name\")}!\");\n}\n\ntest \"greeting\" {{\n    assert(1 + 1 == 2);\n}\n")?;
    write_file(path::join(a, [name, ".gitignore"])?, ".zark-cache/\n.zark/\nbuild/\n")?;
    println("created {name}: cd {name} && zark run");
    return 0;
}

/// the files whose test blocks `zark test` runs in a project: main, lib and tests/*.zk
!List<str> project_test_files(Allocator a, Manifest* p) {
    auto out = List<str>::init(a);
    out.push(p.main)?;
    if (p.lib != p.main) { out.push(p.lib)?; }
    const auto tdir = path::join(a, [p.dir, "tests"])?;
    if (fs::is_dir(tdir)) {
        auto files = fs::walk(a, tdir)?;
        for (auto f : files.slice()) {
            if (str_ends_with(f, ".zk")) { out.push(path::join(a, [tdir, f])?)?; }
        }
    }
    return out;
}

/// in an editor: register the dependencies of the project that contains `file`
void project_setup_for(Allocator a, str file) {
    const auto dir = find_project(a, path::dir(file)) catch "";
    if (dir.len == 0) { return; }
    _ = load_project(a, dir, false, 0) catch null;
}
