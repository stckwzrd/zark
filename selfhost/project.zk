// Projects: zark.toml, dependencies and `zark new`.
//
//   [package]
//   name = "app"
//   main = "src/main.zk"        # what `zark run` / `zark build` compile (default src/main.zk)
//   lib = "src/lib.zk"          # what `import "app"` loads in a project that depends on this one
//
//   [build]
//   sources = ["c/fast.c"]        # C/C++ files compiled and linked in
//   libs = ["ssl"]                # linked as -lssl
//   flags = ["-O"]                # default flags, the command line adds to them
//   out = "build/app"             # where `zark build` writes the program
//
//   [dependencies]
//   utils = { path = "../utils" }
//   json5 = { git = "https://github.com/someone/json5.zk", rev = "v1.2" }
//
// A dependency is imported by its name: `import "utils" as u;` loads its lib file and
// `import "utils/strings" as us;` a file next to it (paths are relative to the lib file's directory). Git dependencies are cloned into
// .zark/deps/<name> the first time they are needed.

import "loader.zk";
import "std/fs" as fs;
import "std/path" as path;
import "std/os" as os;

enum TomlKind { Str, Int, Bool, Array, Table }

struct TomlValue {
    TomlKind kind;
    str s;
    i64 n;
    bool b;
    List<TomlValue*> items;
    List<TomlEntry> entries;
}

struct TomlEntry { str key; TomlValue* value; }

struct TomlParser {
    str src;
    i64 i;
    i64 line;
    str file;
    Allocator a;

    !void fail(str msg) {
        eprintln("{this->file}:{this->line}: error: {msg}");
        return error.CompileFailed;
    }

    void skip_ws() {
        while (this->i < this->src.len && (this->src[this->i] == ' ' || this->src[this->i] == '\t' || this->src[this->i] == '\r')) { this->i += 1; }
    }

    /// whitespace, newlines and comments (inside arrays and between lines)
    void skip_all() {
        while (this->i < this->src.len) {
            const auto c = this->src[this->i];
            if (c == '#') {
                while (this->i < this->src.len && this->src[this->i] != '\n') { this->i += 1; }
            } else if (c == '\n') {
                this->line += 1;
                this->i += 1;
            } else if (c == ' ' || c == '\t' || c == '\r') {
                this->i += 1;
            } else {
                return;
            }
        }
    }

    !str key() {
        this->skip_ws();
        if (this->i < this->src.len && this->src[this->i] == '"') { return this->string(); }
        const auto start = this->i;
        while (this->i < this->src.len) {
            const auto c = this->src[this->i];
            if (!is_alnum(c) && c != '_' && c != '-' && c != '.') { break; }
            this->i += 1;
        }
        if (this->i == start) { this->fail("expected a key")?; }
        return this->src[start..this->i];
    }

    !str string() {
        const auto q = this->src[this->i];
        this->i += 1;
        auto out = List<u8>::init(this->a);
        while (true) {
            if (this->i >= this->src.len || this->src[this->i] == '\n') { this->fail("unterminated string")?; }
            const auto c = this->src[this->i];
            this->i += 1;
            if (c == q) { break; }
            if (c == '\\' && q == '"' && this->i < this->src.len) {
                const auto e = this->src[this->i];
                this->i += 1;
                match e {
                    'n' => out.push('\n')?;
                    't' => out.push('\t')?;
                    '"' => out.push('"')?;
                    '\\' => out.push('\\')?;
                    _ => this->fail("unknown escape in string")?;
                }
                continue;
            }
            out.push(c)?;
        }
        return out.slice();
    }

    !TomlValue* make(TomlKind k) {
        const auto v = this->a.create<TomlValue>()?;
        v.kind = k;
        v.items = List<TomlValue*>::init(this->a);
        v.entries = List<TomlEntry>::init(this->a);
        return v;
    }

    !TomlValue* value() {
        this->skip_ws();
        if (this->i >= this->src.len) { this->fail("expected a value")?; }
        const auto c = this->src[this->i];
        if (c == '"' || c == '\'') {
            const auto v = this->make(.Str)?;
            v.s = this->string()?;
            return v;
        }
        if (c == '[') {
            this->i += 1;
            const auto v = this->make(.Array)?;
            while (true) {
                this->skip_all();
                if (this->i < this->src.len && this->src[this->i] == ']') { this->i += 1; break; }
                v.items.push(this->value()?)?;
                this->skip_all();
                if (this->i < this->src.len && this->src[this->i] == ',') { this->i += 1; continue; }
                if (this->i < this->src.len && this->src[this->i] == ']') { this->i += 1; break; }
                this->fail("expected ',' or ']'")?;
            }
            return v;
        }
        if (c == '{') {
            this->i += 1;
            const auto v = this->make(.Table)?;
            while (true) {
                this->skip_ws();
                if (this->i < this->src.len && this->src[this->i] == '}') { this->i += 1; break; }
                const auto k = this->key()?;
                this->skip_ws();
                if (this->i >= this->src.len || this->src[this->i] != '=') { this->fail("expected '='")?; }
                this->i += 1;
                v.entries.push(TomlEntry{ .key = k, .value = this->value()? })?;
                this->skip_ws();
                if (this->i < this->src.len && this->src[this->i] == ',') { this->i += 1; continue; }
                if (this->i < this->src.len && this->src[this->i] == '}') { this->i += 1; break; }
                this->fail("expected ',' or '}'")?;
            }
            return v;
        }
        if (this->src[this->i..].len >= 4 && str_starts_with(this->src[this->i..], "true")) {
            this->i += 4;
            const auto v = this->make(.Bool)?;
            v.b = true;
            return v;
        }
        if (str_starts_with(this->src[this->i..], "false")) {
            this->i += 5;
            return this->make(.Bool);
        }
        const auto start = this->i;
        while (this->i < this->src.len && (is_digit(this->src[this->i]) || this->src[this->i] == '-' || this->src[this->i] == '_')) { this->i += 1; }
        if (this->i == start) { this->fail("expected a value")?; }
        const auto v = this->make(.Int)?;
        v.n = parse_int(this->src[start..this->i]) catch { this->fail("bad number")?; 0 };
        return v;
    }

    /// the whole file as one table whose entries are named "section.key"
    !TomlValue* document() {
        const auto doc = this->make(.Table)?;
        auto section = "";
        while (true) {
            this->skip_all();
            if (this->i >= this->src.len) { return doc; }
            if (this->src[this->i] == '[') {
                this->i += 1;
                section = this->key()?;
                this->skip_ws();
                if (this->i >= this->src.len || this->src[this->i] != ']') { this->fail("expected ']'")?; }
                this->i += 1;
                continue;
            }
            const auto k = this->key()?;
            this->skip_ws();
            if (this->i >= this->src.len || this->src[this->i] != '=') { this->fail("expected '=' after the key")?; }
            this->i += 1;
            const auto v = this->value()?;
            auto full = List<u8>::init(this->a);
            if (section.len > 0) { sprint(&full, "{section}.{k}")?; } else { full.append(k)?; }
            doc.entries.push(TomlEntry{ .key = full.slice(), .value = v })?;
            this->skip_ws();
            if (this->i < this->src.len && this->src[this->i] == '#') { continue; }
            if (this->i < this->src.len && this->src[this->i] != '\n') { this->fail("expected the end of the line")?; }
        }
        return doc;
    }
}

TomlValue* toml_get(TomlValue* t, str key) {
    for (auto e : t.entries) { if (e.key == key) { return e.value; } }
    return null;
}

!str toml_str(TomlValue* t, str key, str d, str file) {
    const auto v = toml_get(t, key);
    if (v == null) { return d; }
    if (!(v.kind is .Str)) {
        eprintln("{file}: error: '{key}' must be a string");
        return error.CompileFailed;
    }
    return v.s;
}

!void toml_strs(TomlValue* t, str key, List<str>* out, str file) {
    const auto v = toml_get(t, key);
    if (v == null) { return; }
    if (!(v.kind is .Array)) {
        eprintln("{file}: error: '{key}' must be a list of strings");
        return error.CompileFailed;
    }
    for (auto x : v.items) {
        if (!(x.kind is .Str)) {
            eprintln("{file}: error: '{key}' must be a list of strings");
            return error.CompileFailed;
        }
        out.push(x.s)?;
    }
}

struct Manifest {
    str dir;           // absolute
    str manifest;
    str name;
    str main;          // absolute
    str lib;           // absolute
    str out;
    List<str> sources; // absolute
    List<str> libs;
    List<str> flags;
    List<str> cflags;
    List<str> pkgs;
    List<str> lib_dirs;
    List<str> by_value;
}

/// the directory with a zark.toml, searching upward from `start`; "" when there is none
!str find_project(Allocator a, str start) {
    auto dir = path::absolute(a, start) catch { return ""; };
    while (true) {
        const auto m = path::join(a, [dir, "zark.toml"])?;
        if (fs::is_file(m)) { return dir; }
        if (dir == "/") { return ""; }
        dir = path::dir(dir);
    }
    return "";
}

!Manifest* load_project(Allocator a, str dir, bool fetch, i64 depth, PkgState* st) {
    if (depth > 16) {
        eprintln("error: dependencies nest more than 16 levels (a cycle?)");
        return error.CompileFailed;
    }
    const auto manifest = path::join(a, [dir, "zark.toml"])?;
    const auto src = read_file(a, manifest) catch |e| {
        eprintln("error: cannot read '{manifest}': {e}");
        return error.CompileFailed;
    };
    auto tp = TomlParser{ .src = src, .line = 1, .file = manifest, .a = a };
    const auto doc = tp.document()?;
    const auto p = a.create<Manifest>()?;
    p.dir = dir;
    p.manifest = manifest;
    p.sources = List<str>::init(a);
    p.libs = List<str>::init(a);
    p.flags = List<str>::init(a);
    p.cflags = List<str>::init(a);
    p.pkgs = List<str>::init(a);
    p.lib_dirs = List<str>::init(a);
    p.by_value = List<str>::init(a);
    p.name = toml_str(doc, "package.name", path::base(dir), manifest)?;
    p.main = path::join(a, [dir, toml_str(doc, "package.main", "src/main.zk", manifest)?])?;
    p.lib = path::join(a, [dir, toml_str(doc, "package.lib", "src/lib.zk", manifest)?])?;
    if (!fs::is_file(p.lib)) { p.lib = p.main; }
    const auto out = toml_str(doc, "build.out", "", manifest)?;
    if (out.len > 0) { p.out = path::join(a, [dir, out])?; }
    auto srcs = List<str>::init(a);
    toml_strs(doc, "build.sources", &srcs, manifest)?;
    for (auto s : srcs) { p.sources.push(path::join(a, [dir, s])?)?; }
    toml_strs(doc, "build.libs", &p.libs, manifest)?;
    toml_strs(doc, "build.flags", &p.flags, manifest)?;
    auto incs = List<str>::init(a);
    toml_strs(doc, "build.include", &incs, manifest)?;
    for (auto i : incs) {
        auto b = List<u8>::init(a);
        sprint(&b, "-I{path::join(a, [dir, i])?}")?;
        p.cflags.push(b.slice())?;
    }
    auto defs = List<str>::init(a);
    toml_strs(doc, "build.defines", &defs, manifest)?;
    for (auto d : defs) {
        auto b = List<u8>::init(a);
        sprint(&b, "-D{d}")?;
        p.cflags.push(b.slice())?;
    }
    const auto std_name = toml_str(doc, "build.std", "", manifest)?;
    if (std_name.len > 0) {
        auto b = List<u8>::init(a);
        sprint(&b, "-std={std_name}")?;
        p.cflags.push(b.slice())?;
    }
    toml_strs(doc, "build.cflags", &p.cflags, manifest)?;
    toml_strs(doc, "build.pkg-config", &p.pkgs, manifest)?;
    toml_strs(doc, "build.by_value", &p.by_value, manifest)?;
    auto ldirs = List<str>::init(a);
    toml_strs(doc, "build.lib-dirs", &ldirs, manifest)?;
    for (auto d : ldirs) { p.lib_dirs.push(path::join(a, [dir, d])?)?; }
    for (auto e : doc.entries) {
        if (!str_starts_with(e.key, "dependencies.")) { continue; }
        const auto name = e.key[13..];
        const auto spec = e.value;
        auto ddir = "";
        if (spec.kind is .Str) {
            ddir = path::join(a, [dir, spec.s])?;
        } else if (spec.kind is .Table) {
            const auto local = toml_str(spec, "path", "", manifest)?;
            const auto git = toml_str(spec, "git", "", manifest)?;
            const auto rev = toml_str(spec, "rev", "", manifest)?;
            if (local.len > 0) {
                ddir = path::join(a, [dir, local])?;
            } else if (git.len > 0) {
                ddir = path::join(a, [dir, ".zark/deps", name])?;
                if (st != null && st.updating) {
                    if (fetch) {
                        if (st.resolved.has(name)) {
                            const auto prior = st.resolved.get(name) catch "";
                            if (prior != rev) {
                                eprintln("{manifest}: error: dependency '{name}' requests two revisions ('{prior}' and '{rev}'); pin one rev");
                                return error.CompileFailed;
                            }
                            const auto li = lock_index(st.lock.slice(), name);
                            if (li >= 0) { _ = ensure_dep(a, name, git, rev, st.lock.items[li].commit, ddir)?; }
                        } else {
                            const auto commit = resolve_dep(a, name, git, rev, ddir)?;
                            st.resolved.put(name, rev)?;
                            auto li = lock_index(st.lock.slice(), name);
                            if (li < 0) {
                                st.lock.push(LockPkg{ .name = name, .url = git, .rev = rev, .commit = commit })?;
                            } else {
                                const auto lp = &st.lock.items[li];
                                lp.url = git;
                                lp.rev = rev;
                                lp.commit = commit;
                            }
                        }
                    }
                } else if (st != null && st.locked) {
                    const auto li = lock_index(st.lock.slice(), name);
                    if (li < 0) {
                        eprintln("{manifest}: error: dependency '{name}' is not in zark.lock; run `zark update {name}`");
                        return error.CompileFailed;
                    }
                    const auto lp = &st.lock.items[li];
                    if (lp.rev != rev) {
                        eprintln("{manifest}: error: dependency '{name}' requests '{rev}', zark.lock pins '{lp.rev}'; run `zark update {name}`");
                        return error.CompileFailed;
                    }
                    if (fetch) { _ = ensure_dep(a, name, git, rev, lp.commit, ddir)?; }
                } else if (!fs::is_dir(ddir) && fetch) {
                    fetch_git(a, name, git, rev, ddir)?;
                }
            } else {
                eprintln("{manifest}: error: dependency '{name}' needs `path` or `git`");
                return error.CompileFailed;
            }
        } else {
            eprintln("{manifest}: error: dependency '{name}' must be a table like {{ path = \"../x\" }");
            return error.CompileFailed;
        }
        if (!fs::is_dir(ddir)) {
            if (!fetch) { continue; }
            eprintln("{manifest}: error: dependency '{name}' not found at {ddir}");
            return error.CompileFailed;
        }
        if (fs::is_file(path::join(a, [ddir, "zark.toml"])?)) {
            const auto sub = load_project(a, ddir, fetch, depth + 1, st)?;
            register_dep(name, path::dir(sub.lib), sub.lib)?;
            for (auto s : sub.sources) { p.sources.push(s)?; }
            for (auto l : sub.libs) { p.libs.push(l)?; }
            for (auto c : sub.cflags) { p.cflags.push(c)?; }
            for (auto k : sub.pkgs) { p.pkgs.push(k)?; }
            for (auto d : sub.lib_dirs) { p.lib_dirs.push(d)?; }
            for (auto v : sub.by_value) { p.by_value.push(v)?; }
        } else {
            auto lib = path::join(a, [ddir, "src/lib.zk"])?;
            if (!fs::is_file(lib)) { lib = path::join(a, [ddir, "lib.zk"])?; }
            register_dep(name, path::dir(lib), lib)?;
        }
    }
    return p;
}

!void fetch_git(Allocator a, str name, str url, str rev, str dir) {
    eprintln("fetching {name} from {url}");
    fs::make_dirs(path::dir(dir))?;
    auto argv = List<str>::init(a);
    argv.append(["git", "-c", "advice.detachedHead=false", "clone", "--quiet", "--depth", "1"])?;
    if (rev.len > 0) { argv.append(["--branch", rev])?; }
    argv.append([url, dir])?;
    const auto code = run(a, argv.slice())?;
    if (code != 0) {
        eprintln("error: could not clone {url}");
        return error.CompileFailed;
    }
}

struct LockPkg { str name; str url; str rev; str commit; }

i64 lock_index(LockPkg[] l, str name) {
    for (auto [i, p] : l) { if (p.name == name) { return i; } }
    return -1;
}

/// reads `zark.lock`; empty when there is none
!List<LockPkg> read_lock(Allocator a, str dir) {
    auto out = List<LockPkg>::init(a);
    const auto lp = path::join(a, [dir, "zark.lock"])?;
    if (!fs::is_file(lp)) { return out; }
    const auto src = read_file(a, lp) catch |e| {
        eprintln("error: cannot read '{lp}': {e}");
        return error.CompileFailed;
    };
    auto tp = TomlParser{ .src = src, .line = 1, .file = lp, .a = a };
    const auto doc = tp.document()?;
    for (auto e : doc.entries) {
        if (!str_starts_with(e.key, "package.")) { continue; }
        if (!(e.value.kind is .Str)) { continue; }
        const auto rest = e.key[8..];
        const auto dot = str_rfind(rest, ".");
        if (dot <= 0) { continue; }
        const auto name = rest[0..dot];
        const auto field = rest[dot + 1..];
        auto i = lock_index(out.slice(), name);
        if (i < 0) {
            out.push(LockPkg{ .name = name, .url = "", .rev = "", .commit = "" })?;
            i = out.len - 1;
        }
        const auto p = &out.items[i];
        if (field == "url") { p.url = e.value.s; }
        else if (field == "rev") { p.rev = e.value.s; }
        else if (field == "commit") { p.commit = e.value.s; }
    }
    return out;
}

!void write_lock(Allocator a, str dir, LockPkg[] pkgs) {
    auto b = List<u8>::init(a);
    b.append("# zark.lock: generated by `zark update`, do not edit\n")?;
    for (auto p : pkgs) {
        if (p.url.len == 0) { continue; }
        sprint(&b, "\n[package.{p.name}]\nurl = \"{p.url}\"\nrev = \"{p.rev}\"\ncommit = \"{p.commit}\"\n")?;
    }
    write_file(path::join(a, [dir, "zark.lock"])?, b.slice())?;
}

/// the trimmed stdout of a command, or "" when it failed
!str git_out(Allocator a, str[] argv) {
    auto r = os::exec(a, argv)?;
    defer r.deinit();
    if (r.code != 0) { return ""; }
    return a.dup(str_trim(r.out))?;
}

bool looks_like_sha(str s) {
    if (s.len != 40) { return false; }
    for (auto c : s) { if (!is_hex(c)) { return false; } }
    return true;
}

str clip12(str s) {
    if (s.len > 12) { return s[0..12]; }
    return s;
}

/// checks out `commit` (when given) or `rev` in `dir`, fetching as needed; returns HEAD
!str ensure_dep(Allocator a, str name, str url, str rev, str commit, str dir) {
    const auto dotgit = path::join(a, [dir, ".git"])?;
    if (!fs::is_dir(dotgit) && !fs::is_file(dotgit)) {
        if (fs::is_dir(dir)) { return ""; }
        fs::make_dirs(dir)?;
        if (run(a, ["git", "-C", dir, "init", "--quiet"])? != 0) {
            eprintln("error: dependency '{name}': git init failed");
            return error.CompileFailed;
        }
        if (run(a, ["git", "-C", dir, "remote", "add", "origin", url])? != 0) {
            eprintln("error: dependency '{name}': git remote add failed");
            return error.CompileFailed;
        }
    }
    auto target = commit;
    if (target.len == 0) { target = rev; }
    if (target.len > 0) {
        if (run(a, ["git", "-C", dir, "fetch", "--quiet", "--depth", "1", "origin", target])? != 0) {
            _ = run(a, ["git", "-C", dir, "fetch", "--quiet", "origin"])?;
        }
    } else {
        _ = run(a, ["git", "-C", dir, "fetch", "--quiet", "--depth", "1", "origin"])?;
    }
    if (target.len > 0) {
        if (run(a, ["git", "-C", dir, "checkout", "--quiet", "--force", "--detach", target])? != 0) {
            if (run(a, ["git", "-C", dir, "checkout", "--quiet", "--force", "--detach", "FETCH_HEAD"])? != 0) {
                eprintln("error: dependency '{name}': cannot check out {target}");
                return error.CompileFailed;
            }
        }
    } else {
        if (run(a, ["git", "-C", dir, "checkout", "--quiet", "--force", "--detach", "FETCH_HEAD"])? != 0) {
            eprintln("error: dependency '{name}': cannot check out the default branch");
            return error.CompileFailed;
        }
    }
    const auto head = git_out(a, ["git", "-C", dir, "rev-parse", "HEAD"])?;
    if (commit.len > 0 && head != commit) {
        eprintln("error: dependency '{name}' is at {clip12(head)}, the lock pins {clip12(commit)}; run `zark update {name}`");
        return error.CompileFailed;
    }
    return head;
}

/// clones the requested `rev` and returns the commit it points at now (for `zark update`)
!str resolve_dep(Allocator a, str name, str url, str rev, str dir) {
    if (fs::is_dir(dir)) {
        if (run(a, ["rm", "-rf", dir])? != 0) {
            eprintln("error: dependency '{name}': cannot remove {dir}");
            return error.CompileFailed;
        }
    }
    fetch_git(a, name, url, rev, dir)?;
    return git_out(a, ["git", "-C", dir, "rev-parse", "HEAD"])?;
}

struct PkgState { List<LockPkg> lock; Map<str> resolved; bool locked; bool updating; }

!PkgState load_state(Allocator a, str dir) {
    const auto lock = read_lock(a, dir)?;
    return PkgState{ .lock = lock, .resolved = Map<str>::init(a), .locked = fs::is_file(path::join(a, [dir, "zark.lock"])?), .updating = false };
}

!i32 pkg_update_core(Allocator a, str pdir) {
    auto st = load_state(a, pdir)?;
    st.updating = true;
    const auto proj = load_project(a, pdir, true, 0, &st) catch { return 1; };
    _ = proj;
    write_lock(a, pdir, st.lock.slice())?;
    println("updated {st.lock.len} dependencies");
    return 0;
}

/// `zark fetch`: put every locked git dependency at its commit
!i32 pkg_fetch(Allocator a) {
    const auto pdir = find_project(a, ".") catch "";
    if (pdir.len == 0) { eprintln("error: no zark.toml here or above"); return 1; }
    const auto lock = read_lock(a, pdir)?;
    if (lock.len == 0) {
        eprintln("error: no zark.lock; run `zark update` first");
        return 1;
    }
    auto n = 0;
    for (auto p : lock) {
        if (p.url.len == 0) { continue; }
        const auto ddir = path::join(a, [pdir, ".zark/deps", p.name])?;
        _ = ensure_dep(a, p.name, p.url, p.rev, p.commit, ddir) catch { eprintln("error: could not fetch {p.name}"); return 1; };
        n += 1;
    }
    println("fetched {n} dependencies");
    return 0;
}

/// `zark update`: resolve the manifests' revisions and rewrite the lock
!i32 pkg_update(Allocator a) {
    const auto pdir = find_project(a, ".") catch "";
    if (pdir.len == 0) { eprintln("error: no zark.toml here or above"); return 1; }
    return pkg_update_core(a, pdir);
}

!void toml_add_dep(Allocator a, str path, str name, str url, str rev) {
    const auto src = read_file(a, path)?;
    auto b = List<u8>::init(a);
    auto added = false;
    auto start = 0;
    auto i = 0;
    while (i <= src.len) {
        if (i == src.len || src[i] == '\n') {
            const auto line = src[start..i];
            b.append(line)?;
            b.push('\n')?;
            if (!added && str_trim(line) == "[dependencies]") {
                sprint(&b, "{name} = {{ git = \"{url}\", rev = \"{rev}\" }}\n")?;
                added = true;
            }
            start = i + 1;
        }
        i += 1;
    }
    if (!added) {
        b.append("\n[dependencies]\n")?;
        sprint(&b, "{name} = {{ git = \"{url}\", rev = \"{rev}\" }}\n")?;
    }
    write_file(path, b.slice())?;
}

!void toml_remove_dep(Allocator a, str path, str name) {
    const auto src = read_file(a, path)?;
    auto b = List<u8>::init(a);
    auto section = "";
    auto start = 0;
    auto i = 0;
    while (i <= src.len) {
        if (i == src.len || src[i] == '\n') {
            const auto line = src[start..i];
            const auto t = str_trim(line);
            if (t.len >= 2 && t[0] == '[' && t[t.len - 1] == ']') { section = t; }
            auto drop = false;
            if (section == "[dependencies]" && t.len > name.len && str_starts_with(t, name)) {
                const auto c = t[name.len];
                if (c == ' ' || c == '=') { drop = true; }
            }
            if (!drop) {
                b.append(line)?;
                b.push('\n')?;
            }
            start = i + 1;
        }
        i += 1;
    }
    write_file(path, b.slice())?;
}

/// `zark add <git-url> [--rev REV]`: append the dependency and lock it
!i32 pkg_add(Allocator a, str url, str rev) {
    if (url.len == 0) { eprintln("usage: zark add <git-url> [--rev REV]"); return 1; }
    const auto pdir = find_project(a, ".") catch "";
    if (pdir.len == 0) { eprintln("error: no zark.toml here or above"); return 1; }
    auto base = url;
    if (str_ends_with(base, ".git")) { base = base[0..base.len - 4]; }
    auto name = base;
    const auto slash = str_rfind_byte(base, '/');
    if (slash >= 0) { name = base[slash + 1..]; }
    if (name.len == 0) { eprintln("error: cannot derive a package name from '{url}'"); return 1; }
    const auto manifest = path::join(a, [pdir, "zark.toml"])?;
    toml_add_dep(a, manifest, name, url, rev)?;
    println("added {name}");
    return pkg_update_core(a, pdir);
}

/// `zark remove <name>`: drop the dependency from the manifest and the lock
!i32 pkg_remove(Allocator a, str name) {
    if (name.len == 0) { eprintln("usage: zark remove <name>"); return 1; }
    const auto pdir = find_project(a, ".") catch "";
    if (pdir.len == 0) { eprintln("error: no zark.toml here or above"); return 1; }
    const auto manifest = path::join(a, [pdir, "zark.toml"])?;
    toml_remove_dep(a, manifest, name)?;
    const auto lock = read_lock(a, pdir)?;
    auto out = List<LockPkg>::init(a);
    for (auto p : lock) { if (p.name != name) { out.push(p)?; } }
    write_lock(a, pdir, out.slice())?;
    println("removed {name}");
    return 0;
}

!void pkg_flags(Allocator a, str pkg, List<str>* out) {
    const auto r = os::exec(a, ["pkg-config", "--cflags", "--libs", pkg]) catch |e| {
        if (e == error.ProgramNotFound) {
            eprintln("error: pkg-config is not installed (needed for '{pkg}')");
            return error.CompileFailed;
        }
        return e;
    };
    if (r.code != 0) {
        eprintln("error: pkg-config could not find package '{pkg}'");
        return error.CompileFailed;
    }
    auto it = str_fields(r.out);
    while (it.next()) { out.push(it.part)?; }
}

!List<str> project_c_args(Allocator a, Manifest* p) {
    auto out = List<str>::init(a);
    for (auto s : p.sources) { out.push(s)?; }
    for (auto l : p.libs) {
        auto b = List<u8>::init(a);
        sprint(&b, "-l{l}")?;
        out.push(b.slice())?;
    }
    for (auto c : p.cflags) { out.push(c)?; }
    for (auto k : p.pkgs) { pkg_flags(a, k, &out)?; }
    for (auto d : p.lib_dirs) {
        auto b = List<u8>::init(a);
        sprint(&b, "-L{d}")?;
        out.push(b.slice())?;
    }
    if (p.by_value.len > 0) {
        auto b = List<u8>::init(a);
        sprint(&b, "--by-value=")?;
        for (auto [i, v] : p.by_value.slice()) {
            if (i > 0) { sprint(&b, ",")?; }
            sprint(&b, "{v}")?;
        }
        out.push(b.slice())?;
    }
    return out;
}

bool has_main(Manifest* p) {
    return fs::is_file(p.main) || p.sources.len == 0;
}

/// the arguments `zark run/build/test` gets in a project: main file, sources, libs, flags,
/// then what was typed
!List<str> project_args(Allocator a, Manifest* p, str cmd, str[] typed) {
    auto out = List<str>::init(a);
    if (cmd == "test" || has_main(p)) { out.push(p.main)?; }
    out.append(project_c_args(a, p)?.slice())?;
    for (auto f : p.flags) { out.push(f)?; }
    auto has_o = false;
    for (auto t : typed) { if (t == "-o") { has_o = true; } }
    if (cmd == "build" && !has_o) {
        out.push("-o")?;
        if (p.out.len > 0) {
            fs::make_dirs(path::dir(p.out))?;
            out.push(p.out)?;
        } else {
            const auto bdir = path::join(a, [p.dir, "build"])?;
            fs::make_dirs(bdir)?;
            out.push(path::join(a, [bdir, p.name])?)?;
        }
    }
    out.append(typed)?;
    return out;
}

/// `zark new NAME`: a project skeleton
!i32 scaffold_project(Allocator a, str name) {
    if (name.len == 0 || fs::exists(name)) {
        eprintln("error: '{name}' already exists");
        return 1;
    }
    fs::make_dirs(path::join(a, [name, "src"])?)?;
    auto t = List<u8>::init(a);
    sprint(&t, "[package]\nname = \"{path::base(name)}\"\nversion = \"0.1.0\"\nmain = \"src/main.zk\"\n\n[build]\n# sources = [\"c/helper.c\"]\n# libs = [\"m\"]\n# flags = [\"-O\"]\n\n[dependencies]\n# utils = {{ path = \"../utils\" }\n")?;
    write_file(path::join(a, [name, "zark.toml"])?, t.slice())?;
    write_file(path::join(a, [name, "src/main.zk"])?, "import \"std/args\" as args;\n\n!void main() {{\n    auto p = args::Parser::init(c_allocator(), \"app\", \"A new Zark program.\");\n    defer p.deinit();\n    p.option(\"name\", 'n', \"who to greet\", \"world\")?;\n    p.parse() catch |e| {{\n        if (e == error.Help) {{ return; }\n        return e;\n    };\n    println(\"Hello, {{p.get(\"name\")}!\");\n}\n\ntest \"greeting\" {{\n    assert(1 + 1 == 2);\n}\n")?;
    write_file(path::join(a, [name, ".gitignore"])?, ".zark-cache/\n.zark/\nbuild/\n")?;
    println("created {name}: cd {name} && zark run");
    return 0;
}

/// the files whose test blocks `zark test` runs in a project: main, lib and tests/*.zk
!List<str> project_test_files(Allocator a, Manifest* p) {
    auto out = List<str>::init(a);
    if (has_main(p)) { out.push(p.main)?; }
    if (p.lib != p.main) { out.push(p.lib)?; }
    const auto tdir = path::join(a, [p.dir, "tests"])?;
    if (fs::is_dir(tdir)) {
        auto files = fs::walk(a, tdir)?;
        for (auto f : files.slice()) {
            if (str_ends_with(f, ".zk")) { out.push(path::join(a, [tdir, f])?)?; }
        }
    }
    return out;
}

/// in an editor: register the dependencies of the project that contains `file`
void project_setup_for(Allocator a, str file) {
    c_flags = List<str>{};
    const auto dir = find_project(a, path::dir(file)) catch "";
    if (dir.len == 0) { return; }
    const auto p = load_project(a, dir, false, 0, null) catch { return; };
    const auto args = project_c_args(a, p) catch { return; };
    const auto sp = split_extras(a, args.slice()) catch { return; };
    c_flags = sp.flags;
    c_by_value = sp.by_value;
}
