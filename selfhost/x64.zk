// x86-64 machine code encoder and ELF64 relocatable object writer. No external assembler.

const auto RAX = 0;
const auto RCX = 1;
const auto RDX = 2;
const auto RBX = 3;
const auto RSP = 4;
const auto RBP = 5;
const auto RSI = 6;
const auto RDI = 7;
const auto R8 = 8;
const auto R9 = 9;
const auto R10 = 10;
const auto R11 = 11;
const auto R12 = 12;
const auto R13 = 13;
const auto R14 = 14;
const auto R15 = 15;

// condition codes
const auto CC_O = 0;
const auto CC_NO = 1;
const auto CC_B = 2;
const auto CC_AE = 3;
const auto CC_E = 4;
const auto CC_NE = 5;
const auto CC_BE = 6;
const auto CC_A = 7;
const auto CC_S = 8;
const auto CC_P = 10;
const auto CC_NP = 11;
const auto CC_L = 12;
const auto CC_GE = 13;
const auto CC_LE = 14;
const auto CC_G = 15;

// relocation types
const auto R_X86_64_64 = 1;
const auto R_X86_64_PC32 = 2;
const auto R_X86_64_PLT32 = 4;

extern u8* getcwd(u8* buf, u64 size);

struct Reloc { i64 off; str sym; i64 kind; i64 addend; }
struct LineRow { i64 off; i64 line; i64 file; }
struct DbgVar { str name; i64 off; str ty; }
struct DbgFunc { str name; i64 start; i64 end; List<DbgVar> vars; }
struct Fixup { i64 off; str label; }

struct Asm {
    List<u8> code;
    List<Reloc> relocs;
    List<Fixup> fixups;     // jumps to labels in the current function
    Map<i64> labels;

    i64 pos() { return this->code.len; }
    !void b(i64 x) { this->code.push((x & 0xff) as u8)?; }
    !void d32(i64 x) { put_u32(&this->code, x)?; }

    /// opcode bytes packed big-endian into an int: 0x0FAF -> 0F AF
    !void opc(i64 op) {
        if (op > 0xffff) { this->b(op >> 16)?; }
        if (op > 0xff) { this->b(op >> 8)?; }
        this->b(op)?;
    }

    !void rex(bool w, i64 r, i64 b, bool force) {
        auto x = 0x40;
        if (w) { x = x | 8; }
        if (r >= 8) { x = x | 4; }
        if (b >= 8) { x = x | 1; }
        if (x != 0x40 || force) { this->b(x)?; }
    }

    /// [base + disp32]
    !void mem(i64 reg, i64 base, i64 disp) {
        this->b(0x80 | ((reg & 7) << 3) | (base & 7))?;
        if ((base & 7) == 4) { this->b(0x24)?; }
        this->d32(disp)?;
    }

    /// generic  [pfx] [REX] op  modrm(mem)
    !void rm_mem(i64 pfx, bool w, i64 op, i64 reg, i64 base, i64 disp, bool byte_reg) {
        if (pfx >= 0) { this->b(pfx)?; }
        this->rex(w, reg, base, byte_reg && reg >= 4 && reg < 8)?;
        this->opc(op)?;
        this->mem(reg, base, disp)?;
    }

    /// generic  [pfx] [REX] op  modrm(reg, rm)
    !void rm_reg(i64 pfx, bool w, i64 op, i64 reg, i64 rm) {
        if (pfx >= 0) { this->b(pfx)?; }
        this->rex(w, reg, rm, false)?;
        this->opc(op)?;
        this->b(0xC0 | ((reg & 7) << 3) | (rm & 7))?;
    }

    // ---------------------------------------------------------------- moves
    /// load `size` bytes from [base+disp] into reg (zero or sign extended to 64 bits)
    !void ld(i64 reg, i64 base, i64 disp, i64 size, bool sign) {
        if (size == 8) {
            this->rm_mem(-1, true, 0x8B, reg, base, disp, false)?;
        } else if (size == 4) {
            if (sign) { this->rm_mem(-1, true, 0x63, reg, base, disp, false)?; } else { this->rm_mem(-1, false, 0x8B, reg, base, disp, false)?; }
        } else if (size == 2) {
            if (sign) { this->rm_mem(-1, true, 0x0FBF, reg, base, disp, false)?; } else { this->rm_mem(-1, false, 0x0FB7, reg, base, disp, false)?; }
        } else {
            if (sign) { this->rm_mem(-1, true, 0x0FBE, reg, base, disp, false)?; } else { this->rm_mem(-1, false, 0x0FB6, reg, base, disp, false)?; }
        }
    }

    !void st(i64 reg, i64 base, i64 disp, i64 size) {
        if (size == 8) {
            this->rm_mem(-1, true, 0x89, reg, base, disp, false)?;
        } else if (size == 4) {
            this->rm_mem(-1, false, 0x89, reg, base, disp, false)?;
        } else if (size == 2) {
            this->rm_mem(0x66, false, 0x89, reg, base, disp, false)?;
        } else {
            this->rm_mem(-1, false, 0x88, reg, base, disp, true)?;
        }
    }

    !void lea(i64 reg, i64 base, i64 disp) { this->rm_mem(-1, true, 0x8D, reg, base, disp, false)?; }

    /// lea reg, [rip + sym]
    !void lea_sym(i64 reg, str sym) {
        this->rex(true, reg, 0, false)?;
        this->b(0x8D)?;
        this->b(((reg & 7) << 3) | 5)?;
        this->relocs.push(Reloc{ .off = this->pos(), .sym = sym, .kind = R_X86_64_PC32, .addend = -4 })?;
        this->d32(0)?;
    }

    !void mov_imm(i64 reg, i64 v) {
        if (v >= 0 && v <= 0xffffffff) {
            // mov r32, imm32 (zero-extends)
            this->rex(false, 0, reg, false)?;
            this->b(0xB8 + (reg & 7))?;
            this->d32(v)?;
        } else if (v >= -2147483648 && v < 0) {
            this->rex(true, 0, reg, false)?;
            this->b(0xC7)?;
            this->b(0xC0 | (reg & 7))?;
            this->d32(v)?;
        } else {
            this->rex(true, 0, reg, false)?;
            this->b(0xB8 + (reg & 7))?;
            put_u64(&this->code, v)?;
        }
    }

    !void mov_rr(i64 dst, i64 src) { this->rm_reg(-1, true, 0x89, src, dst)?; }

    // ---------------------------------------------------------------- integer ALU (64-bit)
    !void alu(i64 op, i64 dst, i64 src) { this->rm_reg(-1, true, op, src, dst)?; }
    !void add(i64 dst, i64 src) { this->alu(0x01, dst, src)?; }
    !void sub(i64 dst, i64 src) { this->alu(0x29, dst, src)?; }
    !void and_(i64 dst, i64 src) { this->alu(0x21, dst, src)?; }
    !void or_(i64 dst, i64 src) { this->alu(0x09, dst, src)?; }
    !void xor_(i64 dst, i64 src) { this->alu(0x31, dst, src)?; }
    !void cmp(i64 a, i64 b) { this->alu(0x39, a, b)?; }
    !void test(i64 a, i64 b) { this->alu(0x85, a, b)?; }
    !void imul(i64 dst, i64 src) { this->rm_reg(-1, true, 0x0FAF, dst, src)?; }
    !void grp3(i64 n, i64 r) { this->rm_reg(-1, true, 0xF7, n, r)?; }   // 3 neg, 6 div, 7 idiv
    !void shift_cl(i64 n, i64 r) { this->rm_reg(-1, true, 0xD3, n, r)?; } // 4 shl, 5 shr, 7 sar
    !void cqo() {
        this->b(0x48)?;
        this->b(0x99)?;
    }
    !void add_imm(i64 r, i64 v) {
        this->rex(true, 0, r, false)?;
        this->b(0x81)?;
        this->b(0xC0 | (r & 7))?;
        this->d32(v)?;
    }
    !void alu_imm(i64 n, i64 r, i64 v) {
        this->rex(true, 0, r, false)?;
        if (v >= -128 && v <= 127) {
            this->b(0x83)?;
            this->b(0xC0 | (n << 3) | (r & 7))?;
            this->b(v)?;
        } else {
            this->b(0x81)?;
            this->b(0xC0 | (n << 3) | (r & 7))?;
            this->d32(v)?;
        }
    }
    !void shift_imm(i64 n, i64 r, i64 v) {
        this->rex(true, 0, r, false)?;
        this->b(0xC1)?;
        this->b(0xC0 | (n << 3) | (r & 7))?;
        this->b(v)?;
    }
    !void imul_rri(i64 dst, i64 src, i64 v) {
        this->rex(true, dst, src, false)?;
        this->b(0x69)?;
        this->b(0xC0 | ((dst & 7) << 3) | (src & 7))?;
        this->d32(v)?;
    }
    !void imul_imm(i64 r, i64 v) {
        // imul r, r, imm32
        this->rex(true, r, r, false)?;
        this->b(0x69)?;
        this->b(0xC0 | ((r & 7) << 3) | (r & 7))?;
        this->d32(v)?;
    }
    !void setcc(i64 cc, i64 r) {
        this->rex(false, 0, r, r >= 4)?;
        this->b(0x0F)?;
        this->b(0x90 + cc)?;
        this->b(0xC0 | (r & 7))?;
    }
    !void movzx_b(i64 dst, i64 src) {
        this->rex(false, dst, src, src >= 4)?;
        this->b(0x0F)?;
        this->b(0xB6)?;
        this->b(0xC0 | ((dst & 7) << 3) | (src & 7))?;
    }
    !void cmov(i64 cc, i64 dst, i64 src) { this->rm_reg(-1, true, 0x0F40 + cc, dst, src)?; }

    // ---------------------------------------------------------------- SSE
    !void movq_x_r(i64 x, i64 r, bool wide) { this->rm_reg(0x66, wide, 0x0F6E, x, r)?; }
    !void movq_r_x(i64 r, i64 x, bool wide) { this->rm_reg(0x66, wide, 0x0F7E, x, r)?; }
    !void sse(i64 pfx, i64 op, i64 x, i64 y) { this->rm_reg(pfx, false, op, x, y)?; }
    !void cvtsi2f(bool dbl, i64 x, i64 r) {
        auto p = 0xF3;
        if (dbl) { p = 0xF2; }
        this->rm_reg(p, true, 0x0F2A, x, r)?;
    }
    !void cvttf2si(bool dbl, i64 r, i64 x) {
        auto p = 0xF3;
        if (dbl) { p = 0xF2; }
        this->rm_reg(p, true, 0x0F2C, r, x)?;
    }

    // ---------------------------------------------------------------- control flow
    !void jmp(str label) {
        this->b(0xE9)?;
        this->fixups.push(Fixup{ .off = this->pos(), .label = label })?;
        this->d32(0)?;
    }
    !void jcc(i64 cc, str label) {
        this->b(0x0F)?;
        this->b(0x80 + cc)?;
        this->fixups.push(Fixup{ .off = this->pos(), .label = label })?;
        this->d32(0)?;
    }
    !void call_sym(str sym) {
        this->b(0xE8)?;
        this->relocs.push(Reloc{ .off = this->pos(), .sym = sym, .kind = R_X86_64_PLT32, .addend = -4 })?;
        this->d32(0)?;
    }
    !void call_reg(i64 r) { this->rm_reg(-1, false, 0xFF, 2, r)?; }
    !void bind(str label) { this->labels.put(label, this->pos())?; }

    !void resolve_fixups() {
        for (auto f : this->fixups) {
            const auto target = this->labels.get(f.label) catch {
                eprintln("native: unknown label '{f.label}'");
                return error.CompileFailed;
            };
            patch_u32(&this->code, f.off, target - (f.off + 4));
        }
        this->fixups.clear();
        this->labels.clear_all();
    }
}

Asm new_asm(Allocator a) {
    return Asm{ .code = List<u8>::init(a), .relocs = List<Reloc>::init(a), .fixups = List<Fixup>::init(a), .labels = Map<i64>::init(a) };
}

!void put_u32(List<u8>*buf, i64 v) {
    buf.push((v & 0xff) as u8)?;
    buf.push(((v >> 8) & 0xff) as u8)?;
    buf.push(((v >> 16) & 0xff) as u8)?;
    buf.push(((v >> 24) & 0xff) as u8)?;
}

!void put_u64(List<u8>*buf, i64 v) {
    put_u32(buf, v & 0xffffffff)?;
    put_u32(buf, (v >> 32) & 0xffffffff)?;
}

!void put_u16(List<u8>*buf, i64 v) {
    buf.push((v & 0xff) as u8)?;
    buf.push(((v >> 8) & 0xff) as u8)?;
}

!void put_uleb(List<u8>*buf, i64 v) {
    auto x = v as u64;
    while (x >= 128) {
        buf.push(((x & 127) | 128) as u8)?;
        x = x >> 7;
    }
    buf.push(x as u8)?;
}

!void put_sleb(List<u8>*buf, i64 v) {
    auto x = v;
    while (true) {
        const auto byte = x & 127;
        x = x >> 7;
        if ((x == 0 && (byte & 64) == 0) || (x == -1 && (byte & 64) != 0)) {
            buf.push(byte as u8)?;
            return;
        }
        buf.push((byte | 128) as u8)?;
    }
}

!void put_rela(List<u8>*buf, i64 off, i64 kind, i64 sym, i64 addend) {
    put_u64(buf, off)?;
    put_u64(buf, (sym << 32) | kind)?;
    put_u64(buf, addend)?;
}

void patch_u32(List<u8>*buf, i64 at, i64 v) {
    buf.items[at] = (v & 0xff) as u8;
    buf.items[at + 1] = ((v >> 8) & 0xff) as u8;
    buf.items[at + 2] = ((v >> 16) & 0xff) as u8;
    buf.items[at + 3] = ((v >> 24) & 0xff) as u8;
}

template<V> void Map<V>::clear_all() {
    if (this->entries.len > 0) { memset(this->entries.ptr, 0, (this->entries.len as u64) * sizeof(MapEntry<V>)); }
    this->len = 0;
}

// ==================================================================== ELF64 writer

struct Sym {
    str name;
    i64 sec;        // 0 = undefined, else section index
    i64 value;
    i64 size;
    bool global;
    bool func;
}

struct ObjFile {
    Allocator a;
    Asm text;
    List<u8> rodata;
    List<u8> data;
    i64 data_align;
    List<Reloc> data_relocs;
    List<LineRow> rows;
    List<DbgFunc> funcs;
    List<str> files;
    List<Sym> syms;
    Map<i64> sym_index;   // name -> index in syms

    !void define(str name, i64 sec, i64 value, i64 size, bool global, bool func) {
        if (this->sym_index.has(name)) {
            const auto i = this->sym_index.get(name)?;
            const auto s = &this->syms.items[i];
            s.sec = sec;
            s.value = value;
            s.size = size;
            s.global = global;
            s.func = func;
            return;
        }
        this->sym_index.put(name, this->syms.len)?;
        this->syms.push(Sym{ .name = name, .sec = sec, .value = value, .size = size, .global = global, .func = func })?;
    }

    /// appends the code, line rows, debug functions and symbols of another object (one compiled function)
    !void absorb(ObjFile* o) {
        const auto base = this->text.code.len;
        this->text.code.append(o.text.code.slice())?;
        for (auto r : o.text.relocs) {
            this->text.relocs.push(Reloc{ .off = r.off + base, .sym = r.sym, .kind = r.kind, .addend = r.addend })?;
        }
        for (auto w : o.rows) {
            auto file = w.file;
            if (file > 0) { file = this->file_index(o.files.get(file - 1))?; }
            this->rows.push(LineRow{ .off = w.off + base, .line = w.line, .file = file })?;
        }
        for (auto f : o.funcs) {
            this->funcs.push(DbgFunc{ .name = f.name, .start = f.start + base, .end = f.end + base, .vars = f.vars })?;
        }
        for (auto s : o.syms) {
            this->define(s.name, s.sec, s.value + base, s.size, s.global, s.func)?;
        }
    }

    !i64 emit_desc(List<u8>*info, Map<i64>* memo, str d) {
        if (memo.has(d)) { return memo.get(d)?; }
        i64 at = 0;
        if (d[0] == 'A') {
            const auto p = str_find_byte(d, '[');
            const auto n = (parse_int_radix(d[1..p], 10) catch 0) as i64;
            const auto eo = this->emit_desc(info, memo, d[p + 1..d.len - 1])?;
            at = info.len;
            put_uleb(info, 7)?;
            put_u32(info, eo)?;
            put_uleb(info, 8)?;
            put_uleb(info, n)?;
            info.push(0)?;
        } else if (d[0] == 'S' && d.len > 1 && d[1] == '{') {
            const auto inner = d[2..d.len - 1];
            auto c = str_find_byte(inner, ':');
            auto head = inner;
            auto body = "";
            if (c >= 0) {
                head = inner[0..c];
                body = inner[c + 1..];
            }
            const auto hc = str_find_byte(head, ',');
            const auto sname = head[0..hc];
            const auto ssize = (parse_int_radix(head[hc + 1..], 10) catch 0) as i64;
            auto fnames = List<str>::init(this->a);
            auto foffs = List<i64>::init(this->a);
            auto ftypes = List<i64>::init(this->a);
            auto depth = 0;
            auto st = 0;
            for (auto k : 0..body.len + 1) {
                if (k < body.len && (body[k] == '{' || body[k] == '[')) { depth += 1; }
                if (k < body.len && (body[k] == '}' || body[k] == ']')) { depth -= 1; }
                if (k == body.len || (body[k] == ',' && depth == 0)) {
                    const auto f = body[st..k];
                    st = k + 1;
                    if (f.len == 0) { continue; }
                    const auto a1 = str_find_byte(f, '@');
                    const auto e1 = str_find_byte(f, '=');
                    fnames.push(f[0..a1])?;
                    foffs.push((parse_int_radix(f[a1 + 1..e1], 10) catch 0) as i64)?;
                    ftypes.push(this->emit_desc(info, memo, f[e1 + 1..])?)?;
                }
            }
            at = info.len;
            put_uleb(info, 5)?;
            info.append(sname)?;
            info.push(0)?;
            put_uleb(info, ssize)?;
            for (auto [k, fname] : fnames) {
                put_uleb(info, 6)?;
                info.append(fname)?;
                info.push(0)?;
                put_u32(info, ftypes.get(k))?;
                put_uleb(info, foffs.get(k))?;
            }
            info.push(0)?;
        } else {
            auto enc = 7;
            auto size = 8;
            if (d == "bool") { enc = 2; size = 1; }
            else if (d != "ptr") {
                size = (parse_int_radix(d[1..], 10) catch 64) as i64 / 8;
                if (d[0] == 'i') { enc = 5; }
                if (d[0] == 'f') { enc = 4; }
            }
            at = info.len;
            put_uleb(info, 2)?;
            info.append(d)?;
            info.push(0)?;
            info.push(enc as u8)?;
            info.push(size as u8)?;
        }
        memo.put(d, at)?;
        return at;
    }

    !i64 file_index(str name) {
        for (auto [i, f] : this->files) { if (f == name) { return i + 1; } }
        this->files.push(name)?;
        return this->files.len;
    }

    !void add_row(i64 off, i64 line, i64 file) {
        this->rows.push(LineRow{ .off = off, .line = line, .file = file })?;
    }

    !void debug_sections(List<u8>*abbrev, List<u8>*info, List<u8>*line, List<u8>*rinfo, List<u8>*rline) {
        auto cwd = "";
        const auto cp = getcwd(null, 0);
        if (cp != null) { cwd = cstr(cp); }
        put_uleb(abbrev, 1)?;
        put_uleb(abbrev, 0x11)?;
        abbrev.push(1)?;
        const auto attrs = [0x25, 0x08, 0x13, 0x05, 0x03, 0x08, 0x1b, 0x08, 0x10, 0x17, 0x11, 0x01, 0x12, 0x07, 0, 0,
            2, 0x24, 0, 0x03, 0x08, 0x3e, 0x0b, 0x0b, 0x0b, 0, 0,
            3, 0x2e, 1, 0x03, 0x08, 0x11, 0x01, 0x12, 0x07, 0x40, 0x18, 0, 0,
            4, 0x34, 0, 0x03, 0x08, 0x49, 0x13, 0x02, 0x18, 0, 0,
            5, 0x13, 1, 0x03, 0x08, 0x0b, 0x0f, 0, 0,
            6, 0x0d, 0, 0x03, 0x08, 0x49, 0x13, 0x38, 0x0f, 0, 0,
            7, 0x01, 1, 0x49, 0x13, 0, 0,
            8, 0x21, 0, 0x37, 0x0f, 0, 0, 0];
        for (auto x : attrs) { abbrev.push(x as u8)?; }

        put_u32(info, 0)?;
        put_u16(info, 4)?;
        put_u32(info, 0)?;
        info.push(8)?;
        put_uleb(info, 1)?;
        info.append("zark\x00")?;
        put_u16(info, 0x0c)?;
        if (this->files.len > 0) { info.append(this->files.get(0))?; }
        info.push(0)?;
        info.append(cwd)?;
        info.push(0)?;
        put_rela(rinfo, info.len, 10, 2, 0)?;
        put_u32(info, 0)?;
        put_rela(rinfo, info.len, 1, 1, 0)?;
        put_u64(info, 0)?;
        put_u64(info, this->text.code.len)?;
        auto type_at = Map<i64>::init(this->a);
        for (auto f : this->funcs) {
            for (auto v : f.vars) { _ = this->emit_desc(info, &type_at, v.ty)?; }
        }
        for (auto f : this->funcs) {
            put_uleb(info, 3)?;
            info.append(f.name)?;
            info.push(0)?;
            put_rela(rinfo, info.len, 1, 1, f.start)?;
            put_u64(info, 0)?;
            put_u64(info, f.end - f.start)?;
            put_uleb(info, 1)?;
            info.push(0x56)?;
            for (auto v : f.vars) {
                put_uleb(info, 4)?;
                info.append(v.name)?;
                info.push(0)?;
                put_u32(info, type_at.get(v.ty)?)?;
                auto loc = List<u8>::init(this->a);
                loc.push(0x91)?;
                put_sleb(&loc, v.off)?;
                put_uleb(info, loc.len)?;
                info.append(loc.slice())?;
            }
            info.push(0)?;
        }
        info.push(0)?;
        patch_u32(info, 0, info.len - 4);

        put_u32(line, 0)?;
        put_u16(line, 4)?;
        put_u32(line, 0)?;
        const auto hdr_start = line.len;
        const auto params = [1, 1, 1, 0xFB, 14, 13, 0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1];
        for (auto x : params) { line.push(x as u8)?; }
        line.push(0)?;
        for (auto f : this->files) {
            line.append(f)?;
            line.push(0)?;
            line.push(0)?;
            line.push(0)?;
            line.push(0)?;
        }
        line.push(0)?;
        patch_u32(line, 6, line.len - hdr_start);
        auto cur_file = 1;
        auto cur_line = 1;
        auto addr = 0;
        auto live = false;
        for (auto r : this->rows) {
            if (r.line == 0) {
                if (live) {
                    line.push(2)?;
                    put_uleb(line, r.off - addr)?;
                    line.push(0)?;
                    line.push(1)?;
                    line.push(1)?;
                    live = false;
                }
                continue;
            }
            if (!live) {
                line.push(0)?;
                line.push(9)?;
                line.push(2)?;
                put_rela(rline, line.len, 1, 1, r.off)?;
                put_u64(line, 0)?;
                addr = r.off;
                cur_file = 1;
                cur_line = 1;
                live = true;
            }
            if (r.file != cur_file) {
                line.push(4)?;
                put_uleb(line, r.file)?;
                cur_file = r.file;
            }
            if (r.off != addr) {
                line.push(2)?;
                put_uleb(line, r.off - addr)?;
                addr = r.off;
            }
            if (r.line != cur_line) {
                line.push(3)?;
                put_sleb(line, r.line - cur_line)?;
                cur_line = r.line;
            }
            line.push(1)?;
        }
        patch_u32(line, 0, line.len - 4);
    }

    !void reference(str name) {
        if (this->sym_index.has(name)) { return; }
        this->sym_index.put(name, this->syms.len)?;
        this->syms.push(Sym{ .name = name, .sec = 0, .value = 0, .size = 0, .global = true, .func = false })?;
    }

    !void write(str path) {
        const auto a = this->a;
        for (auto r : this->text.relocs) { this->reference(r.sym)?; }
        for (auto r : this->data_relocs) { this->reference(r.sym)?; }
        // symbol order: null, locals, globals
        auto order = List<i64>::init(a);
        for (auto [i, s] : this->syms) { if (!s.global && s.sec != 0) { order.push(i)?; } }
        const auto first_global = order.len + 3;
        for (auto [i, s] : this->syms) { if (s.global || s.sec == 0) { order.push(i)?; } }
        auto final_index = List<i64>::init(a);
        for (auto _i : 0..this->syms.len) { final_index.push(0)?; }
        for (auto [k, i] : order) { final_index.set(i, k + 3); }

        auto strtab = List<u8>::init(a);
        strtab.push(0)?;
        auto symtab = List<u8>::init(a);
        for (auto _k : 0..24) { symtab.push(0)?; }
        for (auto sec : [1, 12]) {
            put_u32(&symtab, 0)?;
            symtab.push(3)?;
            symtab.push(0)?;
            put_u16(&symtab, sec)?;
            put_u64(&symtab, 0)?;
            put_u64(&symtab, 0)?;
        }
        for (auto i : order) {
            const auto s = this->syms.get(i);
            const auto name_off = strtab.len;
            strtab.append(s.name)?;
            strtab.push(0)?;
            put_u32(&symtab, name_off)?;
            auto bind = 0;
            if (s.global || s.sec == 0) { bind = 1; }
            auto typ = 0;
            if (s.sec != 0) {
                typ = 1;
                if (s.func) { typ = 2; }
            }
            symtab.push(((bind << 4) | typ) as u8)?;
            symtab.push(0)?;
            put_u16(&symtab, s.sec)?;
            put_u64(&symtab, s.value)?;
            put_u64(&symtab, s.size)?;
        }

        auto rela_text = List<u8>::init(a);
        for (auto r : this->text.relocs) {
            put_u64(&rela_text, r.off)?;
            put_u64(&rela_text, (final_index.get(this->sym_index.get(r.sym)?) << 32) | r.kind)?;
            put_u64(&rela_text, r.addend)?;
        }
        auto rela_data = List<u8>::init(a);
        for (auto r : this->data_relocs) {
            put_u64(&rela_data, r.off)?;
            put_u64(&rela_data, (final_index.get(this->sym_index.get(r.sym)?) << 32) | r.kind)?;
            put_u64(&rela_data, r.addend)?;
        }

        // section names
        auto shstr = List<u8>::init(a);
        shstr.push(0)?;
        const auto n_text = shstr.len;
        shstr.append(".text\x00")?;
        const auto n_rodata = shstr.len;
        shstr.append(".rodata\x00")?;
        const auto n_data = shstr.len;
        shstr.append(".data\x00")?;
        const auto n_rtext = shstr.len;
        shstr.append(".rela.text\x00")?;
        const auto n_rdata = shstr.len;
        shstr.append(".rela.data\x00")?;
        const auto n_symtab = shstr.len;
        shstr.append(".symtab\x00")?;
        const auto n_strtab = shstr.len;
        shstr.append(".strtab\x00")?;
        const auto n_shstr = shstr.len;
        shstr.append(".shstrtab\x00")?;
        const auto n_note = shstr.len;
        shstr.append(".note.GNU-stack\x00")?;
        const auto n_dabbrev = shstr.len;
        shstr.append(".debug_abbrev\x00")?;
        const auto n_dinfo = shstr.len;
        shstr.append(".debug_info\x00")?;
        const auto n_dline = shstr.len;
        shstr.append(".debug_line\x00")?;
        const auto n_rdinfo = shstr.len;
        shstr.append(".rela.debug_info\x00")?;
        const auto n_rdline = shstr.len;
        shstr.append(".rela.debug_line\x00")?;
        auto dabbrev = List<u8>::init(a);
        auto dinfo = List<u8>::init(a);
        auto dline = List<u8>::init(a);
        auto rdinfo = List<u8>::init(a);
        auto rdline = List<u8>::init(a);
        this->debug_sections(&dabbrev, &dinfo, &dline, &rdinfo, &rdline)?;

        // layout: header, then sections
        auto f = List<u8>::init(a);
        for (auto _k : 0..64) { f.push(0)?; }
        align_buf(&f, 16)?;
        const auto o_text = f.len;
        f.append(this->text.code.slice())?;
        align_buf(&f, 16)?;
        const auto o_rodata = f.len;
        f.append(this->rodata.slice())?;
        align_buf(&f, max(16, this->data_align))?;
        const auto o_data = f.len;
        f.append(this->data.slice())?;
        align_buf(&f, 8)?;
        const auto o_rtext = f.len;
        f.append(rela_text.slice())?;
        const auto o_rdata = f.len;
        f.append(rela_data.slice())?;
        const auto o_symtab = f.len;
        f.append(symtab.slice())?;
        const auto o_strtab = f.len;
        f.append(strtab.slice())?;
        const auto o_shstr = f.len;
        f.append(shstr.slice())?;
        const auto o_dabbrev = f.len;
        f.append(dabbrev.slice())?;
        const auto o_dinfo = f.len;
        f.append(dinfo.slice())?;
        const auto o_dline = f.len;
        f.append(dline.slice())?;
        align_buf(&f, 8)?;
        const auto o_rdinfo = f.len;
        f.append(rdinfo.slice())?;
        const auto o_rdline = f.len;
        f.append(rdline.slice())?;
        const auto o_sh = f.len;

        // section headers: 0 null, 1 text, 2 rodata, 3 data, 4 rela.text, 5 rela.data, 6 symtab, 7 strtab, 8 shstrtab, 9 note
        for (auto _k : 0..64) { f.push(0)?; }
        sec_hdr(&f, n_text, 1, 6, o_text, this->text.code.len, 0, 0, 16, 0)?;
        sec_hdr(&f, n_rodata, 1, 2, o_rodata, this->rodata.len, 0, 0, 16, 0)?;
        sec_hdr(&f, n_data, 1, 3, o_data, this->data.len, 0, 0, max(16, this->data_align), 0)?;
        sec_hdr(&f, n_rtext, 4, 0x40, o_rtext, rela_text.len, 6, 1, 8, 24)?;
        sec_hdr(&f, n_rdata, 4, 0x40, o_rdata, rela_data.len, 6, 3, 8, 24)?;
        sec_hdr(&f, n_symtab, 2, 0, o_symtab, symtab.len, 7, first_global, 8, 24)?;
        sec_hdr(&f, n_strtab, 3, 0, o_strtab, strtab.len, 0, 0, 1, 0)?;
        sec_hdr(&f, n_shstr, 3, 0, o_shstr, shstr.len, 0, 0, 1, 0)?;
        sec_hdr(&f, n_note, 1, 0, o_shstr, 0, 0, 0, 1, 0)?;
        sec_hdr(&f, n_dabbrev, 1, 0, o_dabbrev, dabbrev.len, 0, 0, 1, 0)?;
        sec_hdr(&f, n_dinfo, 1, 0, o_dinfo, dinfo.len, 0, 0, 1, 0)?;
        sec_hdr(&f, n_dline, 1, 0, o_dline, dline.len, 0, 0, 1, 0)?;
        sec_hdr(&f, n_rdinfo, 4, 0x40, o_rdinfo, rdinfo.len, 6, 11, 8, 24)?;
        sec_hdr(&f, n_rdline, 4, 0x40, o_rdline, rdline.len, 6, 12, 8, 24)?;

        // ELF header
        auto h = List<u8>::init(a);
        h.append("\x7fELF")?;
        h.push(2)?;   // 64-bit
        h.push(1)?;   // little endian
        h.push(1)?;   // version
        for (auto _k : 0..9) { h.push(0)?; }
        put_u16(&h, 1)?;      // ET_REL
        put_u16(&h, 62)?;     // EM_X86_64
        put_u32(&h, 1)?;
        put_u64(&h, 0)?;      // entry
        put_u64(&h, 0)?;      // phoff
        put_u64(&h, o_sh)?;   // shoff
        put_u32(&h, 0)?;      // flags
        put_u16(&h, 64)?;     // ehsize
        put_u16(&h, 0)?;
        put_u16(&h, 0)?;
        put_u16(&h, 64)?;     // shentsize
        put_u16(&h, 15)?;     // shnum
        put_u16(&h, 8)?;      // shstrndx
        for (auto k : 0..64) { f.items[k] = h.get(k); }
        write_file(path, f.slice())?;
    }
}

const auto SEC_TEXT = 1;
const auto SEC_RODATA = 2;
const auto SEC_DATA = 3;

ObjFile new_obj(Allocator a) {
    return ObjFile{ .a = a, .text = new_asm(a), .rodata = List<u8>::init(a), .data = List<u8>::init(a), .data_relocs = List<Reloc>::init(a), .rows = List<LineRow>::init(a), .funcs = List<DbgFunc>::init(a), .files = List<str>::init(a), .syms = List<Sym>::init(a), .sym_index = Map<i64>::init(a) };
}

!void align_buf(List<u8>*buf, i64 al) {
    while (buf.len % al != 0) { buf.push(0)?; }
}

!void sec_hdr(List<u8>*f, i64 name, i64 typ, i64 flags, i64 off, i64 size, i64 link, i64 info, i64 align, i64 entsize) {
    put_u32(f, name)?;
    put_u32(f, typ)?;
    put_u64(f, flags)?;
    put_u64(f, 0)?;
    put_u64(f, off)?;
    put_u64(f, size)?;
    put_u32(f, link)?;
    put_u32(f, info)?;
    put_u64(f, align)?;
    put_u64(f, entsize)?;
}
