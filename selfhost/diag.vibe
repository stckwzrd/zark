// Prints the source line of an error with a caret under the offending column.

var diag_prelude: str = ""

fn line_start(src: str, off: i64) i64 {
    var i = off
    if i > src.len { i = src.len }
    while i > 0 && src[i - 1] != '\n' { i -= 1 }
    return i
}

fn line_start_of(src: str, line: i64) i64 {
    var i = 0
    var n = 1
    while n < line && i < src.len {
        if src[i] == '\n' { n += 1 }
        i += 1
    }
    return i
}

fn show_source(file: str, line: i64, off: i64) {
    var src = diag_prelude
    if file != "<std>" { src = read_file(c_allocator(), file) catch return }
    var start = 0
    var shown = line
    if off >= 0 {
        start = line_start(src, off)
        shown = 1
        for i in 0..start {
            if src[i] == '\n' { shown += 1 }
        }
    } else {
        start = line_start_of(src, line)
    }
    var end = start
    while end < src.len && src[end] != '\n' { end += 1 }
    let text = src[start..end]
    eprintln("{shown:5} | {text}")
    if off < 0 { return }
    var pad = List[u8].init(c_allocator())
    for i in start..off {
        if i < end && src[i] == '\t' { pad.push('\t') catch return } else { pad.push(' ') catch return }
    }
    eprintln("      | {pad.slice()}^")
}

fn edit_distance(a: str, b: str) i64 {
    if a.len > 40 || b.len > 40 { return 99 }
    var prev: [41]i64
    var cur: [41]i64
    for j in 0..b.len + 1 { prev[j] = j }
    for i in 1..a.len + 1 {
        cur[0] = i
        for j in 1..b.len + 1 {
            var cost = 1
            if a[i - 1] == b[j - 1] { cost = 0 }
            cur[j] = min(min(prev[j] + 1, cur[j - 1] + 1), prev[j - 1] + cost)
        }
        for j in 0..b.len + 1 { prev[j] = cur[j] }
    }
    return prev[b.len]
}

fn closest(name: str, cands: List[str]) str {
    var best = ""
    var bd = 99
    if name.len < 3 { return "" }
    for c in cands {
        let d = edit_distance(name, c)
        if d < bd {
            bd = d
            best = c
        }
    }
    var limit = 1
    if name.len >= 4 { limit = 2 }
    if name.len >= 9 { limit = 3 }
    if bd <= limit { return best }
    return ""
}
