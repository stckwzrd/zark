// Compiler builtins (embed, panic, assert, __errname) and the lowering of `Fmt` arguments.
// Printing itself lives in the std. For every hole type the compiler generates a small
// Vibe thunk (as source text) that calls the `__fmt_*` hooks of the std.

import "gen_call.vibe"

fn dir_of(path: str) str {
    let i = str_rfind_byte(path, '/')
    if i < 0 { return "." }
    if i == 0 { return "/" }
    return path[0..i]
}

fn src_str(b: *List[u8], s: str) !void {
    b.push('"')?
    for c in s {
        if c == '"' {
            b.append("\\\"")?
        } else if c == '\\' {
            b.append("\\\\")?
        } else if c == '{' {
            b.append("\\\{")?
        } else if c == '}' {
            b.append("\\\}")?
        } else if c == '\n' {
            b.append("\\n")?
        } else {
            b.push(c)?
        }
    }
    b.push('"')?
}

struct FPiece { lit: str, ptr: str, thunk: str, spec: str, has: bool }

impl Gen {
    fn is_builtin(self, name: str) bool {
        match name {
            "panic", "assert", "embed", "__errname" => return true
        }
        return false
    }

    fn mk_pre(self, v: Value, line: i64) !*Expr {
        self.pre_vals.push(v)?
        let e = self.a.create[Expr]()?
        e.k = .Pre
        e.line = line
        e.ival = (self.pre_vals.len - 1) as u64
        return e
    }

    fn call_fn(self, name: str, args: List[*Expr], line: i64) !Value {
        if !self.fns.has(name) { self.err(line); eprintln("prelude missing '{name}'"); return error.CompileFailed }
        return self.call_decl(self.fns.get(name)?, self.new_env()?, null, args, self.no_types(), null, line)
    }

    fn gen_builtin(self, name: str, args: List[*Expr], line: i64) !Value {
        let void_v = Value{ ty: self.t_void, v: "" }
        if name == "embed" {
            if args.len != 1 || args.get(0).k != .StrLit { self.err(line); eprintln("embed takes one string literal"); return error.CompileFailed }
            var pb = self.sb()
            sprint(&pb, "{dir_of(self.file)}/{args.get(0).name}")?
            let data = read_file(self.a, pb.slice()) catch {
                self.err(line); eprintln("embed: cannot read '{pb.slice()}'")
                return error.CompileFailed
            }
            let gname = self.str_global(data)?
            var b = self.sb()
            sprint(&b, "{{ ptr {gname}, i64 {data.len} }}")?
            return Value{ ty: self.t_str, v: b.slice() }
        }
        if name == "__errname" {
            if args.len != 1 { self.err(line); eprintln("__errname takes one argument"); return error.CompileFailed }
            let v = self.gen_expr(args.get(0), null)?
            if v.ty.k != .ErrVal { self.err(line); eprintln("__errname takes an error value"); return error.CompileFailed }
            let pp = self.tmp()?
            sprint(self.ins()?, "  {pp} = getelementptr ptr, ptr @__vibe_errnames, i32 {v.v}\n")?
            let sp = self.load(self.t_ptr_u8, pp)?
            let lp = self.tmp()?
            sprint(self.ins()?, "  {lp} = getelementptr i64, ptr @__vibe_errlens, i32 {v.v}\n")?
            let sl = self.load(self.t_i64, lp)?
            let s1 = self.insert(self.t_str, "undef", sp, 0)?
            return Value{ ty: self.t_str, v: self.insert(self.t_str, s1, sl, 1)? }
        }
        if name == "panic" {
            self.gen_fail(args, 0, false, line)?
            return void_v
        }
        if name == "assert" {
            if args.len != 1 { self.err(line); eprintln("assert takes one argument"); return error.CompileFailed }
            let c = self.gen_cond(args.get(0))?
            let lbad = self.new_label("afail")?
            let lok = self.new_label("aok")?
            sprint(self.ins()?, "  br i1 {c.v}, label %{lok}, label %{lbad}\n")?
            self.terminated = true
            self.label(lbad)?
            self.gen_fail(args, 1, true, line)?
            self.label(lok)?
            return void_v
        }
        self.err(line); eprintln("unknown builtin '{name}'")
        return error.CompileFailed
    }

    fn gen_fail(self, args: List[*Expr], from: i64, is_assert: bool, line: i64) !void {
        if !is_assert && args.len != 1 { self.err(line); eprintln("panic takes one argument"); return error.CompileFailed }
        let fv = self.gen_fmt(args, from, Value{ ty: null, v: "" })?
        var call_args = List[*Expr].init(self.a)
        let fe = self.a.create[Expr]()?
        fe.k = .StrLit
        fe.line = line
        fe.name = self.file
        call_args.push(fe)?
        let le = self.a.create[Expr]()?
        le.k = .IntLit
        le.line = line
        le.ival = line as u64
        call_args.push(le)?
        let be = self.a.create[Expr]()?
        be.k = .BoolLit
        be.line = line
        be.bval = is_assert
        call_args.push(be)?
        call_args.push(self.mk_pre(fv, line)?)?
        _ = self.call_fn("__panic", call_args, line)?
        sprint(self.ins()?, "  unreachable\n")?
        self.terminated = true
    }

    fn fmt_type(self) !*Type {
        let te = self.a.create[TypeExpr]()?
        te.k = .Name
        te.name = "Fmt"
        te.args = List[*TypeExpr].init(self.a)
        return self.resolve_type(te, self.new_env()?)
    }

    fn str_value(self, s: str) !Value {
        if s.len == 0 { return Value{ ty: self.t_str, v: "{{ ptr null, i64 0 }}" } }
        var b = self.sb()
        sprint(&b, "{{ ptr {self.str_global(s)?}, i64 {s.len} }}")?
        return Value{ ty: self.t_str, v: b.slice() }
    }

    /// Builds a `Fmt` value on the stack from call arguments `args[from..]`.
    fn gen_fmt(self, args: List[*Expr], from: i64, first: Value) !Value {
        var pieces = List[FPiece].init(self.a)
        var cur = self.sb()
        for i in from..args.len {
            let x = args.get(i)
            if i > from { cur.push(' ')? }
            if x.k == .Interp {
                for p in x.parts {
                    if p.kind == 0 {
                        cur.append(p.lit)?
                    } else {
                        var spec = ""
                        if p.kind == 2 { spec = p.spec }
                        self.fmt_hole(&pieces, &cur, p.e, spec, false, first)?
                    }
                }
            } else if x.k == .StrLit {
                cur.append(x.name)?
            } else {
                self.fmt_hole(&pieces, &cur, x, "", i == from, first)?
            }
        }
        let ft = self.fmt_type()?
        let sl = ft.si.fields.get(0).ty
        let pt = sl.elem
        var slice_v = ""
        if pieces.len == 0 {
            slice_v = self.insert(sl, "undef", Value{ ty: self.t_ptr_u8, v: "null" }, 0)?
            slice_v = self.insert(sl, slice_v, Value{ ty: self.t_i64, v: "0" }, 1)?
        } else {
            let arr = self.mk_elem(.Array, pt)?
            arr.len = pieces.len as u64
            let slot = self.alloca(arr, "fmtp")?
            for i, pc in pieces {
                let ep = self.tmp()?
                sprint(self.ins()?, "  {ep} = getelementptr {self.llty(pt)?}, ptr {slot}, i64 {i}\n")?
                self.store(self.str_value(pc.lit)?, self.gep_field(pt, ep, 0)?)?
                self.store(Value{ ty: self.t_ptr_u8, v: pc.ptr }, self.gep_field(pt, ep, 1)?)?
                self.store(Value{ ty: pt.si.fields.get(2).ty, v: pc.thunk }, self.gep_field(pt, ep, 2)?)?
                self.store(self.str_value(pc.spec)?, self.gep_field(pt, ep, 3)?)?
            }
            slice_v = self.insert(sl, "undef", Value{ ty: self.t_ptr_u8, v: slot }, 0)?
            slice_v = self.insert(sl, slice_v, Value{ ty: self.t_i64, v: self.num(pieces.len)? }, 1)?
        }
        let f1 = self.insert(ft, "undef", Value{ ty: sl, v: slice_v }, 0)?
        let f2 = self.insert(ft, f1, self.str_value(cur.slice())?, 1)?
        return Value{ ty: ft, v: f2 }
    }

    fn fmt_hole(self, pieces: *List[FPiece], cur: *List[u8], e: *Expr, spec: str, is_first: bool, first: Value) !void {
        var v = first
        if !is_first || first.ty == null { v = self.gen_expr(e, null)? }
        if v.ty.k == .Void { cur.append("void")?; return }
        if v.ty.k == .Null { cur.append("(nil)")?; return }
        let thunk = self.fmt_thunk(v.ty)?
        let slot = self.spill(v)?
        var tn = self.sb()
        sprint(&tn, "@vb.__ff{thunk}")?
        pieces.push(FPiece{ lit: cur.slice(), ptr: slot.v, thunk: tn.slice(), spec: spec, has: true })?
        *cur = self.sb()
    }

    /// Returns the id of the thunk that formats values of type `t`, generating it on first use.
    fn fmt_thunk(self, t: *Type) !i64 {
        let key = self.mangle(t)?
        if self.thunks.has(key) { return self.thunks.get(key) }
        let id = self.thunks.len
        self.thunks.put(key, id)?
        var tn = self.sb()
        sprint(&tn, "__ft{id}")?
        self.rtypes.put(tn.slice(), t)?
        var src = self.sb()
        sprint(&src, "fn __ff{id}(w: *Writer, p: *void, spec: str, d: i64) !void {{\n")?
        self.thunk_body(&src, t, tn.slice())?
        src.append("}\n")?
        let toks = tokenize(self.a, src.slice(), "<fmt>")?
        var ps = new_parser(self.a, toks.slice(), "<fmt>")
        let decls = ps.parse_file()?
        let saved = self.file
        self.add_decls(decls, "<fmt>")?
        self.file = saved
        var fname = self.sb()
        sprint(&fname, "__ff{id}")?
        _ = self.inst_fn(self.fns.get(fname.slice())?, self.new_env()?, self.no_types())?
        return id
    }

    fn user_fmt(self, t: *Type) bool {
        let rn = recv_name(t)
        if rn.len == 0 { return false }
        var kb = self.sb()
        sprint(&kb, "{rn}.fmt") catch return false
        return self.methods.has(kb.slice())
    }

    fn thunk_body(self, b: *List[u8], t: *Type, tn: str) !void {
        if self.user_fmt(t) {
            sprint(b, "    let q = p as *{tn}\n    return q.fmt(w, spec)\n")?
            return
        }
        match t.k {
            .Int => {
                if t.signed { sprint(b, "    return __fmt_int(w, *(p as *{tn}) as i64, spec)\n")? } else { sprint(b, "    return __fmt_uint(w, *(p as *{tn}) as u64, spec)\n")? }
            }
            .Float => sprint(b, "    return __fmt_float(w, *(p as *{tn}) as f64, spec)\n")?
            .Bool => sprint(b, "    return __fmt_bool(w, *(p as *{tn}), spec)\n")?
            .Ptr => sprint(b, "    return __fmt_ptr(w, *(p as *u64), spec)\n")?
            .Func => sprint(b, "    __fmt_lit(w, \"fn@\")?\n    return __fmt_ptr(w, *(p as *u64), spec)\n")?
            .Closure => sprint(b, "    return __fmt_lit(w, \"closure\")\n")?
            .Null => sprint(b, "    return __fmt_lit(w, \"(nil)\")\n")?
            .Void => sprint(b, "    return __fmt_lit(w, \"void\")\n")?
            .ErrVal => sprint(b, "    __fmt_lit(w, \"error.\")?\n    return __fmt_lit(w, __errname(*(p as *{tn})))\n")?
            .Enm => {
                sprint(b, "    match *(p as *{tn}) {{\n")?
                for v in t.ei.decl.variants {
                    sprint(b, "        .{v} => return __fmt_lit(w, ")?
                    var lit = self.sb()
                    lit.push('.')?
                    lit.append(v)?
                    src_str(b, lit.slice())?
                    b.append(")\n")?
                }
                sprint(b, "    }\n    return __fmt_lit(w, \".?\")\n")?
            }
            .Strct => {
                if t.si.decl.is_union { self.union_body(b, t, tn)? } else { self.struct_body(b, t, tn)? }
            }
            .Array => {
                if t.elem.k == .Void { sprint(b, "    return __fmt_lit(w, \"[]\")\n")?; return }
                let c = self.fmt_thunk(t.elem)?
                var n = t.len as i64
                if n > 32 { n = 32 }
                sprint(b, "    let q = p as *__ft{c}\n    __fmt_lit(w, \"[\")?\n    for i in 0..{n} {{\n        if i > 0 {{ __fmt_lit(w, \", \")? }}\n        __ff{c}(w, &q[i], \"\", d + 1)?\n    }}\n")?
                if t.len as i64 > n { sprint(b, "    __fmt_lit(w, \", ...\")?\n")? }
                sprint(b, "    return __fmt_lit(w, \"]\")\n")?
            }
            .Slice => {
                if is_str(t) {
                    sprint(b, "    return __fmt_str(w, *(p as *{tn}), spec, d > 0)\n")?
                    return
                }
                let c = self.fmt_thunk(t.elem)?
                var head = self.sb()
                sprint(&head, "[]{self.type_name(t.elem)?}(len=")?
                sprint(b, "    let s = *(p as *{tn})\n    if d > 0 {{\n        __fmt_lit(w, ")?
                src_str(b, head.slice())?
                sprint(b, ")?\n        __fmt_int(w, s.len, \"\")?\n        return __fmt_lit(w, \")\")\n    }\n")?
                sprint(b, "    __fmt_lit(w, \"[\")?\n    for i in 0..s.len {{\n        if i > 0 {{ __fmt_lit(w, \", \")? }}\n        __ff{c}(w, &s[i], \"\", d + 1)?\n    }}\n    return __fmt_lit(w, \"]\")\n")?
            }
            .Errun => {
                let tail = "    r catch |e| {{\n        __fmt_lit(w, \"error.\")?\n        __fmt_lit(w, __errname(e))?\n        return\n    }}\n"
                sprint(b, "    let r = *(p as *{tn})\n")?
                if t.elem.k == .Void {
                    sprint(b, "{tail}    return __fmt_lit(w, \"void\")\n")?
                } else {
                    let c = self.fmt_thunk(t.elem)?
                    sprint(b, "    var v = r catch |e| {{\n        __fmt_lit(w, \"error.\")?\n        __fmt_lit(w, __errname(e))?\n        return\n    }}\n    return __ff{c}(w, &v, \"\", d)\n")?
                }
            }
        }
    }

    fn struct_body(self, b: *List[u8], t: *Type, tn: str) !void {
        let si = t.si
        sprint(b, "    let q = p as *{tn}\n    __fmt_lit(w, ")?
        var head = self.sb()
        sprint(&head, "{si.display}{{ ")?
        src_str(b, head.slice())?
        b.append(")?\n")?
        for i, f in si.fields {
            var lab = self.sb()
            if i > 0 { lab.append(", ")? }
            sprint(&lab, "{f.name}: ")?
            sprint(b, "    __fmt_lit(w, ")?
            src_str(b, lab.slice())?
            b.append(")?\n")?
            let c = self.fmt_thunk(f.ty)?
            sprint(b, "    if d > 4 {{ __fmt_lit(w, \"...\")? }} else {{ __ff{c}(w, &q.{f.name}, \"\", d + 1)? }}\n")?
        }
        sprint(b, "    return __fmt_lit(w, ")?
        src_str(b, " }")?
        b.append(")\n")?
    }

    fn union_body(self, b: *List[u8], t: *Type, tn: str) !void {
        let si = t.si
        sprint(b, "    let q = p as *{tn}\n    match *q {{\n")?
        for f in si.fields {
            var name = self.sb()
            sprint(&name, "{si.display}.{f.name}")?
            if f.ty.k == .Void {
                sprint(b, "        .{f.name} => return __fmt_lit(w, ")?
                src_str(b, name.slice())?
                b.append(")\n")?
            } else {
                let c = self.fmt_thunk(f.ty)?
                var open = self.sb()
                sprint(&open, "{name.slice()}(")?
                sprint(b, "        .{f.name}(v) => {{\n            if d > 0 {{ return __fmt_lit(w, ")?
                src_str(b, name.slice())?
                b.append(") }\n            __fmt_lit(w, ")?
                src_str(b, open.slice())?
                sprint(b, ")?\n            var tv = v\n            __ff{c}(w, &tv, \"\", d + 1)?\n            return __fmt_lit(w, \")\")\n        }\n")?
            }
        }
        sprint(b, "    }\n    return\n")?
    }
}
