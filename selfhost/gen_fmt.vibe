// Compiler builtins (embed, panic, assert, __errname) and the lowering of `Fmt` arguments.
// Printing itself lives in the std. For every hole type the compiler generates a small
// Vibe thunk (as source text) that calls the `__fmt_*` hooks of the std.

import "gen_call.vibe";
import "gen_async.vibe";

str dir_of(str path) {
    const auto i = str_rfind_byte(path, '/');
    if (i < 0) { return "."; }
    if (i == 0) { return "/"; }
    return path[0..i];
}

!void src_str(List<u8>*b, str s) {
    b.push('"')?;
    for (auto c : s) {
        if (c == '"') {
            b.append("\\\"")?;
        } else if (c == '\\') {
            b.append("\\\\")?;
        } else if (c == '{') {
            b.append("\\\{")?;
        } else if (c == '}') {
            b.append("\\\}")?;
        } else if (c == '\n') {
            b.append("\\n")?;
        } else {
            b.push(c)?;
        }
    }
    b.push('"')?;
}

struct FPiece { str lit; str ptr; str thunk; str spec; bool has; }

bool Gen::is_builtin(str name) {
    match name {
        "panic", "assert", "embed", "asm", "__errname" => return true;
    }
    return false;
}

!Expr* Gen::mk_pre(Value v, i64 line) {
    this->pre_vals.push(v)?;
    const auto e = this->a.create<Expr>()?;
    e.k = .Pre;
    e.line = line;
    e.ival = (this->pre_vals.len - 1) as u64;
    return e;
}

!Value Gen::call_fn(str name, List<Expr*> args, i64 line) {
    if (!this->fns.has(name)) { this->err(line); eprintln("prelude missing '{name}'"); return error.CompileFailed; }
    return this->call_decl(this->fns.get(name)?, this->new_env()?, null, args, this->no_types(), null, line);
}

!Value Gen::gen_builtin(str name, List<Expr*> args, i64 line) {
    const auto void_v = Value{ .ty = this->t_void, .v = "" };
    if (name == "embed") {
        if (args.len != 1 || args.get(0).k != .StrLit) { this->err(line); eprintln("embed takes one string literal"); return error.CompileFailed };
        auto pb = this->sb();
        sprint(&pb, "{dir_of(this->file)}/{args.get(0).name}")?;
        const auto data = read_file(this->a, pb.slice()) catch {
            this->err(line); eprintln("embed: cannot read '{pb.slice()}'");
            return error.CompileFailed;
        };
        const auto gname = this->str_global(data)?;
        auto b = this->sb();
        sprint(&b, "{{ ptr {gname}, i64 {data.len} }}")?;
        return Value{ .ty = this->t_str, .v = b.slice() };
    }
    if (name == "asm") { return this->gen_asm(this->no_types(), args, line); }
    if (name == "__errname") {
        if (args.len != 1) { this->err(line); eprintln("__errname takes one argument"); return error.CompileFailed; }
        const auto v = this->gen_expr(args.get(0), null)?;
        if (v.ty.k != .ErrVal) { this->err(line); eprintln("__errname takes an error value"); return error.CompileFailed };
        const auto pp = this->tmp()?;
        sprint(this->ins()?, "  {pp} = getelementptr ptr, ptr @__vibe_errnames, i32 {v.v}\n")?;
        const auto sp = this->load(this->t_ptr_u8, pp)?;
        const auto lp = this->tmp()?;
        sprint(this->ins()?, "  {lp} = getelementptr i64, ptr @__vibe_errlens, i32 {v.v}\n")?;
        const auto sl = this->load(this->t_i64, lp)?;
        const auto s1 = this->insert(this->t_str, "undef", sp, 0)?;
        return Value{ .ty = this->t_str, .v = this->insert(this->t_str, s1, sl, 1)? };
    }
    if (name == "panic") {
        this->gen_fail(args, 0, false, line)?;
        return void_v;
    }
    if (name == "assert") {
        if (args.len != 1) { this->err(line); eprintln("assert takes one argument"); return error.CompileFailed; }
        const auto c = this->gen_cond(args.get(0))?;
        const auto lbad = this->new_label("afail")?;
        const auto lok = this->new_label("aok")?;
        sprint(this->ins()?, "  br i1 {c.v}, label %{lok}, label %{lbad}\n")?;
        this->terminated = true;
        this->label(lbad)?;
        this->gen_fail(args, 1, true, line)?;
        this->label(lok)?;
        return void_v;
    }
    this->err(line); eprintln("unknown builtin '{name}'");
    return error.CompileFailed;
}

!Value Gen::gen_asm(List<Type*> targs, List<Expr*> args, i64 line) {
    if (args.len < 2 || args.get(0).k != .StrLit || args.get(1).k != .StrLit) {
        this->err(line); eprintln("asm takes a template string, a constraint string and the operands");
        return error.CompileFailed;
    }
    auto ret = this->t_void;
    if (targs.len > 0) { ret = targs.get(0); }
    auto vals = this->sb();
    for (auto [i, x] : args) {
        if (i < 2) { continue; }
        const auto v = this->gen_expr(x, null)?;
        if (v.ty.k == .Void || is_agg_type(v.ty)) { this->err(line); eprintln("asm operands must be scalars"); return error.CompileFailed; }
        if (vals.len > 0) { vals.append(", ")?; }
        sprint(&vals, "{this->llty(v.ty)?} {v.v}")?;
    }
    auto tmpl = this->sb();
    for (auto c : args.get(0).name) {
        if (c == '"' || c == '\\') { sprint(&tmpl, "\\{c:02X}")?; } else if (c == '\n') { tmpl.append("\\0A")?; } else { tmpl.push(c)?; }
    }
    if (ret.k == .Void) {
        sprint(this->ins()?, "  call void asm sideeffect \"{tmpl.slice()}\", \"{args.get(1).name}\"({vals.slice()})\n")?;
        return Value{ .ty = this->t_void, .v = "" };
    }
    const auto t = this->tmp()?;
    sprint(this->ins()?, "  {t} = call {this->llty(ret)?} asm sideeffect \"{tmpl.slice()}\", \"{args.get(1).name}\"({vals.slice()})\n")?;
    return Value{ .ty = ret, .v = t };
}

bool is_agg_type(Type* t) { return t.k == .Strct || t.k == .Array || t.k == .Slice || t.k == .Closure || t.k == .Errun; }

!void Gen::gen_fail(List<Expr*> args, i64 from, bool is_assert, i64 line) {
    if (!is_assert && args.len != 1) { this->err(line); eprintln("panic takes one argument"); return error.CompileFailed; }
    const auto fv = this->gen_fmt(args, from, Value{ .ty = null, .v = "" })?;
    auto call_args = List<Expr*>::init(this->a);
    const auto fe = this->a.create<Expr>()?;
    fe.k = .StrLit;
    fe.line = line;
    fe.name = this->file;
    call_args.push(fe)?;
    const auto le = this->a.create<Expr>()?;
    le.k = .IntLit;
    le.line = line;
    le.ival = line as u64;
    call_args.push(le)?;
    const auto be = this->a.create<Expr>()?;
    be.k = .BoolLit;
    be.line = line;
    be.bval = is_assert;
    call_args.push(be)?;
    call_args.push(this->mk_pre(fv, line)?)?;
    _ = this->call_fn("__panic", call_args, line)?;
    sprint(this->ins()?, "  unreachable\n")?;
    this->terminated = true;
}

!Type* Gen::fmt_type() {
    const auto te = this->a.create<TypeExpr>()?;
    te.k = .Name;
    te.name = "Fmt";
    te.args = List<TypeExpr*>::init(this->a);
    return this->resolve_type(te, this->new_env()?);
}

!Value Gen::str_value(str s) {
    if (s.len == 0) { return Value{ .ty = this->t_str, .v = "{{ ptr null, i64 0 }}" } }
    auto b = this->sb();
    sprint(&b, "{{ ptr {this->str_global(s)?}, i64 {s.len} }}")?;
    return Value{ .ty = this->t_str, .v = b.slice() };
}

/// Builds a `Fmt` value on the stack from call arguments `args[from..]`.
!Value Gen::gen_fmt(List<Expr*> args, i64 from, Value first) {
    auto pieces = List<FPiece>::init(this->a);
    auto cur = this->sb();
    for (auto i : from..args.len) {
        const auto x = args.get(i);
        if (i > from) { cur.push(' ')?; }
        if (x.k == .Interp) {
            for (auto p : x.parts) {
                if (p.kind == 0) {
                    cur.append(p.lit)?;
                } else {
                    auto spec = "";
                    if (p.kind == 2) { spec = p.spec; }
                    this->fmt_hole(&pieces, &cur, p.e, spec, false, first)?;
                }
            }
        } else if (x.k == .StrLit) {
            cur.append(x.name)?;
        } else {
            this->fmt_hole(&pieces, &cur, x, "", i == from, first)?;
        }
    }
    const auto ft = this->fmt_type()?;
    const auto sl = ft.si.fields.get(0).ty;
    const auto pt = sl.elem;
    auto slice_v = "";
    if (pieces.len == 0) {
        slice_v = this->insert(sl, "undef", Value{ .ty = this->t_ptr_u8, .v = "null" }, 0)?;
        slice_v = this->insert(sl, slice_v, Value{ .ty = this->t_i64, .v = "0" }, 1)?;
    } else {
        const auto arr = this->mk_elem(.Array, pt)?;
        arr.len = pieces.len as u64;
        const auto slot = this->alloca(arr, "fmtp")?;
        for (auto [i, pc] : pieces) {
            const auto ep = this->tmp()?;
            sprint(this->ins()?, "  {ep} = getelementptr {this->llty(pt)?}, ptr {slot}, i64 {i}\n")?;
            this->store(this->str_value(pc.lit)?, this->gep_field(pt, ep, 0)?)?;
            this->store(Value{ .ty = this->t_ptr_u8, .v = pc.ptr }, this->gep_field(pt, ep, 1)?)?;
            this->store(Value{ .ty = pt.si.fields.get(2).ty, .v = pc.thunk }, this->gep_field(pt, ep, 2)?)?;
            this->store(this->str_value(pc.spec)?, this->gep_field(pt, ep, 3)?)?;
        }
        slice_v = this->insert(sl, "undef", Value{ .ty = this->t_ptr_u8, .v = slot }, 0)?;
        slice_v = this->insert(sl, slice_v, Value{ .ty = this->t_i64, .v = this->num(pieces.len)? }, 1)?;
    }
    const auto f1 = this->insert(ft, "undef", Value{ .ty = sl, .v = slice_v }, 0)?;
    const auto f2 = this->insert(ft, f1, this->str_value(cur.slice())?, 1)?;
    return Value{ .ty = ft, .v = f2 };
}

!void Gen::fmt_hole(List<FPiece>*pieces, List<u8>*cur, Expr* e, str spec, bool is_first, Value first) {
    auto v = first;
    if (!is_first || first.ty == null) { v = this->gen_expr(e, null)?; }
    if (v.ty.k == .Void) { cur.append("void")?; return };
    if (v.ty.k == .Null) { cur.append("(nil)")?; return };
    if (spec.len > 0 && !this->user_fmt(v.ty)) { this->check_spec(spec, e.line)?; }
    const auto thunk = this->fmt_thunk(v.ty)?;
    const auto slot = this->spill(v)?;
    auto tn = this->sb();
    sprint(&tn, "@vb.__ff{thunk}")?;
    pieces.push(FPiece{ .lit = cur.slice(), .ptr = slot.v, .thunk = tn.slice(), .spec = spec, .has = true })?;
    *cur = this->sb();
}

!void Gen::check_spec(str spec, i64 line) {
    auto i = 0;
    while (i < spec.len && str_find_byte("-+ 0#", spec[i]) >= 0) { i += 1; }
    auto width = 0;
    while (i < spec.len && spec[i] >= '0' && spec[i] <= '9' && width <= 4096) {
        width = width * 10 + (spec[i] - '0') as i64;
        i += 1;
    }
    auto prec = 0;
    if (i < spec.len && spec[i] == '.') {
        i += 1;
        while (i < spec.len && spec[i] >= '0' && spec[i] <= '9' && prec <= 4096) {
            prec = prec * 10 + (spec[i] - '0') as i64;
            i += 1;
        }
    }
    if (i < spec.len && ((spec[i] >= 'a' && spec[i] <= 'z') || (spec[i] >= 'A' && spec[i] <= 'Z'))) { i += 1; }
    if (i == spec.len && width <= 4096 && prec <= 4096) { return; }
    this->err(line);
    eprintln("bad format '{spec}' after ':': a format is [flags][width][.precision][letter], like {{x:08X}} or {{pi:.3}}; to print a literal brace write {{{{ or }}}}");
    return error.CompileFailed;
}

/// Returns the id of the thunk that formats values of type `t`, generating it on first use.
!i64 Gen::fmt_thunk(Type* t) {
    const auto key = this->mangle(t)?;
    if (this->thunks.has(key)) { return this->thunks.get(key); }
    const auto id = this->thunks.len;
    this->thunks.put(key, id)?;
    auto tn = this->sb();
    sprint(&tn, "__ft{id}")?;
    this->rtypes.put(tn.slice(), t)?;
    auto src = this->sb();
    sprint(&src, "!void __ff{id}(Writer* w, void* p, str spec, i64 d) {{\n")?;
    this->thunk_body(&src, t, tn.slice())?;
    src.append("}\n")?;
    const auto toks = tokenize(this->a, src.slice(), "<fmt>")?;
    auto ps = new_parser(this->a, toks.slice(), "<fmt>");
    const auto decls = ps.parse_file()?;
    const auto saved = this->file;
    this->add_decls(decls, "<fmt>")?;
    this->file = saved;
    auto fname = this->sb();
    sprint(&fname, "__ff{id}")?;
    _ = this->inst_fn(this->fns.get(fname.slice())?, this->new_env()?, this->no_types())?;
    return id;
}

bool Gen::user_fmt(Type* t) {
    const auto rn = recv_name(t);
    if (rn.len == 0) { return false; }
    auto kb = this->sb();
    sprint(&kb, "{rn}.fmt") catch return false;
    return this->methods.has(kb.slice());
}

!void Gen::thunk_body(List<u8>*b, Type* t, str tn) {
    if (this->user_fmt(t)) {
        sprint(b, "    auto q = p as *{tn};\n    return q.fmt(w, spec);\n")?;
        return;
    }
    match t.k {
        .Int => {
            if (t.signed) { sprint(b, "    return __fmt_int(w, *(p as *{tn}) as i64, spec);\n")?; } else { sprint(b, "    return __fmt_uint(w, *(p as *{tn}) as u64, spec);\n")?; }
        }
        .Float => sprint(b, "    return __fmt_float(w, *(p as *{tn}) as f64, spec);\n")?;
        .Bool => sprint(b, "    return __fmt_bool(w, *(p as *{tn}), spec);\n")?;
        .Ptr => sprint(b, "    return __fmt_ptr(w, *(p as *u64), spec);\n")?;
        .Func => sprint(b, "    __fmt_lit(w, \"fn@\")?;\n    return __fmt_ptr(w, *(p as *u64), spec);\n")?;
        .Closure => sprint(b, "    return __fmt_lit(w, \"closure\");\n")?;
        .Null => sprint(b, "    return __fmt_lit(w, \"(nil)\");\n")?;
        .Void => sprint(b, "    return __fmt_lit(w, \"void\");\n")?;
        .ErrVal => sprint(b, "    __fmt_lit(w, \"error.\")?;\n    return __fmt_lit(w, __errname(*(p as *{tn})));\n")?;
        .Enm => {
            sprint(b, "    match *(p as *{tn}) {{\n")?;
            for (auto v : t.ei.decl.variants) {
                sprint(b, "        .{v} => return __fmt_lit(w, ")?;
                auto lit = this->sb();
                lit.push('.')?;
                lit.append(v)?;
                src_str(b, lit.slice())?;
                b.append(");\n")?;
            }
            sprint(b, "    }\n    return __fmt_lit(w, \".?\");\n")?;
        }
        .Strct => {
            if (t.si.decl.is_union) { this->union_body(b, t, tn)?; } else { this->struct_body(b, t, tn)?; }
        }
        .Array => {
            if (t.elem.k == .Void) { sprint(b, "    return __fmt_lit(w, \"[]\");\n")?; return };
            const auto c = this->fmt_thunk(t.elem)?;
            auto n = t.len as i64;
            if (n > 32) { n = 32; }
            sprint(b, "    auto q = p as *__ft{c};\n    __fmt_lit(w, \"[\")?;\n    for (auto i : 0..{n}) {{\n        if (i > 0) {{ __fmt_lit(w, \", \")?; }}\n        __ff{c}(w, &q[i], \"\", d + 1)?;\n    }}\n")?;
            if (t.len as i64 > n) { sprint(b, "    __fmt_lit(w, \", ...\")?;\n")?; }
            sprint(b, "    return __fmt_lit(w, \"]\");\n")?;
        }
        .Slice => {
            if (is_str(t)) {
                sprint(b, "    return __fmt_str(w, *(p as *{tn}), spec, d > 0);\n")?;
                return;
            }
            const auto c = this->fmt_thunk(t.elem)?;
            auto head = this->sb();
            sprint(&head, "{this->type_name(t.elem)?}[](len=")?;
            sprint(b, "    auto s = *(p as *{tn});\n    if (d > 0) {{\n        __fmt_lit(w, ")?;
            src_str(b, head.slice())?;
            sprint(b, ")?;\n        __fmt_int(w, s.len, \"\")?;\n        return __fmt_lit(w, \")\");\n    }\n")?;
            sprint(b, "    __fmt_lit(w, \"[\")?;\n    for (auto i : 0..s.len) {{\n        if (i > 0) {{ __fmt_lit(w, \", \")?; }}\n        __ff{c}(w, &s[i], \"\", d + 1)?;\n    }}\n    return __fmt_lit(w, \"]\");\n")?;
        }
        .Errun => {
            const auto tail = "    r catch |e| {{\n        __fmt_lit(w, \"error.\")?;\n        __fmt_lit(w, __errname(e))?;\n        return;\n    }};\n";
            sprint(b, "    auto r = *(p as *{tn});\n")?;
            if (t.elem.k == .Void) {
                sprint(b, "{tail}    return __fmt_lit(w, \"void\");\n")?;
            } else {
                const auto c = this->fmt_thunk(t.elem)?;
                sprint(b, "    auto v = r catch |e| {{\n        __fmt_lit(w, \"error.\")?;\n        __fmt_lit(w, __errname(e))?;\n        return;\n    }};\n    return __ff{c}(w, &v, \"\", d);\n")?;
            }
        }
    }
}

!void Gen::struct_body(List<u8>*b, Type* t, str tn) {
    const auto si = t.si;
    sprint(b, "    auto q = p as *{tn};\n    __fmt_lit(w, ")?;
    auto head = this->sb();
    sprint(&head, "{si.display}{{ ")?;
    src_str(b, head.slice())?;
    b.append(")?;\n")?;
    for (auto [i, f] : si.fields) {
        auto lab = this->sb();
        if (i > 0) { lab.append(", ")?; }
        sprint(&lab, "{f.name}: ")?;
        sprint(b, "    __fmt_lit(w, ")?;
        src_str(b, lab.slice())?;
        b.append(")?;\n")?;
        const auto c = this->fmt_thunk(f.ty)?;
        sprint(b, "    if (d > 4) {{ __fmt_lit(w, \"...\")?; }} else {{ __ff{c}(w, &q.{f.name}, \"\", d + 1)?; }}\n")?;
    }
    sprint(b, "    return __fmt_lit(w, ")?;
    src_str(b, " }")?;
    b.append(");\n")?;
}

!void Gen::union_body(List<u8>*b, Type* t, str tn) {
    const auto si = t.si;
    sprint(b, "    auto q = p as *{tn};\n    match *q {{\n")?;
    for (auto f : si.fields) {
        auto name = this->sb();
        sprint(&name, "{si.display}.{f.name}")?;
        if (f.ty.k == .Void) {
            sprint(b, "        .{f.name} => return __fmt_lit(w, ")?;
            src_str(b, name.slice())?;
            b.append(");\n")?;
        } else {
            const auto c = this->fmt_thunk(f.ty)?;
            auto open = this->sb();
            sprint(&open, "{name.slice()}(")?;
            sprint(b, "        .{f.name}(v) => {{\n            if (d > 0) {{ return __fmt_lit(w, ")?;
            src_str(b, name.slice())?;
            b.append("); }\n            __fmt_lit(w, ")?;
            src_str(b, open.slice())?;
            sprint(b, ")?;\n            auto tv = v;\n            __ff{c}(w, &tv, \"\", d + 1)?;\n            return __fmt_lit(w, \")\");\n        }\n")?;
        }
    }
    sprint(b, "    }\n    return;\n")?;
}
