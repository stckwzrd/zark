// Loads a program: the prelude, a root file and everything it imports.

import "gen_fmt.vibe";
import "resolve.vibe";

const auto PRELUDE = embed("../std/std.vibe");

// Standard library modules, embedded like the prelude. `import "std/fs" as fs;` loads "<std>/fs.vibe".
const auto STD_FS = embed("../std/fs.vibe");
const auto STD_PATH = embed("../std/path.vibe");
const auto STD_TIME = embed("../std/time.vibe");
const auto STD_JSON = embed("../std/json.vibe");
const auto STD_ARGS = embed("../std/args.vibe");
const auto STD_OS = embed("../std/os.vibe");
const auto STD_NET = embed("../std/net.vibe");
const auto STD_HTTP = embed("../std/http.vibe");
const auto STD_THREAD = embed("../std/thread.vibe");

/// the embedded source of "<std>/name.vibe"
!str std_source(str path) {
    match path {
        "<std>/fs.vibe" => return STD_FS;
        "<std>/path.vibe" => return STD_PATH;
        "<std>/time.vibe" => return STD_TIME;
        "<std>/json.vibe" => return STD_JSON;
        "<std>/args.vibe" => return STD_ARGS;
        "<std>/os.vibe" => return STD_OS;
        "<std>/net.vibe" => return STD_NET;
        "<std>/http.vibe" => return STD_HTTP;
        "<std>/thread.vibe" => return STD_THREAD;
    }
    return error.NotFound;
}

bool is_std_path(str path) { return str_starts_with(path, "<std>/"); }

// dependencies of the current project: name -> directory, and name -> the file `import "name"` loads
Map<str> dep_dirs = Map<str>{};
Map<str> dep_libs = Map<str>{};

!void register_dep(str name, str dir, str lib) {
    if (dep_dirs.a.alloc_fn == null) {
        dep_dirs = Map<str>::init(c_allocator());
        dep_libs = Map<str>::init(c_allocator());
    }
    dep_dirs.put(name, dir)?;
    dep_libs.put(name, lib)?;
}

/// the file an `import "rel"` written in directory `dir` refers to
!str import_target(Allocator a, str dir, str rel) {
    if (str_starts_with(rel, "std/") || dir == "<std>") {
        auto name = rel;
        if (str_starts_with(name, "std/")) { name = name[4..]; }
        auto b = List<u8>::init(a);
        if (str_ends_with(name, ".vibe")) { sprint(&b, "<std>/{name}")?; } else { sprint(&b, "<std>/{name}.vibe")?; }
        return b.slice();
    }
    if (dep_dirs.len > 0 && rel.len > 0 && rel[0] != '.' && rel[0] != '/') {
        const auto slash = str_find_byte(rel, '/');
        auto first = rel;
        if (slash >= 0) { first = rel[0..slash]; }
        if (dep_dirs.has(first)) {
            if (slash < 0) { return canonical(a, dep_libs.get(first)?); }
            auto b = List<u8>::init(a);
            sprint(&b, "{dep_dirs.get(first)?}/{rel[slash + 1..]}")?;
            if (!str_ends_with(rel, ".vibe")) { b.append(".vibe")?; }
            return canonical(a, b.slice());
        }
    }
    return canonical(a, join_path(a, dir, rel)?);
}

extern u8* realpath(u8* path, u8* resolved);

struct Loader {
    Allocator a;
    Gen* g;
    Map<str> seen;
    Map<str> prefixes;
    Map<str> overrides;

    !void load_source(str src, str path, str prefix) {
        auto toks = tokenize(this->a, src, path)?;
        auto p = new_parser(this->a, toks.slice(), path);
        const auto decls = p.parse_file()?;
        for (auto c : p.cts) { this->g.cts.put(c.name, c)?; }
        for (auto d : decls) { if (d.k == .Check) { this->g.ct_checks.push(d.ct)?; } }
        const auto dir = dir_of(path);
        auto renames = List<str>::init(this->a);
        for (auto d : decls) {
            if (d.k == .Import) {
                const auto actual = this->load_file(import_target(this->a, dir, d.path)?, d.alias)?;
                if (d.alias.len > 0 && actual != d.alias) {
                    renames.push(d.alias)?;
                    renames.push(actual)?;
                }
            }
        }
        if (prefix.len > 0) { resolve_module(this->a, decls, prefix)?; }
        auto k = 0;
        while (k < renames.len) {
            alias_module(this->a, decls, renames.get(k), renames.get(k + 1))?;
            k += 2;
        }
        this->g.add_decls(decls, path)?;
    }

    /// loads a file once; returns the name its declarations live under (the first import's)
    !str load_file(str path, str prefix) {
        auto key = path;
        if (!is_std_path(path) && !this->overrides.has(path)) { key = canonical(this->a, path)?; }
        if (this->seen.has(key)) {
            const auto old = this->seen.get(key)?;
            if (old != prefix && prefix.len == 0) {
                eprintln("error: '{path}' is imported as '{old}' elsewhere, so a plain import cannot see its names; write `import \"...\" as {old};`");
                return error.CompileFailed;
            }
            return old;
        }
        if (prefix.len > 0 && this->prefixes.has(prefix)) {
            eprintln("error: the name '{prefix}' is already used for '{this->prefixes.get(prefix)?}'; pick another name for '{path}'");
            return error.CompileFailed;
        }
        this->seen.put(key, prefix)?;
        if (prefix.len > 0) { this->prefixes.put(prefix, path)?; }
        if (this->overrides.has(path)) {
            this->load_source(this->overrides.get(path)?, path, prefix)?;
            return prefix;
        }
        if (is_std_path(path)) {
            const auto ssrc = std_source(path) catch {
                eprintln("error: there is no standard module '{path[6..path.len - 5]}' (available: fs, path, time, json, args, os, net, http, thread)");
                return error.CompileFailed;
            };
            if (diag_files.a.alloc_fn == null) { diag_files = Map<str>::init(c_allocator()); }
            diag_files.put(path, ssrc)?;
            this->load_source(ssrc, path, prefix)?;
            return prefix;
        }
        const auto src = read_file(this->a, path) catch |e| {
            eprintln("error: cannot read '{path}': {e}");
            return error.CompileFailed;
        };
        this->load_source(src, path, prefix)?;
        return prefix;
    }
}

!str canonical(Allocator a, str path) {
    u8[4096] pbuf;
    u8[4096] out;
    const auto r = realpath(to_cstr(pbuf[..], path)?, out.ptr);
    if (r == null) { return a.dup(path); }
    return a.dup(cstr(r));
}

!str join_path(Allocator a, str dir, str rel) {
    if (rel.len > 0 && rel[0] == '/') { return rel; }
    auto b = List<u8>::init(a);
    sprint(&b, "{dir}/{rel}")?;
    return b.slice();
}
