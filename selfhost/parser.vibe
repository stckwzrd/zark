// Recursive-descent parser: tokens -> AST. Mirrors src/parser.zig.

import "ast.vibe";
import "parser_new.vibe";

struct Parser {
    Allocator a;
    Token[] toks;
    i64 pos;
    str file;
    bool no_struct;
    List<str> aliases;
    bool quiet;
    bool no_post;
    bool arrow_only;
    List<i64> splits;

    Token peek() { return this->toks[this->pos] };
    Token peek_at(i64 n) {
        auto i = this->pos + n;
        if (i > this->toks.len - 1) { i = this->toks.len - 1; }
        return this->toks[i];
    };
    bool at(Tag t) { return this->toks[this->pos].tag == t; }
    Token advance() {
        const auto t = this->toks[this->pos];
        if (this->pos < this->toks.len - 1) { this->pos += 1; }
        return t;
    };
    bool eat(Tag t) {
        if (this->at(t)) {
            _ = this->advance();
            return true;
        }
        return false;
    }
    !void fail(str msg) {
        const auto t = this->peek();
        if (!this->quiet) {
            eprintln("{this->file}:{t.line}: error: {msg} (near '{t.text}')");
            show_source(this->file, t.line, t.off);
        }
        return error.ParseFailed;
    }
    !Token expect(Tag t) {
        if (!this->at(t)) {
            const auto cur = this->peek();
            if (!this->quiet) {
                eprintln("{this->file}:{cur.line}: error: expected {t} (near '{cur.text}')");
                show_source(this->file, cur.line, cur.off);
            }
            return error.ParseFailed;
        }
        return this->advance();
    };
    void skip_semis() { while (this->at(.semi)) { _ = this->advance(); } }

    // ---------------------------------------------------------------- node helpers
    !Expr* ex(EK k, Token t) {
        const auto e = this->a.create<Expr>()?;
        e.k = k;
        e.line = t.line;
        e.off = t.off;
        e.args = List<Expr*>::init(this->a);
        e.fields = List<FieldInit>::init(this->a);
        e.parts = List<IPart>::init(this->a);
        e.arms = List<MatchArm>::init(this->a);
        return e;
    };
    !Stmt* st(SK k, Token t) {
        const auto s = this->a.create<Stmt>()?;
        s.k = k;
        s.line = t.line;
        s.off = t.off;
        s.stmts = List<Stmt*>::init(this->a);
        s.arms = List<MatchArm>::init(this->a);
        return s;
    };
    !TypeExpr* te(TEK k) {
        const auto t = this->a.create<TypeExpr>()?;
        t.k = k;
        t.off = -1;
        t.args = List<TypeExpr*>::init(this->a);
        return t;
    };
    !TypeExpr* te_name(str name) {
        const auto t = this->te(.Name)?;
        t.name = name;
        return t;
    };
    List<str> strs() { return List<str>::init(this->a); }

    // ---------------------------------------------------------------- declarations
    !List<Decl> parse_file() {
        auto decls = List<Decl>::init(this->a);
        this->skip_semis();
        while (!this->at(.eof)) {
            this->parse_decl(&decls)?;
            this->skip_semis();
        }
        return decls;
    }

    !List<str> parse_type_params(List<str>*cons) {
        auto list = this->strs();
        if (this->eat(.lbracket)) {
            while (!this->at(.rbracket)) {
                list.push(this->expect(.ident)?.text)?;
                if (this->eat(.colon)) { cons.push(this->expect(.ident)?.text)?; } else { cons.push("")?; }
                if (!this->eat(.comma)) { break; }
            }
            _ = this->expect(.rbracket)?;
        } else if (this->eat(.lt)) {
            while (!this->at(.gt)) {
                list.push(this->expect(.ident)?.text)?;
                if (this->eat(.colon)) { cons.push(this->expect(.ident)?.text)?; } else { cons.push("")?; }
                if (!this->eat(.comma)) { break; }
            }
            this->expect_gt()?;
        }
        return list;
    }

    !void parse_decl(List<Decl>*out) {
        const auto t = this->peek();
        auto d = Decl{ .k = .Import, .line = t.line };
        if (t.tag == .ident && t.text == "test" && this->peek_at(1).tag == .str_lit) {
            _ = this->advance();
            const auto name = this->advance().text;
            const auto ret = this->te(.Errun)?;
            ret.elem = this->te_name("void")?;
            const auto f = this->a.create<FnDecl>()?;
            const auto body = this->parse_block()?;
            *f = FnDecl{
                .name = "test", .type_params = this->strs(), .params = List<Param>::init(this->a), .ret = ret,
                .body = body, .line = t.line, .file = this->file, .receiver_params = this->strs(),
                .is_test = true, .test_name = name, .name_off = t.off, .end_off = body.end_off
            };
            out.push(Decl{ .k = .Func, .f = f, .line = t.line })?;
            return;
        }
        match t.tag {
            .kw_import => {
                _ = this->advance();
                const auto pt = this->expect(.str_lit)?;
                d.path = pt.text;
                d.path_off = pt.off;
                if (this->eat(.kw_as)) {
                    const auto at = this->expect(.ident)?;
                    d.alias = at.text;
                    d.name_off = at.off;
                    this->aliases.push(d.alias)?;
                }
            }
            .kw_type => {
                _ = this->advance();
                d.k = .Alias;
                const auto an = this->expect(.ident)?;
                d.path = an.text;
                d.name_off = an.off;
                _ = this->expect(.eq)?;
                d.ty = this->parse_type()?;
            }
            .kw_fn => {
                d.k = .Func;
                d.f = this->parse_fn("", this->strs(), 0)?;
            }
            .kw_extern, .kw_export => {
                if (this->peek_at(1).tag == .kw_fn || (this->peek_at(1).tag == .kw_extern && this->peek_at(2).tag == .kw_fn) || (this->peek_at(1).tag == .kw_export && this->peek_at(2).tag == .kw_fn)) {
                    d.k = .Func;
                    d.f = this->parse_fn("", this->strs(), 0)?;
                } else {
                    this->parse_decl_new(out)?;
                    return;
                }
            }
            .kw_struct, .kw_union => {
                const auto is_union = this->advance().tag == .kw_union;
                const auto nt = this->expect(.ident)?;
                const auto name = nt.text;
                auto cons = this->strs();
                const auto tps = this->parse_type_params(&cons)?;
                _ = this->expect(.lbrace)?;
                auto fields = List<Field>::init(this->a);
                this->skip_semis();
                while (!this->at(.rbrace)) {
                    if (this->new_member(is_union)) {
                        this->parse_member_new(name, tps, is_union, &fields, out)?;
                        this->skip_semis();
                        continue;
                    }
                    const auto ft = this->expect(.ident)?;
                    const auto fname = ft.text;
                    TypeExpr* fty = null;
                    if (is_union && !this->at(.colon)) {
                        fty = this->te_name("void")?;
                    } else {
                        _ = this->expect(.colon)?;
                        fty = this->parse_type()?;
                    }
                    fields.push(Field{ .name = fname, .ty = fty, .off = ft.off })?;
                    _ = this->eat(.comma);
                    this->skip_semis();
                }
                _ = this->expect(.rbrace)?;
                const auto sd = this->a.create<StructDecl>()?;
                *sd = StructDecl{ .name = name, .type_params = tps, .constraints = cons, .fields = fields, .line = t.line, .name_off = nt.off, .is_union = is_union };
                d.k = .Struct;
                d.s = sd;
            }
            .kw_enum => {
                _ = this->advance();
                const auto nt = this->expect(.ident)?;
                const auto name = nt.text;
                _ = this->expect(.lbrace)?;
                auto vs = this->strs();
                auto voffs = List<i64>::init(this->a);
                this->skip_semis();
                auto no_fields = List<Field>::init(this->a);
                while (!this->at(.rbrace)) {
                    const auto nx = this->peek_at(1).tag;
                    if (!(this->at(.ident) && (nx == .comma || nx == .semi || nx == .rbrace))) {
                        this->parse_member_new(name, this->strs(), false, &no_fields, out)?;
                        this->skip_semis();
                        continue;
                    }
                    const auto vt = this->expect(.ident)?;
                    vs.push(vt.text)?;
                    voffs.push(vt.off)?;
                    _ = this->eat(.comma);
                    this->skip_semis();
                }
                _ = this->expect(.rbrace)?;
                const auto ed = this->a.create<EnumDecl>()?;
                *ed = EnumDecl{ .name = name, .variants = vs, .variant_offs = voffs, .line = t.line, .name_off = nt.off };
                d.k = .Enum;
                d.en = ed;
            }
            .kw_impl => {
                _ = this->advance();
                const auto rt = this->expect(.ident)?;
                const auto name = rt.text;
                auto ignored = this->strs();
                const auto tps = this->parse_type_params(&ignored)?;
                _ = this->expect(.lbrace)?;
                this->skip_semis();
                while (!this->at(.rbrace)) {
                    const auto m = Decl{ .k = .Func, .f = this->parse_fn(name, tps, rt.off)?, .line = t.line };
                    out.push(m)?;
                    this->skip_semis();
                }
                _ = this->expect(.rbrace)?;
                return;
            }
            .kw_const, .kw_var => {
                if (t.tag == .kw_const && !(this->peek_at(1).tag == .ident && (this->peek_at(2).tag == .eq || this->peek_at(2).tag == .colon))) {
                    this->parse_decl_new(out)?;
                    return;
                }
                _ = this->advance();
                const auto nt = this->expect(.ident)?;
                const auto name = nt.text;
                TypeExpr* ty = null;
                if (this->eat(.colon)) { ty = this->parse_type()?; }
                _ = this->expect(.eq)?;
                const auto v = this->parse_expr()?;
                const auto cd = this->a.create<ConstDecl>()?;
                *cd = ConstDecl{ .name = name, .ty = ty, .value = v, .mutable = t.tag == .kw_var, .line = t.line, .name_off = nt.off };
                d.k = .Const;
                d.c = cd;
            }
            .kw_template, .kw_static, .ident, .bang, .question, .star => {
                this->parse_decl_new(out)?;
                return;
            }
            _ => {
                this->fail("expected declaration")?;
            }
        }
        out.push(d)?;
    }

    !List<Param> parse_param_list(i64 line, bool* variadic) {
        _ = this->expect(.lparen)?;
        auto params = List<Param>::init(this->a);
        while (!this->at(.rparen)) {
            if (this->eat(.ellipsis)) {
                *variadic = true;
                break;
            }
            const auto pt = this->expect(.ident)?;
            const auto pname = pt.text;
            TypeExpr* pty = null;
            if (this->eat(.colon)) {
                pty = this->parse_type()?;
            } else if (pname == "self") {
                pty = this->te(.Ptr)?;
                pty.elem = this->te_name("Self")?;
            } else {
                eprintln("{this->file}:{line}: error: parameter '{pname}' needs a type");
                show_source(this->file, line, -1);
                return error.ParseFailed;
            }
            params.push(Param{ .name = pname, .ty = pty, .off = pt.off })?;
            if (!this->eat(.comma)) { break; }
        }
        _ = this->expect(.rparen)?;
        return params;
    }

    !Expr* parse_closure(Token t) {
        const auto e = this->ex(.Closure, t)?;
        _ = this->expect(.lbracket)?;
        auto caps = this->strs();
        auto cap_offs = List<i64>::init(this->a);
        while (!this->at(.rbracket)) {
            const auto ct = this->expect(.ident)?;
            caps.push(ct.text)?;
            cap_offs.push(ct.off)?;
            if (!this->eat(.comma)) { break; }
        }
        _ = this->expect(.rbracket)?;
        auto variadic = false;
        const auto params = this->parse_param_list(t.line, &variadic)?;
        TypeExpr* ret = null;
        if (!this->at(.lbrace)) { ret = this->parse_type()?; }
        const auto f = this->a.create<FnDecl>()?;
        *f = FnDecl{
            .name = "closure", .type_params = this->strs(), .constraints = this->strs(), .params = params, .ret = ret,
            .body = this->parse_block()?, .line = t.line, .file = this->file, .receiver_params = this->strs(), .captures = caps, .capture_offs = cap_offs
        };
        f.end_off = f.body.end_off;
        e.func = f;
        return e;
    };

    !FnDecl* parse_fn(str receiver, List<str> recv_params, i64 recv_off) {
        const auto is_extern = this->eat(.kw_extern);
        const auto is_export = this->eat(.kw_export);
        const auto line = this->expect(.kw_fn)?.line;
        const auto nt = this->expect(.ident)?;
        const auto name = nt.text;
        auto cons = this->strs();
        const auto tps = this->parse_type_params(&cons)?;
        auto variadic = false;
        const auto params = this->parse_param_list(line, &variadic)?;
        TypeExpr* ret = null;
        if (!this->at(.lbrace) && !this->at(.semi) && !this->at(.eof)) { ret = this->parse_type()?; }
        Stmt* body = null;
        if (!is_extern) { body = this->parse_block()?; }
        const auto f = this->a.create<FnDecl>()?;
        *f = FnDecl{
            .name = name, .type_params = tps, .constraints = cons, .params = params, .ret = ret, .body = body,
            .is_extern = is_extern, .is_export = is_export, .variadic = variadic, .line = line,
            .file = this->file, .receiver = receiver, .receiver_params = recv_params, .name_off = nt.off, .receiver_off = recv_off
        };
        if (body != null) { f.end_off = body.end_off; }
        return f;
    };

    !TypeExpr* parse_type() {
        if (this->eat(.kw_fn)) {
            const auto t = this->te(.Func)?;
            if (this->eat(.lbracket)) {
                _ = this->expect(.rbracket)?;
                t.closure = true;
            }
            _ = this->expect(.lparen)?;
            while (!this->at(.rparen)) {
                t.args.push(this->parse_type()?)?;
                if (!this->eat(.comma)) { break; }
            }
            _ = this->expect(.rparen)?;
            if (this->eat(.arrow)) {
                t.ret = this->parse_type()?;
            } else if (!this->arrow_only && starts_type(this->peek().tag)) {
                t.ret = this->parse_type()?;
            }
            return this->type_suffix(t);
        }
        if (this->eat(.star)) {
            const auto t = this->te(.Ptr)?;
            t.elem = this->parse_type()?;
            return t;
        }
        if (this->eat(.bang)) {
            const auto t = this->te(.Errun)?;
            t.elem = this->parse_type()?;
            return t;
        }
        if (this->eat(.question)) {
            const auto t = this->te_name("Option")?;
            t.args.push(this->parse_type()?)?;
            return t;
        }
        if (this->eat(.lbracket)) {
            if (this->eat(.rbracket)) {
                const auto t = this->te(.Slice)?;
                t.elem = this->parse_type()?;
                return t;
            }
            const auto t = this->te(.Array)?;
            t.len = this->parse_expr()?;
            _ = this->expect(.rbracket)?;
            t.elem = this->parse_type()?;
            return t;
        }
        const auto nt = this->expect(.ident)?;
        const auto t = this->te_name(this->qualified(nt.text)?)?;
        t.off = nt.off;
        if (this->at(.lbracket) && this->generic_brackets(t.name)) {
            _ = this->advance();
            while (!this->at(.rbracket)) {
                t.args.push(this->parse_type()?)?;
                if (!this->eat(.comma)) { break; }
            }
            _ = this->expect(.rbracket)?;
        } else if (this->at(.lt) && (!this->no_post || is_upper(nt.text[0]))) {
            _ = this->advance();
            while (!this->at(.gt) && !this->at(.shr)) {
                t.args.push(this->parse_type()?)?;
                if (!this->eat(.comma)) { break; }
            }
            this->expect_gt()?;
        }
        return this->type_suffix(t);
    };

    // ---------------------------------------------------------------- statements
    !Stmt* parse_block() {
        const auto lb = this->expect(.lbrace)?;
        const auto b = this->st(.Block, lb)?;
        const auto saved = this->no_struct;
        this->no_struct = false;
        this->skip_semis();
        while (!this->at(.rbrace)) {
            if (this->at(.eof)) { this->fail("unexpected end of file in block")?; }
            b.stmts.push(this->parse_stmt()?)?;
            this->skip_semis();
        }
        const auto rb = this->expect(.rbrace)?;
        b.end_off = rb.off;
        this->no_struct = saved;
        return b;
    };

    !Expr* parse_cond() {
        const auto saved = this->no_struct;
        this->no_struct = true;
        defer this->no_struct = saved;
        return this->parse_expr();
    };

    !Stmt* parse_stmt() {
        const auto t = this->peek();
        match t.tag {
            .lbrace => return this->parse_block();
            .kw_let, .kw_var => {
                _ = this->advance();
                const auto s = this->st(.Let, t)?;
                const auto nt = this->expect(.ident)?;
                s.name = nt.text;
                s.name_off = nt.off;
                s.mutable = t.tag == .kw_var;
                if (this->eat(.colon)) { s.ty = this->parse_type()?; }
                if (this->eat(.eq)) { s.e = this->parse_expr()?; }
                if (s.ty == null && s.e == null) {
                    eprintln("{this->file}:{t.line}: error: '{s.name}' needs a type or initializer");
                    show_source(this->file, t.line, t.off);
                    return error.ParseFailed;
                }
                return s;
            }
            .kw_const => return this->parse_decl_stmt_new(t, true);
            .plusplus, .minusminus => {
                _ = this->advance();
                const auto target = this->parse_prefix()?;
                return this->incr_stmt(t, target, t.tag == .plusplus);
            }
            .kw_if => return this->parse_if();
            .kw_while => {
                _ = this->advance();
                const auto s = this->st(.While, t)?;
                s.e = this->parse_cond()?;
                s.body = this->parse_block()?;
                return s;
            }
            .kw_for => {
                _ = this->advance();
                if (this->at(.lparen)) { return this->parse_for_new(t); }
                const auto t1 = this->expect(.ident)?;
                const auto n1 = t1.text;
                auto n2 = "";
                auto off2 = 0;
                auto has2 = false;
                if (this->eat(.comma)) {
                    const auto t2 = this->expect(.ident)?;
                    n2 = t2.text;
                    off2 = t2.off;
                    has2 = true;
                }
                _ = this->expect(.kw_in)?;
                const auto e = this->parse_cond()?;
                if (this->eat(.dotdot)) {
                    if (has2) { this->fail("range loop takes a single variable")?; }
                    const auto s = this->st(.ForRange, t)?;
                    s.name = n1;
                    s.name_off = t1.off;
                    s.e = e;
                    s.e2 = this->parse_cond()?;
                    s.body = this->parse_block()?;
                    return s;
                }
                const auto s = this->st(.ForEach, t)?;
                s.e = e;
                s.body = this->parse_block()?;
                if (has2) {
                    s.idx = n1;
                    s.idx_off = t1.off;
                    s.has_idx = true;
                    s.name = n2;
                    s.name_off = off2;
                } else {
                    s.name = n1;
                    s.name_off = t1.off;
                }
                return s;
            }
            .kw_return => {
                _ = this->advance();
                const auto s = this->st(.Ret, t)?;
                if (!this->at(.semi) && !this->at(.rbrace)) { s.e = this->parse_expr()?; }
                return s;
            }
            .kw_break => {
                _ = this->advance();
                return this->st(.Brk, t);
            }
            .kw_continue => {
                _ = this->advance();
                return this->st(.Cont, t);
            }
            .kw_defer, .kw_errdefer => {
                _ = this->advance();
                const auto s = this->st(.Defer, t)?;
                s.is_err = t.tag == .kw_errdefer;
                s.body = this->parse_stmt()?;
                return s;
            }
            .kw_match => {
                _ = this->advance();
                const auto s = this->st(.Match, t)?;
                s.e = this->parse_cond()?;
                this->parse_match_arms(&s.arms)?;
                return s;
            }
        }
        if (t.tag == .ident || t.tag == .bang || t.tag == .question || (t.tag == .kw_fn && this->peek_at(1).tag == .lparen)) {
            const auto ds = this->try_decl_stmt(t)?;
            if (ds != null) { return ds; }
        }
        const auto e = this->parse_expr()?;
        const auto op = this->peek().tag;
        match op {
            .plusplus, .minusminus => {
                _ = this->advance();
                return this->incr_stmt(t, e, op == .plusplus);
            }
            .eq, .plus_eq, .minus_eq, .star_eq, .slash_eq, .percent_eq, .pipe_eq, .amp_eq, .caret_eq, .shl_eq, .shr_eq => {
                _ = this->advance();
                const auto s = this->st(.Assign, t)?;
                s.op = op;
                s.e2 = e;
                s.e = this->parse_expr()?;
                return s;
            }
        }
        const auto s = this->st(.ExprS, t)?;
        s.e = e;
        return s;
    };

    !void parse_match_arms(List<MatchArm>*arms) {
        _ = this->expect(.lbrace)?;
        this->skip_semis();
        while (!this->at(.rbrace)) {
            auto pats = List<Expr*>::init(this->a);
            if (this->at(.ident) && this->peek().text == "_") {
                _ = this->advance();
            } else {
                while (true) {
                    pats.push(this->parse_expr()?)?;
                    if (!this->eat(.comma)) { break; }
                    this->skip_semis();
                }
            }
            _ = this->expect(.fat_arrow)?;
            const auto body = this->parse_stmt()?;
            arms.push(MatchArm{ .pats = pats, .body = body })?;
            _ = this->eat(.comma);
            this->skip_semis();
        }
        _ = this->expect(.rbrace)?;
    }

    !Stmt* parse_if() {
        const auto kw = this->expect(.kw_if)?;
        const auto s = this->st(.If, kw)?;
        s.e = this->parse_cond()?;
        s.body = this->parse_block()?;
        if (this->at(.semi) && this->peek_at(1).tag == .kw_else) { _ = this->advance(); }
        if (this->eat(.kw_else)) {
            if (this->at(.kw_if)) { s.els = this->parse_if()?; } else { s.els = this->parse_block()?; }
        }
        return s;
    };

    // ---------------------------------------------------------------- expressions
    !Expr* parse_expr() {
        auto l = this->parse_bin(0)?;
        while (this->at(.kw_catch) || (this->at(.ident) && this->peek().text == "orelse")) {
            const auto kw = this->advance();
            EK kind = .Catch;
            if (kw.tag == .ident) { kind = .Orelse; }
            const auto c = this->ex(kind, kw)?;
            c.l = l;
            if (kind == .Catch && this->eat(.pipe)) {
                const auto bt = this->expect(.ident)?;
                c.name = bt.text;
                c.name_off = bt.off;
                c.has_name = true;
                _ = this->expect(.pipe)?;
            }
            if (this->at(.lbrace)) {
                c.handler = this->parse_block()?;
            } else if (this->at(.kw_return) || this->at(.kw_break) || this->at(.kw_continue)) {
                c.handler = this->parse_stmt()?;
            } else {
                const auto h = this->st(.ExprS, kw)?;
                h.e = this->parse_bin(0)?;
                c.handler = h;
            }
            l = c;
        }
        return l;
    };

    !Expr* parse_bin(i64 min) {
        auto l = this->parse_unary()?;
        while (true) {
            const auto op = this->peek();
            const auto pr = prec(op.tag);
            if (pr < 0 || pr < min) { break; }
            _ = this->advance();
            const auto r = this->parse_bin(pr + 1)?;
            const auto b = this->ex(.Binary, op)?;
            b.op = op.tag;
            b.l = l;
            b.r = r;
            l = b;
        }
        return l;
    };

    !Expr* parse_prefix() {
        const auto t = this->peek();
        match t.tag {
            .minus, .bang, .tilde, .amp, .star => {
                _ = this->advance();
                const auto u = this->ex(.Unary, t)?;
                u.op = t.tag;
                u.l = this->parse_prefix()?;
                return u;
            }
        }
        return this->parse_postfix();
    };

    !Expr* parse_unary() {
        auto e = this->parse_prefix()?;
        while (this->at(.kw_as)) {
            const auto kw = this->advance();
            const auto c = this->ex(.Cast, kw)?;
            c.l = e;
            const auto saved_np = this->no_post;
            this->no_post = true;
            c.ty = this->parse_type()?;
            this->no_post = saved_np;
            e = c;
        }
        return e;
    };

    !TypeExpr* expr_to_type(Expr* e) {
        if (e.k == .Ident) {
            const auto t = this->te_name(e.name)?;
            t.off = e.off;
            return t;
        };
        if (e.k == .Index) {
            const auto base = this->expr_to_type(e.l)?;
            for (auto a : e.args) { base.args.push(this->expr_to_type(a)?)?; }
            return base;
        };
        if (e.k == .Unary && (e.op == .star || e.op == .bang)) {
            const auto t = this->te(if_tek(e.op == .star))?;
            t.elem = this->expr_to_type(e.l)?;
            return t;
        }
        eprintln("{this->file}:{e.line}: error: expected a type");
        show_source(this->file, e.line, e.off);
        return error.ParseFailed;
    };

    bool is_alias(str name) {
        for (auto x : this->aliases) { if (x == name) { return true; } }
        return false;
    }

    !str qualified(str name) {
        if (!this->is_alias(name) || !(this->at(.dot) || this->at(.coloncolon)) || this->peek_at(1).tag != .ident) { return name; }
        _ = this->advance();
        const auto member = this->advance().text;
        auto b = List<u8>::init(this->a);
        sprint(&b, "{name}.{member}")?;
        return b.slice();
    }

    !Expr* parse_postfix() {
        auto e = this->parse_primary()?;
        while (true) {
            const auto t = this->peek();
            if (t.tag == .lparen) {
                _ = this->advance();
                const auto c = this->ex(.Call, t)?;
                c.l = e;
                const auto saved = this->no_struct;
                this->no_struct = false;
                while (!this->at(.rparen)) {
                    c.args.push(this->parse_expr()?)?;
                    if (!this->eat(.comma)) { break; }
                }
                this->no_struct = saved;
                _ = this->expect(.rparen)?;
                e = c;
            } else if (t.tag == .lbracket) {
                _ = this->advance();
                const auto saved = this->no_struct;
                this->no_struct = false;
                if (this->eat(.dotdot)) {
                    const auto s = this->ex(.Slice, t)?;
                    s.l = e;
                    if (!this->at(.rbracket)) { s.x = this->parse_expr()?; }
                    _ = this->expect(.rbracket)?;
                    this->no_struct = saved;
                    e = s;
                    continue;
                }
                const auto first = this->parse_expr()?;
                if (this->eat(.dotdot)) {
                    const auto s = this->ex(.Slice, t)?;
                    s.l = e;
                    s.r = first;
                    if (!this->at(.rbracket)) { s.x = this->parse_expr()?; }
                    _ = this->expect(.rbracket)?;
                    this->no_struct = saved;
                    e = s;
                    continue;
                }
                const auto ix = this->ex(.Index, t)?;
                ix.l = e;
                ix.args.push(first)?;
                while (this->eat(.comma)) { ix.args.push(this->parse_expr()?)?; }
                _ = this->expect(.rbracket)?;
                this->no_struct = saved;
                e = ix;
            } else if (t.tag == .dot || t.tag == .arrow || t.tag == .coloncolon) {
                _ = this->advance();
                const auto f = this->ex(.Field, t)?;
                f.l = e;
                const auto mt = this->expect(.ident)?;
                f.name = mt.text;
                f.name_off = mt.off;
                e = f;
                if (this->at(.lt) && !this->no_post) {
                    const auto g = this->try_generic_args(f)?;
                    if (g != null) { e = g; }
                }
            } else if (t.tag == .question) {
                _ = this->advance();
                const auto q = this->ex(.Try, t)?;
                q.l = e;
                e = q;
            } else if (t.tag == .kw_is) {
                _ = this->advance();
                if (!this->eat(.dot)) {
                    const auto first = this->expect(.ident)?;
                    _ = this->expect(.dot)?;
                    if (this->is_alias(first.text) && this->at(.ident) && this->peek_at(1).tag == .dot) {
                        _ = this->advance();
                        _ = this->advance();
                    }
                }
                const auto x = this->ex(.Is, t)?;
                x.l = e;
                const auto vt = this->expect(.ident)?;
                x.name = vt.text;
                x.name_off = vt.off;
                e = x;
            } else if (t.tag == .lbrace) {
                if (this->no_struct || !is_type_like(e)) { break; }
                _ = this->advance();
                const auto sl = this->ex(.StructLit, t)?;
                sl.ty = this->expr_to_type(e)?;
                this->skip_semis();
                if (this->at(.rbrace)) { sl.zero_rest = true; }
                while (!this->at(.rbrace)) {
                    if (this->eat(.dotdot)) {
                        sl.zero_rest = true;
                        this->skip_semis();
                        break;
                    }
                    auto designated = false;
                    if (this->eat(.dot)) { designated = true; }
                    const auto fnt = this->expect(.ident)?;
                    if (designated) { _ = this->expect(.eq)?; } else { _ = this->expect(.colon)?; }
                    if (designated) { sl.zero_rest = true; }
                    const auto v = this->parse_expr()?;
                    sl.fields.push(FieldInit{ .name = fnt.text, .value = v, .off = fnt.off })?;
                    _ = this->eat(.comma);
                    this->skip_semis();
                }
                _ = this->expect(.rbrace)?;
                e = sl;
            } else {
                break;
            }
        }
        return e;
    };

    !str clean_digits(str s) {
        auto b = List<u8>::init(this->a);
        for (auto c : s) { if (c != '_') { b.push(c)?; } }
        return b.slice();
    }

    !Expr* parse_primary() {
        const auto t = this->advance();
        match t.tag {
            .kw_fn => return this->parse_closure(t);
            .kw_match => {
                const auto e = this->ex(.Match, t)?;
                e.l = this->parse_cond()?;
                this->parse_match_arms(&e.arms)?;
                return e;
            }
            .int_lit => {
                const auto e = this->ex(.IntLit, t)?;
                e.ival = parse_int_radix(t.text, 0) catch {
                    eprintln("{this->file}:{t.line}: error: bad integer literal '{t.text}'");
                    show_source(this->file, t.line, t.off);
                    return error.ParseFailed;
                }
                return e;
            }
            .float_lit => {
                const auto e = this->ex(.FloatLit, t)?;
                e.fval = parse_float(this->clean_digits(t.text)?) catch {
                    eprintln("{this->file}:{t.line}: error: bad float literal");
                    show_source(this->file, t.line, t.off);
                    return error.ParseFailed;
                }
                return e;
            }
            .char_lit => {
                const auto s = this->unescape(t.text)?;
                if (s.len != 1) {
                    eprintln("{this->file}:{t.line}: error: char literal must be one byte");
                    show_source(this->file, t.line, t.off);
                    return error.ParseFailed;
                }
                const auto e = this->ex(.IntLit, t)?;
                e.ival = s[0] as u64;
                return e;
            }
            .str_lit => return this->parse_string(t);
            .kw_true, .kw_false => {
                const auto e = this->ex(.BoolLit, t)?;
                e.bval = t.tag == .kw_true;
                return e;
            }
            .kw_null => return this->ex(.NullLit, t);
            .ident => {
                const auto e = this->ex(.Ident, t)?;
                e.name = this->qualified(t.text)?;
                if (this->at(.lt) && !this->no_post) {
                    const auto g = this->try_generic_args(e)?;
                    if (g != null) { return g; }
                }
                return e;
            }
            .dot => {
                const auto e = this->ex(.EnumLit, t)?;
                const auto mt = this->expect(.ident)?;
                e.name = mt.text;
                e.name_off = mt.off;
                return e;
            }
            .kw_error => {
                _ = this->expect(.dot)?;
                const auto e = this->ex(.ErrorVal, t)?;
                e.name = this->expect(.ident)?.text;
                return e;
            }
            .kw_sizeof, .kw_alignof => {
                _ = this->expect(.lparen)?;
                EK k = .Sizeof;
                if (t.tag == .kw_alignof) { k = .Alignof; }
                const auto e = this->ex(k, t)?;
                e.ty = this->parse_type()?;
                _ = this->expect(.rparen)?;
                return e;
            }
            .lparen => {
                const auto saved = this->no_struct;
                this->no_struct = false;
                const auto e = this->parse_expr()?;
                this->no_struct = saved;
                _ = this->expect(.rparen)?;
                return e;
            }
            .lbracket => {
                if (this->lambda_ahead()) { return this->parse_lambda(t); }
                const auto e = this->ex(.ArrayLit, t)?;
                while (!this->at(.rbracket)) {
                    e.args.push(this->parse_expr()?)?;
                    if (!this->eat(.comma)) { break; }
                }
                _ = this->expect(.rbracket)?;
                return e;
            }
        }
        this->pos -= 1;
        this->fail("expected expression")?;
        return error.ParseFailed;
    };

    !str unescape(str raw) {
        auto out = List<u8>::init(this->a);
        auto i = 0;
        while (i < raw.len) {
            if (raw[i] == '\\' && i + 1 < raw.len) {
                i += 1;
                const auto c = raw[i];
                match c {
                    'n' => out.push('\n')?;
                    't' => out.push('\t')?;
                    'r' => out.push('\r')?;
                    '0' => out.push(0)?;
                    'e' => out.push(27)?;
                    'x' => {
                        if (i + 2 >= raw.len) { this->fail("bad \\x escape")?; }
                        const auto v = parse_int_radix(raw[i + 1..i + 3], 16) catch {
                            this->fail("bad \\x escape")?;
                            return error.ParseFailed;
                        }
                        out.push(v as u8)?;
                        i += 2;
                    }
                    _ => out.push(c)?;
                }
            } else {
                out.push(raw[i])?;
            }
            i += 1;
        }
        return out.slice();
    }

    !Expr* parse_string(Token t) {
        const auto raw = t.text;
        if (str_find_byte(raw, '{') < 0) {
            const auto e = this->ex(.StrLit, t)?;
            e.name = this->unescape(raw)?;
            return e;
        }
        const auto e = this->ex(.Interp, t)?;
        auto lit = List<u8>::init(this->a);
        auto i = 0;
        auto has_expr = false;
        while (i < raw.len) {
            const auto ch = raw[i];
            if (ch == '\\' && i + 1 < raw.len) {
                lit.append(raw[i..i + 2])?;
                i += 2;
                continue;
            }
            if (ch == '{' && i + 1 < raw.len && raw[i + 1] == '{') {
                lit.push('{')?;
                i += 2;
                continue;
            }
            if (ch == '}' && i + 1 < raw.len && raw[i + 1] == '}') {
                lit.push('}')?;
                i += 2;
                continue;
            }
            if (ch == '{') {
                const auto close = match_brace(raw, i);
                if (close < 0) { this->fail("unclosed '{{' in string")?; }
                if (lit.len > 0) {
                    e.parts.push(IPart{ .kind = 0, .lit = this->unescape(lit.slice())?, .e = null, .spec = "" })?;
                    lit = List<u8>::init(this->a);
                }
                auto inner = raw[i + 1..close];
                auto spec = "";
                auto has_spec = false;
                const auto ci = spec_colon(inner);
                if (ci >= 0) {
                    spec = inner[ci + 1..];
                    inner = inner[0..ci];
                    has_spec = true;
                }
                auto toks = tokenize(this->a, inner, this->file)?;
                const auto base = t.off + ((inner.ptr as u64) - (t.text.ptr as u64)) as i64;
                for (auto k : 0..toks.len) {
                    toks.items[k].line = t.line;
                    toks.items[k].off += base;
                }
                auto sub = new_parser(this->a, toks.slice(), this->file);
                sub.aliases = this->aliases;
                const auto x = sub.parse_expr()?;
                if (!sub.at(.semi) && !sub.at(.eof)) {
                    eprintln("{this->file}:{t.line}: error: unexpected tokens in interpolation '{inner}'");
                    show_source(this->file, t.line, t.off);
                    return error.ParseFailed;
                }
                if (has_spec) {
                    e.parts.push(IPart{ .kind = 2, .lit = "", .e = x, .spec = spec })?;
                } else {
                    e.parts.push(IPart{ .kind = 1, .lit = "", .e = x, .spec = "" })?;
                }
                has_expr = true;
                i = close + 1;
                continue;
            }
            lit.push(ch)?;
            i += 1;
        }
        if (lit.len > 0) { e.parts.push(IPart{ .kind = 0, .lit = this->unescape(lit.slice())?, .e = null, .spec = "" })?; }
        if (!has_expr) {
            auto all = List<u8>::init(this->a);
            for (auto p : e.parts) { all.append(p.lit)?; }
            const auto s = this->ex(.StrLit, t)?;
            s.name = all.slice();
            return s;
        }
        return e;
    };
}

Parser new_parser(Allocator a, Token[] toks, str file) {
    return Parser{ .a = a, .toks = toks, .pos = 0, .file = file, .no_struct = false, .aliases = List<str>::init(a), .quiet = false, .no_post = false, .arrow_only = false, .splits = List<i64>::init(a) };
};

i64 prec(Tag t) {
    match t {
        .oror => return 1;
        .andand => return 2;
        .eqeq, .neq, .lt, .le, .gt, .ge => return 3;
        .pipe => return 4;
        .caret => return 5;
        .amp => return 6;
        .shl, .shr => return 7;
        .plus, .minus => return 8;
        .star, .slash, .percent => return 9;
    }
    return -1;
}

bool starts_type(Tag t) {
    match t {
        .ident, .star, .bang, .question, .lbracket, .kw_fn => return true;
    }
    return false;
}

bool is_type_like(Expr* e) {
    if (e.k == .Ident) {
        const auto dot = str_rfind_byte(e.name, '.');
        return e.name.len > dot + 1 && is_upper(e.name[dot + 1]);
    };
    if (e.k == .Index) { return is_type_like(e.l) };
    return false;
}

TEK if_tek(bool is_ptr) {
    if (is_ptr) { return .Ptr; }
    return .Errun;
}

i64 match_brace(str raw, i64 open) {
    auto d = 0;
    auto i = open;
    while (i < raw.len) {
        const auto c = raw[i];
        if (c == '{') {
            d += 1;
        } else if (c == '}') {
            d -= 1;
            if (d == 0) { return i; }
        } else if (c == '"') {
            i += 1;
            while (i < raw.len && raw[i] != '"') {
                if (raw[i] == '\\') { i += 1; }
                i += 1;
            }
        }
        i += 1;
    }
    return -1;
}

i64 spec_colon(str inner) {
    auto d = 0;
    auto i = 0;
    while (i < inner.len) {
        const auto c = inner[i];
        if (c == '(' || c == '[' || c == '{') {
            d += 1;
        } else if (c == ')' || c == ']' || c == '}') {
            d -= 1;
        } else if (c == '"') {
            i += 1;
            while (i < inner.len && inner[i] != '"') {
                if (inner[i] == '\\') { i += 1; }
                i += 1;
            }
        } else if (c == '\'') {
            i += 2;
        } else if (c == ':' && d == 0) {
            return i;
        }
        i += 1;
    }
    return -1;
}
