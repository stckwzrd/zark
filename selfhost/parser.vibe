// Recursive-descent parser: tokens -> AST. Mirrors src/parser.zig.

import "ast.vibe"

struct Parser {
    a: Allocator
    toks: []Token
    pos: i64
    file: str
    no_struct: bool
}

fn new_parser(a: Allocator, toks: []Token, file: str) Parser {
    return Parser{ a: a, toks: toks, pos: 0, file: file, no_struct: false }
}

fn prec(t: Tag) i64 {
    match t {
        .oror => return 1
        .andand => return 2
        .eqeq, .neq, .lt, .le, .gt, .ge => return 3
        .pipe => return 4
        .caret => return 5
        .amp => return 6
        .shl, .shr => return 7
        .plus, .minus => return 8
        .star, .slash, .percent => return 9
    }
    return -1
}

fn starts_type(t: Tag) bool {
    match t {
        .ident, .star, .bang, .lbracket, .kw_fn => return true
    }
    return false
}

fn is_type_like(e: *Expr) bool {
    if e.k == .Ident { return e.name.len > 0 && is_upper(e.name[0]) }
    if e.k == .Index { return is_type_like(e.l) }
    return false
}

impl Parser {
    // ---------------------------------------------------------------- tokens
    fn peek(self) Token { return self.toks[self.pos] }
    fn peek_at(self, n: i64) Token {
        var i = self.pos + n
        if i > self.toks.len - 1 { i = self.toks.len - 1 }
        return self.toks[i]
    }
    fn at(self, t: Tag) bool { return self.toks[self.pos].tag == t }
    fn advance(self) Token {
        let t = self.toks[self.pos]
        if self.pos < self.toks.len - 1 { self.pos += 1 }
        return t
    }
    fn eat(self, t: Tag) bool {
        if self.at(t) {
            _ = self.advance()
            return true
        }
        return false
    }
    fn fail(self, msg: str) !void {
        let t = self.peek()
        eprintln("{self.file}:{t.line}: error: {msg} (near '{t.text}')")
        return error.ParseFailed
    }
    fn expect(self, t: Tag) !Token {
        if !self.at(t) {
            let cur = self.peek()
            eprintln("{self.file}:{cur.line}: error: expected {t} (near '{cur.text}')")
            return error.ParseFailed
        }
        return self.advance()
    }
    fn skip_semis(self) { while self.at(.semi) { _ = self.advance() } }

    // ---------------------------------------------------------------- node helpers
    fn ex(self, k: EK, line: i64) !*Expr {
        let e = self.a.create[Expr]()?
        e.k = k
        e.line = line
        e.args = List[*Expr].init(self.a)
        e.fields = List[FieldInit].init(self.a)
        e.parts = List[IPart].init(self.a)
        return e
    }
    fn st(self, k: SK, line: i64) !*Stmt {
        let s = self.a.create[Stmt]()?
        s.k = k
        s.line = line
        s.stmts = List[*Stmt].init(self.a)
        s.arms = List[MatchArm].init(self.a)
        return s
    }
    fn te(self, k: TEK) !*TypeExpr {
        let t = self.a.create[TypeExpr]()?
        t.k = k
        t.args = List[*TypeExpr].init(self.a)
        return t
    }
    fn te_name(self, name: str) !*TypeExpr {
        let t = self.te(.Name)?
        t.name = name
        return t
    }
    fn strs(self) List[str] { return List[str].init(self.a) }

    // ---------------------------------------------------------------- declarations
    fn parse_file(self) !List[Decl] {
        var decls = List[Decl].init(self.a)
        self.skip_semis()
        while !self.at(.eof) {
            self.parse_decl(&decls)?
            self.skip_semis()
        }
        return decls
    }

    fn parse_type_params(self) !List[str] {
        var list = self.strs()
        if self.eat(.lbracket) {
            while !self.at(.rbracket) {
                list.push(self.expect(.ident)?.text)?
                if !self.eat(.comma) { break }
            }
            _ = self.expect(.rbracket)?
        }
        return list
    }

    fn parse_decl(self, out: *List[Decl]) !void {
        let t = self.peek()
        var d = Decl{ k: .Import, line: t.line, .. }
        match t.tag {
            .kw_import => {
                _ = self.advance()
                d.path = self.expect(.str_lit)?.text
            }
            .kw_type => {
                _ = self.advance()
                d.k = .Alias
                d.path = self.expect(.ident)?.text
                _ = self.expect(.eq)?
                d.ty = self.parse_type()?
            }
            .kw_fn, .kw_extern, .kw_export => {
                d.k = .Func
                d.f = self.parse_fn("", self.strs())?
            }
            .kw_struct, .kw_union => {
                let is_union = self.advance().tag == .kw_union
                let name = self.expect(.ident)?.text
                let tps = self.parse_type_params()?
                _ = self.expect(.lbrace)?
                var fields = List[Field].init(self.a)
                self.skip_semis()
                while !self.at(.rbrace) {
                    let fname = self.expect(.ident)?.text
                    var fty: *TypeExpr = null
                    if is_union && !self.at(.colon) {
                        fty = self.te_name("void")?
                    } else {
                        _ = self.expect(.colon)?
                        fty = self.parse_type()?
                    }
                    fields.push(Field{ name: fname, ty: fty })?
                    _ = self.eat(.comma)
                    self.skip_semis()
                }
                _ = self.expect(.rbrace)?
                let sd = self.a.create[StructDecl]()?
                *sd = StructDecl{ name: name, type_params: tps, fields: fields, line: t.line, is_union: is_union }
                d.k = .Struct
                d.s = sd
            }
            .kw_enum => {
                _ = self.advance()
                let name = self.expect(.ident)?.text
                _ = self.expect(.lbrace)?
                var vs = self.strs()
                self.skip_semis()
                while !self.at(.rbrace) {
                    vs.push(self.expect(.ident)?.text)?
                    _ = self.eat(.comma)
                    self.skip_semis()
                }
                _ = self.expect(.rbrace)?
                let ed = self.a.create[EnumDecl]()?
                *ed = EnumDecl{ name: name, variants: vs, line: t.line }
                d.k = .Enum
                d.en = ed
            }
            .kw_impl => {
                _ = self.advance()
                let name = self.expect(.ident)?.text
                let tps = self.parse_type_params()?
                _ = self.expect(.lbrace)?
                self.skip_semis()
                while !self.at(.rbrace) {
                    let m = Decl{ k: .Func, f: self.parse_fn(name, tps)?, line: t.line, .. }
                    out.push(m)?
                    self.skip_semis()
                }
                _ = self.expect(.rbrace)?
                return
            }
            .kw_const, .kw_var => {
                _ = self.advance()
                let name = self.expect(.ident)?.text
                var ty: *TypeExpr = null
                if self.eat(.colon) { ty = self.parse_type()? }
                _ = self.expect(.eq)?
                let v = self.parse_expr()?
                let cd = self.a.create[ConstDecl]()?
                *cd = ConstDecl{ name: name, ty: ty, value: v, mutable: t.tag == .kw_var, line: t.line }
                d.k = .Const
                d.c = cd
            }
            _ => {
                self.fail("expected declaration")?
            }
        }
        out.push(d)?
    }

    fn parse_fn(self, receiver: str, recv_params: List[str]) !*FnDecl {
        let is_extern = self.eat(.kw_extern)
        let is_export = self.eat(.kw_export)
        let line = self.expect(.kw_fn)?.line
        let name = self.expect(.ident)?.text
        let tps = self.parse_type_params()?
        _ = self.expect(.lparen)?
        var params = List[Param].init(self.a)
        var variadic = false
        while !self.at(.rparen) {
            if self.eat(.ellipsis) {
                variadic = true
                break
            }
            let pname = self.expect(.ident)?.text
            var pty: *TypeExpr = null
            if self.eat(.colon) {
                pty = self.parse_type()?
            } else if pname == "self" {
                pty = self.te(.Ptr)?
                pty.elem = self.te_name("Self")?
            } else {
                eprintln("{self.file}:{line}: error: parameter '{pname}' needs a type")
                return error.ParseFailed
            }
            params.push(Param{ name: pname, ty: pty })?
            if !self.eat(.comma) { break }
        }
        _ = self.expect(.rparen)?
        var ret: *TypeExpr = null
        if !self.at(.lbrace) && !self.at(.semi) && !self.at(.eof) { ret = self.parse_type()? }
        var body: *Stmt = null
        if !is_extern { body = self.parse_block()? }
        let f = self.a.create[FnDecl]()?
        *f = FnDecl{
            name: name, type_params: tps, params: params, ret: ret, body: body,
            is_extern: is_extern, is_export: is_export, variadic: variadic, line: line,
            file: self.file, receiver: receiver, receiver_params: recv_params,
        }
        return f
    }

    fn parse_type(self) !*TypeExpr {
        if self.eat(.kw_fn) {
            _ = self.expect(.lparen)?
            let t = self.te(.Func)?
            while !self.at(.rparen) {
                t.args.push(self.parse_type()?)?
                if !self.eat(.comma) { break }
            }
            _ = self.expect(.rparen)?
            if starts_type(self.peek().tag) { t.ret = self.parse_type()? }
            return t
        }
        if self.eat(.star) {
            let t = self.te(.Ptr)?
            t.elem = self.parse_type()?
            return t
        }
        if self.eat(.bang) {
            let t = self.te(.Errun)?
            t.elem = self.parse_type()?
            return t
        }
        if self.eat(.lbracket) {
            if self.eat(.rbracket) {
                let t = self.te(.Slice)?
                t.elem = self.parse_type()?
                return t
            }
            let t = self.te(.Array)?
            t.len = self.parse_expr()?
            _ = self.expect(.rbracket)?
            t.elem = self.parse_type()?
            return t
        }
        let t = self.te_name(self.expect(.ident)?.text)?
        if self.at(.lbracket) {
            _ = self.advance()
            while !self.at(.rbracket) {
                t.args.push(self.parse_type()?)?
                if !self.eat(.comma) { break }
            }
            _ = self.expect(.rbracket)?
        }
        return t
    }

    // ---------------------------------------------------------------- statements
    fn parse_block(self) !*Stmt {
        let line = self.expect(.lbrace)?.line
        let b = self.st(.Block, line)?
        let saved = self.no_struct
        self.no_struct = false
        self.skip_semis()
        while !self.at(.rbrace) {
            if self.at(.eof) { self.fail("unexpected end of file in block")? }
            b.stmts.push(self.parse_stmt()?)?
            self.skip_semis()
        }
        _ = self.expect(.rbrace)?
        self.no_struct = saved
        return b
    }

    fn parse_cond(self) !*Expr {
        let saved = self.no_struct
        self.no_struct = true
        defer self.no_struct = saved
        return self.parse_expr()
    }

    fn parse_stmt(self) !*Stmt {
        let t = self.peek()
        match t.tag {
            .lbrace => return self.parse_block()
            .kw_let, .kw_var => {
                _ = self.advance()
                let s = self.st(.Let, t.line)?
                s.name = self.expect(.ident)?.text
                s.mutable = t.tag == .kw_var
                if self.eat(.colon) { s.ty = self.parse_type()? }
                if self.eat(.eq) { s.e = self.parse_expr()? }
                if s.ty == null && s.e == null {
                    eprintln("{self.file}:{t.line}: error: '{s.name}' needs a type or initializer")
                    return error.ParseFailed
                }
                return s
            }
            .kw_if => return self.parse_if()
            .kw_while => {
                _ = self.advance()
                let s = self.st(.While, t.line)?
                s.e = self.parse_cond()?
                s.body = self.parse_block()?
                return s
            }
            .kw_for => {
                _ = self.advance()
                let n1 = self.expect(.ident)?.text
                var n2 = ""
                var has2 = false
                if self.eat(.comma) {
                    n2 = self.expect(.ident)?.text
                    has2 = true
                }
                _ = self.expect(.kw_in)?
                let e = self.parse_cond()?
                if self.eat(.dotdot) {
                    if has2 { self.fail("range loop takes a single variable")? }
                    let s = self.st(.ForRange, t.line)?
                    s.name = n1
                    s.e = e
                    s.e2 = self.parse_cond()?
                    s.body = self.parse_block()?
                    return s
                }
                let s = self.st(.ForEach, t.line)?
                s.e = e
                s.body = self.parse_block()?
                if has2 {
                    s.idx = n1
                    s.has_idx = true
                    s.name = n2
                } else {
                    s.name = n1
                }
                return s
            }
            .kw_return => {
                _ = self.advance()
                let s = self.st(.Ret, t.line)?
                if !self.at(.semi) && !self.at(.rbrace) { s.e = self.parse_expr()? }
                return s
            }
            .kw_break => {
                _ = self.advance()
                return self.st(.Brk, t.line)
            }
            .kw_continue => {
                _ = self.advance()
                return self.st(.Cont, t.line)
            }
            .kw_defer, .kw_errdefer => {
                _ = self.advance()
                let s = self.st(.Defer, t.line)?
                s.is_err = t.tag == .kw_errdefer
                s.body = self.parse_stmt()?
                return s
            }
            .kw_match => {
                _ = self.advance()
                let s = self.st(.Match, t.line)?
                s.e = self.parse_cond()?
                _ = self.expect(.lbrace)?
                self.skip_semis()
                while !self.at(.rbrace) {
                    var pats = List[*Expr].init(self.a)
                    if self.at(.ident) && self.peek().text == "_" {
                        _ = self.advance()
                    } else {
                        while true {
                            pats.push(self.parse_expr()?)?
                            if !self.eat(.comma) { break }
                            self.skip_semis()
                        }
                    }
                    _ = self.expect(.fat_arrow)?
                    let body = self.parse_stmt()?
                    s.arms.push(MatchArm{ pats: pats, body: body })?
                    _ = self.eat(.comma)
                    self.skip_semis()
                }
                _ = self.expect(.rbrace)?
                return s
            }
        }
        let e = self.parse_expr()?
        let op = self.peek().tag
        match op {
            .eq, .plus_eq, .minus_eq, .star_eq, .slash_eq, .percent_eq => {
                _ = self.advance()
                let s = self.st(.Assign, t.line)?
                s.op = op
                s.e2 = e
                s.e = self.parse_expr()?
                return s
            }
        }
        let s = self.st(.ExprS, t.line)?
        s.e = e
        return s
    }

    fn parse_if(self) !*Stmt {
        let line = self.expect(.kw_if)?.line
        let s = self.st(.If, line)?
        s.e = self.parse_cond()?
        s.body = self.parse_block()?
        if self.at(.semi) && self.peek_at(1).tag == .kw_else { _ = self.advance() }
        if self.eat(.kw_else) {
            if self.at(.kw_if) { s.els = self.parse_if()? } else { s.els = self.parse_block()? }
        }
        return s
    }

    // ---------------------------------------------------------------- expressions
    fn parse_expr(self) !*Expr {
        var l = self.parse_bin(0)?
        while self.at(.kw_catch) {
            let line = self.advance().line
            let c = self.ex(.Catch, line)?
            c.l = l
            if self.eat(.pipe) {
                c.name = self.expect(.ident)?.text
                c.has_name = true
                _ = self.expect(.pipe)?
            }
            if self.at(.lbrace) {
                c.handler = self.parse_block()?
            } else if self.at(.kw_return) {
                c.handler = self.parse_stmt()?
            } else {
                let h = self.st(.ExprS, line)?
                h.e = self.parse_bin(0)?
                c.handler = h
            }
            l = c
        }
        return l
    }

    fn parse_bin(self, min: i64) !*Expr {
        var l = self.parse_unary()?
        while true {
            let op = self.peek()
            let pr = prec(op.tag)
            if pr < 0 || pr < min { break }
            _ = self.advance()
            let r = self.parse_bin(pr + 1)?
            let b = self.ex(.Binary, op.line)?
            b.op = op.tag
            b.l = l
            b.r = r
            l = b
        }
        return l
    }

    fn parse_prefix(self) !*Expr {
        let t = self.peek()
        match t.tag {
            .minus, .bang, .tilde, .amp, .star => {
                _ = self.advance()
                let u = self.ex(.Unary, t.line)?
                u.op = t.tag
                u.l = self.parse_prefix()?
                return u
            }
        }
        return self.parse_postfix()
    }

    fn parse_unary(self) !*Expr {
        var e = self.parse_prefix()?
        while self.at(.kw_as) {
            let line = self.advance().line
            let c = self.ex(.Cast, line)?
            c.l = e
            c.ty = self.parse_type()?
            e = c
        }
        return e
    }

    fn expr_to_type(self, e: *Expr) !*TypeExpr {
        if e.k == .Ident { return self.te_name(e.name) }
        if e.k == .Index {
            let base = self.expr_to_type(e.l)?
            for a in e.args { base.args.push(self.expr_to_type(a)?)? }
            return base
        }
        if e.k == .Unary && (e.op == .star || e.op == .bang) {
            let t = self.te(if_tek(e.op == .star))?
            t.elem = self.expr_to_type(e.l)?
            return t
        }
        eprintln("{self.file}:{e.line}: error: expected a type")
        return error.ParseFailed
    }

    fn parse_postfix(self) !*Expr {
        var e = self.parse_primary()?
        while true {
            let t = self.peek()
            if t.tag == .lparen {
                _ = self.advance()
                let c = self.ex(.Call, t.line)?
                c.l = e
                let saved = self.no_struct
                self.no_struct = false
                while !self.at(.rparen) {
                    c.args.push(self.parse_expr()?)?
                    if !self.eat(.comma) { break }
                }
                self.no_struct = saved
                _ = self.expect(.rparen)?
                e = c
            } else if t.tag == .lbracket {
                _ = self.advance()
                let saved = self.no_struct
                self.no_struct = false
                if self.eat(.dotdot) {
                    let s = self.ex(.Slice, t.line)?
                    s.l = e
                    if !self.at(.rbracket) { s.x = self.parse_expr()? }
                    _ = self.expect(.rbracket)?
                    self.no_struct = saved
                    e = s
                    continue
                }
                let first = self.parse_expr()?
                if self.eat(.dotdot) {
                    let s = self.ex(.Slice, t.line)?
                    s.l = e
                    s.r = first
                    if !self.at(.rbracket) { s.x = self.parse_expr()? }
                    _ = self.expect(.rbracket)?
                    self.no_struct = saved
                    e = s
                    continue
                }
                let ix = self.ex(.Index, t.line)?
                ix.l = e
                ix.args.push(first)?
                while self.eat(.comma) { ix.args.push(self.parse_expr()?)? }
                _ = self.expect(.rbracket)?
                self.no_struct = saved
                e = ix
            } else if t.tag == .dot {
                _ = self.advance()
                let f = self.ex(.Field, t.line)?
                f.l = e
                f.name = self.expect(.ident)?.text
                e = f
            } else if t.tag == .question {
                _ = self.advance()
                let q = self.ex(.Try, t.line)?
                q.l = e
                e = q
            } else if t.tag == .kw_is {
                _ = self.advance()
                if !self.eat(.dot) {
                    _ = self.expect(.ident)?
                    _ = self.expect(.dot)?
                }
                let x = self.ex(.Is, t.line)?
                x.l = e
                x.name = self.expect(.ident)?.text
                e = x
            } else if t.tag == .lbrace {
                if self.no_struct || !is_type_like(e) { break }
                _ = self.advance()
                let sl = self.ex(.StructLit, t.line)?
                sl.ty = self.expr_to_type(e)?
                self.skip_semis()
                while !self.at(.rbrace) {
                    if self.eat(.dotdot) {
                        sl.zero_rest = true
                        self.skip_semis()
                        break
                    }
                    let fname = self.expect(.ident)?.text
                    _ = self.expect(.colon)?
                    let v = self.parse_expr()?
                    sl.fields.push(FieldInit{ name: fname, value: v })?
                    _ = self.eat(.comma)
                    self.skip_semis()
                }
                _ = self.expect(.rbrace)?
                e = sl
            } else {
                break
            }
        }
        return e
    }

    fn clean_digits(self, s: str) !str {
        var b = List[u8].init(self.a)
        for c in s { if c != '_' { b.push(c)? } }
        return b.slice()
    }

    fn parse_primary(self) !*Expr {
        let t = self.advance()
        match t.tag {
            .int_lit => {
                let e = self.ex(.IntLit, t.line)?
                e.ival = parse_int_radix(t.text, 0) catch {
                    eprintln("{self.file}:{t.line}: error: bad integer literal '{t.text}'")
                    return error.ParseFailed
                }
                return e
            }
            .float_lit => {
                let e = self.ex(.FloatLit, t.line)?
                e.fval = parse_float(self.clean_digits(t.text)?) catch {
                    eprintln("{self.file}:{t.line}: error: bad float literal")
                    return error.ParseFailed
                }
                return e
            }
            .char_lit => {
                let s = self.unescape(t.text)?
                if s.len != 1 {
                    eprintln("{self.file}:{t.line}: error: char literal must be one byte")
                    return error.ParseFailed
                }
                let e = self.ex(.IntLit, t.line)?
                e.ival = s[0] as u64
                return e
            }
            .str_lit => return self.parse_string(t)
            .kw_true, .kw_false => {
                let e = self.ex(.BoolLit, t.line)?
                e.bval = t.tag == .kw_true
                return e
            }
            .kw_null => return self.ex(.NullLit, t.line)
            .ident => {
                let e = self.ex(.Ident, t.line)?
                e.name = t.text
                return e
            }
            .dot => {
                let e = self.ex(.EnumLit, t.line)?
                e.name = self.expect(.ident)?.text
                return e
            }
            .kw_error => {
                _ = self.expect(.dot)?
                let e = self.ex(.ErrorVal, t.line)?
                e.name = self.expect(.ident)?.text
                return e
            }
            .kw_sizeof, .kw_alignof => {
                _ = self.expect(.lparen)?
                var k: EK = .Sizeof
                if t.tag == .kw_alignof { k = .Alignof }
                let e = self.ex(k, t.line)?
                e.ty = self.parse_type()?
                _ = self.expect(.rparen)?
                return e
            }
            .lparen => {
                let saved = self.no_struct
                self.no_struct = false
                let e = self.parse_expr()?
                self.no_struct = saved
                _ = self.expect(.rparen)?
                return e
            }
            .lbracket => {
                let e = self.ex(.ArrayLit, t.line)?
                while !self.at(.rbracket) {
                    e.args.push(self.parse_expr()?)?
                    if !self.eat(.comma) { break }
                }
                _ = self.expect(.rbracket)?
                return e
            }
        }
        self.pos -= 1
        self.fail("expected expression")?
        return error.ParseFailed
    }

    fn unescape(self, raw: str) !str {
        var out = List[u8].init(self.a)
        var i = 0
        while i < raw.len {
            if raw[i] == '\\' && i + 1 < raw.len {
                i += 1
                let c = raw[i]
                match c {
                    'n' => out.push('\n')?
                    't' => out.push('\t')?
                    'r' => out.push('\r')?
                    '0' => out.push(0)?
                    'e' => out.push(27)?
                    'x' => {
                        if i + 2 >= raw.len { self.fail("bad \\x escape")? }
                        let v = parse_int_radix(raw[i + 1..i + 3], 16) catch {
                            self.fail("bad \\x escape")?
                            return error.ParseFailed
                        }
                        out.push(v as u8)?
                        i += 2
                    }
                    _ => out.push(c)?
                }
            } else {
                out.push(raw[i])?
            }
            i += 1
        }
        return out.slice()
    }

    fn parse_string(self, t: Token) !*Expr {
        let raw = t.text
        if str_find_byte(raw, '{') < 0 {
            let e = self.ex(.StrLit, t.line)?
            e.name = self.unescape(raw)?
            return e
        }
        let e = self.ex(.Interp, t.line)?
        var lit = List[u8].init(self.a)
        var i = 0
        var has_expr = false
        while i < raw.len {
            let ch = raw[i]
            if ch == '\\' && i + 1 < raw.len {
                lit.append(raw[i..i + 2])?
                i += 2
                continue
            }
            if ch == '{' && i + 1 < raw.len && raw[i + 1] == '{' {
                lit.push('{')?
                i += 2
                continue
            }
            if ch == '}' && i + 1 < raw.len && raw[i + 1] == '}' {
                lit.push('}')?
                i += 2
                continue
            }
            if ch == '{' {
                let close = match_brace(raw, i)
                if close < 0 { self.fail("unclosed '{{' in string")? }
                if lit.len > 0 {
                    e.parts.push(IPart{ kind: 0, lit: self.unescape(lit.slice())?, e: null, spec: "" })?
                    lit = List[u8].init(self.a)
                }
                var inner = raw[i + 1..close]
                var spec = ""
                var has_spec = false
                let ci = spec_colon(inner)
                if ci >= 0 {
                    spec = inner[ci + 1..]
                    inner = inner[0..ci]
                    has_spec = true
                }
                var toks = tokenize(self.a, inner, self.file)?
                for k in 0..toks.len { toks.items[k].line = t.line }
                var sub = new_parser(self.a, toks.slice(), self.file)
                let x = sub.parse_expr()?
                if !sub.at(.semi) && !sub.at(.eof) {
                    eprintln("{self.file}:{t.line}: error: unexpected tokens in interpolation '{inner}'")
                    return error.ParseFailed
                }
                if has_spec {
                    e.parts.push(IPart{ kind: 2, lit: "", e: x, spec: spec })?
                } else {
                    e.parts.push(IPart{ kind: 1, lit: "", e: x, spec: "" })?
                }
                has_expr = true
                i = close + 1
                continue
            }
            lit.push(ch)?
            i += 1
        }
        if lit.len > 0 { e.parts.push(IPart{ kind: 0, lit: self.unescape(lit.slice())?, e: null, spec: "" })? }
        if !has_expr {
            var all = List[u8].init(self.a)
            for p in e.parts { all.append(p.lit)? }
            let s = self.ex(.StrLit, t.line)?
            s.name = all.slice()
            return s
        }
        return e
    }
}

fn if_tek(is_ptr: bool) TEK {
    if is_ptr { return .Ptr }
    return .Errun
}

fn match_brace(raw: str, open: i64) i64 {
    var d = 0
    var i = open
    while i < raw.len {
        let c = raw[i]
        if c == '{' {
            d += 1
        } else if c == '}' {
            d -= 1
            if d == 0 { return i }
        } else if c == '"' {
            i += 1
            while i < raw.len && raw[i] != '"' {
                if raw[i] == '\\' { i += 1 }
                i += 1
            }
        }
        i += 1
    }
    return -1
}

fn spec_colon(inner: str) i64 {
    var d = 0
    var i = 0
    while i < inner.len {
        let c = inner[i]
        if c == '(' || c == '[' || c == '{' {
            d += 1
        } else if c == ')' || c == ']' || c == '}' {
            d -= 1
        } else if c == '"' {
            i += 1
            while i < inner.len && inner[i] != '"' {
                if inner[i] == '\\' { i += 1 }
                i += 1
            }
        } else if c == '\'' {
            i += 2
        } else if c == ':' && d == 0 {
            return i
        }
        i += 1
    }
    return -1
}
