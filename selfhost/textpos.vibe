// Byte offsets <-> LSP positions (line, UTF-16 column).

import "json.vibe"

struct Text {
    text: str
    starts: List[i64]
}

fn utf16_between(text: str, from: i64, to: i64) i64 {
    var i = from
    var n = 0
    while i < to && i < text.len {
        let c = text[i]
        if c < 0x80 {
            n += 1
            i += 1
        } else if c < 0xE0 {
            n += 1
            i += 2
        } else if c < 0xF0 {
            n += 1
            i += 3
        } else {
            n += 2
            i += 4
        }
    }
    return n
}

fn offset_of_utf16(text: str, from: i64, to: i64, col: i64) i64 {
    var i = from
    var n = 0
    while i < to && i < text.len && n < col {
        let c = text[i]
        if c < 0x80 {
            n += 1
            i += 1
        } else if c < 0xE0 {
            n += 1
            i += 2
        } else if c < 0xF0 {
            n += 1
            i += 3
        } else {
            n += 2
            i += 4
        }
    }
    return min(i, to)
}

fn compute_starts(a: Allocator, text: str) !List[i64] {
    var out = List[i64].init(a)
    out.push(0)?
    for i, c in text {
        if c == '\n' { out.push(i + 1)? }
    }
    return out
}

impl Text {
    fn line_of(self, off: i64) i64 {
        var lo = 0
        var hi = self.starts.len - 1
        while lo < hi {
            let mid = (lo + hi + 1) / 2
            if self.starts.get(mid) <= off { lo = mid } else { hi = mid - 1 }
        }
        return lo
    }

    fn line_end(self, line: i64) i64 {
        if line + 1 < self.starts.len {
            var e = self.starts.get(line + 1) - 1
            if e > self.starts.get(line) && self.text[e - 1] == '\r' { e -= 1 }
            return e
        }
        return self.text.len
    }

    fn col_of(self, off: i64) i64 {
        let line = self.line_of(off)
        return utf16_between(self.text, self.starts.get(line), off)
    }

    fn offset(self, line: i64, col: i64) i64 {
        if line < 0 { return 0 }
        if line >= self.starts.len { return self.text.len }
        return offset_of_utf16(self.text, self.starts.get(line), self.line_end(line), col)
    }

    }

fn try_range(w: *JW, d: Text, from: i64, to: i64) !void {
    w.obj()?
    w.key("start")?
    w.obj()?
    w.key("line")?
    w.int(d.line_of(from))?
    w.key("character")?
    w.int(d.col_of(from))?
    w.end()?
    w.key("end")?
    w.obj()?
    w.key("line")?
    w.int(d.line_of(to))?
    w.key("character")?
    w.int(d.col_of(to))?
    w.end()?
    w.end()?
}

