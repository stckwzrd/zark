// Byte offsets <-> LSP positions (line, UTF-16 column).

import "json.vibe";

struct Text {
    str text;
    List<i64> starts;

    i64 line_of(i64 off) {
        auto lo = 0;
        auto hi = this->starts.len - 1;
        while (lo < hi) {
            const auto mid = (lo + hi + 1) / 2;
            if (this->starts.get(mid) <= off) { lo = mid; } else { hi = mid - 1; }
        }
        return lo;
    }

    i64 line_end(i64 line) {
        if (line + 1 < this->starts.len) {
            auto e = this->starts.get(line + 1) - 1;
            if (e > this->starts.get(line) && this->text[e - 1] == '\r') { e -= 1; }
            return e;
        }
        return this->text.len;
    }

    i64 col_of(i64 off) {
        const auto line = this->line_of(off);
        return utf16_between(this->text, this->starts.get(line), off);
    }

    i64 offset(i64 line, i64 col) {
        if (line < 0) { return 0; }
        if (line >= this->starts.len) { return this->text.len; }
        return offset_of_utf16(this->text, this->starts.get(line), this->line_end(line), col);
    }
}

i64 utf16_between(str text, i64 from, i64 to) {
    auto i = from;
    auto n = 0;
    while (i < to && i < text.len) {
        const auto c = text[i];
        if (c < 0x80) {
            n += 1;
            i += 1;
        } else if (c < 0xE0) {
            n += 1;
            i += 2;
        } else if (c < 0xF0) {
            n += 1;
            i += 3;
        } else {
            n += 2;
            i += 4;
        }
    }
    return n;
}

i64 offset_of_utf16(str text, i64 from, i64 to, i64 col) {
    auto i = from;
    auto n = 0;
    while (i < to && i < text.len && n < col) {
        const auto c = text[i];
        if (c < 0x80) {
            n += 1;
            i += 1;
        } else if (c < 0xE0) {
            n += 1;
            i += 2;
        } else if (c < 0xF0) {
            n += 1;
            i += 3;
        } else {
            n += 2;
            i += 4;
        }
    }
    return min(i, to);
}

!List<i64> compute_starts(Allocator a, str text) {
    auto out = List<i64>::init(a);
    out.push(0)?;
    for (auto [i, c] : text) {
        if (c == '\n') { out.push(i + 1)?; }
    }
    return out;
}

!void try_range(JW* w, Text d, i64 from, i64 to) {
    w.obj()?;
    w.key("start")?;
    w.obj()?;
    w.key("line")?;
    w.int(d.line_of(from))?;
    w.key("character")?;
    w.int(d.col_of(from))?;
    w.end()?;
    w.key("end")?;
    w.obj()?;
    w.key("line")?;
    w.int(d.line_of(to))?;
    w.key("character")?;
    w.int(d.col_of(to))?;
    w.end()?;
    w.end()?;
}
