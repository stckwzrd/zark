import "gen_call.vibe";

Expr* await_of(Expr* e) {
    auto x = e;
    while (x != null && (x.k == .Try || x.k == .Catch)) { x = x.l; }
    if (x != null && x.k == .Await) { return x; }
    return null;
}

void Gen::set_await(Expr* e) {
    this->await_at = null;
    if (this->edepth == 0) { this->await_at = await_of(e); }
}

!TypeExpr* Gen::ptr_te(str name) {
    const auto n = this->a.create<TypeExpr>()?;
    n.k = .Name;
    n.name = name;
    n.args = List<TypeExpr*>::init(this->a);
    n.off = -1;
    const auto p = this->a.create<TypeExpr>()?;
    p.k = .Ptr;
    p.elem = n;
    p.args = List<TypeExpr*>::init(this->a);
    p.off = -1;
    return p;
}

!Type* Gen::prelude_type(str name, Type* arg, i64 line) {
    if (!this->structs.has(name)) { this->err(line); eprintln("async functions need the prelude type '{name}'"); return error.CompileFailed; }
    auto args = List<Type*>::init(this->a);
    if (arg != null) { args.push(arg)?; }
    const auto t = this->mk(.Strct)?;
    t.si = this->get_struct(this->structs.get(name)?, args)?;
    return t;
}

!FnInst* Gen::inst_async(FnDecl* decl, Env env, str key, List<Type*> params, Type* ret) {
    if (decl.is_extern || decl.is_export) { this->err(decl.line); eprintln("an async function cannot be extern or export"); return error.CompileFailed; }
    auto res = ret;
    if (ret.k == .Void) { res = this->t_bool; }
    const auto pt = this->prelude_type("Poll", res, decl.line)?;
    const auto ct = this->prelude_type("Context", null, decl.line)?;
    auto nb = this->sb();
    sprint(&nb, "{key[3..]}..frame")?;
    const auto name = nb.slice();
    auto db = this->sb();
    sprint(&db, "{decl.name} frame")?;
    const auto sd = this->a.create<StructDecl>()?;
    sd.name = name;
    sd.line = decl.line;
    const auto si = this->a.create<StructInst>()?;
    si.decl = sd;
    si.args = List<Type*>::init(this->a);
    si.llname = name;
    si.display = db.slice();
    si.fields = List<FieldInfo>::init(this->a);
    const auto ft = this->mk(.Strct)?;
    ft.si = si;

    const auto fi = this->a.create<FnInst>()?;
    *fi = FnInst{ .decl = decl, .env = env, .llname = key, .params = params, .ret = ft, .generated = true, .busy = true };
    this->fn_insts.put(key, fi)?;

    const auto md = this->a.create<FnDecl>()?;
    md.name = "poll";
    md.line = decl.line;
    md.file = decl.file;
    md.receiver = name;
    md.params = List<Param>::init(this->a);
    md.params.push(Param{ .name = "this", .ty = this->ptr_te("Self")?, .off = -1 })?;
    md.params.push(Param{ .name = "cx", .ty = this->ptr_te("Context")?, .off = -1 })?;
    auto mk = this->sb();
    sprint(&mk, "{name}.poll")?;
    this->methods.put(mk.slice(), md)?;
    const auto penv = this->new_env()?;
    penv.put("Self", ft)?;
    auto pparams = List<Type*>::init(this->a);
    pparams.push(this->mk_elem(.Ptr, ft)?)?;
    pparams.push(this->mk_elem(.Ptr, ct)?)?;
    auto pn = this->sb();
    sprint(&pn, "vb.{name}.poll")?;
    const auto pi = this->a.create<FnInst>()?;
    *pi = FnInst{ .decl = md, .env = penv, .llname = pn.slice(), .params = pparams, .ret = pt, .generated = true };
    this->fn_insts.put(pi.llname, pi)?;

    this->gen_poll(fi, pi, ret)?;
    this->gen_frame_ctor(fi)?;
    return fi;
}

!Type* Gen::poll_output(Type* t) {
    if (t.k != .Strct) { return null; }
    auto kb = this->sb();
    sprint(&kb, "{t.si.decl.name}.poll")?;
    if (!this->methods.has(kb.slice())) { return null; }
    const auto md = this->methods.get(kb.slice())?;
    auto pn = this->sb();
    sprint(&pn, "vb.{t.si.llname}.poll")?;
    Type* pt = null;
    if (md.ret == null && this->fn_insts.has(pn.slice())) { pt = this->fn_insts.get(pn.slice())?.ret; }
    if (md.ret != null && md.type_params.len == 0) { pt = this->resolve_type(md.ret, this->recv_env(md, t)?)?; }
    if (pt == null || !is_union(pt) || pt.si.decl.name != "Poll") { return null; }
    return pt.si.fields.get(field_index(pt.si, "Ready")).ty;
}

!void Gen::infer_from_poll(List<str> tps, Env env) {
    auto free = "";
    auto nfree = 0;
    Type* out = null;
    auto nout = 0;
    for (auto tp : tps) {
        if (!env.has(tp)) {
            free = tp;
            nfree += 1;
            continue;
        }
        const auto o = this->poll_output(env.get(tp)?)?;
        if (o != null) {
            out = o;
            nout += 1;
        }
    }
    if (nfree == 1 && nout == 1) { env.put(free, out)?; }
}

!void Gen::gen_frame_ctor(FnInst* fi) {
    const auto ft = fi.ret;
    const auto fty = this->llty(ft)?;
    const auto w = &this->funcs_out;
    sprint(w, "define internal {fty} @{fi.llname}(")?;
    for (auto [i, p] : fi.params) {
        if (i > 0) { w.append(", ")?; }
        sprint(w, "{this->llty(p)?} %a.{i}")?;
    }
    if (this->safety) { w.append(") #0 {{\nentry:\n")?; } else { w.append(") {{\nentry:\n")?; }
    auto cur = "zeroinitializer";
    for (auto [i, p] : fi.params) {
        sprint(w, "  %c.{i} = insertvalue {fty} {cur}, {this->llty(p)?} %a.{i}, {this->fidx(ft, i + 1)}\n")?;
        auto cb = this->sb();
        sprint(&cb, "%c.{i}")?;
        cur = cb.slice();
    }
    sprint(w, "  ret {fty} {cur}\n}}\n\n")?;
}

!void Gen::gen_poll(FnInst* fi, FnInst* pi, Type* ret) {
    const auto s = *this;
    defer {
        this->file = s.file;
        this->dbg = s.dbg;
        this->last_line = s.last_line;
        this->body = s.body;
        this->allocas = s.allocas;
        this->scopes = s.scopes;
        this->loops = s.loops;
        this->moved = s.moved;
        this->colds = s.colds;
        this->reinit = s.reinit;
        this->shared = s.shared;
        this->nloop = s.nloop;
        this->ntmp = s.ntmp;
        this->nlbl = s.nlbl;
        this->terminated = s.terminated;
        this->cur_label = s.cur_label;
        this->cur = s.cur;
        this->const_this = s.const_this;
        this->env = s.env;
        this->at_line = s.at_line;
        this->at_off = s.at_off;
        this->bor_field = s.bor_field;
        this->bor_ptr = s.bor_ptr;
        this->bor_name = s.bor_name;
        this->in_cast = s.in_cast;
        this->af = s.af;
        this->await_at = s.await_at;
        this->edepth = s.edepth;
        this->in_defer = s.in_defer;
        fi.busy = false;
    }
    const auto decl = fi.decl;
    const auto ft = fi.ret;
    const auto bf = this->a.create<FnInst>()?;
    *bf = FnInst{ .decl = decl, .env = fi.env, .llname = fi.llname, .params = fi.params, .ret = ret, .generated = true };
    this->file = decl.file;
    this->dbg = decl.file.len > 0 && decl.file[0] != '<';
    this->last_line = 0;
    this->body = this->sb();
    this->allocas = this->sb();
    this->scopes = List<Scope>::init(this->a);
    this->loops = List<Loop>::init(this->a);
    this->moved = List<MoveRec>::init(this->a);
    this->colds = List<Cold>::init(this->a);
    this->reinit = false;
    this->shared = false;
    this->nloop = 0;
    this->ntmp = 0;
    this->nlbl = 0;
    this->terminated = false;
    this->cur_label = "entry";
    this->cur = bf;
    this->const_this = false;
    this->env = fi.env;
    this->bor_field = null;
    this->in_cast = false;
    this->await_at = null;
    this->edepth = 0;
    this->in_defer = false;
    const auto af = this->a.create<AsyncFn>()?;
    *af = AsyncFn{ .frame = ft, .poll = pi.ret, .cx = Value{ .ty = pi.params.get(1), .v = "%a.1" }, .slots = List<str>::init(this->a), .resumes = List<str>::init(this->a) };
    this->af = af;

    this->push_scope()?;
    const auto st = this->alloca(this->t_i32, "state")?;
    for (auto [i, p] : decl.params) {
        const auto pty = fi.params.get(i);
        const auto slot = this->alloca(pty, p.name)?;
        this->declare_var(p.name, Var{ .ptr = slot, .ty = pty, .mutable = p.mutable }, decl.line)?;
    }
    auto res = ret;
    if (ret.k == .Void) { res = this->t_bool; }
    af.result = this->alloca(res, "result")?;
    this->terminated = true;
    this->label("astart")?;
    this->gen_stmt(decl.body)?;
    if (!this->terminated) {
        this->run_defers(this->scopes.len - 1, 0, false, false)?;
        if (ret.k == .Void) {
            this->ret_val(Value{ .ty = this->t_void, .v = "" })?;
        } else if (ret.k == .Errun && ret.elem.k == .Void) {
            this->ret_val(Value{ .ty = ret, .v = "zeroinitializer" })?;
        } else {
            if (!always_returns(decl.body)) {
                this->err(decl.line);
                eprintln("function '{decl.name}' does not return a value on every path; add a 'return' at the end");
                return error.CompileFailed;
            }
            sprint(this->ins()?, "  unreachable\n")?;
        }
        this->terminated = true;
    }
    this->label("abad")?;
    if (this->fns.has("__panic")) {
        const auto msg = this->a.create<Expr>()?;
        msg.k = .StrLit;
        msg.line = decl.line;
        msg.name = "async function polled after it finished";
        auto margs = List<Expr*>::init(this->a);
        margs.push(msg)?;
        this->gen_fail(margs, 0, false, decl.line)?;
    } else {
        sprint(this->ins()?, "  unreachable\n")?;
        this->terminated = true;
    }
    this->scopes.len -= 1;
    this->emit_struct_type(ft.si)?;

    const auto fty = this->llty(ft)?;
    const auto w = &this->funcs_out;
    sprint(w, "define internal {this->llty(pi.ret)?} @{pi.llname}(ptr %a.0, ptr %a.1)")?;
    if (this->safety) { w.append(" #0 {{\nentry:\n")?; } else { w.append(" {{\nentry:\n")?; }
    if (this->dbg) { sprint(w, "  ;@F {decl.file}\n  ;@L {decl.line}\n")?; }
    for (auto [i, sl] : af.slots) { sprint(w, "  {sl} = getelementptr {fty}, ptr %a.0, i32 0, i32 {this->fidx(ft, i)}\n")?; }
    w.append(this->allocas.slice())?;
    sprint(w, "  %as.s = load i32, ptr {st}\n")?;
    const auto n = af.resumes.len;
    for (auto k : 0..n + 1) {
        auto to = "astart";
        if (k > 0) { to = af.resumes.get(k - 1); }
        if (k == n) {
            sprint(w, "  %as.c{k} = icmp eq i32 %as.s, {k}\n  br i1 %as.c{k}, label %{to}, label %abad\n")?;
        } else {
            sprint(w, "  %as.c{k} = icmp eq i32 %as.s, {k}\n  br i1 %as.c{k}, label %{to}, label %asn{k}\nasn{k}:\n")?;
        }
    }
    w.append(this->body.slice())?;
    this->emit_colds(w)?;
    w.append("}\n\n")?;
}

!Value Gen::gen_await(Expr* e) {
    if (this->af == null) {
        this->err(e.line); eprintln("'await' can only be used directly inside an async function (not in a plain function or a closure)");
        return error.CompileFailed;
    }
    if (this->in_defer) {
        this->err(e.line); eprintln("'await' is not allowed in deferred code (defer/errdefer)");
        return error.CompileFailed;
    }
    if (e != this->await_at) {
        this->err(e.line); eprintln("'await' cannot be used inside a larger expression here; bind the result to a variable first: auto v = await ...;");
        return error.CompileFailed;
    }
    this->await_at = null;
    const auto fv = this->gen_expr(e.l, null)?;
    this->move_mark(e.l, "await", e.line)?;
    this->invalidate_borrows("await", e.line)?;
    auto kb = this->sb();
    if (fv.ty.k == .Strct) { sprint(&kb, "{fv.ty.si.decl.name}.poll")?; }
    if (fv.ty.k != .Strct || !this->methods.has(kb.slice())) {
        this->err(e.line); eprintln("'{this->type_name(fv.ty)?}' is not a future: it needs a method 'Poll<T> poll(Context* cx)'");
        return error.CompileFailed;
    }
    const auto md = this->methods.get(kb.slice())?;
    const auto slot = this->alloca(fv.ty, "await")?;
    this->store(fv, slot)?;
    const auto af = this->af;
    const auto lr = this->new_label("aresume")?;
    af.resumes.push(lr)?;
    sprint(this->ins()?, "  store i32 {af.resumes.len}, ptr {af.slots.get(0)}\n")?;
    this->label(lr)?;
    auto args = List<Expr*>::init(this->a);
    args.push(this->mk_pre(af.cx, e.line)?)?;
    const auto pv = this->call_method(md, Addr{ .ty = fv.ty, .v = slot, .imm = false }, args, this->no_types(), null, e.line)?;
    if (!is_union(pv.ty) || pv.ty.si.decl.name != "Poll") {
        this->err(e.line); eprintln("'{this->type_name(fv.ty)?}' is not a future: its 'poll' returns '{this->type_name(pv.ty)?}', not Poll<T>");
        return error.CompileFailed;
    }
    const auto tag = this->extract(pv, 0, this->t_i32)?;
    const auto c = this->tmp()?;
    sprint(this->ins()?, "  {c} = icmp eq i32 {tag.v}, {field_index(pv.ty.si, "Pending")}\n")?;
    const auto lp = this->new_label("apend")?;
    const auto lk = this->new_label("aready")?;
    sprint(this->ins()?, "  br i1 {c}, label %{lp}, label %{lk}\n")?;
    this->terminated = true;
    this->label(lp)?;
    const auto pend = this->union_of(af.poll, field_index(af.poll.si, "Pending"), Value{ .ty = null, .v = "" })?;
    sprint(this->ins()?, "  ret {this->llty(af.poll)?} {pend.v}\n")?;
    this->terminated = true;
    this->label(lk)?;
    const auto vt = pv.ty.si.fields.get(field_index(pv.ty.si, "Ready")).ty;
    if (vt.k == .Void) { return Value{ .ty = this->t_void, .v = "" }; }
    return this->union_payload(pv, vt);
}

!void Gen::ret_val(Value v) {
    if (this->af == null) {
        if (v.ty.k == .Void) { sprint(this->ins()?, "  ret void\n")?; } else { sprint(this->ins()?, "  ret {this->llty(v.ty)?} {v.v}\n")?; }
        return;
    }
    const auto af = this->af;
    auto rv = v;
    if (v.ty.k == .Void) { rv = Value{ .ty = this->t_bool, .v = "true" }; }
    this->store(rv, af.result)?;
    sprint(this->ins()?, "  store i32 -1, ptr {af.slots.get(0)}\n")?;
    const auto r = this->union_of(af.poll, field_index(af.poll.si, "Ready"), rv)?;
    sprint(this->ins()?, "  ret {this->llty(af.poll)?} {r.v}\n")?;
}

!Type* Gen::sizeof_type(Expr* e) {
    auto x = e.l;
    if (x == null && e.ty.k == .Name && e.ty.args.len == 0) {
        const auto n = e.ty.name;
        if (this->has_var(n) && !this->env.has(n) && !this->structs.has(n) && !this->aliases.has(n) && !this->enums.has(n)) {
            x = this->a.create<Expr>()?;
            x.k = .Ident;
            x.name = n;
            x.line = e.line;
            x.off = e.ty.off;
        }
    }
    if (x == null) { return this->resolve_type_at(e.ty, e.line); }
    const auto saved_body = this->body.len;
    const auto saved_label = this->cur_label;
    const auto saved_term = this->terminated;
    const auto saved_line = this->last_line;
    const auto saved_moved = this->snap();
    const auto saved_colds = this->colds_copy()?;
    defer {
        this->body.len = saved_body;
        this->cur_label = saved_label;
        this->terminated = saved_term;
        this->last_line = saved_line;
        this->restore_state(saved_moved);
        this->colds = saved_colds;
    }
    return this->gen_expr(x, null)?.ty;
}
