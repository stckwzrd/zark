// Editor features built on the analysis: hover, definition, references, rename, highlights.

import "analysis.vibe";
import "textpos.vibe";

void put(List<u8>*b, str s) {
    b.append(s) catch return;
}

void put_type(List<u8>*b, TypeExpr* te) {
    if (te == null) {
        put(b, "?");
        return;
    }
    match te.k {
        .Name => {
            if (te.name == "Option" && te.args.len == 1) {
                put(b, "?");
                put_type(b, te.args.get(0));
                return;
            }
            put(b, te.name);
            if (te.args.len > 0) {
                put(b, "[");
                for (auto [i, x] : te.args) {
                    if (i > 0) { put(b, ", "); }
                    put_type(b, x);
                }
                put(b, "]");
            }
        }
        .Ptr => {
            put(b, "*");
            put_type(b, te.elem);
        }
        .Slice => {
            put(b, "[]");
            put_type(b, te.elem);
        }
        .Array => {
            put(b, "[");
            if (te.len != null && te.len.k == .IntLit) {
                sprint(b, "{te.len.ival}") catch return;
            } else if (te.len != null && te.len.k == .Ident) {
                put(b, te.len.name);
            } else {
                put(b, "N");
            }
            put(b, "]");
            put_type(b, te.elem);
        }
        .Errun => {
            put(b, "!");
            put_type(b, te.elem);
        }
        .Func => {
            put(b, "fn");
            if (te.closure) { put(b, "[]"); }
            put(b, "(");
            for (auto [i, x] : te.args) {
                if (i > 0) { put(b, ", "); }
                put_type(b, x);
            }
            put(b, ")");
            if (te.ret != null) {
                put(b, " ");
                put_type(b, te.ret);
            }
        }
    }
}

str type_str(Allocator a, TypeExpr* te) {
    auto b = List<u8>::init(a);
    put_type(&b, te);
    return b.slice();
}

void put_params(List<u8>*b, FnDecl* f, bool skip_self) {
    auto first = true;
    for (auto p : f.params) {
        if (skip_self && p.name == "self") { continue; }
        if (!first) { put(b, ", "); }
        first = false;
        put(b, p.name);
        if (p.name == "self" && p.ty != null && p.ty.k == .Ptr && p.ty.elem.k == .Name && p.ty.elem.name == "Self") { continue; }
        put(b, ": ");
        put_type(b, p.ty);
    }
}

void put_generics(List<u8>*b, List<str> names, List<str> cons) {
    if (names.len == 0) { return; }
    put(b, "[");
    for (auto [i, n] : names) {
        if (i > 0) { put(b, ", "); }
        put(b, n);
        if (i < cons.len && cons.get(i).len > 0) {
            put(b, ": ");
            put(b, cons.get(i));
        }
    }
    put(b, "]");
}

str fn_signature(Allocator a, FnDecl* f, bool skip_self) {
    auto b = List<u8>::init(a);
    put(&b, "fn ");
    if (f.receiver.len > 0 && !skip_self) {
        put(&b, last_segment(f.receiver));
        put(&b, ".");
    }
    put(&b, last_segment(f.name));
    put_generics(&b, f.type_params, f.constraints);
    put(&b, "(");
    put_params(&b, f, skip_self);
    if (f.variadic) { put(&b, ", ..."); }
    put(&b, ")");
    if (f.ret != null) {
        put(&b, " ");
        put_type(&b, f.ret);
    }
    return b.slice();
}

str sym_detail(Allocator a, Symbol* s) {
    auto b = List<u8>::init(a);
    match s.k {
        .Fn, .Method => return fn_signature(a, s.fd, false);
        .Struct, .Union => {
            const auto sd = s.sd;
            if (sd.is_union) { put(&b, "union "); } else { put(&b, "struct "); }
            put(&b, s.name);
            put_generics(&b, sd.type_params, sd.constraints);
            put(&b, " ");
            b.push('{') catch return "";
            put(&b, " ");
            for (auto [i, f] : sd.fields) {
                if (i >= 6) {
                    put(&b, ", ...");
                    break;
                }
                if (i > 0) { put(&b, ", "); }
                put(&b, f.name);
                if (!(sd.is_union && f.ty != null && f.ty.k == .Name && f.ty.name == "void")) {
                    put(&b, ": ");
                    put_type(&b, f.ty);
                }
            }
            put(&b, " ");
            b.push('}') catch return "";
        }
        .Enum => {
            put(&b, "enum ");
            put(&b, s.name);
            put(&b, " ");
            b.push('{') catch return "";
            put(&b, " ");
            for (auto [i, v] : s.ed.variants) {
                if (i >= 8) {
                    put(&b, ", ...");
                    break;
                }
                if (i > 0) { put(&b, ", "); }
                put(&b, v);
            }
            put(&b, " ");
            b.push('}') catch return "";
        }
        .Const, .Var => {
            if (s.k == .Const) { put(&b, "const ") } else { put(&b, "var "); }
            put(&b, s.name);
            if (s.ty != null) {
                put(&b, ": ");
                put_type(&b, s.ty);
            }
        }
        .Alias => {
            put(&b, "type ");
            put(&b, s.name);
            put(&b, " = ");
            put_type(&b, s.ty);
        }
        .Field => {
            put(&b, "(field) ");
            put(&b, s.owner);
            put(&b, ".");
            put(&b, s.name);
            put(&b, ": ");
            put_type(&b, s.ty);
        }
        .Variant => {
            put(&b, "(variant) ");
            put(&b, s.owner);
            put(&b, ".");
            put(&b, s.name);
        }
        .Param => {
            put(&b, "(parameter) ");
            put(&b, s.name);
            if (s.ty != null) {
                put(&b, ": ");
                put_type(&b, s.ty);
            }
        }
        .Local => {
            if (s.mutable) { put(&b, "var "); } else { put(&b, "let "); }
            put(&b, s.name);
            if (s.ty != null) {
                put(&b, ": ");
                put_type(&b, s.ty);
            }
        }
        .TypeParam => {
            put(&b, "(type parameter) ");
            put(&b, s.name);
        }
        .Module => {
            put(&b, "module ");
            put(&b, s.name);
        }
    }
    return b.slice();
}

str doc_above(Allocator a, str src, i64 off) {
    auto ls = off;
    while (ls > 0 && src[ls - 1] != '\n') { ls -= 1; }
    auto lines = List<str>::init(a);
    auto end = ls;
    while (end > 0) {
        auto st = end - 1;
        while (st > 0 && src[st - 1] != '\n') { st -= 1; }
        const auto ln = str_trim(src[st..end - 1]);
        if (!str_starts_with(ln, "//")) { break; }
        auto t = ln[2..];
        if (str_starts_with(t, "/")) { t = t[1..]; }
        lines.push(str_trim(t)) catch return "";
        end = st;
    }
    auto b = List<u8>::init(a);
    auto i = lines.len;
    while (i > 0) {
        i -= 1;
        put(&b, lines.get(i));
        put(&b, "\n");
    }
    return b.slice();
}

i64 sym_decl_off(Symbol* s) {
    if (s.fd != null && s.fd.name_off >= 0) { return s.fd.name_off; }
    return s.off;
}

str hover_markdown(Allocator a, Project* p, Symbol* s) {
    auto b = List<u8>::init(a);
    put(&b, "```vibe\n");
    put(&b, sym_detail(a, s));
    put(&b, "\n```");
    if (s.file != "<std>" && s.off >= 0 && p.by_path.has(s.file)) {
        const auto fi = p.by_path.get(s.file) catch null;
        if (fi != null) {
            const auto d = doc_above(a, fi.src, s.off);
            if (d.len > 0) {
                put(&b, "\n\n");
                put(&b, d);
            }
        }
    }
    return b.slice();
}

Occ* occ_at(Project* p, str path, i64 off) {
    Occ* best = null;
    for (auto i : 0..p.occs.len) {
        const auto o = &p.occs.items[i];
        if (o.file != path || off < o.off || off > o.off + o.len) { continue; }
        if (best == null || o.len < best.len) { best = o; }
    }
    return best;
};

str word_at(str src, i64 off) {
    auto s = off;
    auto e = off;
    while (s > 0 && (is_alnum(src[s - 1]) || src[s - 1] == '_')) { s -= 1; }
    while (e < src.len && (is_alnum(src[e]) || src[e] == '_')) { e += 1; }
    return src[s..e];
}

Symbol* sym_for(Project* p, str path, str src, i64 off) {
    const auto o = occ_at(p, path, off);
    if (o != null) { return o.sym; }
    const auto w = word_at(src, off);
    if (w.len == 0) { return null; }
    return p.flat.get(w) catch null;
};

!Text text_of(Allocator a, Project* p, str path) {
    const auto fi = p.by_path.get(path)?;
    return Text{ .text = fi.src, .starts = compute_starts(a, fi.src)? };
};

!void range_json(Allocator a, JW* w, Project* p, str path, i64 off, i64 len) {
    const auto t = text_of(a, p, path)?;
    try_range(w, t, off, off + len)?;
}

!void location(Allocator a, JW* w, Project* p, str path, i64 off, i64 len) {
    w.obj()?;
    w.key("uri")?;
    w.str(path_to_uri(a, path)?)?;
    w.key("range")?;
    auto rw = new_jw(a);
    range_json(a, &rw, p, path, off, len)?;
    w.raw(rw.text())?;
    w.end()?;
}

!str hover(Allocator a, Project* p, str path, str src, i64 off) {
    const auto s = sym_for(p, path, src, off);
    if (s == null) { return "null"; }
    const auto o = occ_at(p, path, off);
    auto w = new_jw(a);
    w.obj()?;
    w.key("contents")?;
    w.obj()?;
    w.key("kind")?;
    w.str("markdown")?;
    w.key("value")?;
    w.str(hover_markdown(a, p, s))?;
    w.end()?;
    if (o != null) {
        w.key("range")?;
        auto rw = new_jw(a);
        range_json(a, &rw, p, path, o.off, o.len)?;
        w.raw(rw.text())?;
    }
    w.end()?;
    return w.text();
}

!str definition(Allocator a, Project* p, str path, str src, i64 off) {
    auto w = new_jw(a);
    w.arr()?;
    const auto fi = p.by_path.get(path) catch null;
    if (fi != null) {
        for (auto d : fi.decls) {
            if (d.k == .Import && off >= d.path_off && off <= d.path_off + d.path.len) {
                const auto full = canonical(a, join_path(a, dir_of(path), d.path)?)?;
                if (p.by_path.has(full)) { location(a, &w, p, full, 0, 0)?; }
                w.end()?;
                return w.text();
            }
        }
    }
    const auto s = sym_for(p, path, src, off);
    if (s != null && s.file != "<std>" && s.off >= 0 && p.by_path.has(s.file)) { location(a, &w, p, s.file, s.off, s.len)?; }
    w.end()?;
    return w.text();
}

!str references(Allocator a, Project* p, str path, str src, i64 off, bool decl) {
    const auto s = sym_for(p, path, src, off);
    auto w = new_jw(a);
    w.arr()?;
    if (s != null) {
        for (auto o : p.occs) {
            if (o.sym != s || !p.by_path.has(o.file)) { continue; }
            if (!decl && o.off == s.off && o.file == s.file) { continue; }
            location(a, &w, p, o.file, o.off, o.len)?;
        }
    }
    w.end()?;
    return w.text();
}

!str highlights(Allocator a, Project* p, str path, str src, i64 off) {
    const auto s = sym_for(p, path, src, off);
    auto w = new_jw(a);
    w.arr()?;
    if (s != null) {
        for (auto o : p.occs) {
            if (o.sym != s || o.file != path) { continue; }
            w.obj()?;
            w.key("range")?;
            auto rw = new_jw(a);
            range_json(a, &rw, p, path, o.off, o.len)?;
            w.raw(rw.text())?;
            w.key("kind")?;
            if (o.off == s.off && o.file == s.file) { w.int(3)?; } else { w.int(2)?; }
            w.end()?;
        }
    }
    w.end()?;
    return w.text();
}

bool valid_ident(str n) {
    if (n.len == 0 || is_digit(n[0])) { return false; }
    for (auto c : n) { if (!(is_alnum(c) || c == '_')) { return false; } }
    return keyword(n) == .ident;
}

!str prepare_rename(Allocator a, Project* p, str path, str src, i64 off) {
    const auto o = occ_at(p, path, off);
    if (o == null || o.sym.file == "<std>" || o.sym.k == .TypeParam && o.sym.off < 0) { return "null"; }
    auto w = new_jw(a);
    w.obj()?;
    w.key("range")?;
    auto rw = new_jw(a);
    range_json(a, &rw, p, path, o.off, o.len)?;
    w.raw(rw.text())?;
    w.key("placeholder")?;
    w.str(o.sym.name)?;
    w.end()?;
    return w.text();
}

!str rename(Allocator a, Project* p, str path, str src, i64 off, str new_name) {
    const auto s = sym_for(p, path, src, off);
    if (s == null || s.file == "<std>" || !valid_ident(new_name)) { return "null"; }
    auto files = List<str>::init(a);
    for (auto o : p.occs) {
        if (o.sym == s && !contains_str(files, o.file)) { files.push(o.file)?; }
    }
    auto w = new_jw(a);
    w.obj()?;
    w.key("changes")?;
    w.obj()?;
    for (auto f : files) {
        w.key(path_to_uri(a, f)?)?;
        w.arr()?;
        for (auto o : p.occs) {
            if (o.sym != s || o.file != f) { continue; }
            w.obj()?;
            w.key("range")?;
            auto rw = new_jw(a);
            range_json(a, &rw, p, f, o.off, o.len)?;
            w.raw(rw.text())?;
            w.key("newText")?;
            w.str(new_name)?;
            w.end()?;
        }
        w.end()?;
    }
    w.end()?;
    w.end()?;
    return w.text();
}

bool is_idc(u8 c) { return is_alnum(c) || c == '_'; }

i64 back_chain(str text, i64 end) {
    auto i = end;
    while (i > 0) {
        const auto c = text[i - 1];
        if (is_idc(c) || c == '.') {
            i -= 1;
            continue;
        }
        if (c == ')' || c == ']') {
            auto depth = 0;
            auto j = i;
            auto found = false;
            while (j > 0) {
                const auto d = text[j - 1];
                if (d == ')' || d == ']') { depth += 1; }
                if (d == '(' || d == '[') {
                    depth -= 1;
                    if (depth == 0) {
                        found = true;
                        break;
                    }
                }
                j -= 1;
            }
            if (!found) { return i; }
            i = j - 1;
            continue;
        }
        break;
    }
    while (i < end && text[i] == '.') { i += 1; }
    return i;
}

Expr* parse_expr_text(Allocator a, Project* p, str text) {
    const auto toks = tokenize(a, text, "<expr>") catch return null;
    auto ps = new_parser(a, toks.slice(), "<expr>");
    for (auto e : p.flat.entries) {
        if (e.used && e.value.k == .Module) { ps.aliases.push(e.key) catch return null };
    }
    return ps.parse_expr() catch null;
};

struct Cand {
    str label;
    i64 kind;
    str detail;
    str insert;
}

struct Items { List<Cand> list; Map<bool> seen; Allocator a;
    void add(str label, i64 kind, str detail, str insert) {
        if (label.len == 0 || this->seen.has(label)) { return; }
        this->seen.put(label, true) catch return;
        this->list.push(Cand{ .label = label, .kind = kind, .detail = detail, .insert = insert }) catch return;
    }
}

i64 sym_kind(SymK k) {
    match k {
        .Fn => return 3;
        .Method => return 2;
        .Struct, .Union => return 22;
        .Enum => return 13;
        .Const, .Var => return 21;
        .Alias => return 7;
        .Field => return 5;
        .Variant => return 20;
        .Param, .Local => return 6;
        .TypeParam => return 25;
        .Module => return 9;
    }
    return 1;
}

void add_symbol(Items* it, Symbol* s, str label, bool skip_self) {
    auto detail = "";
    if (s.k == .Fn || s.k == .Method) { detail = fn_signature(it.a, s.fd, skip_self) } else { detail = sym_detail(it.a, s); }
    it.add(label, sym_kind(s.k), detail, "");
}

void add_members_of(Items* it, Project* p, str owner, bool with_self_only) {
    const auto prefix = qname(p.a, owner, "");
    for (auto e : p.members.entries) {
        if (!e.used || !str_starts_with(e.key, prefix)) { continue; }
        const auto s = e.value;
        if (s.k == .Method && with_self_only && (s.fd.params.len == 0 || s.fd.params.get(0).name != "self")) { continue; }
        add_symbol(it, s, s.name, true);
    }
}

void add_module_members(Items* it, Project* p, str alias) {
    const auto prefix = qname(p.a, alias, "");
    for (auto e : p.flat.entries) {
        if (!e.used || !str_starts_with(e.key, prefix)) { continue; }
        const auto rest = e.key[prefix.len..];
        if (str_find_byte(rest, '.') >= 0) { continue; }
        add_symbol(it, e.value, rest, false);
    }
}

void add_static_members(Items* it, Project* p, str owner) {
    const auto prefix = qname(p.a, owner, "");
    for (auto e : p.members.entries) {
        if (!e.used || !str_starts_with(e.key, prefix)) { continue; }
        const auto s = e.value;
        if (s.k == .Field) { continue };
        add_symbol(it, s, s.name, false);
    }
}

void add_user_members(Items* it, Project* p) {
    for (auto e : p.members.entries) {
        if (!e.used || e.value.file == "<std>") { continue; }
        add_symbol(it, e.value, e.value.name, true);
    }
}

void add_all_variants(Items* it, Project* p) {
    for (auto e : p.members.entries) {
        if (!e.used) { continue; }
        const auto s = e.value;
        if (s.k != .Variant && !(s.k == .Field && s.sd != null && s.sd.is_union)) { continue; }
        it.add(s.name, 20, s.owner, "");
    }
}

const auto KEYWORDS = ["fn", "let", "var", "const", "if", "else", "while", "for", "in", "return", "break", "continue", "struct", "enum", "union", "impl", "extern", "export", "defer", "errdefer", "catch", "orelse", "match", "is", "as", "import", "type", "sizeof", "alignof", "true", "false", "null", "test"];
const auto PRIMS = ["i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64", "usize", "f32", "f64", "bool", "void", "str"];
const auto BUILTINS = ["panic", "assert", "embed"];

void add_globals(Items* it, Project* p, List<Symbol*> near, bool types_only) {
    if (!types_only) {
        for (auto s : near) { add_symbol(it, s, s.name, false); }
    }
    for (auto e : p.flat.entries) {
        if (!e.used || str_find_byte(e.key, '.') >= 0 || str_starts_with(e.key, "__")) { continue; }
        const auto s = e.value;
        const auto is_type = s.k == .Struct || s.k == .Union || s.k == .Enum || s.k == .Alias || s.k == .Module;
        if (types_only && !is_type) { continue; }
        add_symbol(it, s, e.key, false);
    }
    for (auto x : PRIMS) { it.add(x, 25, "primitive type", ""); }
    if (types_only) { return; }
    for (auto x : BUILTINS) { it.add(x, 3, "builtin", ""); }
    for (auto x : KEYWORDS) { it.add(x, 14, "keyword", ""); }
}

u8 prev_sig(str text, i64 from) {
    auto i = from;
    while (i > 0 && (text[i - 1] == ' ' || text[i - 1] == '\t' || text[i - 1] == '\n' || text[i - 1] == '\r')) { i -= 1; }
    if (i == 0) { return 0; }
    return text[i - 1];
}

i64 enclosing_open(str text, i64 from) {
    auto depth = 0;
    auto i = from;
    while (i > 0) {
        const auto c = text[i - 1];
        if (c == ')' || c == ']' || c == '}') { depth += 1; }
        if (c == '(' || c == '[' || c == '{') {
            if (depth == 0) { return i - 1; }
            depth -= 1;
        }
        i -= 1;
    }
    return -1;
}

bool in_line_comment(str text, i64 off) {
    auto ls = off;
    while (ls > 0 && text[ls - 1] != '\n') { ls -= 1; }
    auto quotes = 0;
    auto i = ls;
    while (i + 1 < off) {
        if (text[i] == '"' && (i == ls || text[i - 1] != '\\')) { quotes += 1; }
        if (text[i] == '/' && text[i + 1] == '/' && quotes % 2 == 0) { return true; }
        i += 1;
    }
    return false;
}

bool in_plain_string(str text, i64 off) {
    auto ls = off;
    while (ls > 0 && text[ls - 1] != '\n') { ls -= 1; }
    auto quotes = 0;
    auto brace = 0;
    auto i = ls;
    while (i < off) {
        if (text[i] == '"' && (i == ls || text[i - 1] != '\\')) {
            quotes += 1;
            brace = 0;
        } else if (quotes % 2 == 1) {
            if (text[i] == '{' && !(i + 1 < off && text[i + 1] == '{')) { brace += 1; }
            if (text[i] == '}' && brace > 0) { brace -= 1; }
        }
        i += 1;
    }
    return quotes % 2 == 1 && brace == 0;
}

!Items candidates(Allocator a, Project* p, str path, str text, i64 off) {
    auto it = Items{ .list = List<Cand>::init(a), .seen = Map<bool>::init(a), .a = a };
    if (in_line_comment(text, off) || in_plain_string(text, off)) { return it; }
    auto ps = off;
    while (ps > 0 && is_idc(text[ps - 1])) { ps -= 1; }
    const auto fi = p.by_path.get(path) catch null;
    auto w = Walker{ .p = p, .fi = fi, .locals = p.near, .tps = List<Symbol*>::init(a), .self_ty = null };
    if (ps > 0 && text[ps - 1] == '.') {
        const auto dot = ps - 1;
        const auto before = prev_sig(text, dot);
        const auto tight = dot > 0 && (is_idc(text[dot - 1]) || text[dot - 1] == ')' || text[dot - 1] == ']');
        if (!tight || before == 0 || before == '(' || before == ',' || before == '=' || before == '{') {
            add_all_variants(&it, p);
            return it;
        }
        const auto start = back_chain(text, dot);
        const auto e = parse_expr_text(a, p, text[start..dot]);
        if (e != null && e.k == .Ident) {
            const auto s = w.find(e.name);
            if (s != null && s.k == .Module) {
                add_module_members(&it, p, e.name);
                return it;
            };
            if (s != null && (s.k == .Struct || s.k == .Union || s.k == .Enum)) {
                add_static_members(&it, p, e.name);
                return it;
            }
        };
        const auto ty = w.peel(w.infer(e));
        if (ty != null && ty.k == .Name) {
            add_members_of(&it, p, ty.name, true);
            return it;
        };
        if (ty != null && (ty.k == .Slice || ty.k == .Array)) {
            it.add("len", 5, "i64", "");
            it.add("ptr", 5, "pointer to the first element", "");
            return it;
        }
        add_user_members(&it, p);
        return it;
    }
    const auto open = enclosing_open(text, ps);
    const auto prev = prev_sig(text, ps);
    if (open >= 0 && text[open] == '{' && (prev == '{' || prev == ',')) {
        auto e = open;
        while (e > 0 && (text[e - 1] == ' ' || text[e - 1] == '\t')) { e -= 1; }
        auto s = e;
        while (s > 0 && (is_idc(text[s - 1]) || text[s - 1] == '.')) { s -= 1; }
        const auto tn = text[s..e];
        if (tn.len > 0 && is_upper(last_segment(tn)[0])) {
            const auto sym = p.flat.get(tn) catch null;
            if (sym != null && sym.sd != null) {
                for (auto f : sym.sd.fields) { it.add(f.name, 5, type_str(a, f.ty), ""); }
                return it;
            }
        }
    }
    auto lit_brace = false;
    if (open >= 0 && text[open] == '{') {
        auto e = open;
        while (e > 0 && (text[e - 1] == ' ' || text[e - 1] == '\t')) { e -= 1; }
        auto st = e;
        while (st > 0 && (is_idc(text[st - 1]) || text[st - 1] == '.')) { st -= 1; }
        lit_brace = e > st && is_upper(last_segment(text[st..e])[0]);
    }
    const auto in_expr_brace = lit_brace && prev == ':';
    const auto types_only = (prev == ':' && !in_expr_brace) || prev == '*' || prev == '!' || prev == '?';
    add_globals(&it, p, p.near, types_only);
    return it;
};

!str completion(Allocator a, Project* p, str path, str text, i64 off) {
    const auto it = candidates(a, p, path, text, off)?;
    auto w = new_jw(a);
    w.obj()?;
    w.key("isIncomplete")?;
    w.bool(false)?;
    w.key("items")?;
    w.arr()?;
    for (auto c : it.list) {
        w.obj()?;
        w.key("label")?;
        w.str(c.label)?;
        w.key("kind")?;
        w.int(c.kind)?;
        if (c.detail.len > 0) {
            w.key("detail")?;
            w.str(c.detail)?;
        }
        w.end()?;
    }
    w.end()?;
    w.end()?;
    return w.text();
}

!str signature_help(Allocator a, Project* p, str path, str text, i64 off) {
    auto depth = 0;
    auto commas = 0;
    auto i = off;
    auto open = -1;
    while (i > 0) {
        const auto c = text[i - 1];
        if (c == ')' || c == ']' || c == '}') { depth += 1; }
        if (c == '(' || c == '[' || c == '{') {
            if (depth == 0) {
                if (c == '(') { open = i - 1; }
                break;
            }
            depth -= 1;
        }
        if (c == ',' && depth == 0) { commas += 1; }
        i -= 1;
    }
    if (open < 0) { return "null"; }
    const auto start = back_chain(text, open);
    const auto fi = p.by_path.get(path) catch null;
    auto w = Walker{ .p = p, .fi = fi, .locals = p.near, .tps = List<Symbol*>::init(a), .self_ty = null };
    const auto e = parse_expr_text(a, p, text[start..open]);
    if (e == null) { return "null"; }
    FnDecl* fd = null;
    auto skip_self = false;
    if (e.k == .Ident) {
        const auto s = w.find(e.name);
        if (s != null && s.k == .Fn) { fd = s.fd };
    } else if (e.k == .Field) {
        Symbol* ms = null;
        if (e.l.k == .Ident) {
            const auto ts = w.find(e.l.name);
            if (ts != null && (ts.k == .Struct || ts.k == .Union || ts.k == .Enum)) { ms = w.member(p.mk_name(e.l.name) catch null, e.name); }
        };
        if (ms == null) {
            ms = w.member(w.infer(e.l), e.name);
            skip_self = true;
        }
        if (ms != null && ms.k == .Method) { fd = ms.fd };
    };
    if (fd == null) { return "null"; }
    if (skip_self && (fd.params.len == 0 || fd.params.get(0).name != "self")) { skip_self = false; }
    auto label = List<u8>::init(a);
    put(&label, "fn ");
    put(&label, last_segment(fd.name));
    put_generics(&label, fd.type_params, fd.constraints);
    put(&label, "(");
    auto ranges = List<i64>::init(a);
    auto first = true;
    for (auto pr : fd.params) {
        if (skip_self && pr.name == "self") { continue; }
        if (!first) { put(&label, ", "); }
        first = false;
        ranges.push(label.len)?;
        put(&label, pr.name);
        if (!(pr.name == "self" && pr.ty != null && pr.ty.k == .Ptr && pr.ty.elem.k == .Name && pr.ty.elem.name == "Self")) {
            put(&label, ": ");
            put_type(&label, pr.ty);
        }
        ranges.push(label.len)?;
    }
    put(&label, ")");
    if (fd.ret != null) {
        put(&label, " ");
        put_type(&label, fd.ret);
    }
    auto sw = new_jw(a);
    sw.obj()?;
    sw.key("signatures")?;
    sw.arr()?;
    sw.obj()?;
    sw.key("label")?;
    sw.str(label.slice())?;
    sw.key("parameters")?;
    sw.arr()?;
    auto k = 0;
    while (k + 1 < ranges.len) {
        sw.obj()?;
        sw.key("label")?;
        sw.arr()?;
        sw.int(ranges.get(k))?;
        sw.int(ranges.get(k + 1))?;
        sw.end()?;
        sw.end()?;
        k += 2;
    }
    sw.end()?;
    sw.end()?;
    sw.end()?;
    sw.key("activeSignature")?;
    sw.int(0)?;
    sw.key("activeParameter")?;
    sw.int(min(commas, max(ranges.len / 2 - 1, 0)))?;
    sw.end()?;
    return sw.text();
}
