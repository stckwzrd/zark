// Language server over stdio: `vibe lsp`. It reuses the compiler frontend, so what the editor shows is what the compiler says.

import "loader.vibe"
import "json.vibe"
import "fmt.vibe"
import "textpos.vibe"
import "ide.vibe"

extern fn read(fd: i32, buf: *u8, n: u64) i64
extern fn dup(fd: i32) i32
extern fn dup2(from: i32, to: i32) i32
extern fn close(fd: i32) i32
extern fn fileno(f: *void) i32
extern fn tmpfile() *void
extern fn poll(fds: *PollFd, n: u64, timeout: i32) i32

struct PollFd { fd: i32, events: i16, revents: i16 }

struct Reader {
    buf: []u8
    pos: i64
    len: i64
}

fn new_reader(a: Allocator) !Reader {
    return Reader{ buf: a.alloc[u8](65536)?, pos: 0, len: 0 }
}

impl Reader {
    fn fill(self) bool {
        let n = read(0, self.buf.ptr, self.buf.len as u64)
        if n <= 0 { return false }
        self.pos = 0
        self.len = n
        return true
    }

    fn byte(self) i64 {
        if self.pos >= self.len && !self.fill() { return -1 }
        let b = self.buf[self.pos]
        self.pos += 1
        return b as i64
    }

    fn pending(self) bool {
        if self.pos < self.len { return true }
        var p = PollFd{ fd: 0, events: 1, revents: 0 }
        return poll(&p, 1, 0) > 0
    }

    fn message(self, a: Allocator) !str {
        var length = -1
        while true {
            var line = List[u8].init(a)
            while true {
                let b = self.byte()
                if b < 0 { return error.Eof }
                if b == '\n' { break }
                if b != '\r' { line.push(b as u8)? }
            }
            if line.len == 0 {
                if length >= 0 { break }
                continue
            }
            let h = line.slice()
            if h.len > 15 && str_starts_with(h, "Content-Length:") {
                length = (parse_int(str_trim(h[15..])) catch 0) as i64
            }
        }
        if length > 268435456 { length = 0 }
        let body = a.alloc[u8](length)?
        for i in 0..length {
            let b = self.byte()
            if b < 0 { return error.Eof }
            body[i] = b as u8
        }
        return body
    }
}

struct Doc {
    uri: str
    path: str
    text: str
    version: i64
    starts: List[i64]
    open: bool
    last_syms: str
}

impl Doc {
    fn tx(self) Text { return Text{ text: self.text, starts: self.starts } }
}

struct Server {
    a: Allocator
    rd: Reader
    out: *void
    docs: Map[*Doc]
    dirty: List[str]
    published: Map[List[str]]
    root: str
    down: bool
}

fn hex_val(c: u8) i64 {
    if c >= '0' && c <= '9' { return (c - '0') as i64 }
    if c >= 'a' && c <= 'f' { return (c - 'a') as i64 + 10 }
    if c >= 'A' && c <= 'F' { return (c - 'A') as i64 + 10 }
    return -1
}

fn uri_to_path(a: Allocator, uri: str) !str {
    var s = uri
    if str_starts_with(s, "file://") { s = s[7..] }
    var b = List[u8].init(a)
    var i = 0
    while i < s.len {
        if s[i] == '%' && i + 2 < s.len && hex_val(s[i + 1]) >= 0 && hex_val(s[i + 2]) >= 0 {
            b.push((hex_val(s[i + 1]) * 16 + hex_val(s[i + 2])) as u8)?
            i += 3
        } else {
            b.push(s[i])?
            i += 1
        }
    }
    return b.slice()
}

var uri_map: Map[str] = Map[str]{ .. }
var rename_blocked: bool = false

fn path_to_uri(a: Allocator, path: str) !str {
    if uri_map.has(path) { return uri_map.get(path) }
    var b = List[u8].init(a)
    b.append("file://")?
    for c in path {
        if is_alnum(c) || c == '/' || c == '-' || c == '_' || c == '.' || c == '~' {
            b.push(c)?
        } else {
            sprint(&b, "%{c:02X}")?
        }
    }
    return b.slice()
}

impl Server {
    fn send(self, body: str) {
        var hdr = List[u8].init(self.a)
        sprint(&hdr, "Content-Length: {body.len}\r\n\r\n") catch return
        _ = fwrite(hdr.items.ptr, 1, hdr.len as u64, self.out)
        _ = fwrite(body.ptr, 1, body.len as u64, self.out)
        _ = fflush(self.out)
        hdr.deinit()
    }

    fn reply(self, a: Allocator, id: *Json, result: str) !void {
        var w = new_jw(a)
        w.obj()?
        w.key("jsonrpc")?
        w.str("2.0")?
        w.key("id")?
        if jkind(id) == .Str { w.str(jstr(id, ""))? } else { w.int(jint(id, 0))? }
        w.key("result")?
        w.raw(result)?
        w.end()?
        self.send(w.text())
    }

    fn fail(self, a: Allocator, id: *Json, code: i64, msg: str) !void {
        var w = new_jw(a)
        w.obj()?
        w.key("jsonrpc")?
        w.str("2.0")?
        w.key("id")?
        if jkind(id) == .Str { w.str(jstr(id, ""))? } else { w.int(jint(id, 0))? }
        w.key("error")?
        w.obj()?
        w.key("code")?
        w.int(code)?
        w.key("message")?
        w.str(msg)?
        w.end()?
        w.end()?
        self.send(w.text())
    }

    fn notify(self, a: Allocator, method: str, params: str) !void {
        var w = new_jw(a)
        w.obj()?
        w.key("jsonrpc")?
        w.str("2.0")?
        w.key("method")?
        w.str(method)?
        w.key("params")?
        w.raw(params)?
        w.end()?
        self.send(w.text())
    }

    fn doc_at(self, j: *Json) *Doc {
        let uri = jstr(jget(jget(j, "textDocument"), "uri"), "")
        return self.docs.get(uri) catch null
    }

    fn set_doc(self, uri: str, text: str, version: i64) !void {
        let copy = self.a.dup(text)?
        if self.docs.has(uri) {
            let old = self.docs.get(uri)?
            self.a.free(old.text)
            old.starts.deinit()
            old.text = copy
            old.starts = compute_starts(self.a, copy)?
            old.version = version
            old.open = true
            return
        }
        let path = uri_to_path(self.a, uri)?
        let d = self.a.create[Doc]()?
        d.uri = self.a.dup(uri)?
        d.path = canonical(self.a, path)?
        uri_map.put(d.path, d.uri)?
        d.text = copy
        d.version = version
        d.starts = compute_starts(self.a, copy)?
        d.open = true
        self.docs.put(d.uri, d)?
    }

    fn publish(self, a: Allocator, uri: str, diags: str) !void {
        var w = new_jw(a)
        w.obj()?
        w.key("uri")?
        w.str(uri)?
        w.key("diagnostics")?
        w.raw(diags)?
        w.end()?
        self.notify(a, "textDocument/publishDiagnostics", w.text())?
    }

    fn mark_dirty(self, uri: str) !void {
        for x in self.dirty { if x == uri { return } }
        self.dirty.push(self.a.dup(uri)?)?
    }
}

fn capabilities(a: Allocator) !str {
    var w = new_jw(a)
    w.obj()?
    w.key("capabilities")?
    w.obj()?
    w.key("positionEncoding")?
    w.str("utf-16")?
    w.key("textDocumentSync")?
    w.obj()?
    w.key("openClose")?
    w.bool(true)?
    w.key("change")?
    w.int(1)?
    w.key("save")?
    w.obj()?
    w.end()?
    w.end()?
    w.key("documentSymbolProvider")?
    w.bool(true)?
    w.key("documentFormattingProvider")?
    w.bool(true)?
    w.key("hoverProvider")?
    w.bool(true)?
    w.key("completionProvider")?
    w.obj()?
    w.key("triggerCharacters")?
    w.arr()?
    w.str(".")?
    w.end()?
    w.end()?
    w.key("signatureHelpProvider")?
    w.obj()?
    w.key("triggerCharacters")?
    w.arr()?
    w.str("(")?
    w.str(",")?
    w.end()?
    w.end()?
    w.key("definitionProvider")?
    w.bool(true)?
    w.key("referencesProvider")?
    w.bool(true)?
    w.key("workspaceSymbolProvider")?
    w.bool(true)?
    w.key("codeActionProvider")?
    w.obj()?
    w.key("codeActionKinds")?
    w.arr()?
    w.str("quickfix")?
    w.end()?
    w.end()?
    w.key("documentHighlightProvider")?
    w.bool(true)?
    w.key("renameProvider")?
    w.obj()?
    w.key("prepareProvider")?
    w.bool(true)?
    w.end()?
    w.end()?
    w.key("serverInfo")?
    w.obj()?
    w.key("name")?
    w.str("vibe")?
    w.end()?
    w.end()?
    return w.text()
}

fn format_doc(s: *Server, a: Allocator, d: *Doc) !str {
    var w = new_jw(a)
    w.arr()?
    let saved = dup(2)
    let tmp = tmpfile()
    _ = dup2(fileno(tmp), 2)
    let out = format_source(a, d.text, d.path) catch ""
    _ = dup2(saved, 2)
    _ = close(saved)
    _ = fclose(tmp)
    if out.len > 0 && out != d.text {
        let last = d.starts.len - 1
        w.obj()?
        w.key("range")?
        var rw = new_jw(a)
        try_range(&rw, d.tx(), 0, d.text.len)?
        w.raw(rw.text())?
        w.key("newText")?
        w.str(out)?
        w.end()?
    }
    w.end()?
    return w.text()
}

struct Diag {
    path: str
    line: i64
    text: str
    col: i64
    msg: str
}

fn silence_begin() i32 {
    let saved = dup(2)
    let tmp = tmpfile()
    _ = dup2(fileno(tmp), 2)
    _ = fclose(tmp)
    return saved
}

fn silence_end(saved: i32) {
    _ = dup2(saved, 2)
    _ = close(saved)
}

fn run_frontend(s: *Server, a: Allocator, d: *Doc) {
    let g = new_gen(a, true) catch return
    var overrides = Map[str].init(a)
    for e in s.docs.entries {
        if e.used && e.value.open { overrides.put(e.value.path, e.value.text) catch return }
    }
    var loader = Loader{ a: a, g: g, seen: Map[str].init(a), prefixes: Map[str].init(a), overrides: overrides }
    diag_prelude = PRELUDE
    diag_files = overrides
    g.test_root = d.path
    loader.load_source(PRELUDE, "<std>", "") catch {
        g.flush_diag()
        return
    }
    loader.load_file(d.path, "") catch {
        g.flush_diag()
        return
    }
    g.generate_check(d.path) catch g.flush_diag()
}

fn capture_check(s: *Server, a: Allocator, d: *Doc) !str {
    let saved = dup(2)
    let tmp = tmpfile()
    _ = dup2(fileno(tmp), 2)
    run_frontend(s, a, d)
    diag_files = Map[str]{ .. }
    _ = dup2(saved, 2)
    _ = close(saved)
    _ = fseek(tmp, 0, 2)
    let n = ftell(tmp)
    _ = fseek(tmp, 0, 0)
    var out = ""
    if n > 0 {
        let buf = a.alloc[u8](n)?
        _ = fread(buf.ptr, 1, n as u64, tmp)
        out = buf
    }
    _ = fclose(tmp)
    return out
}

fn parse_diags(a: Allocator, text: str, root: str) !List[Diag] {
    var out = List[Diag].init(a)
    var lines = List[str].init(a)
    var st = 0
    for i, c in text {
        if c == '\n' {
            lines.push(text[st..i])?
            st = i + 1
        }
    }
    if st < text.len { lines.push(text[st..])? }
    for i, ln in lines {
        let at = str_find(ln, ": error: ")
        if at < 0 {
            if str_starts_with(ln, "error: ") { out.push(Diag{ path: root, line: 1, text: "", col: -1, msg: ln[7..] })? }
            continue
        }
        let head = ln[0..at]
        let colon = str_rfind_byte(head, ':')
        if colon < 0 { continue }
        let path = head[0..colon]
        if str_starts_with(path, "<") { continue }
        var d = Diag{ path: path, line: (parse_int(head[colon + 1..]) catch 1) as i64, text: "", col: -1, msg: ln[at + 9..] }
        if i + 1 < lines.len {
            let sn = lines.get(i + 1)
            if sn.len >= 8 && sn[5..8] == " | " && is_digit(str_trim(sn[0..5])[0]) {
                d.line = (parse_int(str_trim(sn[0..5])) catch 1) as i64
                d.text = sn[8..]
                if i + 2 < lines.len {
                    let cr = lines.get(i + 2)
                    if str_starts_with(cr, "      | ") {
                        let caret = str_rfind_byte(cr, '^')
                        if caret >= 8 { d.col = caret - 8 }
                    }
                }
            }
        }
        out.push(d)?
    }
    return out
}

fn diag_json(a: Allocator, dg: Diag) !str {
    var from = 0
    var to = 0
    if dg.col >= 0 {
        from = utf16_between(dg.text, 0, dg.col)
        var e = dg.col
        while e < dg.text.len && (is_alnum(dg.text[e]) || dg.text[e] == '_' || dg.text[e] == '.') { e += 1 }
        if e == dg.col && e < dg.text.len { e += 1 }
        to = utf16_between(dg.text, 0, e)
        if to <= from { to = from + 1 }
    } else {
        to = 1000
    }
    var w = new_jw(a)
    w.obj()?
    w.key("range")?
    w.obj()?
    w.key("start")?
    w.obj()?
    w.key("line")?
    w.int(max(dg.line - 1, 0))?
    w.key("character")?
    w.int(from)?
    w.end()?
    w.key("end")?
    w.obj()?
    w.key("line")?
    w.int(max(dg.line - 1, 0))?
    w.key("character")?
    w.int(to)?
    w.end()?
    w.end()?
    w.key("severity")?
    w.int(1)?
    w.key("source")?
    w.str("vibe")?
    w.key("message")?
    w.str(dg.msg)?
    w.end()?
    return w.text()
}

fn run_checks(s: *Server) {
    var uris = List[str].init(s.a)
    for u in s.dirty { uris.push(u) catch return }
    s.dirty.len = 0
    for u in uris {
        let d = s.docs.get(u) catch null
        if d == null || !d.open { continue }
        var ar = Arena.init(c_allocator())
        let a = ar.allocator()
        check_doc(s, a, d) catch |e| {
            eprintln("vibe lsp: check failed: {e}")
        }
        ar.deinit()
    }
    for u in uris { s.a.free(u) }
    uris.deinit()
}

fn check_doc(s: *Server, a: Allocator, d: *Doc) !void {
    let text = capture_check(s, a, d)?
    let diags = parse_diags(a, text, d.path)?
    var paths = List[str].init(a)
    paths.push(d.path)?
    for dg in diags {
        if !contains_str(paths, dg.path) { paths.push(dg.path)? }
    }
    for p in paths {
        var w = new_jw(a)
        w.arr()?
        for dg in diags {
            if dg.path == p { w.raw(diag_json(a, dg)?)? }
        }
        w.end()?
        s.publish(a, path_to_uri(a, p)?, w.text())?
    }
    if s.published.has(d.path) {
        let olds = s.published.get(d.path)?
        for old in olds {
            if !contains_str(paths, old) { s.publish(a, path_to_uri(a, old)?, "[]")? }
            s.a.free(old)
        }
        olds.deinit()
    }
    var keep = List[str].init(s.a)
    for p in paths { keep.push(s.a.dup(p)?)? }
    s.published.put(d.path, keep)?
}

struct Node2 {
    kind: i64
    name: str
    from: i64
    to: i64
    sel: i64
    sel_len: i64
    kids: List[*Node2]
}

fn node2(a: Allocator, kind: i64, name: str, from: i64, to: i64, sel: i64) !*Node2 {
    let n = a.create[Node2]()?
    *n = Node2{ kind: kind, name: name, from: from, to: max(to, from), sel: sel, sel_len: name.len, kids: List[*Node2].init(a) }
    return n
}

fn render_node(w: *JW, a: Allocator, d: *Doc, n: *Node2) !void {
    w.obj()?
    w.key("name")?
    w.str(n.name)?
    w.key("kind")?
    w.int(n.kind)?
    w.key("range")?
    var rw = new_jw(a)
    try_range(&rw, d.tx(), n.from, n.to)?
    w.raw(rw.text())?
    w.key("selectionRange")?
    var sw = new_jw(a)
    try_range(&sw, d.tx(), n.sel, n.sel + n.sel_len)?
    w.raw(sw.text())?
    if n.kids.len > 0 {
        w.key("children")?
        w.arr()?
        for k in n.kids { render_node(w, a, d, k)? }
        w.end()?
    }
    w.end()?
}

fn line_start_off(d: *Doc, line: i64) i64 {
    if line < 1 { return 0 }
    if line > d.starts.len { return d.text.len }
    return d.starts.get(line - 1)
}

fn build_symbols(a: Allocator, d: *Doc, decls: List[Decl]) !List[*Node2] {
    var top = List[*Node2].init(a)
    var owners = Map[*Node2].init(a)
    for dc in decls {
        match dc.k {
            .Struct => {
                let sd = dc.s
                var kind = 23
                if sd.is_union { kind = 23 }
                let n = node2(a, kind, sd.name, line_start_off(d, sd.line), d.tx().line_end(d.tx().line_of(sd.name_off)), sd.name_off)?
                for f in sd.fields {
                    let k = node2(a, 8, f.name, f.off, f.off + f.name.len, f.off)?
                    n.kids.push(k)?
                    n.to = max(n.to, k.to)
                }
                owners.put(sd.name, n)?
                top.push(n)?
            }
            .Enum => {
                let ed = dc.en
                let n = node2(a, 10, ed.name, line_start_off(d, ed.line), d.tx().line_end(d.tx().line_of(ed.name_off)), ed.name_off)?
                for i, v in ed.variants {
                    let k = node2(a, 22, v, ed.variant_offs.get(i), ed.variant_offs.get(i) + v.len, ed.variant_offs.get(i))?
                    n.kids.push(k)?
                    n.to = max(n.to, k.to)
                }
                owners.put(ed.name, n)?
                top.push(n)?
            }
            .Const => {
                var kind = 14
                if dc.c.mutable { kind = 13 }
                top.push(node2(a, kind, dc.c.name, line_start_off(d, dc.c.line), dc.c.name_off + dc.c.name.len, dc.c.name_off)?)?
            }
            .Alias => top.push(node2(a, 26, dc.path, line_start_off(d, dc.line), dc.name_off + dc.path.len, dc.name_off)?)?
            .Func => {
                let f = dc.f
                var name = f.name
                var kind = 12
                if f.is_test {
                    var nb = List[u8].init(a)
                    sprint(&nb, "test \"{f.test_name}\"")?
                    name = nb.slice()
                    kind = 24
                }
                var to = f.end_off + 1
                if f.body == null { to = f.name_off + f.name.len }
                var sel_len = f.name.len
                if f.is_test { sel_len = 4 }
                let n = node2(a, kind, name, line_start_off(d, f.line), to, f.name_off)?
                n.sel_len = sel_len
                if f.receiver.len > 0 {
                    n.kind = 6
                    if owners.has(f.receiver) {
                        let o = owners.get(f.receiver)?
                        o.kids.push(n)?
                        o.to = max(o.to, n.to)
                        continue
                    }
                }
                top.push(n)?
            }
        }
    }
    return top
}

fn document_symbols(s: *Server, a: Allocator, d: *Doc) !str {
    let saved = silence_begin()
    var ok = true
    var decls = List[Decl].init(a)
    let toks = tokenize(a, d.text, d.path) catch {
        ok = false
        List[Token].init(a)
    }
    if ok {
        var p = new_parser(a, toks.slice(), d.path)
        decls = p.parse_file() catch {
            ok = false
            decls
        }
    }
    silence_end(saved)
    if !ok {
        if d.last_syms.len == 0 { return "[]" }
        return d.last_syms
    }
    let nodes = build_symbols(a, d, decls)?
    var w = new_jw(a)
    w.arr()?
    for n in nodes { render_node(&w, a, d, n)? }
    w.end()?
    if d.last_syms.len > 0 { s.a.free(d.last_syms) }
    d.last_syms = s.a.dup(w.text())?
    return w.text()
}

fn analysis_for(s: *Server, a: Allocator, d: *Doc, off: i64) !*Project {
    return analysis_with(s, a, d, d.text, off)
}

fn analysis_with(s: *Server, a: Allocator, d: *Doc, text: str, off: i64) !*Project {
    let p = a.create[Project]()?
    var ov = Map[str].init(a)
    for e in s.docs.entries {
        if e.used && e.value.open { ov.put(e.value.path, e.value.text)? }
    }
    ov.put(d.path, text)?
    *p = new_project(a, ov)
    let saved = silence_begin()
    analyze(p, d.path, d.path, off) catch {}
    silence_end(saved)
    return p
}

fn cursor_of(d: *Doc, params: *Json) i64 {
    let pos = jget(params, "position")
    return d.tx().offset(jint(jget(pos, "line"), 0), jint(jget(pos, "character"), 0))
}

fn handle_completion(s: *Server, a: Allocator, id: *Json, method: str, params: *Json) !void {
    let d = s.doc_at(params)
    if d == null {
        s.reply(a, id, "null")?
        return
    }
    let off = cursor_of(d, params)
    if method == "textDocument/signatureHelp" {
        let p = analysis_for(s, a, d, off)?
        let saved = silence_begin()
        let out = signature_help(a, p, d.path, d.text, off)
        silence_end(saved)
        s.reply(a, id, out?)?
        return
    }
    var ps = off
    while ps > 0 && is_idc(d.text[ps - 1]) { ps -= 1 }
    var text = d.text
    var at = off
    if ps > 0 && d.text[ps - 1] == '.' {
        var b = List[u8].init(a)
        b.append(d.text[0..ps - 1])?
        b.append(d.text[off..])?
        text = b.slice()
        at = ps - 1
    }
    let p = analysis_with(s, a, d, text, at)?
    let saved = silence_begin()
    let out = completion(a, p, d.path, d.text, off)
    silence_end(saved)
    s.reply(a, id, out?)?
}

fn handle_query(s: *Server, a: Allocator, id: *Json, method: str, params: *Json) !bool {
    if method == "textDocument/completion" || method == "textDocument/signatureHelp" {
        handle_completion(s, a, id, method, params)?
        return true
    }
    if method == "workspace/symbol" {
        s.reply(a, id, workspace_symbols(s, a, jstr(jget(params, "query"), ""))?)?
        return true
    }
    if method == "textDocument/codeAction" {
        s.reply(a, id, code_actions(a, params)?)?
        return true
    }
    if method == "textDocument/references" || method == "textDocument/rename" {
        let d = s.doc_at(params)
        if d == null {
            s.reply(a, id, "null")?
            return true
        }
        let off = cursor_of(d, params)
        if method == "textDocument/references" { s.reply(a, id, refs_json(s, a, d, off, jbool(jget(jget(params, "context"), "includeDeclaration"), true))?)? }
        if method == "textDocument/rename" { s.reply(a, id, rename_json(s, a, d, off, jstr(jget(params, "newName"), ""))?)? }
        return true
    }
    if method != "textDocument/hover" && method != "textDocument/definition" && method != "textDocument/references" && method != "textDocument/documentHighlight" && method != "textDocument/prepareRename" && method != "textDocument/rename" { return false }
    let d = s.doc_at(params)
    if d == null {
        s.reply(a, id, "null")?
        return true
    }
    let off = cursor_of(d, params)
    let p = analysis_for(s, a, d, off)?
    if method == "textDocument/hover" { s.reply(a, id, hover(a, p, d.path, d.text, off)?)? }
    if method == "textDocument/definition" { s.reply(a, id, definition(a, p, d.path, d.text, off)?)? }
    if method == "textDocument/documentHighlight" { s.reply(a, id, highlights(a, p, d.path, d.text, off)?)? }
    if method == "textDocument/prepareRename" { s.reply(a, id, prepare_rename(a, p, d.path, d.text, off)?)? }
    return true
}

fn handle(s: *Server, a: Allocator, msg: *Json) !void {
    let method = jstr(jget(msg, "method"), "")
    let id = jget(msg, "id")
    let params = jget(msg, "params")
    let is_req = id != null && jkind(id) != .Null
    if method == "initialize" {
        var root = jstr(jget(params, "rootUri"), "")
        let folders = jget(params, "workspaceFolders")
        if jlen(folders) > 0 { root = jstr(jget(jat(folders, 0), "uri"), root) }
        if root.len > 0 { s.root = uri_to_path(s.a, root)? }
        s.reply(a, id, capabilities(a)?)?
        return
    }
    if method == "shutdown" {
        s.down = true
        s.reply(a, id, "null")?
        return
    }
    if method == "exit" {
        exit(0)
        return
    }
    if method == "textDocument/didOpen" {
        let td = jget(params, "textDocument")
        let uri = jstr(jget(td, "uri"), "")
        s.set_doc(uri, jstr(jget(td, "text"), ""), jint(jget(td, "version"), 0))?
        s.mark_dirty(uri)?
        return
    }
    if method == "textDocument/didChange" {
        let td = jget(params, "textDocument")
        let uri = jstr(jget(td, "uri"), "")
        let changes = jget(params, "contentChanges")
        if jlen(changes) > 0 {
            let last = jat(changes, jlen(changes) - 1)
            s.set_doc(uri, jstr(jget(last, "text"), ""), jint(jget(td, "version"), 0))?
            s.mark_dirty(uri)?
        }
        return
    }
    if method == "textDocument/didSave" {
        s.mark_dirty(jstr(jget(jget(params, "textDocument"), "uri"), ""))?
        return
    }
    if method == "textDocument/didClose" {
        let uri = jstr(jget(jget(params, "textDocument"), "uri"), "")
        let d = s.docs.get(uri) catch null
        if d != null { d.open = false }
        s.publish(a, uri, "[]")?
        return
    }
    if method == "textDocument/formatting" {
        let d = s.doc_at(params)
        if d == null {
            s.reply(a, id, "[]")?
            return
        }
        s.reply(a, id, format_doc(s, a, d)?)?
        return
    }
    if method == "textDocument/documentSymbol" {
        let d = s.doc_at(params)
        if d == null {
            s.reply(a, id, "[]")?
            return
        }
        s.reply(a, id, document_symbols(s, a, d)?)?
        return
    }
    if is_req && handle_query(s, a, id, method, params)? { return }
    if is_req { s.fail(a, id, -32601, "method not found")? }
}

fn lsp_main() i32 {
    let a = c_allocator()
    uri_map = Map[str].init(a)
    var s = Server{
        a: a, rd: new_reader(a) catch return 1, out: fdopen(1, "wb"), docs: Map[*Doc].init(a), dirty: List[str].init(a),
        published: Map[List[str]].init(a), root: "", down: false,
    }
    while true {
        if s.dirty.len > 0 && !s.rd.pending() { run_checks(&s) }
        var ar = Arena.init(c_allocator())
        let ta = ar.allocator()
        let body = s.rd.message(ta) catch {
            break
        }
        let msg = json_parse(ta, body) catch {
            ar.deinit()
            continue
        }
        handle(&s, ta, msg) catch |e| {
            eprintln("vibe lsp: {e}")
            let rid = jget(msg, "id")
            if rid != null && jkind(rid) != .Null { s.fail(ta, rid, -32603, "internal error") catch {} }
        }
        ar.deinit()
    }
    return 0
}

extern fn popen(cmd: *u8, mode: *u8) *void
extern fn pclose(f: *void) i32

struct OccRef { file: str, off: i64, range: str, decl: bool }

fn lc(c: u8) u8 {
    if c >= 'A' && c <= 'Z' { return c + 32 }
    return c
}

fn list_workspace(a: Allocator, root: str) !List[str] {
    var out = List[str].init(a)
    if root.len == 0 || str_find_byte(root, '\'') >= 0 { return out }
    var cmd = List[u8].init(a)
    sprint(&cmd, "find '{root}' -name '*.vibe' -not -path '*/.vibe-cache/*' -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null | head -2000")?
    let f = popen(a.dupz(cmd.slice())?, "r")
    if f == null { return out }
    var buf = List[u8].init(a)
    var chunk: [4096]u8
    while true {
        let n = fread(chunk.ptr, 1, 4096, f)
        if n == 0 { break }
        buf.append(chunk[0..n as i64])?
    }
    _ = pclose(f)
    var st = 0
    let text = buf.slice()
    for i, c in text {
        if c == '\n' {
            if i > st { out.push(canonical(a, text[st..i])?)? }
            st = i + 1
        }
    }
    return out
}

fn file_imports(a: Allocator, path: str) !List[str] {
    var out = List[str].init(a)
    let src = read_file(a, path) catch return out
    let toks = tokenize(a, src, path)?
    var p = new_parser(a, toks.slice(), path)
    let decls = p.parse_file()?
    for d in decls {
        if d.k == .Import { out.push(canonical(a, join_path(a, dir_of(path), d.path)?)?)? }
    }
    return out
}

fn roots_for(s: *Server, a: Allocator, target: str, hint_dir: str) !List[str] {
    var base = s.root
    if base.len == 0 { base = hint_dir }
    let files = list_workspace(a, base)?
    var imports = Map[List[str]].init(a)
    let saved = silence_begin()
    var tname = target
    let ts = str_rfind_byte(target, '/')
    if ts >= 0 { tname = target[ts + 1..] }
    for f in files {
        let im = file_imports(a, f) catch {
            let text = read_file(a, f) catch ""
            if str_find(text, tname) >= 0 { rename_blocked = true }
            List[str].init(a)
        }
        imports.put(f, im)?
    }
    silence_end(saved)
    var reach = List[str].init(a)
    reach.push(target)?
    var changed = true
    while changed {
        changed = false
        for f in files {
            if contains_str(reach, f) { continue }
            let im = imports.get(f) catch {
                continue
            }
            for x in im {
                if contains_str(reach, x) {
                    reach.push(f)?
                    changed = true
                    break
                }
            }
        }
    }
    var roots = List[str].init(a)
    for f in reach {
        var imported = false
        for g in reach {
            if g == f { continue }
            let im = imports.get(g) catch {
                continue
            }
            if contains_str(im, f) { imported = true }
        }
        if !imported { roots.push(f)? }
    }
    if roots.len == 0 { roots.push(target)? }
    return roots
}

fn collect_refs(a: Allocator, p: *Project, tfile: str, toff: i64, seen: *Map[bool], out: *List[OccRef]) !void {
    for o in p.occs {
        if o.sym.file != tfile || o.sym.off != toff || !p.by_path.has(o.file) { continue }
        var kb = List[u8].init(a)
        sprint(&kb, "{o.file}:{o.off}")?
        if seen.has(kb.slice()) { continue }
        seen.put(kb.slice(), true)?
        var rw = new_jw(a)
        range_json(a, &rw, p, o.file, o.off, o.len)?
        out.push(OccRef{ file: o.file, off: o.off, range: rw.text(), decl: o.off == toff && o.file == tfile })?
    }
}

fn all_refs(s: *Server, a: Allocator, d: *Doc, off: i64) !List[OccRef] {
    var out = List[OccRef].init(a)
    var seen = Map[bool].init(a)
    let p = analysis_for(s, a, d, off)?
    let sym = sym_for(p, d.path, d.text, off)
    if sym == null || sym.file == "<std>" || sym.off < 0 { return out }
    collect_refs(a, p, sym.file, sym.off, &seen, &out)?
    if sym.k == .Local || sym.k == .Param || sym.k == .TypeParam { return out }
    let roots = roots_for(s, a, sym.file, dir_of(d.path)) catch return out
    for r in roots {
        if r == d.path { continue }
        var ov = Map[str].init(a)
        for e in s.docs.entries {
            if e.used && e.value.open { ov.put(e.value.path, e.value.text)? }
        }
        let q = a.create[Project]()?
        *q = new_project(a, ov)
        let saved = silence_begin()
        analyze(q, r, r, -1) catch {}
        silence_end(saved)
        for f in q.files { if !f.ok { rename_blocked = true } }
        collect_refs(a, q, sym.file, sym.off, &seen, &out)?
    }
    return out
}

fn refs_json(s: *Server, a: Allocator, d: *Doc, off: i64, with_decl: bool) !str {
    let refs = all_refs(s, a, d, off)?
    var w = new_jw(a)
    w.arr()?
    for r in refs {
        if r.decl && !with_decl { continue }
        w.obj()?
        w.key("uri")?
        w.str(path_to_uri(a, r.file)?)?
        w.key("range")?
        w.raw(r.range)?
        w.end()?
    }
    w.end()?
    return w.text()
}

fn rename_json(s: *Server, a: Allocator, d: *Doc, off: i64, new_name: str) !str {
    if !valid_ident(new_name) { return "null" }
    rename_blocked = false
    let refs = all_refs(s, a, d, off)?
    if refs.len == 0 || rename_blocked { return "null" }
    var files = List[str].init(a)
    for r in refs { if !contains_str(files, r.file) { files.push(r.file)? } }
    var w = new_jw(a)
    w.obj()?
    w.key("changes")?
    w.obj()?
    for f in files {
        w.key(path_to_uri(a, f)?)?
        w.arr()?
        for r in refs {
            if r.file != f { continue }
            w.obj()?
            w.key("range")?
            w.raw(r.range)?
            w.key("newText")?
            w.str(new_name)?
            w.end()?
        }
        w.end()?
    }
    w.end()?
    w.end()?
    return w.text()
}

fn symbol_kind_of(k: SymK) i64 {
    match k {
        .Fn => return 12
        .Method => return 6
        .Struct, .Union => return 23
        .Enum => return 10
        .Const => return 14
        .Var => return 13
        .Alias => return 26
        .Field => return 8
        .Variant => return 22
    }
    return 13
}

fn workspace_symbols(s: *Server, a: Allocator, query: str) !str {
    let files = list_workspace(a, s.root)?
    var w = new_jw(a)
    w.arr()?
    var count = 0
    var q = List[u8].init(a)
    for c in query { q.push(lc(c))? }
    let saved = silence_begin()
    for f in files {
        if count >= 200 { break }
        let src = read_file(a, f) catch {
            continue
        }
        let toks = tokenize(a, src, f) catch {
            continue
        }
        var ps = new_parser(a, toks.slice(), f)
        let decls = ps.parse_file() catch {
            continue
        }
        let tx = Text{ text: src, starts: compute_starts(a, src)? }
        for dc in decls {
            var name = ""
            var off = 0
            var kind = 13
            match dc.k {
                .Func => {
                    if dc.f.is_test { continue }
                    name = dc.f.name
                    off = dc.f.name_off
                    kind = 12
                    if dc.f.receiver.len > 0 { kind = 6 }
                }
                .Struct => {
                    name = dc.s.name
                    off = dc.s.name_off
                    kind = 23
                }
                .Enum => {
                    name = dc.en.name
                    off = dc.en.name_off
                    kind = 10
                }
                .Const => {
                    name = dc.c.name
                    off = dc.c.name_off
                    kind = 14
                }
                .Alias => {
                    name = dc.path
                    off = dc.name_off
                    kind = 26
                }
                .Import => continue
            }
            var lower = List[u8].init(a)
            for c in name { lower.push(lc(c))? }
            if q.len > 0 && str_find(lower.slice(), q.slice()) < 0 { continue }
            w.obj()?
            w.key("name")?
            w.str(name)?
            w.key("kind")?
            w.int(kind)?
            w.key("location")?
            w.obj()?
            w.key("uri")?
            w.str(path_to_uri(a, f)?)?
            w.key("range")?
            var rw = new_jw(a)
            try_range(&rw, tx, off, off + name.len)?
            w.raw(rw.text())?
            w.end()?
            w.end()?
            count += 1
        }
    }
    silence_end(saved)
    w.end()?
    return w.text()
}

fn code_actions(a: Allocator, params: *Json) !str {
    let uri = jstr(jget(jget(params, "textDocument"), "uri"), "")
    let diags = jget(jget(params, "context"), "diagnostics")
    var w = new_jw(a)
    w.arr()?
    for i in 0..jlen(diags) {
        let dg = jat(diags, i)
        let msg = jstr(jget(dg, "message"), "")
        let at = str_find(msg, "(did you mean '")
        if at < 0 { continue }
        let rest = msg[at + 15..]
        let q = str_find_byte(rest, '\'')
        if q <= 0 { continue }
        let fix = rest[0..q]
        var title = List[u8].init(a)
        sprint(&title, "Change to '{fix}'")?
        let r = jget(dg, "range")
        if jint(jget(jget(r, "end"), "character"), 0) >= 1000 { continue }
        w.obj()?
        w.key("title")?
        w.str(title.slice())?
        w.key("kind")?
        w.str("quickfix")?
        w.key("isPreferred")?
        w.bool(true)?
        w.key("edit")?
        w.obj()?
        w.key("changes")?
        w.obj()?
        w.key(uri)?
        w.arr()?
        w.obj()?
        w.key("range")?
        w.obj()?
        w.key("start")?
        w.obj()?
        w.key("line")?
        w.int(jint(jget(jget(r, "start"), "line"), 0))?
        w.key("character")?
        w.int(jint(jget(jget(r, "start"), "character"), 0))?
        w.end()?
        w.key("end")?
        w.obj()?
        w.key("line")?
        w.int(jint(jget(jget(r, "end"), "line"), 0))?
        w.key("character")?
        w.int(jint(jget(jget(r, "end"), "character"), 0))?
        w.end()?
        w.end()?
        w.key("newText")?
        w.str(fix)?
        w.end()?
        w.end()?
        w.end()?
        w.end()?
        w.end()?
    }
    w.end()?
    return w.text()
}
