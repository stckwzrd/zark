// Loads a program: the prelude, a root file and everything it imports.

import "gen_fmt.zk";
import "resolve.zk";
import "cbind.zk";

const auto PRELUDE = embed("../std/std.zk");
const auto RT_C = embed("../std/rt.c");

// Standard library modules, embedded like the prelude. `import "std/fs" as fs;` loads "<std>/fs.zk".
const auto STD_FS = embed("../std/fs.zk");
const auto STD_PATH = embed("../std/path.zk");
const auto STD_TIME = embed("../std/time.zk");
const auto STD_JSON = embed("../std/json.zk");
const auto STD_ARGS = embed("../std/args.zk");
const auto STD_OS = embed("../std/os.zk");
const auto STD_NET = embed("../std/net.zk");
const auto STD_HTTP = embed("../std/http.zk");
const auto STD_THREAD = embed("../std/thread.zk");
const auto STD_ASYNC = embed("../std/async.zk");
const auto STD_COLLECTIONS = embed("../std/collections.zk");
const auto STD_SMART = embed("../std/smart.zk");
const auto STD_FILE = embed("../std/file.zk");
const auto STD_BINARY = embed("../std/binary.zk");
const auto STD_ENCODING = embed("../std/encoding.zk");
const auto STD_IO = embed("../std/io.zk");
const auto STD_CSV = embed("../std/csv.zk");
const auto STD_BINARY_IO = embed("../std/binary_io.zk");

/// the embedded source of "<std>/name.zk"
!str std_source(Allocator a, str path) {
    if (path == "<std>/builtin.zk") {
        auto b = List<u8>::init(a);
        const auto os = cfg_os_name();
        const auto arch = cfg_arch_name();
        const auto abi = cfg_abi_name();
        sprint(&b, "const auto os = \"{os}\"; const auto arch = \"{arch}\"; const auto abi = \"{abi}\"; const auto endian = \"little\"; const auto pointer_bits = 64; const auto compiler_version = \"{VERSION}\";\n")?;
        for (auto name : ["is_linux", "is_macos", "is_windows", "is_x86_64", "is_aarch64", "is_freestanding", "is_test", "optimized", "safety", "overflow_checks", "fast"]) {
            const auto value = cfg_flag(name)?;
            sprint(&b, "const auto {name} = {value};\n")?;
        }
        return b.slice();
    }
    match path {
        "<std>/fs.zk" => return STD_FS;
        "<std>/path.zk" => return STD_PATH;
        "<std>/time.zk" => return STD_TIME;
        "<std>/json.zk" => return STD_JSON;
        "<std>/args.zk" => return STD_ARGS;
        "<std>/os.zk" => return STD_OS;
        "<std>/net.zk" => return STD_NET;
        "<std>/http.zk" => return STD_HTTP;
        "<std>/thread.zk" => return STD_THREAD;
        "<std>/async.zk" => return STD_ASYNC;
        "<std>/collections.zk" => return STD_COLLECTIONS;
        "<std>/smart.zk" => return STD_SMART;
        "<std>/file.zk" => return STD_FILE;
        "<std>/binary.zk" => return STD_BINARY;
        "<std>/encoding.zk" => return STD_ENCODING;
        "<std>/io.zk" => return STD_IO;
        "<std>/csv.zk" => return STD_CSV;
        "<std>/binary_io.zk" => return STD_BINARY_IO;
    }
    return error.NotFound;
}

bool is_std_path(str path) { return str_starts_with(path, "<std>/"); }

// dependencies of the current project: name -> directory, and name -> the file `import "name"` loads
Map<str> dep_dirs = Map<str>{};
Map<str> dep_libs = Map<str>{};

!void register_dep(str name, str dir, str lib) {
    if (dep_dirs.a.alloc_fn == null) {
        dep_dirs = Map<str>::init(c_allocator());
        dep_libs = Map<str>::init(c_allocator());
    }
    dep_dirs.put(name, dir)?;
    dep_libs.put(name, lib)?;
}

/// the file an `import "rel"` written in directory `dir` refers to
!str import_target(Allocator a, str dir, str rel) {
    if (str_starts_with(rel, "std/") || dir == "<std>") {
        auto name = rel;
        if (str_starts_with(name, "std/")) { name = name[4..]; }
        auto b = List<u8>::init(a);
        if (str_ends_with(name, ".zk")) { sprint(&b, "<std>/{name}")?; } else { sprint(&b, "<std>/{name}.zk")?; }
        return b.slice();
    }
    if (dep_dirs.len > 0 && rel.len > 0 && rel[0] != '.' && rel[0] != '/') {
        const auto slash = str_find_byte(rel, '/');
        auto first = rel;
        if (slash >= 0) { first = rel[0..slash]; }
        if (dep_dirs.has(first)) {
            if (slash < 0) { return canonical(a, dep_libs.get(first)?); }
            auto b = List<u8>::init(a);
            sprint(&b, "{dep_dirs.get(first)?}/{rel[slash + 1..]}")?;
            if (!str_ends_with(rel, ".zk")) { b.append(".zk")?; }
            return canonical(a, b.slice());
        }
    }
    return canonical(a, join_path(a, dir, rel)?);
}

extern u8* realpath(u8* path, u8* resolved);

struct Loader {
    Allocator a;
    Gen* g;
    Map<str> seen;
    Map<str> prefixes;
    Map<str> overrides;
    Map<str> ctypes;

    !void load_source(str src, str path, str prefix) {
        auto toks = tokenize(this->a, src, path)?;
        auto p = new_parser(this->a, toks.slice(), path);
        const auto decls = p.parse_file()?;
        for (auto c : p.cts) { this->g.cts.put(c.name, c)?; }
        for (auto d : decls) { if (d.k == .Check) { this->g.ct_checks.push(d.ct)?; } }
        if (prefix.len == 0 && c_headers.len > 0 && c_headers.has(path)) { this->claim_c_types(decls.slice(), c_headers.get(path)?)?; }
        const auto dir = dir_of(path);
        auto renames = List<str>::init(this->a);
        for (auto d : decls) {
            if (d.k == .Import) {
                auto target = "";
                if (is_c_header(d.path)) {
                    target = cbind_import(this->a, d.path, dir) catch |e| {
                        if (e != error.CompileFailed) { eprintln("error: cannot bind {d.path}: {e}"); }
                        return error.CompileFailed;
                    };
                } else {
                    target = import_target(this->a, dir, d.path)?;
                }
                const auto actual = this->load_file(target, d.alias)?;
                if (d.alias.len > 0 && actual != d.alias) {
                    renames.push(d.alias)?;
                    renames.push(actual)?;
                }
            }
        }
        if (prefix.len > 0) { resolve_module(this->a, decls.slice(), prefix)?; }
        auto k = 0;
        while (k < renames.len) {
            alias_module(this->a, decls.slice(), renames.get(k), renames.get(k + 1))?;
            k += 2;
        }
        this->g.add_decls(decls, path)?;
    }

    !void claim_c_types(Decl[] decls, str header) {
        if (this->ctypes.a.alloc_fn == null) { this->ctypes = Map<str>::init(this->a); }
        for (auto d : decls) {
            auto name = "";
            if (d.k == .Struct) { name = d.s.name; }
            if (d.k == .Alias) { name = d.path; }
            if (name.len == 0) { continue; }
            if (this->ctypes.has(name)) {
                const auto other = this->ctypes.get(name)?;
                if (cx_is_header(other) || cx_is_header(header)) {
                    eprintln("error: headers '{other}' and '{header}' both declare '{name}'; import them with 'as' or through one header that includes both");
                    return error.CompileFailed;
                }
                eprintln("error: C headers '{other}' and '{header}' both declare '{name}' (from a header they both include); importing both is not supported yet, import the one header that includes both");
                return error.CompileFailed;
            }
            this->ctypes.put(name, header)?;
        }
    }

    /// loads a file once; returns the name its declarations live under (the first import's)
    !str load_file(str path, str prefix) {
        auto key = path;
        if (!is_std_path(path) && !this->overrides.has(path)) { key = canonical(this->a, path)?; }
        if (this->seen.has(key)) {
            const auto old = this->seen.get(key)?;
            if (old != prefix && prefix.len == 0) {
                if (c_headers.len > 0 && c_headers.has(path)) {
                    const auto h = c_headers.get(path)?;
                    eprintln("error: '{h}' is imported as '{old}' elsewhere, so a plain import cannot see its names; write `import \"{h}\" as {old};`");
                    return error.CompileFailed;
                }
                eprintln("error: '{path}' is imported as '{old}' elsewhere, so a plain import cannot see its names; write `import \"...\" as {old};`");
                return error.CompileFailed;
            }
            return old;
        }
        if (prefix.len > 0 && this->prefixes.has(prefix)) {
            eprintln("error: the name '{prefix}' is already used for '{c_header_name(this->prefixes.get(prefix)?)}'; pick another name for '{c_header_name(path)}'");
            return error.CompileFailed;
        }
        this->seen.put(key, prefix)?;
        if (prefix.len > 0) { this->prefixes.put(prefix, path)?; }
        if (this->overrides.has(path)) {
            this->load_source(this->overrides.get(path)?, path, prefix)?;
            return prefix;
        }
        if (is_std_path(path)) {
            const auto ssrc = std_source(this->a, path) catch {
                eprintln("error: there is no standard module '{path[6..path.len - 5]}' (available: fs, path, time, json, args, os, net, http, thread, async, collections, smart, file, binary, binary_io, encoding, io, csv, builtin)");
                return error.CompileFailed;
            };
            if (diag_files.a.alloc_fn == null) { diag_files = Map<str>::init(c_allocator()); }
            diag_files.put(path, ssrc)?;
            this->load_source(ssrc, path, prefix)?;
            return prefix;
        }
        const auto src = read_file(this->a, path) catch |e| {
            eprintln("error: cannot read '{path}': {e}");
            return error.CompileFailed;
        };
        this->load_source(src, path, prefix)?;
        return prefix;
    }
}

!str canonical(Allocator a, str path) {
    u8[4096] pbuf;
    u8[4096] out;
    const auto r = realpath(to_cstr(pbuf[..], path)?, out.ptr);
    if (r == null) { return a.dup(path); }
    return a.dup(cstr(r));
}

!str join_path(Allocator a, str dir, str rel) {
    if (rel.len > 0 && rel[0] == '/') { return rel; }
    auto b = List<u8>::init(a);
    sprint(&b, "{dir}/{rel}")?;
    return b.slice();
}
