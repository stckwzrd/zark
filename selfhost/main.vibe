// vibe — the self-hosted compiler driver.

import "gen_fmt.vibe"
import "native.vibe"

const PRELUDE = embed("../src/std.vibe")

extern fn realpath(path: *u8, resolved: *u8) *u8

struct Loader {
    a: Allocator
    g: *Gen
    seen: Map[bool]
}

fn canonical(a: Allocator, path: str) !str {
    var pbuf: [4096]u8
    var out: [4096]u8
    let r = realpath(to_cstr(pbuf[..], path)?, out.ptr)
    if r == null { return a.dup(path) }
    return a.dup(cstr(r))
}

fn join_path(a: Allocator, dir: str, rel: str) !str {
    if rel.len > 0 && rel[0] == '/' { return rel }
    var b = List[u8].init(a)
    sprint(&b, "{dir}/{rel}")?
    return b.slice()
}

impl Loader {
    fn load_source(self, src: str, path: str) !void {
        var toks = tokenize(self.a, src, path)?
        var p = new_parser(self.a, toks.slice(), path)
        let decls = p.parse_file()?
        let dir = dir_of(path)
        for d in decls {
            if d.k == .Import { self.load_file(canonical(self.a, join_path(self.a, dir, d.path)?)?)? }
        }
        self.g.add_decls(decls, path)?
    }

    fn load_file(self, path: str) !void {
        if self.seen.has(path) { return }
        self.seen.put(path, true)?
        let src = read_file(self.a, path) catch |e| {
            eprintln("error: cannot read '{path}': {e}")
            return error.CompileFailed
        }
        self.load_source(src, path)?
    }
}

fn usage() {
    eprintln("vibe 0.4 (self-hosted) — a compact systems language (LLVM backend)

usage:
  vibe run   <file.vibe> [extra.c|.cpp|.o ...] [-O] [-- program args]
  vibe build <file.vibe> [extra.c|.cpp|.o ...] [-o out] [-O] [--release]
  vibe ir    <file.vibe>            print LLVM IR to stdout
  vibe tokens <file.vibe ...>       dump tokens
")
}

fn stem_of(path: str) str {
    var s = path
    let slash = str_rfind_byte(s, '/')
    if slash >= 0 { s = s[slash + 1..] }
    let dot = str_rfind_byte(s, '.')
    if dot > 0 { s = s[0..dot] }
    return s
}

fn base_of(path: str) str {
    let slash = str_rfind_byte(path, '/')
    if slash >= 0 { return path[slash + 1..] }
    return path
}

fn compile(a: Allocator) !i32 {
    if arg_count() < 3 {
        usage()
        return 1
    }
    let cmd = arg(1)

    if cmd == "tokens" {
        var out = List[u8].init(a)
        for k in 2..arg_count() {
            let path = arg(k)
            let src = read_file(a, path)?
            let toks = tokenize(a, src, path) catch return 1
            for t in toks {
                var tn: [32]u8
                let name = bprint(tn[..], t.tag)?
                sprint(&out, "{t.line} {name} {t.text}\n")?
            }
        }
        print(out.slice())
        return 0
    }

    let is_run = cmd == "run"
    let is_build = cmd == "build"
    let is_ir = cmd == "ir"
    if !is_run && !is_build && !is_ir {
        usage()
        return 1
    }

    var src_file = ""
    var extras = List[str].init(a)
    var prog_args = List[str].init(a)
    var out_path = ""
    var opt = false
    var safety = true
    var force_llvm = false
    var force_native = false
    var timing = false
    var i = 2
    while i < arg_count() {
        let x = arg(i)
        if x == "--" {
            for j in i + 1..arg_count() { prog_args.push(arg(j))? }
            break
        } else if x == "-O" {
            opt = true
        } else if x == "--release" {
            opt = true
            safety = false
        } else if x == "--llvm" {
            force_llvm = true
        } else if x == "--native" {
            force_native = true
        } else if x == "--time" {
            timing = true
        } else if x == "--no-safety" {
            safety = false
        } else if x == "-o" {
            i += 1
            if i < arg_count() { out_path = arg(i) }
        } else if str_ends_with(x, ".vibe") {
            src_file = x
        } else {
            extras.push(x)?
        }
        i += 1
    }
    if src_file.len == 0 {
        usage()
        return 1
    }

    let t0 = now_ns()
    let g = new_gen(a, safety)?
    var loader = Loader{ a: a, g: g, seen: Map[bool].init(a) }
    diag_prelude = PRELUDE
    loader.load_source(PRELUDE, "<std>") catch {
        g.flush_diag()
        return 1
    }
    loader.load_file(src_file) catch {
        g.flush_diag()
        return 1
    }
    g.generate() catch {
        g.flush_diag()
        return 1
    }

    var ir = List[u8].init(a)
    g.output(&ir)?
    let t1 = now_ns()
    if is_ir {
        print(ir.slice())
        return 0
    }

    let cache = ".vibe-cache"
    _ = mkdir(".vibe-cache", 493)
    let stem = stem_of(src_file)
    let use_native = force_native || (!opt && !force_llvm)
    var llb = List[u8].init(a)
    if use_native { sprint(&llb, "{cache}/{stem}.o")? } else { sprint(&llb, "{cache}/{stem}.ll")? }
    let ll_path = llb.slice()
    if use_native {
        native_compile(a, ir.slice(), ll_path) catch |e| {
            eprintln("error: native backend failed: {e}")
            return 1
        }
    } else {
        write_file(ll_path, ir.slice())?
    }
    let t2 = now_ns()

    var exe = out_path
    if exe.len == 0 {
        if is_run {
            var eb = List[u8].init(a)
            sprint(&eb, "{cache}/{stem}")?
            exe = eb.slice()
        } else {
            exe = stem
        }
    }
    var olevel = "-O0"
    if opt { olevel = "-O2" }

    var objs = List[str].init(a)
    var needs_cxx = false
    for x in extras {
        if str_ends_with(x, ".o") || str_ends_with(x, ".a") || str_ends_with(x, ".so") || str_starts_with(x, "-l") || str_starts_with(x, "-L") {
            objs.push(x)?
            continue
        }
        let is_cpp = str_ends_with(x, ".cpp") || str_ends_with(x, ".cc") || str_ends_with(x, ".cxx")
        if is_cpp { needs_cxx = true }
        var ob = List[u8].init(a)
        sprint(&ob, "{cache}/{base_of(x)}.o")?
        var cc = "clang"
        if is_cpp { cc = "clang++" }
        let code = run(a, [cc, olevel, "-c", x, "-o", ob.slice()])?
        if code != 0 { return code }
        objs.push(ob.slice())?
    }

    var link = List[str].init(a)
    if needs_cxx { link.push("clang++")? } else { link.push("clang")? }
    if use_native {
        link.append(["-no-pie", ll_path])?
    } else {
        link.append([olevel, "-Wno-override-module", ll_path])?
    }
    link.append(objs.slice())?
    link.append(["-o", exe, "-lm"])?
    let lc = run(a, link.slice())?
    if lc != 0 {
        eprintln("error: link failed (input kept at {ll_path})")
        return lc
    }
    if timing {
        let t3 = now_ns()
        var backend = "llvm"
        if use_native { backend = "native" }
        eprintln("time: frontend {(t1 - t0) as f64 / 1000000.0:.1} ms, {backend} backend {(t2 - t1) as f64 / 1000000.0:.1} ms, link {(t3 - t2) as f64 / 1000000.0:.1} ms")
    }

    if is_run {
        var argv = List[str].init(a)
        if str_find_byte(exe, '/') < 0 {
            var eb = List[u8].init(a)
            sprint(&eb, "./{exe}")?
            argv.push(eb.slice())?
        } else {
            argv.push(exe)?
        }
        argv.append(prog_args.slice())?
        return run(a, argv.slice())
    }
    return 0
}

fn main() i32 {
    var ar = Arena.init(c_allocator())
    let code = compile(ar.allocator()) catch |e| {
        eprintln("error: {e}")
        1
    }
    return code
}
