// Gives the declarations of a module imported `as name` the prefix `name.` and rewrites
// the references to them inside that module.

import "ast.vibe";

struct Resolver {
    Allocator a;
    str prefix;
    Map<bool> names;
    List<str> locals;
    str from;          // alias mode: names written "from.x" become "to.x"
    str to;

    !str qual(str name) {
        auto b = List<u8>::init(this->a);
        sprint(&b, "{this->prefix}.{name}")?;
        return b.slice();
    }

    bool is_local(str name) {
        for (auto x : this->locals) { if (x == name) { return true; } }
        return false;
    }

    !str rename(str name) {
        if (this->from.len > 0) {
            if (name.len > this->from.len && name[this->from.len] == '.' && str_starts_with(name, this->from)) {
                const auto rest = name[this->from.len + 1..];
                if (this->to.len == 0) { return rest; }
                auto b = List<u8>::init(this->a);
                sprint(&b, "{this->to}.{rest}")?;
                return b.slice();
            }
            return name;
        }
        if (this->names.has(name) && !this->is_local(name)) { return this->qual(name); }
        return name;
    }

    !void rtype(TypeExpr* t) {
        if (t == null) { return; }
        if (t.k == .Name) { t.name = this->rename(t.name)? };
        for (auto x : t.args) { this->rtype(x)?; }
        this->rtype(t.elem)?;
        this->rexpr(t.len)?;
        this->rtype(t.ret)?;
    }

    !void rexpr(Expr* e) {
        if (e == null) { return; }
        match e.k {
            .Ident => {
                e.name = this->rename(e.name)?;
                return;
            }
            .Interp => {
                for (auto p : e.parts) { if (p.kind != 0) { this->rexpr(p.e)?; } }
                return;
            }
            .Catch, .Orelse => {
                this->rexpr(e.l)?;
                const auto mark = this->locals.len;
                if (e.has_name && e.k == .Catch) { this->locals.push(e.name)? };
                this->rstmt(e.handler)?;
                this->locals.len = mark;
                return;
            }
            .Match => {
                this->rexpr(e.l)?;
                this->rarms(e.arms)?;
                return;
            }
            .Closure => {
                const auto f = e.func;
                const auto mark = this->locals.len;
                for (auto p : f.params) { this->rtype(p.ty)?; }
                this->rtype(f.ret)?;
                for (auto c : f.captures) { this->locals.push(c)?; }
                for (auto p : f.params) { this->locals.push(p.name)?; }
                this->rstmt(f.body)?;
                this->locals.len = mark;
                return;
            }
        }
        this->rexpr(e.l)?;
        this->rexpr(e.r)?;
        this->rexpr(e.x)?;
        for (auto x : e.args) { this->rexpr(x)?; }
        this->rtype(e.ty)?;
        for (auto f : e.fields) { this->rexpr(f.value)?; }
    }

    !void rarms(List<MatchArm> arms) {
        for (auto arm : arms) {
            const auto mark = this->locals.len;
            for (auto pat : arm.pats) {
                if (pat.k == .Call && pat.args.len == 1 && pat.args.get(0).k == .Ident) {
                    this->locals.push(pat.args.get(0).name)?;
                } else {
                    this->rexpr(pat)?;
                }
            }
            this->rstmt(arm.body)?;
            this->locals.len = mark;
        }
    }

    !void rstmt(Stmt* s) {
        if (s == null) { return; }
        const auto mark = this->locals.len;
        match s.k {
            .Let => {
                this->rtype(s.ty)?;
                this->rexpr(s.e)?;
                this->locals.push(s.name)?;
                return;
            }
            .Assign => {
                this->rexpr(s.e2)?;
                this->rexpr(s.e)?;
            }
            .ExprS, .Ret => this->rexpr(s.e)?;
            .If => {
                this->rexpr(s.e)?;
                this->rstmt(s.body)?;
                this->rstmt(s.els)?;
            }
            .While => {
                this->rexpr(s.e)?;
                this->rstmt(s.body)?;
            }
            .ForRange, .ForEach => {
                this->rexpr(s.e)?;
                this->rexpr(s.e2)?;
                this->locals.push(s.name)?;
                if (s.has_idx) { this->locals.push(s.idx)?; }
                this->rstmt(s.body)?;
            }
            .Block => {
                for (auto x : s.stmts) { this->rstmt(x)?; }
            }
            .Defer => this->rstmt(s.body)?;
            .Match => {
                this->rexpr(s.e)?;
                this->rarms(s.arms)?;
            }
        }
        this->locals.len = mark;
    }

    !void rfn(FnDecl* f) {
        const auto mark = this->locals.len;
        for (auto x : f.type_params) { this->locals.push(x)?; }
        for (auto x : f.receiver_params) { this->locals.push(x)?; }
        if (f.receiver.len > 0) { f.receiver = this->rename(f.receiver)?; }
        for (auto p : f.params) { this->rtype(p.ty)?; }
        this->rtype(f.ret)?;
        for (auto p : f.params) { this->locals.push(p.name)?; }
        this->rstmt(f.body)?;
        this->locals.len = mark;
        if (f.receiver.len == 0 && f.is_extern && this->from.len == 0) {
            // an extern of a module gets a prefixed name in Vibe, so it cannot collide with the
            // program's own functions, and keeps its C symbol for linking
            if (f.link_name.len == 0) { f.link_name = f.name; }
            f.name = this->rename(f.name)?;
        }
        if (f.receiver.len == 0 && !f.is_extern && !f.is_export && !f.is_test) { f.name = this->rename(f.name)?; }
    }
}

/// in `decls`, references written through the import name `from` (from::x) are rewritten to
/// the name `to` the module was first imported under ("" = the global namespace)
!void alias_module(Allocator a, List<Decl> decls, str from, str to) {
    auto r = Resolver{ .a = a, .prefix = "", .names = Map<bool>::init(a), .locals = List<str>::init(a), .from = from, .to = to };
    r.walk(decls)?;
}

!void resolve_module(Allocator a, List<Decl> decls, str prefix) {
    auto r = Resolver{ .a = a, .prefix = prefix, .names = Map<bool>::init(a), .locals = List<str>::init(a) };
    for (auto d : decls) {
        match d.k {
            .Func => {
                const auto f = d.f;
                if (f.receiver.len == 0 && !f.is_export && !f.is_test) { r.names.put(f.name, true)?; }
            }
            .Struct => r.names.put(d.s.name, true)?;
            .Enum => r.names.put(d.en.name, true)?;
            .Const => r.names.put(d.c.name, true)?;
            .Alias => r.names.put(d.path, true)?;
        }
    }
    r.walk(decls)?;
}

!void Resolver::walk(List<Decl> decls) {
    const auto r = this;
    for (auto i : 0..decls.len) {
        const auto d = &decls.items[i];
        match d.k {
            .Func => r.rfn(d.f)?;
            .Struct => {
                const auto mark = r.locals.len;
                for (auto x : d.s.type_params) { r.locals.push(x)?; }
                for (auto fld : d.s.fields) { r.rtype(fld.ty)?; }
                r.locals.len = mark;
                d.s.name = r.rename(d.s.name)?;
            }
            .Enum => d.en.name = r.rename(d.en.name)?;
            .Const => {
                r.rtype(d.c.ty)?;
                r.rexpr(d.c.value)?;
                d.c.name = r.rename(d.c.name)?;
            }
            .Alias => {
                r.rtype(d.ty)?;
                d.path = r.rename(d.path)?;
            }
            .Check => r.rexpr(d.ct)?;
        }
    }
}
