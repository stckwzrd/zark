align(16) struct a16 { i8 c; }
align(16) struct m16 { i8 c; i32 x; }
align(16) struct pair16 { i64 a; i64 b; }
align(16) struct dbl16 { f64 x; f64 y; }
align(16) struct mix16 { f64 d; i64 n; }
align(16) struct off16 { u64[4] storage; }
align(16) struct un16 { u64[2] storage; u8* as_c() { void* p = this; return p; } i64* as_l() { void* p = this; return p; } f64* as_d() { void* p = this; return p; } }
struct has16 { i32 k; pair16 p; }
align(16) struct hu { u64[2] storage; a16* as_a() { void* p = this; return p; } i32* as_i() { void* p = this; return p; } }
align(32) struct a32 { i32 x; }
align(16) struct big16 { i64 a; i64 b; i64 c; }
extern pair16 mk_pair(i64 a, i64 b);
extern i64 sum_pair(pair16 p);
extern f64 sum_dbl(dbl16 d);
extern dbl16 mk_dbl(f64 x, f64 y);
extern i64 sum_mix(mix16 m);
extern i64 sum_big(big16* b);
extern i32 a32_x(a32* p);
extern i64 sum_has_p(has16* h);
extern i32 read_un16(un16* u);
