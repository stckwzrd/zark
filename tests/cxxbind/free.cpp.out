[[noreturn]] static inline void zark_cxx_fail(const char *f) {
    fflush(stdout);
    try {
        throw;
    } catch (const std::exception &e) {
        fprintf(stderr, "zark: uncaught C++ exception in %s: %s\n", f, e.what());
    } catch (...) {
        fprintf(stderr, "zark: uncaught C++ exception in %s\n", f);
    }
    abort();
}
