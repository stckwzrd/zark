import "refalias.hpp" as f;

!void main() {
    f::M m = f::M{ .x = 1 };
    m.addtwice(&m);
    println(m.x);
    f::S s = f::S{};
    s.v.x = 1;
    const auto r1 = f::bump(&s.v, &s);
    println(r1, s.v.x);
    f::V v = f::V{ .x = 1 };
    f::H h = f::H{ .p = &v };
    const auto r2 = f::via_h(&v, &h);
    println(r2, v.x);
    v.x = 1;
    f::V* pv = &v;
    const auto r3 = f::via_hh(&v, &pv);
    println(r3, v.x);
    v.x = 1;
    const auto r4 = f::via_void(&v, &v);
    println(r4, v.x);
    f::V[2] arr = [f::V{ .x = 1 }, f::V{ .x = 2 }];
    const auto r5 = f::via_arr(&arr[0], &arr);
    println(r5, arr[0].x);
    v.x = 1;
    const auto r6 = f::via_td(&v, &v);
    println(r6, v.x);
    v.x = 1;
    const auto r7 = f::via_ref(&v, &v);
    println(r7, v.x);
    v.x = 1;
    f::HV hv = f::HV{ .p = &v };
    const auto r8 = f::via_hv(&v, &hv);
    println(r8, v.x);
    v.x = 1;
    f::Own o = f::Own{ .n = 0, .v = f::V{ .x = 1 }, .w = null };
    o.w = &o.v;
    o.poke(&o.v);
    println(o.n, o.v.x);
    f::V a = f::V{ .x = 3 };
    f::V b = f::V{ .x = 4 };
    i32 c = 0;
    const auto t = f::two(&a, &b, &c);
    println(t, c, f::ro(a, b), f::ro(f::V{ .x = 5 }, f::V{ .x = 6 }));
    println(f::len(f::V{ .x = 7 }, "s", 2), f::sq(9), m.peek(f::V{ .x = 2 }), m.with(a, b), f::M::smul(a, 5));
    v.x = 1;
    _ = v.op_add_assign(&v);
    println(v.x, (a + b).x);
}
