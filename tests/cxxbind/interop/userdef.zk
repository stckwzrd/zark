import "userdef.hpp" as f;

!void main() {
    const auto d = f::D::make();
    const auto e = f::E2::make();
    const auto ea = f::EA::make();
    const auto fv = f::F::make();
    const auto g = f::G::make();
    println(d.y, d.z, e.b.y, e.w, ea.bs[0].y, ea.bs[1].y, ea.w);
    println(fv.y, fv.z, fv.q, g.b.y, g.w, g.g);
    println(f::cpp_d(), f::cpp_e(), f::cpp_f(), f::cpp_g(), f::cpp_own());
