import "std/time" as time;

test "calendar conversions" {
    u8[64] b;
    const auto d = time::utc(1763631785);
    assert(bprint(b[..], "{d}")? == "2025-11-20T09:43:05Z");
    assert(d.weekday() is .Thursday && d.day_of_year() == 324 && d.to_unix() == 1763631785);
    const auto p = time::parse("2024-02-29T23:59:59+01:00")?;
    assert(p.to_unix() == 1709247599);
    assert(bprint(b[..], "{p.add_days(1)}")? == "2024-03-01T23:59:59+01:00");
    assert(bprint(b[..], "{time::utc(-1)}")? == "1969-12-31T23:59:59Z");
    assert(bprint(b[..], "{time::parse("2026-01-05")?:d}")? == "2026-01-05");
    assert(time::parse("2026-01-05 10:00:00.250Z")?.nsec == 250000000);
    auto bad = false;
    _ = time::parse("2023-02-29") catch |e| { bad = e == error.InvalidDate; time::DateTime{} };
    assert(bad);
}

test "round trips over a wide range" {
    for (auto t : 0..3000) {
        const auto x = t * 86399 * 37 - 2000000000;
        const auto dt = time::from_unix(x, -5 * 3600);
        assert(dt.to_unix() == x);
        u8[64] b;
        assert(time::parse(bprint(b[..], "{dt}")?)?.to_unix() == x);
    }
}

test "clock and sleeping" {
    auto sw = time::Stopwatch::start();
    time::sleep_ms(15);
    assert(sw.ms() >= 15 && sw.ms() < 2000);
    assert(time::now_utc().year >= 2025);
    assert(time::unix_ms() / 1000 - time::unix() <= 1);
}
