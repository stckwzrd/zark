import "std/thread" as thread;
import "std/time" as time;
import "std/async" as async;

extern i64 vrt_poller_new();
extern i32 vrt_poller_set(i64 p, i32 fd, i32 readable, i32 writable, u64 token);
extern i32 vrt_poller_wait(i64 p, u64* tokens, i32* events, i32 max, i64 timeout_ms);
extern i32 vrt_poller_wake(i64 p);
extern void vrt_poller_free(i64 p);
extern i32 pipe(i32* fds);
extern i64 write(i32 fd, void* buf, u64 n);

void bump(void* data) {
    auto n = data as *i64;
    *n += 1;
}

test "poll values" {
    const auto r = Poll<i64>::Ready(3);
    match (r) {
        .Ready(v) => assert(v == 3);
        .Pending => assert(false);
    }
    const Poll<i64> p = .Pending;
    match (p) {
        .Ready(_) => assert(false);
        .Pending => assert(true);
    }
}

test "waker calls its function" {
    i64 count = 0;
    auto w = Waker{ .data = &count as *void, .wake_fn = bump };
    w.wake();
    assert(count == 1);
}

test "poller reports a readable pipe" {
    const auto p = vrt_poller_new();
    assert(p > 0);
    i32[2] fds;
    assert(pipe(&fds[0]) == 0);
    assert(vrt_poller_set(p, fds[0], 1, 0, 7) == 0);
    u64[4] tokens;
    i32[4] events;
    assert(vrt_poller_wait(p, &tokens[0], &events[0], 4, 0) == 0);
    u8 b = 1;
    assert(write(fds[1], &b as *void, 1) == 1);
    assert(vrt_poller_wait(p, &tokens[0], &events[0], 4, 0) == 1);
    assert(tokens[0] == 7);
    assert((events[0] & 1) != 0);
    assert(vrt_poller_set(p, fds[0], 0, 0, 7) == 0);
    assert(vrt_poller_wait(p, &tokens[0], &events[0], 4, 0) == 0);
    assert(vrt_poller_set(p, 999, 1, 0, 1) < 0);
    assert(vrt_poller_wait(p, &tokens[0], &events[0], 0, 0) == 0);
    vrt_poller_free(p);
}

test "wake interrupts wait" {
    const auto p = vrt_poller_new();
    assert(p > 0);
    auto t = thread::spawn([p]() -> void {
        time::sleep_ms(20);
        vrt_poller_wake(p);
    })?;
    u64[4] tokens;
    i32[4] events;
    const auto start = time::mono_ns();
    assert(vrt_poller_wait(p, &tokens[0], &events[0], 4, 5000) == 0);
    assert(time::mono_ns() - start < 1000000000);
    t.join();
    vrt_poller_free(p);
}

struct Countdown {
    i64 n;

    Poll<i64> poll(Context* cx) {
        if (this->n == 0) { return .Ready(42); }
        this->n -= 1;
        cx.waker.wake();
        return .Pending;
    }
}

struct SleepPush {
    async::Sleep s;
    i64 v;
    List<i64>* out;

    Poll<bool> poll(Context* cx) {
        match (this->s.poll(cx)) {
            .Ready(_) => {
                this->out.push(this->v) catch {};
                return .Ready(true);
            }
            .Pending => return .Pending;
        }
        return .Pending;
    }
}

struct AllDone<T> {
    List<async::JoinHandle<T>>* hs;

    Poll<bool> poll(Context* cx) {
        for (auto h : this->hs.slice()) {
            if (!h.done()) {
                cx.waker.wake();
                return .Pending;
            }
        }
        return .Ready(true);
    }
}

test "block_on drives a hand-written future" {
    auto ex = async::Executor::init(c_allocator())?;
    defer ex.deinit();
    auto f = Countdown{ .n = 5 };
    const auto v = ex.block_on<Countdown, i64>(&f)?;
    assert(v == 42);
}

test "sleep orders tasks by deadline" {
    auto ex = async::Executor::init(c_allocator())?;
    defer ex.deinit();
    auto out = List<i64>::init(c_allocator());
    auto hs = List<async::JoinHandle<bool>>::init(c_allocator());
    for (auto ms : [30, 10, 20]) {
        const auto t = SleepPush{ .s = async::Sleep::after(&ex, ms), .v = ms, .out = &out };
        hs.push(ex.spawn<SleepPush, bool>(t)?)?;
    }
    auto all = AllDone<bool>{ .hs = &hs };
    assert(ex.block_on<AllDone<bool>, bool>(&all)?);
    assert(out.len == 3);
    assert(out.get(0) == 10);
    assert(out.get(1) == 20);
    assert(out.get(2) == 30);
    hs.deinit();
    out.deinit();
}

test "ten thousand tasks" {
    auto dbg = DebugAllocator::init();
    const auto a = dbg.allocator();
    {
        auto ex = async::Executor::init(a)?;
        defer ex.deinit();
        auto hs = List<async::JoinHandle<i64>>::init(a);
        defer hs.deinit();
        for (auto i : 0..10000) {
            hs.push(ex.spawn<Countdown, i64>(Countdown{ .n = 3 })?)?;
        }
        auto all = AllDone<i64>{ .hs = &hs };
        assert(ex.block_on<AllDone<i64>, bool>(&all)?);
        for (auto h : hs.slice()) { assert(h.take() == 42); }
    }
    dbg.deinit()?;
}
