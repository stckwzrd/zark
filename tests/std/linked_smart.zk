import "std/collections" as collections;
import "std/smart" as smart;

struct Item { i64* cleanups; i64 number; }
void cleanup_item(Item* value) { *value.cleanups += 1; }
void cleanup_list(List<i64>* value) { value.deinit(); }

test "linked list owns resource elements" {
    auto dbg = DebugAllocator::init();
    {
        auto xs = collections::LinkedList<List<i64>>::init(dbg.allocator(), cleanup_list);
        defer xs.deinit();
        auto first = List<i64>::init(dbg.allocator());
        first.push(4)?;
        xs.push_back(first)?;
        auto second = List<i64>::init(dbg.allocator());
        second.push(7)?;
        xs.push_front(second)?;
        auto removed = xs.pop_front()?;
        assert(removed.get(0) == 7);
        removed.deinit();
        assert(xs.front().get(0) == 4);
    }
    dbg.deinit()?;
}

test "linked list supports both ends and iteration" {
    auto dbg = DebugAllocator::init();
    {
        auto xs = collections::LinkedList<i64>::init(dbg.allocator(), null);
        defer xs.deinit();
        assert(xs.is_empty() && xs.front() == null && xs.back() == null);
        _ = xs.pop_front() catch |e| { assert(e == error.Empty); 0 };
        xs.push_back(2)?;
        xs.push_front(1)?;
        xs.push_back(3)?;
        assert(xs.len == 3 && *xs.front() == 1 && *xs.back() == 3);
        auto it = xs.iter();
        auto sum = 0;
        while (it.next()) { sum += *it.value(); }
        assert(sum == 6);
        assert(xs.pop_front()? == 1);
        assert(xs.pop_back()? == 3);
        assert(xs.pop_back()? == 2);
        assert(xs.is_empty());
        xs.push_front(4)?;
        xs.clear();
        assert(xs.is_empty() && xs.front() == null && xs.back() == null);
    }
    dbg.deinit()?;
}

test "linked list cleans up remaining values and failed insertions" {
    auto dbg = DebugAllocator::init();
    auto cleaned = 0;
    {
        auto xs = collections::LinkedList<Item>::init(dbg.allocator(), cleanup_item);
        defer xs.deinit();
        xs.push_back(Item{ .cleanups = &cleaned, .number = 1 })?;
        xs.push_front(Item{ .cleanups = &cleaned, .number = 2 })?;
        const auto removed = xs.pop_back()?;
        assert(removed.number == 1 && cleaned == 0);
        dbg.fail_after_n(0);
        xs.push_back(Item{ .cleanups = &cleaned }) catch |e| { assert(e == error.OutOfMemory); };
        assert(cleaned == 1 && xs.len == 1);
    }
    assert(cleaned == 2);
    dbg.deinit()?;
}

test "box owns or transfers its value" {
    auto dbg = DebugAllocator::init();
    auto cleaned = 0;
    {
        auto box = smart::Box<Item>::init(dbg.allocator(), Item{ .cleanups = &cleaned, .number = 7 }, cleanup_item)?;
        assert(box.get().number == 7);
        const auto item = box.take();
        assert(item.number == 7 && cleaned == 0);
        auto other = smart::Box<Item>::init(dbg.allocator(), Item{ .cleanups = &cleaned }, cleanup_item)?;
        other.deinit();
        assert(cleaned == 1);
        dbg.fail_after_n(0);
        auto unexpected = smart::Box<Item>::init(dbg.allocator(), Item{ .cleanups = &cleaned }, cleanup_item) catch |e| {
            assert(e == error.OutOfMemory && cleaned == 2);
            dbg.deinit()?;
            return;
        };
        unexpected.deinit();
        panic("allocation should fail");
    }
}

test "box can transfer a resource value" {
    auto dbg = DebugAllocator::init();
    {
        auto values = List<i64>::init(dbg.allocator());
        values.push(11)?;
        auto box = smart::Box<List<i64>>::init(dbg.allocator(), values, cleanup_list)?;
        auto transferred = box.take();
        assert(transferred.get(0) == 11);
        transferred.deinit();
    }
    dbg.deinit()?;
}

test "rc cleans up once after the last owner" {
    auto dbg = DebugAllocator::init();
    auto cleaned = 0;
    {
        auto first = smart::Rc<Item>::init(dbg.allocator(), Item{ .cleanups = &cleaned, .number = 8 }, cleanup_item)?;
        auto second = first.clone();
        first.deinit();
        assert(cleaned == 0 && second.get().number == 8);
        second.deinit();
        assert(cleaned == 1);
    }
    dbg.deinit()?;
}

test "rc cleans up if allocation fails" {
    auto dbg = DebugAllocator::init();
    auto cleaned = 0;
    dbg.fail_after_n(0);
    auto unexpected = smart::Rc<Item>::init(dbg.allocator(), Item{ .cleanups = &cleaned }, cleanup_item) catch |e| {
        assert(e == error.OutOfMemory && cleaned == 1);
        dbg.deinit()?;
        return;
    };
    unexpected.deinit();
    panic("allocation should fail");
}
