import "std/os" as os;
import "std/args" as args;

test "exec captures output and exit code" {
    auto dbg = DebugAllocator::init();
    const auto a = dbg.allocator();
    {
        auto r = os::exec(a, ["sh", "-c", "echo out; echo err >&2; exit 3"])?;
        defer r.deinit();
        assert(r.code == 3 && r.out == "out\n" && r.err == "err\n" && !r.ok());
        const auto input = str_repeat(a, "x", 300000)?;
        defer a.free(input);
        auto big = os::exec_with(a, os::Command{ .argv = ["wc", "-c"], .input = input })?;
        defer big.deinit();
        assert(str_trim(big.out) == "300000");
        auto w = os::exec_with(a, os::Command{ .argv = ["pwd"], .cwd = "/" })?;
        defer w.deinit();
        assert(w.out == "/\n");
        auto missing = false;
        _ = os::exec(a, ["definitely-not-a-program-xyz"]) catch |e| { missing = e == error.ProgramNotFound; os::Output{} };
        assert(missing);
    }
    dbg.deinit()?;
}

test "environment" {
    os::set_env("ZARK_X", "42")?;
    assert(env("ZARK_X")? == "42");
    assert(os::env_or("ZARK_NOPE", "d") == "d");
    os::unset_env("ZARK_X")?;
    assert(os::env_or("ZARK_X", "gone") == "gone");
    assert(os::cpu_count() > 0 && os::pid() > 0);
}

test "argument parser" {
    auto p = args::Parser::init(c_allocator(), "tool", "Does things.");
    defer p.deinit();
    p.flag("verbose", 'v', "print more")?;
    p.flag("all", 'a', "everything")?;
    p.option("out", 'o', "output directory", ".")?;
    p.option("jobs", 'j', "parallel jobs", "1")?;
    p.parse_from(["-va", "x.txt", "--out=/tmp/o", "-j4", "--", "-not-an-option"])?;
    assert(p.has("verbose") && p.has("all") && p.get("out") == "/tmp/o" && p.get_int("jobs")? == 4);
    assert(p.rest().len == 2 && p.rest()[1] == "-not-an-option");
    auto q = args::Parser::init(c_allocator(), "tool", "");
    defer q.deinit();
    q.option("out", 'o', "output", "x")?;
    assert(q.get("out") == "x" && !q.has("out"));
    auto unknown = false;
    q.parse_from(["--bogus"]) catch |e| { unknown = e == error.UnknownOption; };
    assert(unknown);
}

test "exec frees argument copies when allocation fails" {
    for (auto fail : 0..5) {
        auto dbg = DebugAllocator::init();
        dbg.fail_after_n(fail);
        auto result = os::exec(dbg.allocator(), ["sh", "-c", "true"]) catch |e| {
            assert(e == error.OutOfMemory);
            dbg.deinit()?;
            continue;
        };
        result.deinit();
        dbg.deinit()?;
    }
}

test "run frees argument copies when allocation fails" {
    for (auto fail : 0..4) {
        auto dbg = DebugAllocator::init();
        dbg.fail_after_n(fail);
        _ = run(dbg.allocator(), ["sh", "-c", "true"]) catch |e| {
            assert(e == error.OutOfMemory);
            dbg.deinit()?;
            continue;
        };
        panic("expected allocation failure");
    }
}

extern i32 fcntl(i32 fd, i32 cmd, ...);

i64 count_open_fds() {
    auto count = 0;
    for (auto i : 0..1024) { if (fcntl(i as i32, 1) >= 0) { count += 1; } }
    return count;
}

test "exec cleans up descriptors on output allocation failure" {
    const auto before = count_open_fds();
    auto dbg = DebugAllocator::init();
    dbg.fail_after_n(4);
    auto failed = false;
    auto result = os::exec(dbg.allocator(), ["sh", "-c", "printf x"]) catch |e| {
        failed = e == error.OutOfMemory;
        os::Output{}
    };
    if (!failed) { result.deinit(); }
    assert(failed);
    assert(count_open_fds() == before);
    dbg.deinit()?;
}

test "exec cleans up failed output transfers and reaps the child" {
    for (auto fail : 4..8) {
        const auto before = count_open_fds();
        auto dbg = DebugAllocator::init();
        dbg.fail_after_n(fail);
        auto failed = false;
        auto result = os::exec(dbg.allocator(), ["sh", "-c", "printf x; printf y >&2"]) catch |e| {
            failed = e == error.OutOfMemory;
            os::Output{}
        };
        if (!failed) { result.deinit(); }
        assert(failed);
        assert(count_open_fds() == before);
        i32 child_status = 0;
        assert(waitpid(-1, &child_status, 1) < 0);
        dbg.deinit()?;
    }
}

test "exec tolerates child closing stdin early" {
    const auto a = c_allocator();
    const auto input = str_repeat(a, "x", 300000)?;
    defer a.free(input);
    auto r = os::exec_with(a, os::Command{ .argv = ["sh", "-c", "exit 0"], .input = input })?;
    defer r.deinit();
    assert(r.code == 0);
}

test "exec drains output while sending large input" {
    const auto a = c_allocator();
    const auto input = str_repeat(a, "x", 300000)?;
    defer a.free(input);
    auto r = os::exec_with(a, os::Command{ .argv = ["sh", "-c", "head -c 300000 /dev/zero; cat >/dev/null"], .input = input })?;
    defer r.deinit();
    assert(r.code == 0 && r.out.len == 300000);
}

test "owned child waits and can be explicitly signalled" {
    auto first = os::Child::spawn(c_allocator(), ["sh", "-c", "exit 7"])?;
    defer first.deinit();
    assert(first.wait()? == 7);
    auto twice = false;
    _ = first.wait() catch |e| { twice = e == error.AlreadyWaited; 0 };
    assert(twice);
    auto second = os::Child::spawn(c_allocator(), ["sh", "-c", "exec sleep 30"])?;
    defer second.deinit();
    second.signal(15)?;
    assert(second.wait()? == 143);
}

test "owned child is reaped when released" {
    {
        auto child = os::Child::spawn(c_allocator(), ["sh", "-c", "exec sleep 30"])?;
        child.deinit();
    }
    i32 status = 0;
    assert(waitpid(-1, &status, 1) < 0);
}
