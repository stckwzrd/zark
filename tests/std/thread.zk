import "std/thread" as thread;

void cleanup_locked(thread::Locked<i64>* value) { value.deinit(); }
struct Tracked { thread::AtomicI64* destroyed; }
void cleanup_tracked(Tracked* value) { value.destroyed.add(1); }
void cleanup_list(List<i64>* value) { value.deinit(); }

test "arc owns a resource value" {
    auto dbg = DebugAllocator::init();
    {
        auto values = List<i64>::init(dbg.allocator());
        values.push(42)?;
        auto shared = thread::Arc<List<i64>>::init(dbg.allocator(), values, cleanup_list)?;
        assert(shared.get().get(0) == 42);
        shared.deinit();
    }
    dbg.deinit()?;
}

test "arc releases once after the last clone" {
    auto dbg = DebugAllocator::init();
    auto destroyed = thread::AtomicI64{};
    {
        auto first = thread::Arc<Tracked>::init(dbg.allocator(), Tracked{ .destroyed = &destroyed }, cleanup_tracked)?;
        auto second = first.clone();
        first.deinit();
        assert(destroyed.load() == 0);
        second.deinit();
        assert(destroyed.load() == 1);
    }
    dbg.deinit()?;
}

test "arc cleans up when allocation fails" {
    auto dbg = DebugAllocator::init();
    auto destroyed = thread::AtomicI64{};
    dbg.fail_after_n(0);
    auto unexpected = thread::Arc<Tracked>::init(dbg.allocator(), Tracked{ .destroyed = &destroyed }, cleanup_tracked) catch |e| {
        assert(e == error.OutOfMemory);
        assert(destroyed.load() == 1);
        dbg.deinit()?;
        return;
    };
    unexpected.deinit();
    panic("allocation should fail");
}

test "shared values and atomics" {
    auto flag = thread::AtomicBool{};
    assert(!flag.load());
    assert(flag.compare_swap(false, true));
    assert(flag.load() && !flag.compare_swap(false, true));
    flag.store(false);
    assert(!flag.load());
    auto count = thread::AtomicU64{};
    assert(count.add(7) == 0 && count.load() == 7);
    assert(count.compare_swap(7, 9) && count.load() == 9);

    auto shared = thread::Arc<thread::Locked<i64>>::init(c_allocator(), thread::Locked<i64>{}, cleanup_locked)?;
    defer shared.deinit();
    auto copy = shared.clone();
    defer copy.deinit();
    auto t = thread::spawn([&copy]() -> void {
        const auto s = copy.get();
        for (auto i : 0..10000) {
            const auto v = s.lock();
            *v += 1;
            s.unlock();
        }
    })?;
    for (auto i : 0..10000) {
        const auto s = shared.get();
        const auto v = s.lock();
        *v += 1;
        s.unlock();
    }
    t.join();
    const auto s = shared.get();
    const auto v = s.lock();
    assert(*v == 20000);
    s.unlock();
}

test "threads, atomics and a mutex" {
    auto counter = thread::AtomicI64{};
    auto plain = 0;
    auto mu = thread::Mutex{};
    thread::Thread[8] ts;
    for (auto i : 0..8) {
        ts[i] = thread::spawn([&counter, &plain, &mu]() -> void {
            for (auto k : 0..20000) {
                counter.add(1);
                mu.lock();
                plain += 1;
                mu.unlock();
            }
        })?;
    }
    for (auto i : 0..8) { ts[i].join(); }
    assert(counter.load() == 160000 && plain == 160000);
    assert(counter.compare_swap(160000, 1) && counter.load() == 1 && !counter.compare_swap(5, 6));
}

test "channel with several consumers" {
    auto dbg = DebugAllocator::init();
    {
        const auto ch = thread::Channel<i64>::create(dbg.allocator(), 4)?;
        defer ch.destroy();
        auto sum = thread::AtomicI64{};
        auto wg = thread::WaitGroup{};
        wg.add(3);
        thread::Thread[3] cs;
        for (auto i : 0..3) {
            cs[i] = thread::spawn([&ch, &wg, &sum]() -> void {
                while (true) {
                    const auto v = ch.recv() catch { break; };
                    sum.add(v);
                }
                wg.done();
            })?;
        }
        for (auto i : 1..1001) { ch.send(i)?; }
        ch.close();
        wg.wait();
        for (auto i : 0..3) { cs[i].join(); }
        assert(sum.load() == 500500);
        auto closed = false;
        ch.send(1) catch |e| { closed = e == error.Closed; };
        assert(closed);
        assert(ch.try_recv() is .None);
    }
    dbg.deinit()?;
}

test "parallel_for and timed waits" {
    i64[1000] squares;
    thread::parallel_for(1000, 0, [&squares](i64 i) -> void { squares[i] = i * i; })?;
    for (auto i : 0..1000) { assert(squares[i] == i * i); }
    auto m = thread::Mutex{};
    auto c = thread::Cond{};
    m.lock();
    assert(!c.wait_ms(&m, 20));
    m.unlock();
}
