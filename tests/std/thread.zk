import "std/thread" as thread;

void cleanup_locked(thread::Locked<i64>* value) { value.deinit(); }
struct Tracked { thread::AtomicI64* destroyed; }
void cleanup_tracked(Tracked* value) { value.destroyed.add(1); }

test "weak arc expires and retains the control block" {
    auto dbg = DebugAllocator::init();
    auto destroyed = thread::AtomicI64{};
    {
        auto owner = thread::Arc<Tracked>::init(dbg.allocator(), Tracked{ .destroyed = &destroyed }, cleanup_tracked)?;
        errdefer owner.deinit();
        auto weak = owner.downgrade();
        errdefer weak.deinit();
        auto other = weak.clone();
        errdefer other.deinit();
        auto upgraded = weak.upgrade() orelse return error.Unexpected;
        owner.deinit();
        assert(destroyed.load() == 0);
        upgraded.deinit();
        assert(destroyed.load() == 1 && dbg.live == 1);
        assert(weak.upgrade() is .None);
        weak.deinit();
        assert(dbg.live == 1 && other.upgrade() is .None);
        auto expired_clone = other.clone();
        other.deinit();
        assert(dbg.live == 1 && expired_clone.upgrade() is .None);
        expired_clone.deinit();
        assert(dbg.live == 0);
    }
    dbg.deinit()?;
}

test "weak arc upgrade races the last strong release" {
    auto destroyed = thread::AtomicI64{};
    auto started = thread::AtomicBool{};
    auto owner = thread::Arc<Tracked>::init(c_allocator(), Tracked{ .destroyed = &destroyed }, cleanup_tracked)?;
    errdefer owner.deinit();
    auto weak = owner.downgrade();
    errdefer weak.deinit();
    auto worker = thread::spawn([&weak, &started]() -> void {
        started.store(true);
        for (auto i : 0..20000) {
            auto result = weak.upgrade();
            match (result) {
                .Some(value) => { assert(value.get().destroyed != null); value.deinit(); },
                .None => {},
            }
        }
    })?;
    while (!started.load()) { thread::yield(); }
    owner.deinit();
    worker.join();
    assert(destroyed.load() == 1 && weak.upgrade() is .None);
    weak.deinit();
}
void cleanup_list(List<i64>* value) { value.deinit(); }

test "arc owns a resource value" {
    auto dbg = DebugAllocator::init();
    {
        auto values = List<i64>::init(dbg.allocator());
        values.push(42)?;
        auto shared = thread::Arc<List<i64>>::init(dbg.allocator(), values, cleanup_list)?;
        assert(shared.get().get(0) == 42);
        shared.deinit();
    }
    dbg.deinit()?;
}

test "arc releases once after the last clone" {
    auto dbg = DebugAllocator::init();
    auto destroyed = thread::AtomicI64{};
    {
        auto first = thread::Arc<Tracked>::init(dbg.allocator(), Tracked{ .destroyed = &destroyed }, cleanup_tracked)?;
        auto second = first.clone();
        first.deinit();
        assert(destroyed.load() == 0);
        second.deinit();
        assert(destroyed.load() == 1);
    }
    dbg.deinit()?;
}

test "arc cleans up when allocation fails" {
    auto dbg = DebugAllocator::init();
    auto destroyed = thread::AtomicI64{};
    dbg.fail_after_n(0);
    auto unexpected = thread::Arc<Tracked>::init(dbg.allocator(), Tracked{ .destroyed = &destroyed }, cleanup_tracked) catch |e| {
        assert(e == error.OutOfMemory);
        assert(destroyed.load() == 1);
        dbg.deinit()?;
        return;
    };
    unexpected.deinit();
    panic("allocation should fail");
}

test "shared values and atomics" {
    auto flag = thread::AtomicBool{};
    assert(!flag.load());
    assert(flag.compare_swap(false, true));
    assert(flag.load() && !flag.compare_swap(false, true));
    flag.store(false);
    assert(!flag.load());
    auto count = thread::AtomicU64{};
    assert(count.add(7) == 0 && count.load() == 7);
    assert(count.compare_swap(7, 9) && count.load() == 9);

    auto shared = thread::Arc<thread::Locked<i64>>::init(c_allocator(), thread::Locked<i64>{}, cleanup_locked)?;
    defer shared.deinit();
    auto copy = shared.clone();
    defer copy.deinit();
    auto t = thread::spawn([&copy]() -> void {
        const auto s = copy.get();
        for (auto i : 0..10000) {
            const auto v = s.lock();
            *v += 1;
            s.unlock();
        }
    })?;
    for (auto i : 0..10000) {
        const auto s = shared.get();
        const auto v = s.lock();
        *v += 1;
        s.unlock();
    }
    t.join();
    const auto s = shared.get();
    const auto v = s.lock();
    assert(*v == 20000);
    s.unlock();
}

test "threads, atomics and a mutex" {
    auto counter = thread::AtomicI64{};
    auto plain = 0;
    auto mu = thread::Mutex{};
    thread::Thread[8] ts;
    for (auto i : 0..8) {
        ts[i] = thread::spawn([&counter, &plain, &mu]() -> void {
            for (auto k : 0..20000) {
                counter.add(1);
                mu.lock();
                plain += 1;
                mu.unlock();
            }
        })?;
    }
    for (auto i : 0..8) { ts[i].join(); }
    assert(counter.load() == 160000 && plain == 160000);
    assert(counter.compare_swap(160000, 1) && counter.load() == 1 && !counter.compare_swap(5, 6));
}

test "channel with several consumers" {
    auto dbg = DebugAllocator::init();
    {
        const auto ch = thread::Channel<i64>::create(dbg.allocator(), 4)?;
        defer ch.destroy();
        auto sum = thread::AtomicI64{};
        auto wg = thread::WaitGroup{};
        wg.add(3);
        thread::Thread[3] cs;
        for (auto i : 0..3) {
            cs[i] = thread::spawn([&ch, &wg, &sum]() -> void {
                while (true) {
                    const auto v = ch.recv() catch { break; };
                    sum.add(v);
                }
                wg.done();
            })?;
        }
        for (auto i : 1..1001) { ch.send(i)?; }
        ch.close();
        wg.wait();
        for (auto i : 0..3) { cs[i].join(); }
        assert(sum.load() == 500500);
        auto closed = false;
        ch.send(1) catch |e| { closed = e == error.Closed; };
        assert(closed);
        assert(ch.try_recv() is .None);
    }
    dbg.deinit()?;
}

test "parallel_for and timed waits" {
    i64[1000] squares;
    thread::parallel_for(1000, 0, [&squares](i64 i) -> void { squares[i] = i * i; })?;
    for (auto i : 0..1000) { assert(squares[i] == i * i); }
    auto m = thread::Mutex{};
    auto c = thread::Cond{};
    m.lock();
    assert(!c.wait_ms(&m, 20));
    m.unlock();
}

test "channel try_send preserves caller value on full and closed" {
    auto dbg = DebugAllocator::init();
    {
        const auto ch = thread::Channel<List<i64>>::create(dbg.allocator(), 1)?;
        defer ch.destroy();
        auto first = List<i64>::init(dbg.allocator());
        first.push(7)?;
        ch.try_send(&first)?;
        auto second = List<i64>::init(dbg.allocator());
        second.push(9)?;
        auto full = false;
        ch.try_send(&second) catch |e| { full = e == error.Full; };
        assert(full && second.get(0) == 9);
        auto got = ch.recv()?;
        assert(got.get(0) == 7);
        got.deinit();
        ch.close();
        auto closed = false;
        ch.try_send(&second) catch |e| { closed = e == error.Closed; };
        assert(closed && second.get(0) == 9);
        second.deinit();
    }
    dbg.deinit()?;
}

test "semaphore controls parallel access" {
    auto sem = thread::Semaphore{};
    defer sem.deinit();
    assert(!sem.try_wait());
    sem.post()?;
    sem.post()?;
    assert(sem.try_wait() && sem.try_wait() && !sem.try_wait());
    sem.post()?;
    sem.post()?;
    auto active = thread::AtomicI64{};
    auto done = thread::AtomicI64{};
    thread::Thread[6] threads;
    for (auto i : 0..6) {
        threads[i] = thread::spawn([&sem, &active, &done]() -> void {
            for (auto n : 0..500) {
                sem.wait();
                const auto before = active.add(1);
                assert(before >= 0 && before < 2);
                thread::yield();
                active.add(-1);
                done.add(1);
                sem.post() catch panic("semaphore overflow");
            }
        })?;
    }
    for (auto i : 0..6) { threads[i].join(); }
    assert(done.load() == 3000 && active.load() == 0);
    assert(sem.try_wait() && sem.try_wait() && !sem.try_wait());
}

test "reader writer lock allows shared reads and exclusive writes" {
    auto rw = thread::RwLock<i64>{ .value = 5 };
    defer rw.deinit();
    const auto first = rw.read_lock();
    const auto second = rw.read_lock();
    assert(*first == 5 && *second == 5);
    rw.read_unlock();
    rw.read_unlock();
    const auto write = rw.write_lock();
    *write = 10;
    rw.write_unlock();
    auto started = thread::AtomicBool{};
    auto entered = thread::AtomicBool{};
    const auto held = rw.read_lock();
    auto t = thread::spawn([&rw, &started, &entered]() -> void {
        started.store(true);
        const auto p = rw.write_lock();
        entered.store(true);
        *p += 1;
        rw.write_unlock();
    })?;
    while (!started.load()) { thread::yield(); }
    assert(!entered.load() && *held == 10);
    rw.read_unlock();
    t.join();
    assert(entered.load());
    const auto result = rw.read_lock();
    assert(*result == 11);
    rw.read_unlock();
}

test "semaphore reports permit overflow" {
    auto sem = thread::Semaphore{ .permits = 9223372036854775807 };
    defer sem.deinit();
    auto overflow = false;
    sem.post() catch |e| { overflow = e == error.Overflow; };
    assert(overflow && sem.try_wait());
}

test "reader writer lock protects concurrent increments" {
    auto rw = thread::RwLock<i64>{};
    defer rw.deinit();
    thread::Thread[4] workers;
    for (auto i : 0..4) {
        workers[i] = thread::spawn([&rw]() -> void {
            for (auto n : 0..1000) {
                const auto v = rw.write_lock();
                *v += 1;
                rw.write_unlock();
            }
        })?;
    }
    for (auto i : 0..4) { workers[i].join(); }
    const auto v = rw.read_lock();
    assert(*v == 4000);
    rw.read_unlock();
}
