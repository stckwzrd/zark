// Module rules: an extern in a module does not collide with the program's own functions.
import "std/fs" as fs;
import "std/os" as os;

i64 rename(i64 x) { return x + 1; }
i64 close(i64 x) { return x * 2; }
i64 getpid() { return 7; }

test "program functions next to module externs" {
    assert(rename(1) == 2 && close(4) == 8 && getpid() == 7);
    assert(os::pid() != 7);
    const auto a = c_allocator();
    const auto dir = fs::temp_dir(a, "vibe-mod")?;
    defer fs::remove_all(a, dir) catch |e| {};
    u8[256] b;
    const auto f = bprint(b[..], "{dir}/a")?;
    write_file(f, "x")?;
    u8[256] b2;
    const auto g = bprint(b2[..], "{dir}/b")?;
    fs::move(f, g)?;
    assert(fs::exists(g) && !fs::exists(f));
}
