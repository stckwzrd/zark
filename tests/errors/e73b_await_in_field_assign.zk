import "std/async" as async;

struct P { i64 f; }

async i64 g() { return 3; }

async i64 h() {
    P p = P{ .f = 1 };
    p.f = await g();
    return p.f;
}

!void main() {
    auto ex = async::Executor::init(c_allocator())?;
    defer ex.deinit();
    auto t = h();
    i64 r = ex.block_on(&t)?;
    println(r);
}
