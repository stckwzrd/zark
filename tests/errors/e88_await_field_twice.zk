import "std/async" as async;

struct F { i64 n; Poll<i64> poll(Context* cx) { return .Ready(this->n); } }
struct Holder { F y; }

async i64 use() {
    auto h = Holder{ .y = F{ .n = 3 } };
    const auto a = await h.y;
    const auto b = await h.y;
    return a + b;
}

!void main() {
    auto ex = async::Executor::init(c_allocator())?;
    defer ex.deinit();
    auto f = use();
    println(ex.block_on(&f)?);
}
