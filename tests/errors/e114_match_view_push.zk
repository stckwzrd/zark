union U { List<i64> xs; i64 n; }
!void main() {
    auto arr = List<U>::init(c_allocator());
    const U u = .xs(List<i64>::init(c_allocator()));
    arr.push(u)?;
    for (auto x : arr) {
        match (x) {
            .xs(l) => { l.push(1)?; },
            .n => {},
        }
    }
    arr.items[0].xs.deinit();
    arr.deinit();
}
