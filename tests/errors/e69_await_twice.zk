import "std/async" as async;

async i64 work() { return 3; }

async i64 body() {
    auto f = work();
    auto a = await f;
    auto b = await f;
    return a + b;
}

!void main() {
    auto ex = async::Executor::init(c_allocator())?;
    defer ex.deinit();
    auto t = body();
    i64 r = ex.block_on(&t)?;
    println(r);
}
