import "std/async" as async;

struct Yield1 {
    bool done;

    Poll<bool> poll(Context* cx) {
        if (this->done) { return .Ready(true); }
        this->done = true;
        cx.waker.wake();
        return .Pending;
    }
}

async i64 body(List<i64>* list) {
    auto p = list.at(0);
    await Yield1{};
    println(*p);
    return 0;
}

!void main() {
    auto ex = async::Executor::init(c_allocator())?;
    defer ex.deinit();
    auto l = List<i64>::init(c_allocator());
    defer l.deinit();
    l.push(7)?;
    auto t = body(&l);
    i64 r = ex.block_on(&t)?;
    println(r);
}
