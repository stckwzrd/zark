struct Holder { List<i64> l; }

void take(List<i64> l) {
    l.deinit();
}

!void main() {
    auto l = List<i64>::init(c_allocator());
    auto l2 = l;
    l2.push(1)?;
    l2.push(2)?;
    println(l2.len);
    l2.deinit();

    auto src = List<i64>::init(c_allocator());
    src.push(7)?;
    auto copy = src.clone()?;
    src.deinit();
    println(copy.get(0));
    copy.deinit();

    auto h = Holder{ .l = List<i64>::init(c_allocator()) };
    h.l.push(3)?;
    println(h.l.get(0));
    h.l.deinit();

    auto whole = Holder{ .l = List<i64>::init(c_allocator()) };
    whole.l.push(4)?;
    auto moved = whole;
    moved.l.push(5)?;
    println(moved.l.get(1));
    moved.l.deinit();

    auto field = Holder{ .l = List<i64>::init(c_allocator()) };
    field.l.push(6)?;
    auto fcopy = field.l;
    fcopy.push(7)?;
    println(fcopy.len);
    fcopy.deinit();

    take(List<i64>::init(c_allocator()));
    println("ok");
}
