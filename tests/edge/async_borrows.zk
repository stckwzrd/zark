import "std/async" as async;

struct Yield1 {
    bool done;

    Poll<bool> poll(Context* cx) {
        if (this->done) { return .Ready(true); }
        this->done = true;
        cx.waker.wake();
        return .Pending;
    }
}

async i64 work(i64 n) {
    await Yield1{};
    return n * 2;
}

async i64 local_ptr() {
    i64 x = 5;
    auto p = &x;
    await Yield1{};
    *p += 1;
    return x;
}

async i64 arg_slice(str s) {
    auto t = s[1..3];
    await Yield1{};
    println(t);
    return t.len;
}

async i64 list_before(List<i64>* list) {
    auto p = list.at(0);
    *p = 9;
    auto n = 0;
    for (auto x : list) { n += x; }
    await Yield1{};
    list.push(4) catch return -1;
    return list.get(0) + list.len + n;
}

async !i64 spawned(async::Executor* ex) {
    auto f = work(10);
    async::JoinHandle<i64> h = ex.spawn(f)?;
    auto g = work(4);
    auto a = await g;
    auto b = await h;
    return a + b;
}

struct Buf {
    i64[3] a;

    i64[] slice() { return this->a[0..3]; }
}

async i64 own_slice() {
    auto b = Buf{ .a = [1, 2, 3] };
    auto n = 0;
    for (auto x : b) {
        await Yield1{};
        n += x;
    }
    return n;
}

!void main() {
    auto ex = async::Executor::init(c_allocator())?;
    defer ex.deinit();
    auto t1 = local_ptr();
    i64 r1 = ex.block_on(&t1)?;
    println(r1);
    auto t2 = arg_slice("hello");
    i64 r2 = ex.block_on(&t2)?;
    println(r2);
    auto l = List<i64>::init(c_allocator());
    defer l.deinit();
    l.push(1)?;
    auto t3 = list_before(&l);
    i64 r3 = ex.block_on(&t3)?;
    println(r3);
    auto t4 = spawned(&ex);
    i64 r4 = ex.block_on(&t4)?;
    println(r4);
    auto t5 = own_slice();
    i64 r5 = ex.block_on(&t5)?;
    println(r5);
}
