i64 mul(i64 a, i64 b) { return a * b; }
u64 umul(u64 a, u64 b) { return a * b; }

void main() {
    const i64 min = -9223372036854775807 - 1;
    println(mul(2147483647, 2147483647));
    println(mul(-2147483648, -2147483648));
    println(mul(2147483648, 2147483648));
    println(mul(3037000499, 3037000499));
    println(mul(min, 1), mul(1, min), mul(0, min), mul(min, 0));
    println(mul(-1, 9223372036854775807), mul(9223372036854775807, -1));
    println(mul(-3037000499, 3037000499), mul(4611686018427387904, -2));
    println(umul(4294967295, 4294967295));
    println(umul(4294967296, 4294967295));
    println(umul(0, 18446744073709551615), umul(1, 18446744073709551615));
    println(umul(9223372036854775808, 1), umul(6148914691236517205, 3));
}
