// Path strings (Unix, '/' separated). Nothing here touches the file system except absolute().
//   import "std/path" as path;
//   path::ext("a/b.tar.gz") == ".gz";  path::join(a, ["src", "main.vibe"])?

/// the last component: "a/b/c.txt" -> "c.txt", "a/b/" -> "b"
str base(str p) {
    auto s = p;
    while (s.len > 1 && s[s.len - 1] == '/') { s = s[0..s.len - 1]; }
    const auto i = str_rfind_byte(s, '/');
    if (i < 0 || s.len == 1) { return s; }
    return s[i + 1..];
}

/// everything before the last component: "a/b/c.txt" -> "a/b", "c.txt" -> ".", "/c" -> "/"
str dir(str p) {
    auto s = p;
    while (s.len > 1 && s[s.len - 1] == '/') { s = s[0..s.len - 1]; }
    const auto i = str_rfind_byte(s, '/');
    if (i < 0) { return "."; }
    if (i == 0) { return "/"; }
    return s[0..i];
}

/// the extension with its dot: "a/b.tar.gz" -> ".gz", ".bashrc" -> "", "Makefile" -> ""
str ext(str p) {
    const auto b = base(p);
    const auto i = str_rfind_byte(b, '.');
    if (i <= 0) { return ""; }
    return b[i..];
}

/// the file name without its extension: "a/b.tar.gz" -> "b.tar"
str stem(str p) {
    const auto b = base(p);
    const auto e = ext(p);
    return b[0..b.len - e.len];
}

bool is_abs(str p) { return p.len > 0 && p[0] == '/'; }

/// joins components with '/'; an absolute component restarts the path; the result is normalized
!str join(Allocator a, str[] parts) {
    auto b = List<u8>::init(a);
    defer b.deinit();
    for (auto p : parts) {
        if (p.len == 0) { continue; }
        if (is_abs(p)) { b.clear(); }
        if (b.len > 0 && b.items[b.len - 1] != '/') { b.push('/')?; }
        b.append(p)?;
    }
    return normalize(a, b.slice());
}

/// removes "." components, duplicate slashes and resolves ".." lexically
!str normalize(Allocator a, str p) {
    if (p.len == 0) { return a.dup("."); }
    auto parts = List<str>::init(a);
    defer parts.deinit();
    const auto abs = is_abs(p);
    auto it = str_split(p, "/");
    while (it.next()) {
        const auto c = it.part;
        if (c.len == 0 || c == ".") { continue; }
        if (c == "..") {
            if (parts.len > 0 && parts.get(parts.len - 1) != "..") { parts.len -= 1; continue; }
            if (abs) { continue; }
        }
        parts.push(c)?;
    }
    const auto body = str_join(a, parts.slice(), "/")?;
    if (abs) {
        defer a.free(body);
        return str_concat(a, ["/", body])?;
    }
    if (body.len == 0) {
        a.free(body);
        return a.dup(".");
    }
    return body;
}

/// `p` relative to directory `from` (both are normalized first): relative(a, "/a/b/c", "/a/d") == "../b/c"
!str relative(Allocator a, str p, str from) {
    const auto np = normalize(a, p)?;
    defer a.free(np);
    const auto nf = normalize(a, from)?;
    defer a.free(nf);
    auto xs = str_split_all(a, np, "/")?;
    defer xs.deinit();
    auto ys = str_split_all(a, nf, "/")?;
    defer ys.deinit();
    auto i = 0;
    while (i < xs.len && i < ys.len && xs.get(i) == ys.get(i)) { i += 1; }
    auto out = List<str>::init(a);
    defer out.deinit();
    for (auto k : i..ys.len) { if (ys.get(k) != "." && ys.get(k).len > 0) { out.push("..")?; } }
    for (auto k : i..xs.len) { if (xs.get(k) != "." && xs.get(k).len > 0) { out.push(xs.get(k))?; } }
    if (out.len == 0) { return a.dup("."); }
    return str_join(a, out.slice(), "/");
}

extern u8* realpath(u8* path, u8* resolved);

/// the absolute path with symbolic links resolved; the file must exist
!str absolute(Allocator a, str p) {
    u8[4096] pb;
    u8[4096] out;
    if (realpath(to_cstr(pb[..], p)?, &out[0]) == null) { errno_error()?; }
    return a.dup(cstr(&out[0]));
}
