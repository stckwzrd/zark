extern i64 vrt_poller_new();
extern i32 vrt_poller_set(i64 p, i32 fd, i32 readable, i32 writable, u64 token);
extern i32 vrt_poller_wait(i64 p, u64* tokens, i32* events, i32 max, i64 timeout_ms);
extern void vrt_poller_free(i64 p);
extern i32 vrt_set_nonblocking(i32 fd);
extern i32 accept(i32 fd, u8* addr, u32* len);
extern i64 recv(i32 fd, void* buf, u64 n, i32 flags);
extern i64 vrt_send(i32 fd, void* buf, u64 n, i32 flags);
extern i32 close(i32 fd);
extern i32 vrt_errno();

import "std/net" as net;

struct Task {
    void* frame;
    fn[](void*, Context*) -> bool poll_thunk;
    fn[](void*) cancel_thunk;
    bool canceled;
    i32 state;
    Executor* ex;
    u64 size;
    i64 index;
    i32 timers;
    i32 io;
    i32 waits;
    bool released;
    Waker joiner;
    Task* waiter;
}

struct TaskBox<F, T> {
    Task head;
    F fut;
    T result;
}

struct Timer {
    i64 deadline;
    Waker waker;
    Task* task;
}

struct Reg {
    bool r;
    bool w;
    bool rready;
    bool wready;
    Waker rw;
    Waker ww;
    Task* rt;
    Task* wt;
    u64 rgen;
    u64 wgen;
}

void task_wake(void* data) {
    auto t = data as *Task;
    if (t.state == 0 || t.state == 2) {
        t.state = 1;
        auto q = &t.ex.queue;
        q.items[q.len] = t;
        q.len += 1;
    }
}

void main_wake(void* data) {
    auto ex = data as *Executor;
    ex.main_woken = true;
}

struct JoinHandle<T> {
    Executor* ex;
    Task* task;
    T* slot;
    i64 gi;
    u64 gen;

    Task* live() {
        if (this->ex.gens.get(this->gi) != this->gen) { panic("JoinHandle used after take() or detach()"); }
        return this->task;
    }

    bool done() { return this->live().state == 3; }
    T take() {
        assert(this->done());
        const auto v = *this->slot;
        this->detach();
        return v;
    }

    void detach() {
        auto t = this->live();
        this->ex.gens.set(this->gi, this->gen + 1);
        this->ex.spare.push(this->gi) catch {};
        t.released = true;
        this->ex.release(t);
    }

    /// cancel the task now: it runs its deferred code inside this call, then
    /// the executor frees the frame on its next turn (immediately if the task
    /// had already finished)
    void cancel() {
        auto t = this->live();
        this->ex.gens.set(this->gi, this->gen + 1);
        this->ex.spare.push(this->gi) catch {};
        t.released = true;
        t.canceled = true;
        if (t.state != 3) { t.cancel_thunk(t.frame); }
        task_wake(t);
        this->ex.release(t);
    }

    Poll<T> poll(Context* cx) {
        if (this->done()) { return .Ready(this->take()); }
        auto t = this->task;
        t.joiner = cx.waker;
        const auto cur = t.ex.current;
        if (t.waiter != cur) {
            const auto old = t.waiter;
            t.waiter = cur;
            if (cur != null) { cur.waits += 1; }
            if (old != null) {
                old.waits -= 1;
                t.ex.release(old);
            }
        }
        return .Pending;
    }
}

struct Pair<A, B> { A first; B second; }

struct Join2<A, B> {
    JoinHandle<A> a;
    JoinHandle<B> b;
    bool adone;
    bool bdone;
    bool canceled;
    A av;
    B bv;

    /// a finished side was already taken; only the pending one is cancelled
    void cancel() {
        if (this->canceled) { return; }
        this->canceled = true;
        if (!this->adone) { this->a.cancel(); }
        if (!this->bdone) { this->b.cancel(); }
    }

    Poll<Pair<A, B>> poll(Context* cx) {
        if (this->canceled) { return .Pending; }
        if (!this->adone) {
            match (this->a.poll(cx)) {
                .Ready(v) => { this->av = v; this->adone = true; }
                .Pending => {}
            }
        }
        if (!this->bdone) {
            match (this->b.poll(cx)) {
                .Ready(v) => { this->bv = v; this->bdone = true; }
                .Pending => {}
            }
        }
        if (this->adone && this->bdone) {
            return .Ready(Pair<A, B>{ .first = this->av, .second = this->bv });
        }
        return .Pending;
    }
}

/// wait for both handles and return their values
template<A, B> Join2<A, B> join(JoinHandle<A> a, JoinHandle<B> b) {
    return Join2<A, B>{ .a = a, .b = b };
}

union Select2Result<A, B> { A First; B Second; }

struct Select2<A, B> {
    JoinHandle<A> a;
    JoinHandle<B> b;
    bool done;
    bool canceled;

    void cancel() {
        if (this->done || this->canceled) { return; }
        this->canceled = true;
        this->a.cancel();
        this->b.cancel();
    }

    Poll<Select2Result<A, B>> poll(Context* cx) {
        if (this->done || this->canceled) { return .Pending; }
        match (this->a.poll(cx)) {
            .Ready(v) => {
                this->done = true;
                this->b.cancel();
                return .Ready(Select2Result<A, B>::First(v));
            }
            .Pending => {}
        }
        match (this->b.poll(cx)) {
            .Ready(v) => {
                this->done = true;
                this->a.cancel();
                return .Ready(Select2Result<A, B>::Second(v));
            }
            .Pending => {}
        }
        return .Pending;
    }
}

/// the value of whichever handle finishes first; the other task is cancelled
template<A, B> Select2<A, B> select(JoinHandle<A> a, JoinHandle<B> b) {
    return Select2<A, B>{ .a = a, .b = b };
}

// ---------------------------------------------------------------- channels

/// A FIFO queue of values between tasks. It is unbounded: `send` never waits,
/// it only allocates. `recv` is a future that resolves to `error.Closed` when
/// the channel was closed and its queue is empty. Single-threaded: the tasks
/// must run on one executor.
owned struct Channel<T> {
    T[] buf;        // ring buffer; capacity = buf.len
    i64 head;
    i64 len;
    List<Waker> waiters;
    Allocator a;
    bool closed;

    static !Self init(Allocator a) {
        return Self{ .buf = (null as *T)[0..0], .waiters = List<Waker>::init(a), .a = a };
    }

    void deinit() move {
        this->a.free(this->buf);
        this->waiters.deinit();
    }

    !void send(T v) {
        if (this->closed) { return error.Closed; }
        if (this->len == this->buf.len) {
            auto cap = this->buf.len * 2;
            if (cap < 8) { cap = 8; }
            const auto nb = this->a.alloc<T>(cap)?;
            for (auto i : 0..this->len) { nb[i] = this->buf[(this->head + i) % this->buf.len]; }
            this->a.free(this->buf);
            this->buf = nb;
            this->head = 0;
        }
        this->buf[(this->head + this->len) % this->buf.len] = v;
        this->len += 1;
        for (auto w : this->waiters.slice()) { w.wake(); }
        this->waiters.clear();
    }

    Recv<T> recv() { return Recv<T>{ .ch = this }; }

    void close() {
        this->closed = true;
        for (auto w : this->waiters.slice()) { w.wake(); }
        this->waiters.clear();
    }
}

/// one pending receive; `cancel()` unregisters it from the channel
struct Recv<T> {
    Channel<T>* ch;
    Waker waker;
    bool waiting;

    Poll<!T> poll(Context* cx) {
        if (this->ch.len > 0) {
            const auto v = this->ch.buf[this->ch.head];
            this->ch.head = (this->ch.head + 1) % this->ch.buf.len;
            this->ch.len -= 1;
            return .Ready(v);
        }
        if (this->ch.closed) { return .Ready(error.Closed); }
        if (!this->waiting) {
            this->waker = cx.waker;
            this->waiting = true;
            this->ch.waiters.push(this->waker) catch {};
        }
        return .Pending;
    }

    void cancel() {
        if (!this->waiting) { return; }
        auto i = 0;
        while (i < this->ch.waiters.len) {
            if (this->ch.waiters.items[i].data == this->waker.data) { _ = this->ch.waiters.swap_remove(i); } else { i += 1; }
        }
        this->waiting = false;
    }
}

union SelectRecvResult<A, B> { A First; B Second; }

/// wait for the first of two receives; the other one is unregistered
struct SelectRecv<A, B> {
    Recv<A> a;
    Recv<B> b;
    bool done;

    void cancel() {
        if (this->done) { return; }
        this->done = true;
        this->a.cancel();
        this->b.cancel();
    }

    Poll<SelectRecvResult<!A, !B>> poll(Context* cx) {
        if (this->done) { return .Pending; }
        match (this->a.poll(cx)) {
            .Ready(v) => {
                this->done = true;
                this->b.cancel();
                return .Ready(SelectRecvResult<!A, !B>::First(v));
            }
            .Pending => {}
        }
        match (this->b.poll(cx)) {
            .Ready(v) => {
                this->done = true;
                this->a.cancel();
                return .Ready(SelectRecvResult<!A, !B>::Second(v));
            }
            .Pending => {}
        }
        return .Pending;
    }
}

template<A, B> SelectRecv<A, B> select_recv(Recv<A> a, Recv<B> b) {
    return SelectRecv<A, B>{ .a = a, .b = b };
}


owned struct Executor {
    Allocator a;
    i64 poller;
    List<Task*> tasks;
    List<Task*> queue;
    List<Task*> batch;
    List<Timer> timers;
    List<Reg> regs;
    List<u64> gens;
    List<i64> spare;
    Task* current;
    i64 io;
    bool main_woken;
    bool closing;

    static !Executor init(Allocator a) {
        const auto p = vrt_poller_new();
        if (p <= 0) { return error.SystemCall; }
        return Executor{ .a = a, .poller = p, .tasks = List<Task*>::init(a), .queue = List<Task*>::init(a),
            .batch = List<Task*>::init(a), .timers = List<Timer>::init(a),
            .regs = List<Reg>::init(a), .gens = List<u64>::init(a), .spare = List<i64>::init(a) };
    }

    void deinit() move {
        this->closing = true;
        for (auto t : this->tasks.slice()) {
            if (t.state != 3 && !t.canceled) {
                t.canceled = true;
                t.cancel_thunk(t.frame);
            }
            this->drop_io(t);
        }
        this->timers.clear();
        for (auto t : this->tasks.slice()) { this->a.free<u8>((t as *u8)[0..t.size as i64]); }
        this->tasks.deinit();
        this->queue.deinit();
        this->batch.deinit();
        this->timers.deinit();
        this->regs.deinit();
        this->gens.deinit();
        this->spare.deinit();
        vrt_poller_free(this->poller);
    }

    template<F, T> !JoinHandle<T> spawn(move F fut) {
        if (this->closing) { return error.SystemCall; }
        const auto n = this->tasks.len + 1;
        this->tasks.reserve(n)?;
        this->queue.reserve(n)?;
        this->batch.reserve(n)?;
        this->gens.reserve(this->gens.len + 1)?;
        this->spare.reserve(this->gens.len + 1)?;
        auto b = this->a.create<TaskBox<F, T>>()?;
        auto gi = this->gens.len;
        if (this->spare.len > 0) { gi = this->spare.pop()?; } else { this->gens.push(0)?; }
        b.fut = fut;
        b.head = Task{ .frame = b as *void, .state = 1, .ex = this, .size = sizeof(TaskBox<F, T>), .index = this->tasks.len,
            .poll_thunk = [](void* p, Context* cx) -> bool {
                auto b = p as *TaskBox<F, T>;
                match (b.fut.poll(cx)) {
                    .Ready(v) => {
                        b.result = v;
                        return true;
                    }
                    .Pending => return false;
                }
                return false;
            },
            .cancel_thunk = [](void* p) {
                auto b = p as *TaskBox<F, T>;
                b.fut.cancel();
            } };
        this->tasks.push(&b.head)?;
        this->queue.push(&b.head)?;
        return JoinHandle<T>{ .ex = this, .task = &b.head, .slot = &b.result, .gi = gi, .gen = this->gens.get(gi) };
    }

    template<F, T> !T block_on(F* fut) {
        auto cx = Context{ .waker = Waker{ .data = this as *void, .wake_fn = main_wake } };
        u64[64] tokens;
        i32[64] events;
        this->main_woken = true;
        while (true) {
            this->fire_timers();
            if (this->main_woken) {
                this->main_woken = false;
                match (fut.poll(&cx)) {
                    .Ready(v) => {
                        this->drop_io(null);
                        return v;
                    }
                    .Pending => {}
                }
            }
            this->run_batch();
            if (this->main_woken || this->queue.len > 0) { continue; }
            const auto timeout = this->timeout_ms();
            if (timeout < 0 && this->io == 0) {
                this->drop_io(null);
                fut.cancel();
                return error.Deadlock;
            }
            const auto n = vrt_poller_wait(this->poller, &tokens[0], &events[0], 64, timeout);
            if (n < 0) {
                this->drop_io(null);
                fut.cancel();
                return error.SystemCall;
            }
            for (auto i : 0..n as i64) {
                const auto e = events[i];
                this->ready(tokens[i] as i32, (e & 5) != 0, (e & 6) != 0);
            }
        }
        return error.Deadlock;
    }

    void run_batch() {
        const auto tmp = this->batch;
        this->batch = this->queue;
        this->queue = tmp;
        auto i = 0;
        while (i < this->batch.len) {
            auto t = this->batch.get(i);
            t.state = 2;
            auto cx = Context{ .waker = Waker{ .data = t as *void, .wake_fn = task_wake } };
            this->current = t;
            auto done = true;
            if (!t.canceled) { done = t.poll_thunk(t.frame, &cx); }
            this->current = null;
            if (done) {
                if (t.state == 1) { this->unqueue(t); }
                t.state = 3;
                if (t.io > 0) { this->drop_io(t); }
                t.joiner.wake();
                const auto w = t.waiter;
                if (w != null) {
                    t.waiter = null;
                    w.waits -= 1;
                    this->release(w);
                }
                this->release(t);
            } else if (t.state == 2) {
                t.state = 0;
            }
            i += 1;
        }
        this->batch.clear();
    }

    void unqueue(Task* t) {
        for (auto i : 0..this->queue.len) {
            if (this->queue.get(i) == t) {
                _ = this->queue.swap_remove(i) catch t;
                return;
            }
        }
    }

    void release(Task* t) {
        if (this->closing) { return; }
        if (t.state != 3 || !t.released || t.timers > 0 || t.waits > 0) { return; }
        _ = this->tasks.swap_remove(t.index) catch t;
        if (t.index < this->tasks.len) { this->tasks.get(t.index).index = t.index; }
        this->a.free<u8>((t as *u8)[0..t.size as i64]);
    }

    !u64 arm(i32 fd, bool write, Waker w) {
        while (this->regs.len <= fd as i64) { this->regs.push(Reg{})?; }
        auto g = &this->regs.items[fd as i64];
        auto t = this->current;
        if (write) {
            g.ww = w;
            g.wgen += 1;
            if (g.w && g.wt == t && !g.wready) { return g.wgen; }
            if (g.w && g.wt != null) { g.wt.io -= 1; }
            if (!g.w) { this->io += 1; }
            g.w = true;
            g.wready = false;
            g.wt = t;
        } else {
            g.rw = w;
            g.rgen += 1;
            if (g.r && g.rt == t && !g.rready) { return g.rgen; }
            if (g.r && g.rt != null) { g.rt.io -= 1; }
            if (!g.r) { this->io += 1; }
            g.r = true;
            g.rready = false;
            g.rt = t;
        }
        if (t != null) { t.io += 1; }
        if (vrt_poller_set(this->poller, fd, g.r as i32, g.w as i32, fd as u64) != 0) {
            this->disarm(fd, write);
            return error.SystemCall;
        }
        if (write) { return g.wgen; }
        return g.rgen;
    }

    void disarm(i32 fd, bool write) {
        auto g = &this->regs.items[fd as i64];
        if (write) {
            if (!g.w) { return; }
            g.w = false;
            if (g.wt != null) { g.wt.io -= 1; }
        } else {
            if (!g.r) { return; }
            g.r = false;
            if (g.rt != null) { g.rt.io -= 1; }
        }
        this->io -= 1;
        _ = vrt_poller_set(this->poller, fd, g.r as i32, g.w as i32, fd as u64);
    }

    bool take_ready(i32 fd, bool write) {
        auto g = &this->regs.items[fd as i64];
        if (write && !g.wready || !write && !g.rready) { return false; }
        this->disarm(fd, write);
        return true;
    }

    void ready(i32 fd, bool r, bool w) {
        if (fd as i64 >= this->regs.len) { return; }
        auto g = &this->regs.items[fd as i64];
        if (r && g.r) {
            g.rready = true;
            g.rw.wake();
        }
        if (w && g.w) {
            g.wready = true;
            g.ww.wake();
        }
        _ = vrt_poller_set(this->poller, fd, (g.r && !g.rready) as i32, (g.w && !g.wready) as i32, fd as u64);
    }

    void drop_io(Task* t) {
        for (auto fd : 0..this->regs.len) {
            const auto g = this->regs.get(fd);
            if (g.r && g.rt == t) { this->disarm(fd as i32, false); }
            if (g.w && g.wt == t) { this->disarm(fd as i32, true); }
        }
    }

    void forget(i32 fd) {
        if (fd as i64 >= this->regs.len) { return; }
        this->disarm(fd, false);
        this->disarm(fd, true);
    }

    !void add_timer(i64 deadline, Waker w) {
        this->timers.push(Timer{ .deadline = deadline, .waker = w, .task = this->current })?;
        if (this->current != null) { this->current.timers += 1; }
        auto h = this->timers.slice();
        auto i = h.len - 1;
        while (i > 0 && h[(i - 1) / 2].deadline > h[i].deadline) {
            swap(&h[i], &h[(i - 1) / 2]);
            i = (i - 1) / 2;
        }
    }

    void fire_timers() {
        const auto now = now_ns();
        while (this->timers.len > 0 && this->timers.get(0).deadline <= now) {
            const auto w = this->timers.get(0).waker;
            const auto t = this->timers.get(0).task;
            this->timers.set(0, this->timers.get(this->timers.len - 1));
            this->timers.len -= 1;
            auto h = this->timers.slice();
            auto i = 0;
            while (true) {
                auto m = i;
                const auto l = 2 * i + 1;
                if (l < h.len && h[l].deadline < h[m].deadline) { m = l; }
                if (l + 1 < h.len && h[l + 1].deadline < h[m].deadline) { m = l + 1; }
                if (m == i) { break; }
                swap(&h[i], &h[m]);
                i = m;
            }
            w.wake();
            if (t != null) {
                t.timers -= 1;
                this->release(t);
            }
        }
    }

    i64 timeout_ms() {
        if (this->timers.len == 0) { return -1; }
        const auto left = this->timers.get(0).deadline - now_ns();
        if (left <= 0) { return 0; }
        return (left + 999999) / 1000000;
    }
}

struct Sleep {
    Executor* ex;
    i64 deadline;
    bool armed;

    static Sleep after(Executor* ex, i64 ms) { return Sleep{ .ex = ex, .deadline = now_ns() + ms * 1000000 }; }

    void cancel() {}

    Poll<bool> poll(Context* cx) {
        if (now_ns() >= this->deadline) { return .Ready(true); }
        if (!this->armed) {
            this->ex.add_timer(this->deadline, cx.waker) catch {
                cx.waker.wake();
                return .Pending;
            };
            this->armed = true;
        }
        return .Pending;
    }
}

struct Io {
    Executor* ex;
    i32 fd;
    bool write;
    bool armed;
    u64 gen;

    Poll<bool> poll(Context* cx) {
        if (this->armed && this->ex.take_ready(this->fd, this->write)) {
            this->armed = false;
            return .Ready(true);
        }
        this->gen = this->ex.arm(this->fd, this->write, cx.waker) catch {
            this->armed = false;
            return .Ready(false);
        };
        this->armed = true;
        return .Pending;
    }

    void cancel() {
        if (!this->armed) { return; }
        this->armed = false;
        const auto g = this->ex.regs.get(this->fd as i64);
        if (this->write && g.wgen != this->gen || !this->write && g.rgen != this->gen) { return; }
        this->ex.disarm(this->fd, this->write);
    }
}

struct Readable {
    Io io;

    static Readable on(Executor* ex, i32 fd) { return Readable{ .io = Io{ .ex = ex, .fd = fd } }; }
    Poll<bool> poll(Context* cx) { return this->io.poll(cx); }
    void cancel() { this->io.cancel(); }
}

struct Writable {
    Io io;

    static Writable on(Executor* ex, i32 fd) { return Writable{ .io = Io{ .ex = ex, .fd = fd, .write = true } }; }
    Poll<bool> poll(Context* cx) { return this->io.poll(cx); }
    void cancel() { this->io.cancel(); }
}

struct TcpListener {
    Executor* ex;
    i32 fd;

    static !TcpListener bind(Executor* ex, str host, i64 port) {
        const auto l = net::listen(host, port)?;
        if (vrt_set_nonblocking(l.fd) != 0) {
            _ = close(l.fd);
            return error.SystemCall;
        }
        return TcpListener{ .ex = ex, .fd = l.fd };
    }

    i64 port() {
        const auto l = net::Listener{ .fd = this->fd };
        return l.port();
    }

    Accept accept() { return Accept{ .ex = this->ex, .fd = this->fd, .r = Readable::on(this->ex, this->fd) }; }

    void close() move {
        this->ex.forget(this->fd);
        _ = close(this->fd);
        this->fd = -1;
    }
}

struct Accept {
    Executor* ex;
    i32 fd;
    Readable r;

    void cancel() { this->r.cancel(); }

    Poll<!TcpStream> poll(Context* cx) {
        while (true) {
            if (this->r.io.armed) {
                match (this->r.poll(cx)) {
                    .Ready(_) => {}
                    .Pending => return .Pending;
                }
            }
            const auto fd = accept(this->fd, null, null);
            if (fd >= 0) {
                if (vrt_set_nonblocking(fd) != 0) {
                    _ = close(fd);
                    return .Ready(error.SystemCall);
                }
                return .Ready(TcpStream{ .ex = this->ex, .fd = fd });
            }
            const auto e = vrt_errno();
            if (e == 11) {
                match (this->r.poll(cx)) {
                    .Ready(_) => return .Ready(error.SystemCall);
                    .Pending => return .Pending;
                }
            }
            if (e != 4 && e != 103) {
                errno_error() catch |err| { return .Ready(err); };
            }
        }
        return .Pending;
    }
}

struct TcpStream {
    Executor* ex;
    i32 fd;

    static !TcpStream connect(Executor* ex, str host, i64 port) {
        const auto c = net::connect_to(host, port)?;
        if (vrt_set_nonblocking(c.fd) != 0) {
            _ = close(c.fd);
            return error.SystemCall;
        }
        return TcpStream{ .ex = ex, .fd = c.fd };
    }

    Read read(u8[] buf) { return Read{ .ex = this->ex, .fd = this->fd, .buf = buf, .r = Readable::on(this->ex, this->fd) }; }
    Write write(str data) { return Write{ .ex = this->ex, .fd = this->fd, .data = data, .w = Writable::on(this->ex, this->fd) }; }

    void close() move {
        this->ex.forget(this->fd);
        _ = close(this->fd);
        this->fd = -1;
    }
}

struct Read {
    Executor* ex;
    i32 fd;
    u8[] buf;
    Readable r;

    void cancel() { this->r.cancel(); }

    Poll<!i64> poll(Context* cx) {
        while (true) {
            if (this->r.io.armed) {
                match (this->r.poll(cx)) {
                    .Ready(_) => {}
                    .Pending => return .Pending;
                }
            }
            const auto n = recv(this->fd, this->buf.ptr, this->buf.len as u64, 0);
            if (n >= 0) { return .Ready(n); }
            const auto e = vrt_errno();
            if (e == 11) {
                match (this->r.poll(cx)) {
                    .Ready(_) => return .Ready(error.SystemCall);
                    .Pending => return .Pending;
                }
            }
            if (e != 4) {
                errno_error() catch |err| { return .Ready(err); };
            }
        }
        return .Pending;
    }
}

struct Write {
    Executor* ex;
    i32 fd;
    str data;
    i64 off;
    Writable w;

    void cancel() { this->w.cancel(); }

    Poll<!i64> poll(Context* cx) {
        while (this->off < this->data.len) {
            if (this->w.io.armed) {
                match (this->w.poll(cx)) {
                    .Ready(_) => {}
                    .Pending => return .Pending;
                }
            }
            const auto n = vrt_send(this->fd, this->data.ptr + this->off, (this->data.len - this->off) as u64, net::MSG_NOSIGNAL);
            if (n >= 0) {
                this->off += n;
                continue;
            }
            const auto e = vrt_errno();
            if (e == 11) {
                match (this->w.poll(cx)) {
                    .Ready(_) => return .Ready(error.SystemCall);
                    .Pending => return .Pending;
                }
            }
            if (e != 4) {
                errno_error() catch |err| { return .Ready(err); };
            }
        }
        return .Ready(this->off);
    }
}
