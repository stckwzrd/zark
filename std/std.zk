// ===== Zark standard prelude (auto-imported) =====
// Rule: nothing in the language or in this prelude allocates behind your back.
// Every heap allocation goes through an Allocator value that you pass in explicitly.

// ---- libc ----
extern i32 printf(u8* fmt, ...);
extern void* malloc(u64 n);
extern void* calloc(u64 n, u64 size);
extern void* realloc(void* p, u64 n);
extern void free(void* p);
extern void exit(i32 code);
extern i32 memcmp(void* a, void* b, u64 n);
extern void* memcpy(void* dst, void* src, u64 n);
extern void* memmove(void* dst, void* src, u64 n);
extern void* memset(void* dst, i32 c, u64 n);
extern void* aligned_alloc(u64 align, u64 n);
extern u64 strlen(u8* s);
extern void* fdopen(i32 fd, u8* mode);
extern u8* fgets(u8* buf, i32 n, void* f);
extern i64 clock();
extern i32 rand();
extern void srand(u32 seed);
extern i64 time(i64* t);

// ---- math (libm) ----
extern f64 sqrt(f64 x);
extern f64 sin(f64 x);
extern f64 cos(f64 x);
extern f64 tan(f64 x);
extern f64 pow(f64 x, f64 y);
extern f64 exp(f64 x);
extern f64 log(f64 x);
extern f64 floor(f64 x);
extern f64 ceil(f64 x);
extern f64 fabs(f64 x);

const auto PI = 3.141592653589793;

// ---- process ----
i64 __argc = 0;
u8**__argv = null;
void* __stdin = null;

i64 arg_count() { return __argc; }
str arg(i64 i) {
    if (i < 0 || i >= __argc) { panic("arg index {i} out of range"); }
    return cstr(__argv[i]);
}

// ---- runtime helpers used by the compiler (never allocate) ----
bool __str_eq(str a, str b) {
    if (a.len != b.len) { return false; }
    if (a.len == 0) { return true; }
    return memcmp(a.ptr, b.ptr, a.len as u64) == 0;
}

void __ovf(str file, i64 line) {
    eprintln("panic: integer overflow at {file}:{line}");
    exit(1);
}

void __divz(str file, i64 line) {
    eprintln("panic: division by zero at {file}:{line}");
    exit(1);
}

void __oobs(i64 lo, i64 hi, i64 n, str file, i64 line) {
    eprintln("panic: slice [{lo}..{hi}] out of bounds (len {n}) at {file}:{line}");
    exit(1);
}

void __oob(i64 i, i64 n, str file, i64 line) {
    eprintln("panic: index {i} out of bounds (len {n}) at {file}:{line}");
    exit(1);
}

// ================================================================ memory

/// An allocator is just a context pointer plus two functions.
/// Contract: alloc_fn returns zeroed memory aligned to `align`, or null.
struct Allocator {
    void* ctx;
    fn(void*, u64, u64) -> void* alloc_fn;
    fn(void*, void*, u64) free_fn;

    template<T> !T[] alloc(i64 n) {
        if (n == 0) { return (null as *T)[0..0]; }
        if (this->alloc_fn == null) { return error.NoAllocator; }
        if (n < 0 || (n as u64) > 0x4000000000000000 / max(sizeof(T), 1 as u64)) { return error.OutOfMemory; }
        const auto p = this->alloc_fn(this->ctx, (n as u64) * sizeof(T), alignof(T));
        if (p == null) { return error.OutOfMemory; }
        return (p as *T)[0..n];
    }
    template<T> !T[] grow(T[] old, i64 n) {
        if (this->alloc_fn == null) { return error.NoAllocator; }
        if (n < 0 || (n as u64) > 0x4000000000000000 / max(sizeof(T), 1 as u64)) { return error.OutOfMemory; }
        if (this->alloc_fn != __c_alloc || old.len == 0) {
            const auto fresh = this->alloc<T>(n)?;
            if (old.len > 0) { memcpy(fresh.ptr, old.ptr, (old.len as u64) * sizeof(T)); }
            this->free(old);
            return fresh;
        }
        const auto p = realloc(old.ptr, (n as u64) * sizeof(T));
        if (p == null) { return error.OutOfMemory; }
        return (p as *T)[0..n];
    }
    template<T> void free(move T[] s) {
        if (s.len > 0 && this->free_fn != null) { this->free_fn(this->ctx, s.ptr, (s.len as u64) * sizeof(T)); }
    }
    /// one zeroed T
    template<T> !T* create() {
        const auto s = this->alloc<T>(1)?;
        return s.ptr;
    }
    template<T> void destroy(move T* p) { if (this->free_fn != null) { this->free_fn(this->ctx, p, sizeof(T)); } }
    /// copy a string into memory owned by this allocator
    !str dup(str s) {
        const auto d = this->alloc<u8>(s.len)?;
        if (s.len > 0) { memcpy(d.ptr, s.ptr, s.len as u64); }
        return d;
    }

    !u8* dupz(str s) {
        const auto d = this->alloc<u8>(s.len + 1)?;
        if (s.len > 0) { memcpy(d.ptr, s.ptr, s.len as u64); }
        return d.ptr;
    }
}

// -- libc heap
void* __c_alloc(void* ctx, u64 n, u64 align) {
    if (align > 16) {
        const auto p = aligned_alloc(align, (n + align - 1) / align * align);
        if (p != null) { memset(p, 0, n); }
        return p;
    }
    return calloc(1, n);
}
void __c_free(void* ctx, void* p, u64 n) { free(p); }
Allocator c_allocator() {
    return Allocator{ .ctx = null, .alloc_fn = __c_alloc, .free_fn = __c_free };
}

// -- bump allocator over a buffer you own (stack, static, or anything). Never touches the heap.
struct FixedBuf {
    u8[] buf;
    i64 used;

    static Self init(u8[] buf) { return Self{ .buf = buf, .used = 0 } };
    Allocator allocator() {
        return Allocator{ .ctx = this, .alloc_fn = __fixed_alloc, .free_fn = __fixed_free };
    }
    void reset() { this->used = 0; }
    i64 remaining() { return this->buf.len - this->used; }
}

void* __fixed_alloc(void* ctx, u64 n, u64 align) {
    const auto fb = ctx as *FixedBuf;
    const auto base = fb.buf.ptr as u64;
    const auto addr = base + (fb.used as u64);
    const auto aligned = (addr + align - 1) / align * align;
    const auto off = (aligned - base) as i64;
    if (off + (n as i64) > fb.buf.len) { return null; }
    fb.used = off + n as i64;
    const auto p = fb.buf.ptr + off;
    memset(p, 0, n);
    return p;
}

void __fixed_free(void* ctx, void* p, u64 n) {
    // only the most recent allocation can be given back
    const auto fb = ctx as *FixedBuf;
    if ((p as u64) + n == (fb.buf.ptr as u64) + (fb.used as u64)) { fb.used -= n as i64; }
}

// ================================================================ generic helpers

template<T> T min(T a, T b) { if (a < b) { return a; } return b; }
template<T> T max(T a, T b) { if (a > b) { return a; } return b; }
template<T> T abs(T a) { if (a < 0) { return -a; } return a; }
template<T> void swap(T* a, T* b) { const auto t = *a; *a = *b; *b = t; }

/// in-place sort of any slice whose elements support < and >
template<T> void sort(T[] s) { if (s.len > 1) { __qsort(s.ptr, 0, s.len - 1); } }

template<T> void __qsort(T* a, i64 lo, i64 hi) {
    while (hi - lo > 16) {
        const auto mid = lo + (hi - lo) / 2;
        if (a[mid] < a[lo]) { swap(&a[mid], &a[lo]); }
        if (a[hi] < a[lo]) { swap(&a[hi], &a[lo]); }
        if (a[hi] < a[mid]) { swap(&a[hi], &a[mid]); }
        const auto pivot = a[mid];
        auto i = lo;
        auto j = hi;
        while (i <= j) {
            while (a[i] < pivot) { i += 1; }
            while (a[j] > pivot) { j -= 1; }
            if (i <= j) {
                swap(&a[i], &a[j]);
                i += 1;
                j -= 1;
            }
        }
        if (j - lo < hi - i) {
            __qsort(a, lo, j);
            lo = i;
        } else {
            __qsort(a, i, hi);
            hi = j;
        }
    }
    for (auto i : lo + 1..hi + 1) {
        const auto v = a[i];
        auto j = i - 1;
        while (j >= lo && a[j] > v) {
            a[j + 1] = a[j];
            j -= 1;
        }
        a[j + 1] = v;
    }
}

// ================================================================ strings (no allocation)

str cstr(u8* p) { return p[0..strlen(p) as i64]; }

bool str_starts_with(str s, str prefix) {
    if (prefix.len > s.len) { return false; }
    return s[0..prefix.len] == prefix;
}

bool str_ends_with(str s, str suffix) {
    if (suffix.len > s.len) { return false; }
    return s[s.len - suffix.len..] == suffix;
}

i64 str_find(str s, str needle) {
    if (needle.len == 0) { return 0; }
    auto i = 0;
    while (i + needle.len <= s.len) {
        if (s[i..i + needle.len] == needle) { return i; }
        i += 1;
    }
    return -1;
}

bool __is_space(u8 c) { return c == ' ' || c == '\n' || c == '\t' || c == '\r'; }

str str_trim(str s) {
    auto a = 0;
    auto b = s.len;
    while (a < b && __is_space(s[a])) { a += 1; }
    while (b > a && __is_space(s[b - 1])) { b -= 1; }
    return s[a..b];
}

!i64 parse_int(str s) {
    const auto t = str_trim(s);
    if (t.len == 0) { return error.InvalidNumber; }
    auto i = 0;
    auto neg = false;
    if (t[0] == '-') { neg = true; i = 1; }
    if (i >= t.len) { return error.InvalidNumber; }
    u64 limit = 9223372036854775807;
    if (neg) { limit = 9223372036854775808; }
    u64 v = 0;
    while (i < t.len) {
        const auto c = t[i];
        if (c < '0' || c > '9') { return error.InvalidNumber; }
        const auto d = (c - '0') as u64;
        if (v > (limit - d) / 10) { return error.InvalidNumber; }
        v = v * 10 + d;
        i += 1;
    }
    if (neg) { return (0 -% v) as i64; }
    return v as i64;
}

/// read one line from stdin into `buf` (without the newline)
!str read_line(u8[] buf) {
    if (__stdin == null) { __stdin = fdopen(0, "r"); }
    if (fgets(buf.ptr, buf.len as i32, __stdin) == null) { return error.EndOfFile; }
    auto s = cstr(buf.ptr);
    if (s.len > 0 && s[s.len - 1] == '\n') { s = s[0..s.len - 1]; }
    return s;
}

// ================================================================ List[T]

struct List<T> {
    T[] items;   // capacity = items.len
    i64 len;
    Allocator a;

    static Self init(Allocator a) { return Self{ .a = a } };

    void deinit() move {
        this->a.free(this->items);
        this->items = this->items[0..0];
        this->len = 0;
    }

    !void reserve(i64 n) invalidates {
        if (n <= this->items.len) { return; }
        auto cap = this->items.len * 2;
        if (cap < 8) { cap = 8; }
        if (cap < n) { cap = n; }
        this->items = this->a.grow<T>(this->items, cap)?;
    }

    !void push(T v) invalidates {
        this->reserve(this->len + 1)?;
        this->items[this->len] = v;
        this->len += 1;
    }

    !void append(T[] xs) invalidates {
        const auto n = xs.len;
        if (n == 0) { return; }
        auto src = xs;
        const auto base = this->items.ptr as u64;
        const auto sp = xs.ptr as u64;
        const auto inside = this->items.len > 0 && sp >= base && sp < base + (this->items.len as u64) * sizeof(T);
        const auto off = (sp - base) / max(sizeof(T), 1 as u64);
        this->reserve(this->len + n)?;
        if (inside) { src = this->items[off as i64..off as i64 + n]; }
        for (auto i : 0..n) { this->items[this->len + i] = src[i]; }
        this->len += n;
    }

    !T pop() {
        if (this->len == 0) { return error.Empty; }
        this->len -= 1;
        return this->items[this->len];
    }

    !T last() {
        if (this->len == 0) { return error.Empty; }
        return this->items[this->len - 1];
    }

    T get(i64 i) { return this->slice()[i]; }
    void set(i64 i, T v) { this->slice()[i] = v; }
    T[] slice() borrows { return this->items[0..this->len]; }
    bool is_empty() { return this->len == 0; }
    void clear() { this->len = 0; }

    bool contains(T v) {
        for (auto x : this->slice()) { if (x == v) { return true; } }
        return false;
    }

    void reverse() {
        auto i = 0;
        auto j = this->len - 1;
        while (i < j) {
            swap(&this->items[i], &this->items[j]);
            i += 1;
            j -= 1;
        }
    }

    void sort() { sort(this->slice()); }

    /// a pointer to element i (valid until the next push or insert)
    T* at(i64 i) borrows { return &this->slice()[i]; }

    /// index of the first element equal to v, or -1
    i64 index_of(T v) {
        for (auto [i, x] : this->slice()) { if (x == v) { return i; } }
        return -1;
    }

    /// inserts v before position i (0 <= i <= len), shifting the rest
    !void insert(i64 i, T v) invalidates {
        if (i < 0 || i > this->len) { return error.OutOfRange; }
        this->reserve(this->len + 1)?;
        auto j = this->len;
        while (j > i) {
            this->items[j] = this->items[j - 1];
            j -= 1;
        }
        this->items[i] = v;
        this->len += 1;
    }

    /// removes element i keeping the order of the rest
    !T remove_at(i64 i) {
        if (i < 0 || i >= this->len) { return error.OutOfRange; }
        const auto v = this->items[i];
        for (auto j : i..this->len - 1) { this->items[j] = this->items[j + 1]; }
        this->len -= 1;
        return v;
    }

    /// removes element i in O(1) by moving the last element into its place
    !T swap_remove(i64 i) {
        if (i < 0 || i >= this->len) { return error.OutOfRange; }
        const auto v = this->items[i];
        this->items[i] = this->items[this->len - 1];
        this->len -= 1;
        return v;
    }

    /// hands the elements over as an exactly sized slice (free it with the same allocator)
    /// and leaves the list empty
    !T[] take() {
        auto r = this->a.alloc<T>(this->len)?;
        for (auto i : 0..this->len) { r[i] = this->items[i]; }
        this->deinit();
        return r;
    }

    void truncate(i64 n) { if (n < this->len) { this->len = max(n, 0); } }

    /// a copy with its own memory from the same allocator
    !Self clone() {
        auto c = Self::init(this->a);
        c.append(this->slice())?;
        return c;
    }
}

// ================================================================ Map[V]
// string-keyed hash map; keys are NOT copied (use Allocator.dup if you need ownership)

struct MapEntry<V> { str key; V value; bool used; }

struct Map<V> {
    MapEntry<V>[] entries;
    i64 len;
    Allocator a;

    static Self init(Allocator a) { return Self{ .a = a } };

    void deinit() move {
        this->a.free(this->entries);
        this->entries = this->entries[0..0];
        this->len = 0;
    }

    i64 __find(str key) {
        const auto cap = this->entries.len;
        auto i = (hash_str(key) % (cap as u64)) as i64;
        while (true) {
            const auto e = &this->entries[i];
            if (!e.used || e.key == key) { return i; }
            i = (i + 1) % cap;
        }
        return -1;
    }

    void __insert(str key, V value) {
        const auto e = &this->entries[this->__find(key)];
        if (!e.used) { this->len += 1; }
        e.key = key;
        e.value = value;
        e.used = true;
    }

    !void __grow() {
        const auto old = this->entries;
        auto nc = old.len * 2;
        if (nc < 16) { nc = 16; }
        this->entries = this->a.alloc<MapEntry<V>>(nc)?;
        this->len = 0;
        for (auto e : old) {
            if (e.used) { this->__insert(e.key, e.value); }
        }
        this->a.free(old);
    }

    !void put(str key, V value) invalidates {
        if ((this->len + 1) * 4 > this->entries.len * 3) { this->__grow()?; }
        this->__insert(key, value);
    }

    !V get(str key) {
        if (this->entries.len == 0) { return error.NotFound; }
        const auto e = &this->entries[this->__find(key)];
        if (!e.used) { return error.NotFound; }
        return e.value;
    }

    bool has(str key) {
        if (this->entries.len == 0) { return false; }
        return this->entries[this->__find(key)].used;
    }

    /// a pointer to the value for in-place changes, or null
    V* get_ptr(str key) borrows {
        if (this->entries.len == 0) { return null; }
        const auto e = &this->entries[this->__find(key)];
        if (!e.used) { return null; }
        return &e.value;
    }

    V get_or(str key, V d) { return this->get(key) catch d; }

    /// removes the key; false when it was not there
    bool remove(str key) invalidates {
        if (this->entries.len == 0) { return false; }
        const auto cap = this->entries.len;
        auto i = this->__find(key);
        if (!this->entries[i].used) { return false; }
        auto j = i;
        while (true) {
            j = (j + 1) % cap;
            if (!this->entries[j].used) { break; }
            const auto home = (hash_str(this->entries[j].key) % (cap as u64)) as i64;
            if (!__probe_between(i, home, j)) {
                this->entries[i] = this->entries[j];
                i = j;
            }
        }
        this->entries[i] = MapEntry<V>{};
        this->len -= 1;
        return true;
    }

    void clear() {
        for (auto i : 0..this->entries.len) { this->entries[i] = MapEntry<V>{}; }
        this->len = 0;
    }

    /// auto it = m.iter(); while (it.next()) { println(it.key(), it.value()); }
    MapIter<V> iter() borrows { return MapIter<V>{ .entries = this->entries, .i = -1 }; }
}

struct MapIter<V> {
    MapEntry<V>[] entries;
    i64 i;

    bool next() {
        this->i += 1;
        while (this->i < this->entries.len && !this->entries[this->i].used) { this->i += 1; }
        return this->i < this->entries.len;
    }
    str key() { return this->entries[this->i].key; }
    V value() { return this->entries[this->i].value; }
    V* value_ptr() { return &this->entries[this->i].value; }
}

/// is `home` cyclically in (i, j]? (linear probing: the entry at j may stay)
bool __probe_between(i64 i, i64 home, i64 j) {
    if (i <= j) { return i < home && home <= j; }
    return i < home || home <= j;
}

u64 hash_str(str s) {
    u64 h = 14695981039346656037;
    for (auto c : s) {
        h = h ^ (c as u64);
        h = h * 1099511628211;
    }
    return h;
}

// ================================================================ Option[T]

union Option<T> {
    T Some;
    None;

    bool is_some() {
        match *this {
            .Some(_) => return true;
            .None => return false;
        }
        return false;
    }
    T unwrap_or(T d) {
        match *this {
            .Some(v) => return v;
            .None => return d;
        }
        return d;
    }
}


union Poll<T> {
    T Ready;
    Pending;
}

struct Waker {
    void* data;
    fn(void*) wake_fn;

    void wake() {
        if (this->wake_fn != null) { this->wake_fn(this->data); }
    }
}

struct Context {
    Waker waker;
}

// ================================================================ C strings

/// copy `s` into `buf` and NUL-terminate it (no allocation)
!u8* to_cstr(u8[] buf, str s) {
    if (s.len + 1 > buf.len) { return error.NoSpace; }
    if (s.len > 0) { memcpy(buf.ptr, s.ptr, s.len as u64); }
    buf[s.len] = 0;
    return buf.ptr;
}

// ================================================================ characters

bool is_digit(u8 c) { return c >= '0' && c <= '9'; }
bool is_alpha(u8 c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
bool is_alnum(u8 c) { return is_alpha(c) || is_digit(c); }
bool is_upper(u8 c) { return c >= 'A' && c <= 'Z'; }
bool is_hex(u8 c) { return is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'); }

// ================================================================ files

extern void* fopen(u8* path, u8* mode);
extern i32 fclose(void* f);
extern u64 fread(void* buf, u64 size, u64 n, void* f);
extern u64 fwrite(void* buf, u64 size, u64 n, void* f);
extern i32 fseek(void* f, i64 off, i32 whence);
extern i64 ftell(void* f);
extern i32 remove(u8* path);
extern i32 mkdir(u8* path, u32 mode);

/// read a whole file; memory comes from `a`
!str read_file(Allocator a, str path) {
    u8[4096] pbuf;
    const auto f = fopen(to_cstr(pbuf[..], path)?, "rb");
    if (f == null) { return error.FileNotFound; }
    defer _ = fclose(f);
    _ = fseek(f, 0, 2);
    const auto n = ftell(f);
    _ = fseek(f, 0, 0);
    if (n < 0) { return error.ReadFailed; }
    const auto buf = a.alloc<u8>(n)?;
    if (n > 0 && fread(buf.ptr, 1, n as u64, f) != n as u64) {
        a.free(buf);
        return error.ReadFailed;
    }
    return buf;
}

!void write_file(str path, str data) {
    u8[4096] pbuf;
    const auto f = fopen(to_cstr(pbuf[..], path)?, "wb");
    if (f == null) { return error.CannotOpen; }
    defer _ = fclose(f);
    if (data.len > 0 && fwrite(data.ptr, 1, data.len as u64, f) != data.len as u64) { return error.WriteFailed; }
}

template<T> void __ct_emit(str path, T v) {
    const auto p = &v as *u8;
    write_file(path, p[0..sizeof(T) as i64]) catch panic("cannot write the comptime result to {path}");
}

void __ct_emit_str(str path, str v) {
    write_file(path, v) catch panic("cannot write the comptime result to {path}");
}

bool file_exists(str path) {
    u8[4096] pbuf;
    const auto p = to_cstr(pbuf[..], path) catch return false;
    const auto f = fopen(p, "rb");
    if (f == null) { return false; }
    _ = fclose(f);
    return true;
}

// ================================================================ processes

extern i32 fork();
extern i32 execvp(u8* file, u8**argv);
extern i32 waitpid(i32 pid, i32* status, i32 options);
extern void _exit(i32 code);
extern u8* getenv(u8* name);
extern i32 fflush(void* f);

/// run a program (searched in PATH) and wait for it; returns its exit code
!i32 run(Allocator a, str[] argv) {
    if (argv.len == 0) { return error.NoProgram; }
    const auto cargs = a.alloc<u8*>(argv.len + 1)?;
    defer a.free(cargs);
    for (auto [i, s] : argv) { cargs[i] = a.dupz(s)?; }
    defer { for (auto i : 0..argv.len) { a.free_fn(a.ctx, cargs[i], (argv[i].len + 1) as u64); } }
    _ = fflush(null);
    const auto pid = fork();
    if (pid < 0) { return error.ForkFailed; }
    if (pid == 0) {
        _ = execvp(cargs[0], cargs.ptr);
        eprintln("error: cannot run '{argv[0]}'");
        _exit(127);
    }
    i32 status = 0;
    if (waitpid(pid, &status, 0) < 0) { return error.WaitFailed; }
    if ((status & 0x7f) != 0) { return error.Signaled; }
    return (status >> 8) & 0xff;
}

!str env(str name) {
    u8[256] nbuf;
    const auto p = getenv(to_cstr(nbuf[..], name)?);
    if (p == null) { return error.NotFound; }
    return cstr(p);
}

// ================================================================ Arena
// Growable bump allocator on top of a parent allocator. free() is a no-op; deinit() releases everything.
// Chunks are linked through a small header, so the arena itself never needs a container.

struct __ChunkHdr { __ChunkHdr* prev; u64 size; }

struct Arena {
    Allocator parent;
    __ChunkHdr* head;
    u64 used;      // bytes used in head chunk (after header)
    u64 cap;       // usable bytes in head chunk
    u64 total;     // bytes handed out overall

    static Self init(Allocator parent) { return Self{ .parent = parent } };
    Allocator allocator() {
        return Allocator{ .ctx = this, .alloc_fn = __arena_alloc, .free_fn = __arena_free };
    }
    void deinit() move {
        auto c = this->head;
        while (c != null) {
            const auto prev = c.prev;
            this->parent.free_fn(this->parent.ctx, c, c.size);
            c = prev;
        }
        this->head = null;
        this->used = 0;
        this->cap = 0;
    }
}

void* __arena_alloc(void* ctx, u64 n, u64 align) {
    const auto ar = ctx as *Arena;
    const auto hdr = sizeof(__ChunkHdr);
    if (n > 0x4000000000000000 || align > 4096) { return null; }
    if (ar.head != null) {
        const auto base = (ar.head as u64) + hdr;
        const auto at = (base + ar.used + align - 1) / align * align;
        if (at + n <= base + ar.cap) {
            ar.used = at + n - base;
            ar.total += n;
            return at as *void;
        }
    }
    u64 size = 64 * 1024;
    while (size < n + align + hdr) { size *= 2; }
    const auto mem = ar.parent.alloc_fn(ar.parent.ctx, size, 16);
    if (mem == null) { return null; }
    const auto c = mem as *__ChunkHdr;
    c.prev = ar.head;
    c.size = size;
    ar.head = c;
    ar.used = 0;
    ar.cap = size - hdr;
    return __arena_alloc(ctx, n, align);
}

void __arena_free(void* ctx, void* p, u64 n) {}

// ================================================================ more string helpers

i64 str_rfind_byte(str s, u8 c) {
    auto i = s.len - 1;
    while (i >= 0) {
        if (s[i] == c) { return i; }
        i -= 1;
    }
    return -1;
}

i64 str_find_byte(str s, u8 c) {
    for (auto [i, x] : s) { if (x == c) { return i; } }
    return -1;
}

/// parse with an explicit radix (2..36); accepts an optional 0x/0b/0o prefix when radix == 0
!u64 parse_int_radix(str s, i64 radix) {
    auto t = s;
    auto r = radix;
    if (r == 0) {
        r = 10;
        if (t.len > 2 && t[0] == '0') {
            if (t[1] == 'x') { r = 16; t = t[2..]; } else if (t[1] == 'b') { r = 2; t = t[2..]; } else if (t[1] == 'o') { r = 8; t = t[2..]; }
        }
    }
    if (t.len == 0) { return error.InvalidNumber; }
    u64 v = 0;
    for (auto c : t) {
        if (c == '_') { continue; }
        i64 d = 99;
        if (is_digit(c)) { d = (c - '0') as i64; } else if (c >= 'a' && c <= 'z') { d = (c - 'a') as i64 + 10; } else if (c >= 'A' && c <= 'Z') { d = (c - 'A') as i64 + 10; }
        if (d >= r) { return error.InvalidNumber; }
        if (v > (0xFFFFFFFFFFFFFFFF - (d as u64)) / (r as u64)) { return error.InvalidNumber; }
        v = v * (r as u64) + (d as u64);
    }
    return v;
}

extern f64 strtod(u8* s, u8**end);

!f64 parse_float(str s) {
    const auto t = str_trim(s);
    if (t.len == 0) { return error.InvalidNumber; }
    u8[128] buf;
    const auto p = to_cstr(buf[..], t)?;
    u8* end = null;
    const auto v = strtod(p, &end);
    if ((end as u64) - (p as u64) != t.len as u64) { return error.InvalidNumber; }
    return v;
}

/// reinterpret the bits of a value (same size required at the call site)
u64 bits_f64(f64 x) { auto y = x; return *(&y as *u64); }
f64 f64_from_bits(u64 x) { auto y = x; return *(&y as *f64); }

// ================================================================ time
struct Timespec { i64 sec; i64 nsec; }
extern i32 vrt_clock_gettime(i32 id, Timespec* ts);

/// monotonic wall clock in nanoseconds
extern i32 vrt_errno();
extern void vrt_breakpoint();
extern i64 vrt_sysconf(i32 name);
extern i64 vrt_syscall(i64 nr, i64 a1, i64 a2, i64 a3, i64 a4, i64 a5, i64 a6);

/// the libc errno of the last failed call as an error (error.NotFound, error.PermissionDenied, ...)
!void errno_error() {
    _ = __sys_result(0 - vrt_errno() as i64)?;
    return error.SystemCall;
}

i64 now_ns() {
    auto ts = Timespec{ .sec = 0, .nsec = 0 };
    _ = vrt_clock_gettime(1, &ts);
    return ts.sec * 1000000000 + ts.nsec;
}

// ================================================================ formatting
// The compiler only builds `Fmt` values at call sites whose last parameter is a `Fmt`
// and calls the `__fmt_*` hooks below from the per-type thunks it generates.

extern i32 dprintf(i32 fd, u8* fmt, ...);
extern i32 snprintf(u8* buf, u64 n, u8* fmt, ...);

struct Writer {
    void* ctx;
    fn(void*, str) -> !void write_fn;

    !void write(str s) {
        if (s.len > 0) { this->write_fn(this->ctx, s)?; }
    }

    !void put(Fmt f) {
        for (auto i : 0..f.pieces.len) {
            const auto pc = &f.pieces[i];
            this->write(pc.lit)?;
            const auto r = pc.thunk(this, pc.value, pc.spec, 0);
            r catch |e| {
                if (e == error.BadFormat) { this->write("<bad format>")? } else { return e; }
            }
        }
        this->write(f.tail)?;
    }
}

struct FmtPiece {
    str lit;
    void* value;
    fn(Writer*, void*, str, i64) -> !void thunk;
    str spec;
}

struct Fmt {
    FmtPiece[] pieces;
    str tail;

    !void fmt(Writer* w, str spec) { return w.put(*this); }
}

struct OutBuf {
    u8[512] buf;
    i64 n;
    i32 fd;
}

void __ob_flush(OutBuf* b) {
    if (b.n == 0) { return; }
    if (b.fd == 1) {
        printf("%.*s", b.n as i32, b.buf.ptr);
    } else {
        fflush(null);
        dprintf(2, "%.*s", b.n as i32, b.buf.ptr);
    }
    b.n = 0;
}

!void __ob_write(void* ctx, str s) {
    const auto b = ctx as *OutBuf;
    if (b.n + s.len > 512) { __ob_flush(b); }
    if (s.len > 512) {
        if (b.fd == 1) { printf("%.*s", s.len as i32, s.ptr); } else {
            fflush(null);
            dprintf(2, "%.*s", s.len as i32, s.ptr);
        }
        return;
    }
    memcpy(b.buf.ptr + b.n, s.ptr, s.len as u64);
    b.n += s.len;
}

void __emit_out(i32 fd, Fmt f, bool nl) {
    auto ob = OutBuf{ .n = 0, .fd = fd };
    auto w = Writer{ .ctx = &ob as *void, .write_fn = __ob_write };
    _ = w.put(f);
    if (nl) { _ = w.write("\n"); }
    __ob_flush(&ob);
}

void print(Fmt f) { __emit_out(1, f, false); }
void println(Fmt f) { __emit_out(1, f, true); }
void eprint(Fmt f) { __emit_out(2, f, false); }
void eprintln(Fmt f) { __emit_out(2, f, true); }

struct FmtBuf { u8[] buf; i64 n; }

!void __buf_write(void* ctx, str s) {
    const auto b = ctx as *FmtBuf;
    auto room = b.buf.len - 1 - b.n;
    if (room < 0) { room = 0; }
    auto k = s.len;
    if (k > room) { k = room; }
    if (k > 0) { memcpy(b.buf.ptr + b.n, s.ptr, k as u64); }
    b.n += s.len;
}

!str bprint(u8[] buf, Fmt f) {
    auto bw = FmtBuf{ .buf = buf, .n = 0 };
    auto w = Writer{ .ctx = &bw as *void, .write_fn = __buf_write };
    w.put(f)?;
    if (bw.n >= buf.len) { return error.NoSpace; }
    buf[bw.n] = 0;
    return buf[0..bw.n];
}

!void __list_write(void* ctx, str s) {
    const auto l = ctx as *List<u8>;
    l.append(s)?;
}

!void sprint(List<u8>*out, Fmt f) {
    auto w = Writer{ .ctx = out as *void, .write_fn = __list_write };
    w.put(f)?;
}

void __panic(str file, i64 line, bool is_assert, Fmt f) {
    if (is_assert) {
        eprint("assertion failed ({file}:{line})\n");
    } else {
        eprint("panic: {f} ({file}:{line})\n");
    }
    exit(1);
}

!void __fmt_lit(Writer* w, str s) { return w.write(s); }

struct FmtSpec {
    bool left;
    bool plus;
    bool space;
    bool zero;
    bool alt;
    i64 width;
    i64 prec;
    u8 conv;
}

!FmtSpec __spec(str spec) {
    auto s = FmtSpec{ .left = false, .plus = false, .space = false, .zero = false, .alt = false, .width = 0, .prec = -1, .conv = 0 };
    auto i = 0;
    while (i < spec.len) {
        const auto c = spec[i];
        if (c == '-') { s.left = true; } else if (c == '+') { s.plus = true; } else if (c == ' ') { s.space = true; } else if (c == '0') { s.zero = true; } else if (c == '#') { s.alt = true; } else { break; }
        i += 1;
    }
    while (i < spec.len && is_digit(spec[i])) {
        s.width = s.width * 10 + (spec[i] - '0') as i64;
        i += 1;
    }
    if (i < spec.len && spec[i] == '.') {
        i += 1;
        s.prec = 0;
        while (i < spec.len && is_digit(spec[i])) {
            s.prec = s.prec * 10 + (spec[i] - '0') as i64;
            i += 1;
        }
    }
    if (i < spec.len && is_alpha(spec[i])) {
        s.conv = spec[i];
        i += 1;
    }
    if (i != spec.len || s.width > 4096 || s.prec > 4096) { return error.BadFormat; }
    return s;
}

!void __pad(Writer* w, bool zero, i64 n) {
    const auto blanks = "                                ";
    const auto zeros = "00000000000000000000000000000000";
    auto left = n;
    while (left > 0) {
        auto k = left;
        if (k > 32) { k = 32; }
        if (zero) { w.write(zeros[0..k])?; } else { w.write(blanks[0..k])?; }
        left -= k;
    }
}

!void __emit(Writer* w, FmtSpec sp, str prefix, str body, i64 zeros, bool zero_ok) {
    const auto total = prefix.len + zeros + body.len;
    auto fill = sp.width - total;
    if (fill < 0) { fill = 0; }
    if (sp.left) {
        w.write(prefix)?;
        __pad(w, true, zeros)?;
        w.write(body)?;
        return __pad(w, false, fill);
    }
    if (sp.zero && zero_ok) {
        w.write(prefix)?;
        __pad(w, true, fill + zeros)?;
        return w.write(body);
    }
    __pad(w, false, fill)?;
    w.write(prefix)?;
    __pad(w, true, zeros)?;
    return w.write(body);
}

!void __fmt_num(Writer* w, u64 bits, bool signed, str spec) {
    const auto sp = __spec(spec)?;
    auto conv = sp.conv;
    if (conv == 0) {
        if (signed) { conv = 'd'; } else { conv = 'u'; }
    }
    if (conv == 'c') {
        u8[1] one;
        one[0] = bits as u8;
        return __emit(w, sp, "", one[..], 0, false);
    }
    if (str_find_byte("dixXou", conv) < 0) { return error.BadFormat; }
    u64 base = 10;
    if (conv == 'x' || conv == 'X') { base = 16; }
    if (conv == 'o') { base = 8; }
    auto neg = false;
    auto mag = bits;
    if (conv == 'd' || conv == 'i') {
        if ((bits as i64) < 0) {
            neg = true;
            mag = 0 - bits;
        }
    }
    u8[72] digits;
    auto n = 72;
    const auto hex = "0123456789abcdef";
    const auto hexu = "0123456789ABCDEF";
    if (mag == 0) {
        n -= 1;
        digits[n] = '0';
    }
    while (mag > 0) {
        n -= 1;
        const auto dgt = (mag % base) as i64;
        if (conv == 'X') { digits[n] = hexu[dgt]; } else { digits[n] = hex[dgt]; }
        mag = mag / base;
    }
    auto body = digits[n..];
    i64 zeros = 0;
    if (sp.prec > body.len) { zeros = sp.prec - body.len; }
    auto prefix = "";
    if (neg) {
        prefix = "-";
    } else if (base == 10 && sp.plus) {
        prefix = "+";
    } else if (base == 10 && sp.space) {
        prefix = " ";
    } else if (sp.alt && base == 16 && bits != 0) {
        if (conv == 'X') { prefix = "0X"; } else { prefix = "0x"; }
    } else if (sp.alt && base == 8 && zeros == 0) {
        prefix = "0";
    }
    return __emit(w, sp, prefix, body, zeros, sp.prec < 0);
}

!void __fmt_int(Writer* w, i64 v, str spec) {
    if (spec.len == 1 && spec[0] == 1) { return __fmt_raw(w, v as u64); }
    if (spec.len == 0) {
        u8[24] digits;
        auto n = 24;
        auto neg = false;
        auto mag = v as u64;
        if (v < 0) {
            neg = true;
            mag = 0 - mag;
        }
        if (mag == 0) {
            n -= 1;
            digits[n] = '0';
        }
        while (mag > 0) {
            n -= 1;
            digits[n] = '0' + (mag % 10) as u8;
            mag = mag / 10;
        }
        if (neg) {
            n -= 1;
            digits[n] = '-';
        }
        return w.write(digits[n..]);
    }
    return __fmt_num(w, v as u64, true, spec);
}

!void __fmt_uint(Writer* w, u64 v, str spec) {
    if (spec.len == 1 && spec[0] == 1) { return __fmt_raw(w, v); }
    if (spec.len == 0) {
        u8[24] digits;
        auto n = 24;
        auto mag = v;
        if (mag == 0) {
            n -= 1;
            digits[n] = '0';
        }
        while (mag > 0) {
            n -= 1;
            digits[n] = '0' + (mag % 10) as u8;
            mag = mag / 10;
        }
        return w.write(digits[n..]);
    }
    return __fmt_num(w, v, false, spec);
}

!void __fmt_float(Writer* w, f64 v, str spec) {
    if (spec.len == 1 && spec[0] == 1) { return __fmt_raw(w, bits_f64(v)); }
    if (v != v) { return w.write("nan"); }
    u8[48] f;
    u8[512] out;
    auto n = 0;
    f[n] = '%';
    n += 1;
    if (spec.len == 0) {
        f[n] = 'g';
        n += 1;
    } else {
        const auto sp = __spec(spec)?;
        for (auto c : spec) {
            if (is_alpha(c)) { break; }
            if (n >= 40) { return error.BadFormat; }
            f[n] = c;
            n += 1;
        }
        auto conv = sp.conv;
        if (conv == 0) { conv = 'f'; }
        if (str_find_byte("eEfFgGaA", conv) < 0) { return error.BadFormat; }
        f[n] = conv;
        n += 1;
    }
    f[n] = 0;
    const auto len = snprintf(out.ptr, 512, f.ptr, v);
    if (len < 0 || len >= 512) { return error.BadFormat; }
    return w.write(out[0..len as i64]);
}

!void __fmt_str(Writer* w, str s, str spec, bool quoted) {
    if (spec.len == 1 && spec[0] == 1) { __fmt_raw(w, s.len as u64)?; return w.write(s); }
    if (quoted) {
        w.write("\"")?;
        w.write(s)?;
        return w.write("\"");
    }
    if (spec.len == 0) { return w.write(s); }
    const auto sp = __spec(spec)?;
    if (sp.conv != 0) { return error.BadFormat; }
    auto body = s;
    if (sp.prec >= 0 && sp.prec < body.len) { body = body[0..sp.prec]; }
    return __emit(w, sp, "", body, 0, false);
}

!void __fmt_bool(Writer* w, bool b, str spec) {
    if (spec.len == 1 && spec[0] == 1) { if (b) { return __fmt_raw(w, 1); } return __fmt_raw(w, 0); }
    if (b) { return __fmt_str(w, "true", spec, false); }
    return __fmt_str(w, "false", spec, false);
}

!void __fmt_ptr(Writer* w, u64 v, str spec) {
    if (spec.len == 1 && spec[0] == 1) { return __fmt_raw(w, v); }
    if (v == 0) { return w.write("(nil)"); }
    w.write("0x")?;
    return __fmt_num(w, v, false, "x");
}

struct Cpu {
    static void cli() { asm("cli", "~\{memory\}"); }
    static void sti() { asm("sti", "~\{memory\}"); }
    static void halt() { asm("hlt", "~\{memory\}"); }
    static void pause() { asm("pause", "~\{memory\}"); }
    static void nop() { asm("nop", ""); }
    static void breakpoint() { asm("int3", ""); }
    static void fence() { asm("mfence", "~\{memory\}"); }
    static void load_fence() { asm("lfence", "~\{memory\}"); }
    static void store_fence() { asm("sfence", "~\{memory\}"); }
    static u64 rdtsc() { return asm<u64>("rdtsc; shlq $$32, %rdx; orq %rdx, %rax", "=\{rax\},~\{rdx\}"); }
    static u64 cr0() { return asm<u64>("mov %cr0, $0", "=r"); }
    static u64 cr2() { return asm<u64>("mov %cr2, $0", "=r"); }
    static u64 cr3() { return asm<u64>("mov %cr3, $0", "=r"); }
    static u64 cr4() { return asm<u64>("mov %cr4, $0", "=r"); }
    static void set_cr0(u64 v) { asm("mov $0, %cr0", "r,~\{memory\}", v); }
    static void set_cr3(u64 v) { asm("mov $0, %cr3", "r,~\{memory\}", v); }
    static void set_cr4(u64 v) { asm("mov $0, %cr4", "r,~\{memory\}", v); }
    static void load_idt(void* descriptor) { asm("lidt ($0)", "r,~\{memory\}", descriptor); }
    static void load_gdt(void* descriptor) { asm("lgdt ($0)", "r,~\{memory\}", descriptor); }
    static void invlpg(void* addr) { asm("invlpg ($0)", "r,~\{memory\}", addr); }
    static u64 rdmsr(u32 msr) { return asm<u64>("rdmsr; shlq $$32, %rdx; orq %rdx, %rax", "=\{rax\},\{ecx\},~\{rdx\}", msr); }
    static void wrmsr(u32 msr, u64 v) { asm("wrmsr", "\{ecx\},\{eax\},\{edx\},~\{memory\}", msr, v as u32, (v >> 32) as u32); }
}

struct Port {
    static u8 in8(u16 port) { return asm<u8>("inb %dx, %al", "=\{al\},\{dx\}", port); }
    static u16 in16(u16 port) { return asm<u16>("inw %dx, %ax", "=\{ax\},\{dx\}", port); }
    static u32 in32(u16 port) { return asm<u32>("inl %dx, %eax", "=\{eax\},\{dx\}", port); }
    static void out8(u16 port, u8 v) { asm("outb %al, %dx", "\{al\},\{dx\},~\{memory\}", v, port); }
    static void out16(u16 port, u16 v) { asm("outw %ax, %dx", "\{ax\},\{dx\},~\{memory\}", v, port); }
    static void out32(u16 port, u32 v) { asm("outl %eax, %dx", "\{eax\},\{dx\},~\{memory\}", v, port); }
}

struct Bits {
    static u64 mask(u64 hi, u64 lo) {
        if (hi >= 63) { return ~(0 as u64) << lo; }
        return (((1 as u64) << (hi + 1)) - 1) & (~(0 as u64) << lo);
    }
    static u64 bit(u64 n) { return (1 as u64) << n; }
    static u64 get(u64 v, u64 hi, u64 lo) { return (v & Bits::mask(hi, lo)) >> lo; }
    static u64 set(u64 v, u64 hi, u64 lo, u64 x) { return (v & ~Bits::mask(hi, lo)) | ((x << lo) & Bits::mask(hi, lo)); }
}

struct Atomic {
    static u32 fetch_add32(u32* p, u32 v) { return asm<u32>("lock xaddl $0, ($1)", "=r,r,0,~\{memory\}", p, v); }
    static u64 fetch_add64(u64* p, u64 v) { return asm<u64>("lock xaddq $0, ($1)", "=r,r,0,~\{memory\}", p, v); }
    static u8 fetch_add8(u8* p, u8 v) { return asm<u8>("lock xaddb $0, ($1)", "=r,r,0,~\{memory\}", p, v); }
    static u16 fetch_add16(u16* p, u16 v) { return asm<u16>("lock xaddw $0, ($1)", "=r,r,0,~\{memory\}", p, v); }
    static u8 swap8(u8* p, u8 v) { return asm<u8>("xchgb $0, ($1)", "=r,r,0,~\{memory\}", p, v); }
    static u16 swap16(u16* p, u16 v) { return asm<u16>("xchgw $0, ($1)", "=r,r,0,~\{memory\}", p, v); }
    static u8 cas8(u8* p, u8 expected, u8 desired) { return asm<u8>("lock cmpxchgb $2, ($1)", "=\{al\},r,r,0,~\{memory\}", p, desired, expected); }
    static u16 cas16(u16* p, u16 expected, u16 desired) { return asm<u16>("lock cmpxchgw $2, ($1)", "=\{ax\},r,r,0,~\{memory\}", p, desired, expected); }
    static u32 swap32(u32* p, u32 v) { return asm<u32>("xchgl $0, ($1)", "=r,r,0,~\{memory\}", p, v); }
    static u64 swap64(u64* p, u64 v) { return asm<u64>("xchgq $0, ($1)", "=r,r,0,~\{memory\}", p, v); }
    static u32 cas32(u32* p, u32 expected, u32 desired) { return asm<u32>("lock cmpxchgl $2, ($1)", "=\{ax\},r,r,0,~\{memory\}", p, desired, expected); }
    static u64 cas64(u64* p, u64 expected, u64 desired) { return asm<u64>("lock cmpxchgq $2, ($1)", "=\{rax\},r,r,0,~\{memory\}", p, desired, expected); }
}

struct Spinlock {
    volatile u32 state;

    void lock() {
        while (Atomic::swap32(&state as *u32, 1) != 0) { Cpu::pause(); }
    }

    bool try_lock() { return Atomic::swap32(&state as *u32, 1) == 0; }

    void unlock() { Atomic::swap32(&state as *u32, 0); }
}

!i64 __sys_result(i64 r) {
    if (r >= 0) { return r; }
    match -r {
        1, 13 => return error.PermissionDenied;
        2 => return error.NotFound;
        3 => return error.NoProcess;
        5 => return error.IoError;
        12 => return error.OutOfMemory;
        14 => return error.BadAddress;
        17 => return error.AlreadyExists;
        20 => return error.NotADirectory;
        21 => return error.IsADirectory;
        22 => return error.InvalidArgument;
        24 => return error.TooManyOpenFiles;
        28 => return error.NoSpaceLeft;
        32 => return error.BrokenPipe;
        39 => return error.DirectoryNotEmpty;
        104 => return error.ConnectionReset;
        110 => return error.TimedOut;
        111 => return error.ConnectionRefused;
        113 => return error.HostUnreachable;
        _ => return error.SystemCall;
    }
    return error.SystemCall;
}

struct Sys {
    static i64 raw(i64 nr, i64 a1, i64 a2, i64 a3, i64 a4, i64 a5, i64 a6) {
        return vrt_syscall(nr, a1, a2, a3, a4, a5, a6);
    }
    static !i64 call(i64 nr, i64 a1, i64 a2, i64 a3, i64 a4, i64 a5, i64 a6) { return __sys_result(Sys::raw(nr, a1, a2, a3, a4, a5, a6)); }
    static !i64 read(i64 fd, void* buf, u64 n) { return Sys::call(0, fd, buf as i64, n as i64, 0, 0, 0); }
    static !i64 write(i64 fd, void* buf, u64 n) { return Sys::call(1, fd, buf as i64, n as i64, 0, 0, 0); }
    static !i64 open(u8* path, i64 flags, i64 mode) { return Sys::call(2, path as i64, flags, mode, 0, 0, 0); }
    static !i64 close(i64 fd) { return Sys::call(3, fd, 0, 0, 0, 0, 0); }
    static !i64 pread(i64 fd, void* buf, u64 n, i64 off) { return Sys::call(17, fd, buf as i64, n as i64, off, 0, 0); }
    static !i64 pwrite(i64 fd, void* buf, u64 n, i64 off) { return Sys::call(18, fd, buf as i64, n as i64, off, 0, 0); }
    static !i64 mmap(void* addr, u64 len, i64 prot, i64 flags, i64 fd, i64 off) { return Sys::call(9, addr as i64, len as i64, prot, flags, fd, off); }
    static !i64 munmap(void* addr, u64 len) { return Sys::call(11, addr as i64, len as i64, 0, 0, 0, 0); }
    static !i64 ioctl(i64 fd, u64 req, i64 arg) { return Sys::call(16, fd, req as i64, arg, 0, 0, 0); }
    static !str slurp(Allocator a, str path) {
        u8[256] pb;
        const auto p = to_cstr(pb[..], path)?;
        const auto fd = Sys::open(p, 0, 0)?;
        defer _ = Sys::close(fd);
        auto out = List<u8>::init(a);
        errdefer out.deinit();
        u8[4096] chunk;
        while (true) {
            const auto n = Sys::read(fd, &chunk[0], 4096)?;
            if (n == 0) { break; }
            out.append(chunk[0..n])?;
        }
        return out.take();
    }
    static !u64 file_size(str path) {
        u8[256] pb;
        const auto p = to_cstr(pb[..], path)?;
        u64[18] st;
        _ = Sys::call(4, p as i64, &st[0] as i64, 0, 0, 0, 0)?;
        return st[6];
    }
    static i64 getpid() { return Sys::raw(39, 0, 0, 0, 0, 0, 0); }
    static void exit(i64 code) { _ = Sys::raw(231, code, 0, 0, 0, 0, 0); }
}

struct Iovec { void* base; u64 len; }

struct Mapping {
    u8* base;
    u64 len;

    static !Mapping file(str path, u64 offset, u64 len, bool write) {
        u8[256] pb;
        const auto p = to_cstr(pb[..], path)?;
        auto flags = 0x101000;
        auto prot = 1;
        if (write) {
            flags |= 2;
            prot = 3;
        }
        const auto fd = Sys::open(p, flags, 0)?;
        defer _ = Sys::close(fd);
        const auto a = Sys::mmap(null, len, prot, 1, fd, offset as i64)?;
        return Mapping{ .base = a as *u8, .len = len };
    }

    static !Mapping anonymous(u64 len) {
        const auto a = Sys::mmap(null, len, 3, 0x22, -1, 0)?;
        return Mapping{ .base = a as *u8, .len = len };
    }

    !void unmap() {
        _ = Sys::munmap(this->base, this->len)?;
        this->base = null;
        this->len = 0;
    }

    !void check(u64 off, u64 size) {
        if (off + size > this->len || off + size < off) { return error.OutOfRange; }
    }

    !u8 read8(u64 off) {
        this->check(off, 1)?;
        volatile u8* p = this->base + off;
        return *p;
    }
    !u16 read16(u64 off) {
        this->check(off, 2)?;
        volatile u16* p = (this->base + off) as *u16;
        return *p;
    }
    !u32 read32(u64 off) {
        this->check(off, 4)?;
        volatile u32* p = (this->base + off) as *u32;
        return *p;
    }
    !u64 read64(u64 off) {
        this->check(off, 8)?;
        volatile u64* p = (this->base + off) as *u64;
        return *p;
    }
    !void write8(u64 off, u8 v) {
        this->check(off, 1)?;
        volatile u8* p = this->base + off;
        *p = v;
    }
    !void write16(u64 off, u16 v) {
        this->check(off, 2)?;
        volatile u16* p = (this->base + off) as *u16;
        *p = v;
    }
    !void write32(u64 off, u32 v) {
        this->check(off, 4)?;
        volatile u32* p = (this->base + off) as *u32;
        *p = v;
    }
    !void write64(u64 off, u64 v) {
        this->check(off, 8)?;
        volatile u64* p = (this->base + off) as *u64;
        *p = v;
    }
    !u64 read_into(u64 off, u8[] out) {
        this->check(off, out.len as u64)?;
        volatile u8* src = this->base + off;
        for (auto i : 0..out.len) { out[i] = src[i]; }
        return out.len as u64;
    }
}

struct Proc {
    static !u64 read(i64 pid, u64 addr, u8[] out) {
        auto local = Iovec{ .base = out.ptr, .len = out.len as u64 };
        auto remote = Iovec{ .base = addr as *void, .len = out.len as u64 };
        const auto n = Sys::call(310, pid, &local as i64, 1, &remote as i64, 1, 0)?;
        return n as u64;
    }

    static !u64 write(i64 pid, u64 addr, u8[] data) {
        auto local = Iovec{ .base = data.ptr, .len = data.len as u64 };
        auto remote = Iovec{ .base = addr as *void, .len = data.len as u64 };
        const auto n = Sys::call(311, pid, &local as i64, 1, &remote as i64, 1, 0)?;
        return n as u64;
    }

    static !str maps(Allocator a, i64 pid) {
        u8[64] pb;
        const auto path = bprint(pb[..], "/proc/{pid}/maps")?;
        return Sys::slurp(a, path);
    }
}

struct Msr {
    static !u64 read(i64 cpu, u32 msr) {
        u8[64] pb;
        const auto path = bprint(pb[..], "/dev/cpu/{cpu}/msr")?;
        const auto p = to_cstr(pb[..], path)?;
        const auto fd = Sys::open(p, 0, 0)?;
        defer _ = Sys::close(fd);
        u64 v = 0;
        const auto n = Sys::pread(fd, &v, 8, msr as i64)?;
        if (n != 8) { return error.IoError; }
        return v;
    }
}

struct Pci {
    static !Mapping bar(str device, i64 n, bool write) {
        u8[96] pb;
        const auto path = bprint(pb[..], "/sys/bus/pci/devices/{device}/resource{n}")?;
        const auto len = Sys::file_size(path)?;
        return Mapping::file(path, 0, len, write);
    }

    static !u32 config32(str device, u64 off) {
        u8[96] pb;
        const auto path = bprint(pb[..], "/sys/bus/pci/devices/{device}/config")?;
        const auto p = to_cstr(pb[..], path)?;
        const auto fd = Sys::open(p, 0, 0)?;
        defer _ = Sys::close(fd);
        u32 v = 0;
        const auto n = Sys::pread(fd, &v, 4, off as i64)?;
        if (n != 4) { return error.IoError; }
        return v;
    }

    static !List<str> list(Allocator a) {
        auto out = List<str>::init(a);
        const auto fd = Sys::open("/sys/bus/pci/devices\0".ptr, 0x10000, 0)?;
        defer _ = Sys::close(fd);
        u8[4096] buf;
        while (true) {
            const auto n = Sys::call(217, fd, &buf[0] as i64, 4096, 0, 0, 0)?;
            if (n == 0) { break; }
            auto pos = 0;
            while (pos < n) {
                const auto reclen = (buf[pos + 16] as i64) | ((buf[pos + 17] as i64) << 8);
                const auto name = cstr(&buf[pos + 19]);
                if (name[0] != '.') { out.push(a.dup(name)?)?; }
                pos += reclen;
            }
        }
        return out;
    }
}

// ================================================================ strings (more)
// Splitting and searching return slices of the input: nothing is copied.
// Functions that build a new string take an Allocator.

bool is_space(u8 c) { return __is_space(c); }
bool is_lower(u8 c) { return c >= 'a' && c <= 'z'; }
u8 to_lower(u8 c) { if (is_upper(c)) { return c + 32; } return c; }
u8 to_upper(u8 c) { if (is_lower(c)) { return c - 32; } return c; }

bool str_contains(str s, str needle) { return str_find(s, needle) >= 0; }

/// index of the last occurrence of `needle`, or -1
i64 str_rfind(str s, str needle) {
    if (needle.len > s.len) { return -1; }
    auto i = s.len - needle.len;
    while (i >= 0) {
        if (s[i..i + needle.len] == needle) { return i; }
        i -= 1;
    }
    return -1;
}

/// non-overlapping occurrences of `needle` (0 for an empty needle)
i64 str_count(str s, str needle) {
    if (needle.len == 0) { return 0; }
    auto n = 0;
    auto i = 0;
    while (i + needle.len <= s.len) {
        if (s[i..i + needle.len] == needle) { n += 1; i += needle.len; } else { i += 1; }
    }
    return n;
}

str str_trim_start(str s) {
    auto a = 0;
    while (a < s.len && __is_space(s[a])) { a += 1; }
    return s[a..];
}

str str_trim_end(str s) {
    auto b = s.len;
    while (b > 0 && __is_space(s[b - 1])) { b -= 1; }
    return s[0..b];
}

/// `s` without `prefix` when it starts with it, otherwise `s` unchanged
str str_strip_prefix(str s, str prefix) {
    if (str_starts_with(s, prefix)) { return s[prefix.len..]; }
    return s;
}

str str_strip_suffix(str s, str suffix) {
    if (str_ends_with(s, suffix)) { return s[0..s.len - suffix.len]; }
    return s;
}

bool str_eq_ignore_case(str a, str b) {
    if (a.len != b.len) { return false; }
    for (auto [i, c] : a) { if (to_lower(c) != to_lower(b[i])) { return false; } }
    return true;
}

/// -1, 0 or 1, byte order (for sort_by)
i64 str_cmp(str a, str b) {
    const auto n = min(a.len, b.len);
    for (auto i : 0..n) {
        if (a[i] < b[i]) { return -1; }
        if (a[i] > b[i]) { return 1; }
    }
    if (a.len < b.len) { return -1; }
    if (a.len > b.len) { return 1; }
    return 0;
}

bool str_less(str a, str b) { return str_cmp(a, b) < 0; }

/// Iterates over the parts of a string between separators:
///   auto it = str_split("a,b,,c", ",");
///   while (it.next()) { println(it.part); }     // a, b, "", c
struct Split {
    str rest;
    str sep;
    str part;
    bool done;
    bool ws;       // split on runs of whitespace, skip empty parts

    bool next() {
        if (this->ws) {
            auto i = 0;
            while (i < this->rest.len && __is_space(this->rest[i])) { i += 1; }
            if (i == this->rest.len) { this->done = true; return false; }
            auto j = i;
            while (j < this->rest.len && !__is_space(this->rest[j])) { j += 1; }
            this->part = this->rest[i..j];
            this->rest = this->rest[j..];
            return true;
        }
        if (this->done) { return false; }
        const auto i = str_find(this->rest, this->sep);
        if (i < 0 || this->sep.len == 0) {
            this->part = this->rest;
            this->done = true;
            return true;
        }
        this->part = this->rest[0..i];
        this->rest = this->rest[i + this->sep.len..];
        return true;
    }
}

Split str_split(str s, str sep) { return Split{ .rest = s, .sep = sep }; }

/// words separated by any amount of whitespace
Split str_fields(str s) { return Split{ .rest = s, .ws = true }; }

/// Iterates over lines; a trailing "\r" is removed and a final empty line is skipped.
struct Lines {
    str rest;
    str line;

    bool next() {
        if (this->rest.len == 0) { return false; }
        auto i = str_find_byte(this->rest, '\n');
        if (i < 0) {
            this->line = this->rest;
            this->rest = this->rest[this->rest.len..];
        } else {
            this->line = this->rest[0..i];
            this->rest = this->rest[i + 1..];
        }
        if (this->line.len > 0 && this->line[this->line.len - 1] == '\r') { this->line = this->line[0..this->line.len - 1]; }
        return true;
    }
}

Lines str_lines(str s) { return Lines{ .rest = s }; }

/// all the parts at once; the parts point into `s`
!List<str> str_split_all(Allocator a, str s, str sep) {
    auto out = List<str>::init(a);
    errdefer out.deinit();
    auto it = str_split(s, sep);
    while (it.next()) { out.push(it.part)?; }
    return out;
}

!str str_join(Allocator a, str[] parts, str sep) {
    auto n = 0;
    for (auto [i, p] : parts) {
        n += p.len;
        if (i > 0) { n += sep.len; }
    }
    auto out = a.alloc<u8>(n)?;
    auto o = 0;
    for (auto [i, p] : parts) {
        if (i > 0 && sep.len > 0) { memcpy(out.ptr + o, sep.ptr, sep.len as u64); o += sep.len; }
        if (p.len > 0) { memcpy(out.ptr + o, p.ptr, p.len as u64); o += p.len; }
    }
    return out;
}

!str str_concat(Allocator a, str[] parts) { return str_join(a, parts, ""); }

/// every occurrence of `from` replaced by `to` (a new string)
!str str_replace(Allocator a, str s, str from, str to) {
    auto out = List<u8>::init(a);
    errdefer out.deinit();
    if (from.len == 0) {
        out.append(s)?;
        return out.take();
    }
    auto i = 0;
    while (i < s.len) {
        if (i + from.len <= s.len && s[i..i + from.len] == from) {
            out.append(to)?;
            i += from.len;
        } else {
            out.push(s[i])?;
            i += 1;
        }
    }
    return out.take();
}

!str str_repeat(Allocator a, str s, i64 n) {
    auto out = a.alloc<u8>(s.len * max(n, 0))?;
    for (auto k : 0..n) { if (s.len > 0) { memcpy(out.ptr + k * s.len, s.ptr, s.len as u64); } }
    return out;
}

/// ASCII letters converted; other bytes (UTF-8 included) are kept
!str str_to_lower(Allocator a, str s) {
    auto out = a.alloc<u8>(s.len)?;
    for (auto [i, c] : s) { out[i] = to_lower(c); }
    return out;
}

!str str_to_upper(Allocator a, str s) {
    auto out = a.alloc<u8>(s.len)?;
    for (auto [i, c] : s) { out[i] = to_upper(c); }
    return out;
}

// ---- UTF-8 ----

struct Rune { u32 code; i64 size; }

/// decodes the code point that starts at byte `i`
!Rune utf8_decode(str s, i64 i) {
    if (i < 0 || i >= s.len) { return error.OutOfRange; }
    const auto b0 = s[i] as u32;
    if (b0 < 0x80) { return Rune{ .code = b0, .size = 1 }; }
    auto n = 0;
    auto cp = 0 as u32;
    auto lo = 0 as u32;
    if ((b0 & 0xe0) == 0xc0) { n = 2; cp = b0 & 0x1f; lo = 0x80; }
    else if ((b0 & 0xf0) == 0xe0) { n = 3; cp = b0 & 0x0f; lo = 0x800; }
    else if ((b0 & 0xf8) == 0xf0) { n = 4; cp = b0 & 0x07; lo = 0x10000; }
    else { return error.InvalidUtf8; }
    if (i + n > s.len) { return error.InvalidUtf8; }
    for (auto k : 1..n) {
        const auto b = s[i + k] as u32;
        if ((b & 0xc0) != 0x80) { return error.InvalidUtf8; }
        cp = (cp << 6) | (b & 0x3f);
    }
    if (cp < lo || cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff)) { return error.InvalidUtf8; }
    return Rune{ .code = cp, .size = n };
}

/// writes the UTF-8 bytes of `cp` into `buf` (at least 4 bytes) and returns them
!str utf8_encode(u8[] buf, u32 cp) {
    if (buf.len < 4) { return error.NoSpace; }
    if (cp < 0x80) { buf[0] = cp as u8; return buf[0..1]; }
    if (cp < 0x800) {
        buf[0] = (0xc0 | (cp >> 6)) as u8;
        buf[1] = (0x80 | (cp & 0x3f)) as u8;
        return buf[0..2];
    }
    if (cp >= 0xd800 && cp <= 0xdfff) { return error.InvalidUtf8; }
    if (cp < 0x10000) {
        buf[0] = (0xe0 | (cp >> 12)) as u8;
        buf[1] = (0x80 | ((cp >> 6) & 0x3f)) as u8;
        buf[2] = (0x80 | (cp & 0x3f)) as u8;
        return buf[0..3];
    }
    if (cp > 0x10ffff) { return error.InvalidUtf8; }
    buf[0] = (0xf0 | (cp >> 18)) as u8;
    buf[1] = (0x80 | ((cp >> 12) & 0x3f)) as u8;
    buf[2] = (0x80 | ((cp >> 6) & 0x3f)) as u8;
    buf[3] = (0x80 | (cp & 0x3f)) as u8;
    return buf[0..4];
}

bool utf8_valid(str s) {
    auto i = 0;
    while (i < s.len) {
        const auto r = utf8_decode(s, i) catch { return false; };
        i += r.size;
    }
    return true;
}

/// the number of code points; an invalid byte counts as one
i64 utf8_len(str s) {
    auto n = 0;
    auto i = 0;
    while (i < s.len) {
        const auto r = utf8_decode(s, i) catch Rune{ .code = 0xfffd, .size = 1 };
        i += r.size;
        n += 1;
    }
    return n;
}

/// Iterates over code points; an invalid byte yields U+FFFD:
///   auto it = utf8_runes("привет");
///   while (it.next()) { println(it.code, it.at); }
struct Runes {
    str s;
    i64 i;
    i64 at;        // byte offset of the current code point
    u32 code;

    bool next() {
        if (this->i >= this->s.len) { return false; }
        const auto r = utf8_decode(this->s, this->i) catch Rune{ .code = 0xfffd, .size = 1 };
        this->at = this->i;
        this->code = r.code;
        this->i += r.size;
        return true;
    }
}

Runes utf8_runes(str s) { return Runes{ .s = s }; }

// ================================================================ sorting with a comparison

/// sorts with `less(a, b)`; stable (insertion merges), O(n log n)
template<T> !void sort_by(Allocator a, T[] s, fn(T, T) -> bool less) {
    if (s.len < 2) { return; }
    auto tmp = a.alloc<T>(s.len)?;
    defer a.free(tmp);
    __merge_sort(s, tmp, less);
}

template<T> void __merge_sort(T[] s, T[] tmp, fn(T, T) -> bool less) {
    const auto n = s.len;
    if (n <= 16) {
        for (auto i : 1..n) {
            const auto x = s[i];
            auto j = i - 1;
            while (j >= 0 && less(x, s[j])) {
                s[j + 1] = s[j];
                j -= 1;
            }
            s[j + 1] = x;
        }
        return;
    }
    const auto mid = n / 2;
    __merge_sort(s[0..mid], tmp[0..mid], less);
    __merge_sort(s[mid..], tmp[mid..n], less);
    auto i = 0;
    auto j = mid;
    auto k = 0;
    while (i < mid && j < n) {
        if (less(s[j], s[i])) { tmp[k] = s[j]; j += 1; } else { tmp[k] = s[i]; i += 1; }
        k += 1;
    }
    while (i < mid) { tmp[k] = s[i]; i += 1; k += 1; }
    while (j < n) { tmp[k] = s[j]; j += 1; k += 1; }
    for (auto x : 0..n) { s[x] = tmp[x]; }
}

// ================================================================ hashing any value

struct FnvHasher { u64 h; }

!void __hash_write(void* ctx, str s) {
    const auto hs = ctx as *FnvHasher;
    auto h = hs.h;
    if (s.len == 8) {
        h = (h ^ *(s.ptr as *u64)) *% 0x100000001b3;
        h = h ^ (h >> 29);
    } else {
        for (auto c : s) { h = (h ^ (c as u64)) *% 1099511628211; }
    }
    hs.h = h;
}

/// the "raw" format used by hash_of: the 8 bytes of a scalar instead of its digits
!void __fmt_raw(Writer* w, u64 v) {
    auto x = v;
    return w.write((&x as *u8)[0..8]);
}

/// A hash of the printed form of the arguments, so it works for every printable type:
/// ints, strings, enums, and structs compared field by field.
u64 hash_of(Fmt f) {
    auto hs = FnvHasher{ .h = 14695981039346656037 };
    auto w = Writer{ .ctx = &hs, .write_fn = __hash_write };
    for (auto i : 0..f.pieces.len) {
        const auto pc = &f.pieces[i];
        w.write(pc.lit) catch |e| {};
        pc.thunk(&w, pc.value, "\x01", 0) catch |e| {};
    }
    w.write(f.tail) catch |e| {};
    // final mix (splitmix64) so that close keys spread over the table
    auto x = hs.h;
    x = (x ^ (x >> 30)) *% 0xbf58476d1ce4e5b9;
    x = (x ^ (x >> 27)) *% 0x94d049bb133111eb;
    return x ^ (x >> 31);
}

// ================================================================ HashMap<K, V>, HashSet<T>
// Any key type that can be printed and compared with `==`: integers, str, enums, structs
// (a struct key needs `operator==` that compares all fields). Keys are not copied.

struct HashEntry<K, V> { K key; V value; u64 hash; bool used; }

struct HashMap<K, V> {
    HashEntry<K, V>[] entries;
    i64 len;
    Allocator a;

    static Self init(Allocator a) { return Self{ .a = a }; }

    void deinit() move {
        this->a.free(this->entries);
        this->entries = this->entries[0..0];
        this->len = 0;
    }

    i64 __slot(K key, u64 h) {
        const auto cap = this->entries.len;
        const auto mask = (cap - 1) as u64;
        auto i = (h & mask) as i64;
        while (true) {
            const auto e = &this->entries[i];
            if (!e.used) { return i; }
            if (e.hash == h && e.key == key) { return i; }
            i = ((i + 1) as u64 & mask) as i64;
        }
        return -1;
    }

    !void __grow() {
        const auto old = this->entries;
        auto nc = old.len * 2;
        if (nc < 16) { nc = 16; }
        this->entries = this->a.alloc<HashEntry<K, V>>(nc)?;
        for (auto e : old) {
            if (e.used) { this->entries[this->__slot(e.key, e.hash)] = e; }
        }
        this->a.free(old);
    }

    /// inserts or replaces
    !void put(K key, V value) invalidates {
        if ((this->len + 1) * 4 > this->entries.len * 3) { this->__grow()?; }
        const auto h = hash_of(key);
        const auto e = &this->entries[this->__slot(key, h)];
        if (!e.used) { this->len += 1; }
        *e = HashEntry<K, V>{ .key = key, .value = value, .hash = h, .used = true };
    }

    /// a copy of the value, or error.NotFound
    !V get(K key) {
        const auto p = this->get_ptr(key);
        if (p == null) { return error.NotFound; }
        return *p;
    }

    V get_or(K key, V d) {
        const auto p = this->get_ptr(key);
        if (p == null) { return d; }
        return *p;
    }

    /// a pointer to the stored value for in-place changes, or null; valid until the next put
    V* get_ptr(K key) borrows {
        if (this->len == 0) { return null; }
        const auto e = &this->entries[this->__slot(key, hash_of(key))];
        if (!e.used) { return null; }
        return &e.value;
    }

    bool has(K key) { return this->get_ptr(key) != null; }

    /// removes the key; false when it was not there
    bool remove(K key) invalidates {
        if (this->len == 0) { return false; }
        const auto cap = this->entries.len;
        auto i = this->__slot(key, hash_of(key));
        if (!this->entries[i].used) { return false; }
        auto j = i;
        while (true) {
            j = (j + 1) & (cap - 1);
            if (!this->entries[j].used) { break; }
            const auto home = (this->entries[j].hash & ((cap - 1) as u64)) as i64;
            if (!__probe_between(i, home, j)) {
                this->entries[i] = this->entries[j];
                i = j;
            }
        }
        this->entries[i] = HashEntry<K, V>{};
        this->len -= 1;
        return true;
    }

    void clear() {
        for (auto i : 0..this->entries.len) { this->entries[i] = HashEntry<K, V>{}; }
        this->len = 0;
    }

    /// auto it = m.iter(); while (it.next()) { println(it.key(), it.value()); }
    HashIter<K, V> iter() borrows { return HashIter<K, V>{ .entries = this->entries, .i = -1 }; }

    /// the keys in a new list (in table order)
    !List<K> keys(Allocator a) {
        auto out = List<K>::init(a);
        errdefer out.deinit();
        out.reserve(this->len)?;
        for (auto e : this->entries) { if (e.used) { out.push(e.key)?; } }
        return out;
    }
}

struct HashIter<K, V> {
    HashEntry<K, V>[] entries;
    i64 i;

    bool next() {
        this->i += 1;
        while (this->i < this->entries.len && !this->entries[this->i].used) { this->i += 1; }
        return this->i < this->entries.len;
    }
    K key() { return this->entries[this->i].key; }
    V value() { return this->entries[this->i].value; }
    V* value_ptr() { return &this->entries[this->i].value; }
}

struct HashSet<T> {
    HashMap<T, bool> m;

    static Self init(Allocator a) { return Self{ .m = HashMap<T, bool>::init(a) }; }
    void deinit() move { this->m.deinit(); }
    /// true when the value was new
    !bool add(T v) {
        if (this->m.has(v)) { return false; }
        this->m.put(v, true)?;
        return true;
    }
    bool has(T v) { return this->m.has(v); }
    bool remove(T v) { return this->m.remove(v); }
    i64 len() { return this->m.len; }
    void clear() { this->m.clear(); }
    HashIter<T, bool> iter() borrows { return this->m.iter(); }
    !List<T> items(Allocator a) { return this->m.keys(a); }
}

// ================================================================ DebugAllocator
// An allocator for finding memory bugs. Every block gets its own pages with an inaccessible
// page right after it, and freed blocks become inaccessible instead of being reused:
//   - reading or writing past the end of a block, or after free, stops the program with a
//     message that names the block (through the crash handler);
//   - double free, freeing a foreign pointer and freeing with the wrong size panic;
//   - deinit() lists the blocks that were never freed and returns error.MemoryLeak.
// Slow and memory hungry (at least 8 KiB per block): use it in tests and debug builds.
//
//   auto dbg = DebugAllocator::init();
//   const auto a = dbg.allocator();
//   ... use a ...
//   dbg.deinit()?;

struct DbgBlock { u64 base; u64 map_len; u64 user; u64 size; i64 id; bool freed; }

DebugAllocator* __dbg_list = null;

struct DebugAllocator {
    HashMap<u64, DbgBlock> blocks;
    i64 next_id;
    i64 live;
    u64 live_bytes;
    u64 peak_bytes;
    i64 fail_after;       // < 0: never fail; n: the allocation after n more succeeds returns null
    i64 trap_id;          // > 0: stop in the debugger (int3) when block #trap_id is allocated
    DebugAllocator* next_dbg;
    bool registered;

    static Self init() {
        return Self{ .blocks = HashMap<u64, DbgBlock>::init(c_allocator()), .fail_after = -1 };
    }

    Allocator allocator() {
        if (!this->registered) {
            this->next_dbg = __dbg_list;
            __dbg_list = this;
            this->registered = true;
        }
        return Allocator{ .ctx = this, .alloc_fn = __dbg_alloc, .free_fn = __dbg_free };
    }

    /// makes the allocation after `n` more successful ones return out-of-memory
    void fail_after_n(i64 n) { this->fail_after = n; }

    !void deinit() move {
        auto leaks = 0;
        auto it = this->blocks.iter();
        while (it.next()) {
            const auto b = it.value();
            if (!b.freed) {
                leaks += 1;
                if (leaks <= 20) { eprintln("leak: block #{b.id}, {b.size} bytes at 0x{b.user:x}"); }
            }
            _ = Sys::munmap(b.base as *void, b.map_len) catch 0;
        }
        if (leaks > 20) { eprintln("... and {leaks - 20} more"); }
        if (leaks > 0) { eprintln("DebugAllocator: {leaks} block(s) leaked, {this->live_bytes} bytes (set trap_id to a block number to stop in gdb where it is allocated)"); }
        this->blocks.deinit();
        if (this->registered) {
            if (__dbg_list == this) {
                __dbg_list = this->next_dbg;
            } else {
                auto p = __dbg_list;
                while (p != null && p.next_dbg != this) { p = p.next_dbg; }
                if (p != null) { p.next_dbg = this->next_dbg; }
            }
            this->registered = false;
        }
        if (leaks > 0) { return error.MemoryLeak; }
    }
}

void* __dbg_alloc(void* ctx, u64 n, u64 align) {
    const auto d = ctx as *DebugAllocator;
    if (d.fail_after == 0) { return null; }
    if (d.fail_after > 0) { d.fail_after -= 1; }
    const auto al = max(align, 1);
    const auto rounded = (n + al - 1) / al * al;
    u64 pg = 4096;
    const auto sc = vrt_sysconf(30);
    if (sc > 0) { pg = sc as u64; }
    const auto pages = (rounded + pg - 1) / pg + 1;
    const auto len = pages * pg;
    const auto base = Sys::mmap(null, len, 3, 0x22, -1, 0) catch { return null; };
    const auto guard = (base as u64) + (pages - 1) * pg;
    _ = Sys::call(10, guard as i64, pg as i64, 0, 0, 0, 0) catch 0;
    const auto user = guard - rounded;
    d.next_id += 1;
    const auto blk = DbgBlock{ .base = base as u64, .map_len = len, .user = user, .size = n, .id = d.next_id };
    d.blocks.put(user, blk) catch {
        _ = Sys::munmap(base as *void, len) catch 0;
        return null;
    };
    d.live += 1;
    d.live_bytes += n;
    d.peak_bytes = max(d.peak_bytes, d.live_bytes);
    if (d.trap_id > 0 && d.next_id == d.trap_id) { vrt_breakpoint(); }
    return user as *void;
}

void __dbg_free(void* ctx, void* p, u64 n) {
    const auto d = ctx as *DebugAllocator;
    const auto b = d.blocks.get_ptr(p as u64);
    if (b == null) { panic("DebugAllocator: free of {p} which this allocator never handed out"); }
    if (b.freed) { panic("DebugAllocator: double free of block #{b.id} ({b.size} bytes)"); }
    if (n != b.size) { panic("DebugAllocator: block #{b.id} has {b.size} bytes but was freed with size {n}"); }
    _ = Sys::call(10, b.base as i64, b.map_len as i64, 0, 0, 0, 0) catch 0;
    b.freed = true;
    d.live -= 1;
    d.live_bytes -= b.size;
}

/// what the debug allocators know about an address (for the crash handler)
!str __dbg_describe(u8[] buf, u64 addr) {
    auto d = __dbg_list;
    while (d != null) {
        auto it = d.blocks.iter();
        while (it.next()) {
            const auto b = it.value();
            if (addr >= b.base && addr < b.base + b.map_len) {
                if (b.freed) { return bprint(buf, "use after free: block #{b.id} ({b.size} bytes) was already freed"); }
                if (addr >= b.user + b.size) { return bprint(buf, "out of bounds: {addr - b.user - b.size} byte(s) past the end of block #{b.id} ({b.size} bytes)"); }
                return bprint(buf, "inside block #{b.id} ({b.size} bytes)");
            }
        }
        d = d.next_dbg;
    }
    return "";
}

// ================================================================ crash handler
// __rt_init is called by main before anything else (not with --freestanding). It installs a
// handler that turns SIGSEGV, SIGBUS, SIGFPE and SIGILL into a readable message with the cause
// and a backtrace. Set ZARK_CRASH_HANDLER=0 to keep the default behavior (core dumps).

struct DlInfo { u8* fname; void* fbase; u8* sname; void* saddr; }

extern void vrt_crash_install(fn(i32, i64, u64, u64, u64, u64) f);
extern i32 vrt_backtrace(void** buf, i32 n);
extern i32 vrt_os();
extern i64 vrt_exe_path(u8* buf, u64 n);
extern i32 dladdr(void* addr, DlInfo* info);
extern i32 dup2(i32 a, i32 b);

void __rt_init() {
    const auto e = getenv("ZARK_CRASH_HANDLER");
    if (e != null && cstr(e) == "0") { return; }
    vrt_crash_install(__crash_handler);
}

void __crash_write(str s) {
    auto rest = s;
    while (rest.len > 0) {
        const auto n = Sys::write(2, rest.ptr, rest.len as u64) catch 0;
        if (n <= 0) { return; }
        rest = rest[n..];
    }
}

void __crash_handler(i32 sig, i64 code, u64 addr, u64 rip, u64 rsp, u64 bp) {
    u8[512] line;
    u8[256] extra;
    _ = fflush(null);
    auto what = "crash";
    auto why = "";
    match sig {
        11 => {
            what = "segmentation fault";
            if (addr < 4096) { why = "null pointer dereference"; }
            else if (addr < rsp + 4096 && rsp - addr < 1048576) { why = "stack overflow (endless recursion?)"; }
        }
        7 => what = "bus error";
        8 => {
            what = "arithmetic error";
            if (code == 1) { why = "integer division by zero"; }
            if (code == 2) { why = "integer overflow"; }
        }
        4 => what = "illegal instruction";
    }
    const auto dbg = __dbg_describe(extra[..], addr) catch "";
    if (dbg.len > 0) { why = dbg; }
    if (why.len > 0) {
        __crash_write(bprint(line[..], "\nfatal: {what}: {why} (address 0x{addr:x})\n") catch "\nfatal: crash\n");
    } else {
        __crash_write(bprint(line[..], "\nfatal: {what} at address 0x{addr:x}\n") catch "\nfatal: crash\n");
    }

    // backtrace: the faulting instruction, then the callers the unwinder can find
    void*[48] frames;
    frames[0] = rip as *void;
    auto n = 1;
    void*[48] raw;
    const auto got = vrt_backtrace(&raw[0], 48);
    auto started = false;
    for (auto i : 0..got as i64) {
        if (raw[i] as u64 == rip) { started = true; continue; }
        if (started && n < 48) { frames[n] = raw[i]; n += 1; }
    }
    if (n == 1) {
        // no unwind tables (our own backend): follow the frame-pointer chain while it stays on the stack
        auto fp = bp;
        while (n < 48 && fp > rsp && fp < rsp + 67108864 && (fp & 7) == 0) {
            const auto ret = *((fp + 8) as *u64);
            if (ret < 4096) { break; }
            frames[n] = ret as *void;
            n += 1;
            const auto next = *(fp as *u64);
            if (next <= fp) { break; }
            fp = next;
        }
    }
    DlInfo self;
    auto fp = __rt_init;
    _ = dladdr(*(&fp as **void), &self);
    u8[2048] args;
    auto ao = 0;
    u8*[56] argv;
    auto ac = 0;
    u8[1024] exe;
    const auto el = vrt_exe_path(&exe[0], 1023);
    if (el <= 0) { return; }
    exe[el] = 0;
    for (auto a : ["addr2line", "-f", "-C", "-i", "-p", "-e"]) {
        argv[ac] = a.ptr;
        ac += 1;
    }
    argv[ac] = &exe[0];
    ac += 1;
    __crash_write("backtrace:\n");
    for (auto i : 0..n) {
        const auto pc = frames[i] as u64;
        DlInfo di;
        auto off = pc;
        auto file = "?";
        if (dladdr(frames[i], &di) != 0) {
            off = pc - (di.fbase as u64);
            if (di.fname != null) { file = cstr(di.fname); }
        }
        __crash_write(bprint(line[..], "  #{i} 0x{off:x} in {file}\n") catch "");
        if (di.fbase == self.fbase && ac < 55) {
            auto o = off;
            if (*((di.fbase as u64 + 16) as *u16) == 2) { o = pc; }   // ET_EXEC: addr2line wants the address
            if (i > 0) { o -= 1; }
            const auto t = bprint(args[ao..], "0x{o:x}") catch "";
            if (t.len > 0) {
                argv[ac] = &args[ao];
                ac += 1;
                ao += t.len + 1;
            }
        }
    }
    if (ac > 7 && vrt_os() == 1) {
        argv[ac] = null;
        __crash_write("where (addr2line):\n");
        const auto pid = fork();
        if (pid == 0) {
            _ = dup2(2, 1);
            _ = execvp(argv[0], &argv[0]);
            _exit(127);
        }
        if (pid > 0) {
            i32 status = 0;
            _ = waitpid(pid, &status, 0);
        }
    }
}
