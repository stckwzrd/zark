extern i64 vrt_poller_new();
extern i32 vrt_poller_set(i64 p, i32 fd, i32 readable, i32 writable, u64 token);
extern i32 vrt_poller_wait(i64 p, u64* tokens, i32* events, i32 max, i64 timeout_ms);
extern void vrt_poller_free(i64 p);
extern i32 vrt_set_nonblocking(i32 fd);
extern i32 accept(i32 fd, u8* addr, u32* len);
extern i64 recv(i32 fd, void* buf, u64 n, i32 flags);
extern i64 vrt_send(i32 fd, void* buf, u64 n, i32 flags);
extern i32 close(i32 fd);
extern i32 vrt_errno();

import "std/net" as net;

struct Task {
    void* frame;
    fn[](void*, Context*) -> bool poll_thunk;
    i32 state;
    Executor* ex;
    u64 size;
    i64 index;
    i32 timers;
    i32 io;
    i32 waits;
    bool released;
    Waker joiner;
    Task* waiter;
}

struct TaskBox<F, T> {
    Task head;
    F fut;
    T result;
}

struct Timer {
    i64 deadline;
    Waker waker;
    Task* task;
}

struct Reg {
    bool r;
    bool w;
    bool rready;
    bool wready;
    Waker rw;
    Waker ww;
    Task* rt;
    Task* wt;
}

void task_wake(void* data) {
    auto t = data as *Task;
    if (t.state == 0 || t.state == 2) {
        t.state = 1;
        auto q = &t.ex.queue;
        q.items[q.len] = t;
        q.len += 1;
    }
}

void main_wake(void* data) {
    auto ex = data as *Executor;
    ex.main_woken = true;
}

struct JoinHandle<T> {
    Task* task;
    T* slot;

    bool done() { return this->task.state == 3; }
    T take() {
        const auto v = *this->slot;
        this->detach();
        return v;
    }

    void detach() {
        this->task.released = true;
        this->task.ex.release(this->task);
    }

    Poll<T> poll(Context* cx) {
        if (this->done()) { return .Ready(this->take()); }
        auto t = this->task;
        t.joiner = cx.waker;
        const auto cur = t.ex.current;
        if (t.waiter != cur) {
            const auto old = t.waiter;
            t.waiter = cur;
            if (cur != null) { cur.waits += 1; }
            if (old != null) {
                old.waits -= 1;
                t.ex.release(old);
            }
        }
        return .Pending;
    }
}

owned struct Executor {
    Allocator a;
    i64 poller;
    List<Task*> tasks;
    List<Task*> queue;
    List<Task*> batch;
    List<Timer> timers;
    List<Reg> regs;
    Task* current;
    i64 io;
    bool main_woken;

    static !Executor init(Allocator a) {
        const auto p = vrt_poller_new();
        if (p <= 0) { return error.SystemCall; }
        return Executor{ .a = a, .poller = p, .tasks = List<Task*>::init(a), .queue = List<Task*>::init(a),
            .batch = List<Task*>::init(a), .timers = List<Timer>::init(a),
            .regs = List<Reg>::init(a) };
    }

    void deinit() move {
        for (auto t : this->tasks.slice()) { this->a.free<u8>((t as *u8)[0..t.size as i64]); }
        this->tasks.deinit();
        this->queue.deinit();
        this->batch.deinit();
        this->timers.deinit();
        this->regs.deinit();
        vrt_poller_free(this->poller);
    }

    template<F, T> !JoinHandle<T> spawn(F fut) {
        const auto n = this->tasks.len + 1;
        this->tasks.reserve(n)?;
        this->queue.reserve(n)?;
        this->batch.reserve(n)?;
        auto b = this->a.create<TaskBox<F, T>>()?;
        b.fut = fut;
        b.head = Task{ .frame = b as *void, .state = 1, .ex = this, .size = sizeof(TaskBox<F, T>), .index = this->tasks.len,
            .poll_thunk = [](void* p, Context* cx) -> bool {
                auto b = p as *TaskBox<F, T>;
                match (b.fut.poll(cx)) {
                    .Ready(v) => {
                        b.result = v;
                        return true;
                    }
                    .Pending => return false;
                }
                return false;
            } };
        this->tasks.push(&b.head)?;
        this->queue.push(&b.head)?;
        return JoinHandle<T>{ .task = &b.head, .slot = &b.result };
    }

    template<F, T> !T block_on(F* fut) {
        auto cx = Context{ .waker = Waker{ .data = this as *void, .wake_fn = main_wake } };
        u64[64] tokens;
        i32[64] events;
        this->main_woken = true;
        while (true) {
            this->fire_timers();
            if (this->main_woken) {
                this->main_woken = false;
                match (fut.poll(&cx)) {
                    .Ready(v) => {
                        this->drop_io(null);
                        return v;
                    }
                    .Pending => {}
                }
            }
            this->run_batch();
            if (this->main_woken || this->queue.len > 0) { continue; }
            const auto timeout = this->timeout_ms();
            if (timeout < 0 && this->io == 0) { return error.Deadlock; }
            const auto n = vrt_poller_wait(this->poller, &tokens[0], &events[0], 64, timeout);
            if (n < 0) {
                this->drop_io(null);
                return error.SystemCall;
            }
            for (auto i : 0..n as i64) {
                const auto e = events[i];
                this->ready(tokens[i] as i32, (e & 5) != 0, (e & 6) != 0);
            }
        }
        return error.Deadlock;
    }

    void run_batch() {
        const auto tmp = this->batch;
        this->batch = this->queue;
        this->queue = tmp;
        auto i = 0;
        while (i < this->batch.len) {
            auto t = this->batch.get(i);
            t.state = 2;
            auto cx = Context{ .waker = Waker{ .data = t as *void, .wake_fn = task_wake } };
            this->current = t;
            const auto done = t.poll_thunk(t.frame, &cx);
            this->current = null;
            if (done) {
                if (t.state == 1) { this->unqueue(t); }
                t.state = 3;
                if (t.io > 0) { this->drop_io(t); }
                t.joiner.wake();
                const auto w = t.waiter;
                if (w != null) {
                    t.waiter = null;
                    w.waits -= 1;
                    this->release(w);
                }
                this->release(t);
            } else if (t.state == 2) {
                t.state = 0;
            }
            i += 1;
        }
        this->batch.clear();
    }

    void unqueue(Task* t) {
        for (auto i : 0..this->queue.len) {
            if (this->queue.get(i) == t) {
                _ = this->queue.swap_remove(i) catch t;
                return;
            }
        }
    }

    void release(Task* t) {
        if (t.state != 3 || !t.released || t.timers > 0 || t.waits > 0) { return; }
        _ = this->tasks.swap_remove(t.index) catch t;
        if (t.index < this->tasks.len) { this->tasks.get(t.index).index = t.index; }
        this->a.free<u8>((t as *u8)[0..t.size as i64]);
    }

    !void arm(i32 fd, bool write, Waker w) {
        while (this->regs.len <= fd as i64) { this->regs.push(Reg{})?; }
        auto g = &this->regs.items[fd as i64];
        auto t = this->current;
        if (write) {
            g.ww = w;
            if (g.w && g.wt == t) { return; }
            if (g.w && g.wt != null) { g.wt.io -= 1; }
            if (!g.w) { this->io += 1; }
            g.w = true;
            g.wready = false;
            g.wt = t;
        } else {
            g.rw = w;
            if (g.r && g.rt == t) { return; }
            if (g.r && g.rt != null) { g.rt.io -= 1; }
            if (!g.r) { this->io += 1; }
            g.r = true;
            g.rready = false;
            g.rt = t;
        }
        if (t != null) { t.io += 1; }
        if (vrt_poller_set(this->poller, fd, g.r as i32, g.w as i32, fd as u64) != 0) {
            this->disarm(fd, write);
            return error.SystemCall;
        }
    }

    void disarm(i32 fd, bool write) {
        auto g = &this->regs.items[fd as i64];
        if (write) {
            if (!g.w) { return; }
            g.w = false;
            if (g.wt != null) { g.wt.io -= 1; }
        } else {
            if (!g.r) { return; }
            g.r = false;
            if (g.rt != null) { g.rt.io -= 1; }
        }
        this->io -= 1;
        _ = vrt_poller_set(this->poller, fd, g.r as i32, g.w as i32, fd as u64);
    }

    bool take_ready(i32 fd, bool write) {
        auto g = &this->regs.items[fd as i64];
        if (write && !g.wready || !write && !g.rready) { return false; }
        this->disarm(fd, write);
        return true;
    }

    void ready(i32 fd, bool r, bool w) {
        if (fd as i64 >= this->regs.len) { return; }
        auto g = &this->regs.items[fd as i64];
        if (r && g.r) {
            g.rready = true;
            g.rw.wake();
        }
        if (w && g.w) {
            g.wready = true;
            g.ww.wake();
        }
    }

    void drop_io(Task* t) {
        for (auto fd : 0..this->regs.len) {
            const auto g = this->regs.get(fd);
            if (g.r && g.rt == t) { this->disarm(fd as i32, false); }
            if (g.w && g.wt == t) { this->disarm(fd as i32, true); }
        }
    }

    void forget(i32 fd) {
        if (fd as i64 >= this->regs.len) { return; }
        this->disarm(fd, false);
        this->disarm(fd, true);
    }

    !void add_timer(i64 deadline, Waker w) {
        this->timers.push(Timer{ .deadline = deadline, .waker = w, .task = this->current })?;
        if (this->current != null) { this->current.timers += 1; }
        auto h = this->timers.slice();
        auto i = h.len - 1;
        while (i > 0 && h[(i - 1) / 2].deadline > h[i].deadline) {
            swap(&h[i], &h[(i - 1) / 2]);
            i = (i - 1) / 2;
        }
    }

    void fire_timers() {
        const auto now = now_ns();
        while (this->timers.len > 0 && this->timers.get(0).deadline <= now) {
            const auto w = this->timers.get(0).waker;
            const auto t = this->timers.get(0).task;
            this->timers.set(0, this->timers.get(this->timers.len - 1));
            this->timers.len -= 1;
            auto h = this->timers.slice();
            auto i = 0;
            while (true) {
                auto m = i;
                const auto l = 2 * i + 1;
                if (l < h.len && h[l].deadline < h[m].deadline) { m = l; }
                if (l + 1 < h.len && h[l + 1].deadline < h[m].deadline) { m = l + 1; }
                if (m == i) { break; }
                swap(&h[i], &h[m]);
                i = m;
            }
            w.wake();
            if (t != null) {
                t.timers -= 1;
                this->release(t);
            }
        }
    }

    i64 timeout_ms() {
        if (this->timers.len == 0) { return -1; }
        const auto left = this->timers.get(0).deadline - now_ns();
        if (left <= 0) { return 0; }
        return (left + 999999) / 1000000;
    }
}

struct Sleep {
    Executor* ex;
    i64 deadline;
    bool armed;

    static Sleep after(Executor* ex, i64 ms) { return Sleep{ .ex = ex, .deadline = now_ns() + ms * 1000000 }; }

    Poll<bool> poll(Context* cx) {
        if (now_ns() >= this->deadline) { return .Ready(true); }
        if (!this->armed) {
            this->ex.add_timer(this->deadline, cx.waker) catch {
                cx.waker.wake();
                return .Pending;
            };
            this->armed = true;
        }
        return .Pending;
    }
}

struct Io {
    Executor* ex;
    i32 fd;
    bool write;
    bool armed;

    Poll<bool> poll(Context* cx) {
        if (this->armed && this->ex.take_ready(this->fd, this->write)) {
            this->armed = false;
            return .Ready(true);
        }
        this->ex.arm(this->fd, this->write, cx.waker) catch {
            this->armed = false;
            return .Ready(false);
        };
        this->armed = true;
        return .Pending;
    }

    void cancel() {
        if (!this->armed) { return; }
        this->ex.disarm(this->fd, this->write);
        this->armed = false;
    }
}

struct Readable {
    Io io;

    static Readable on(Executor* ex, i32 fd) { return Readable{ .io = Io{ .ex = ex, .fd = fd } }; }
    Poll<bool> poll(Context* cx) { return this->io.poll(cx); }
    void cancel() { this->io.cancel(); }
}

struct Writable {
    Io io;

    static Writable on(Executor* ex, i32 fd) { return Writable{ .io = Io{ .ex = ex, .fd = fd, .write = true } }; }
    Poll<bool> poll(Context* cx) { return this->io.poll(cx); }
    void cancel() { this->io.cancel(); }
}

struct TcpListener {
    Executor* ex;
    i32 fd;

    static !TcpListener bind(Executor* ex, str host, i64 port) {
        const auto l = net::listen(host, port)?;
        if (vrt_set_nonblocking(l.fd) != 0) {
            _ = close(l.fd);
            return error.SystemCall;
        }
        return TcpListener{ .ex = ex, .fd = l.fd };
    }

    i64 port() {
        const auto l = net::Listener{ .fd = this->fd };
        return l.port();
    }

    Accept accept() { return Accept{ .ex = this->ex, .fd = this->fd, .r = Readable::on(this->ex, this->fd) }; }

    void close() move {
        this->ex.forget(this->fd);
        _ = close(this->fd);
        this->fd = -1;
    }
}

struct Accept {
    Executor* ex;
    i32 fd;
    Readable r;

    void cancel() { this->r.cancel(); }

    Poll<!TcpStream> poll(Context* cx) {
        while (true) {
            if (this->r.io.armed) {
                match (this->r.poll(cx)) {
                    .Ready(_) => {}
                    .Pending => return .Pending;
                }
            }
            const auto fd = accept(this->fd, null, null);
            if (fd >= 0) {
                if (vrt_set_nonblocking(fd) != 0) {
                    _ = close(fd);
                    return .Ready(error.SystemCall);
                }
                return .Ready(TcpStream{ .ex = this->ex, .fd = fd });
            }
            const auto e = vrt_errno();
            if (e == 11) {
                match (this->r.poll(cx)) {
                    .Ready(_) => return .Ready(error.SystemCall);
                    .Pending => return .Pending;
                }
            }
            if (e != 4 && e != 103) {
                errno_error() catch |err| { return .Ready(err); };
            }
        }
        return .Pending;
    }
}

struct TcpStream {
    Executor* ex;
    i32 fd;

    static !TcpStream connect(Executor* ex, str host, i64 port) {
        const auto c = net::connect_to(host, port)?;
        if (vrt_set_nonblocking(c.fd) != 0) {
            _ = close(c.fd);
            return error.SystemCall;
        }
        return TcpStream{ .ex = ex, .fd = c.fd };
    }

    Read read(u8[] buf) { return Read{ .ex = this->ex, .fd = this->fd, .buf = buf, .r = Readable::on(this->ex, this->fd) }; }
    Write write(str data) { return Write{ .ex = this->ex, .fd = this->fd, .data = data, .w = Writable::on(this->ex, this->fd) }; }

    void close() move {
        this->ex.forget(this->fd);
        _ = close(this->fd);
        this->fd = -1;
    }
}

struct Read {
    Executor* ex;
    i32 fd;
    u8[] buf;
    Readable r;

    void cancel() { this->r.cancel(); }

    Poll<!i64> poll(Context* cx) {
        while (true) {
            if (this->r.io.armed) {
                match (this->r.poll(cx)) {
                    .Ready(_) => {}
                    .Pending => return .Pending;
                }
            }
            const auto n = recv(this->fd, this->buf.ptr, this->buf.len as u64, 0);
            if (n >= 0) { return .Ready(n); }
            const auto e = vrt_errno();
            if (e == 11) {
                match (this->r.poll(cx)) {
                    .Ready(_) => return .Ready(error.SystemCall);
                    .Pending => return .Pending;
                }
            }
            if (e != 4) {
                errno_error() catch |err| { return .Ready(err); };
            }
        }
        return .Pending;
    }
}

struct Write {
    Executor* ex;
    i32 fd;
    str data;
    i64 off;
    Writable w;

    void cancel() { this->w.cancel(); }

    Poll<!i64> poll(Context* cx) {
        while (this->off < this->data.len) {
            if (this->w.io.armed) {
                match (this->w.poll(cx)) {
                    .Ready(_) => {}
                    .Pending => return .Pending;
                }
            }
            const auto n = vrt_send(this->fd, this->data.ptr + this->off, (this->data.len - this->off) as u64, net::MSG_NOSIGNAL);
            if (n >= 0) {
                this->off += n;
                continue;
            }
            const auto e = vrt_errno();
            if (e == 11) {
                match (this->w.poll(cx)) {
                    .Ready(_) => return .Ready(error.SystemCall);
                    .Pending => return .Pending;
                }
            }
            if (e != 4) {
                errno_error() catch |err| { return .Ready(err); };
            }
        }
        return .Ready(this->off);
    }
}
