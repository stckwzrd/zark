{
  "main": {
    "prefix": "main",
    "body": ["void main() {", "\t$0", "}"],
    "description": "main function"
  },
  "function": {
    "prefix": "fn",
    "body": ["${1:i64} ${2:name}(${3}) {", "\t$0", "}"],
    "description": "function"
  },
  "function error union": {
    "prefix": "fne",
    "body": ["!${1:i64} ${2:name}(${3}) {", "\t$0", "}"],
    "description": "function returning an error union"
  },
  "async function": {
    "prefix": "async",
    "body": ["async !${1:void} ${2:name}(${3}) {", "\t$0", "}"],
    "description": "async function returning a future"
  },
  "generic function": {
    "prefix": "tmpl",
    "body": ["template<${1:T}: ${2:Ord}> ${1:T} ${3:name}(${1:T} a) {", "\t$0", "}"],
    "description": "generic function with a constraint"
  },
  "struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "\t${2:i64} ${3:value};", "\t$0", "}"],
    "description": "struct"
  },
  "owned struct": {
    "prefix": "owned",
    "body": ["owned struct ${1:Name} {", "\t${2:i64} ${3:value};", "", "\tvoid close() move {", "\t\t$0", "\t}", "}"],
    "description": "owned struct that must be consumed"
  },
  "union": {
    "prefix": "union",
    "body": ["union ${1:Name} {", "\t${2:i64} ${3:n};", "\t${4:List<i64> xs};", "}"],
    "description": "tagged union"
  },
  "enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} { ${2:A}, ${3:B} }"],
    "description": "enum"
  },
  "interface": {
    "prefix": "interface",
    "body": ["interface ${1:Name} {", "\t${2:i64} ${3:get}();", "\t$0", "}"],
    "description": "interface"
  },
  "method": {
    "prefix": "method",
    "body": ["${1:i64} ${2:method}(${3}) {", "\t$0", "}"],
    "description": "method inside a struct"
  },
  "move method": {
    "prefix": "movemethod",
    "body": ["void ${1:deinit}() move {", "\t$0", "}"],
    "description": "method that consumes the receiver"
  },
  "defer": {
    "prefix": "defer",
    "body": ["defer {", "\t$0", "}"],
    "description": "run at scope exit"
  },
  "errdefer": {
    "prefix": "errdefer",
    "body": ["errdefer {", "\t$0", "}"],
    "description": "run only when the function fails"
  },
  "test": {
    "prefix": "test",
    "body": ["test \"${1:name}\" {", "\tassert(${2:true});", "\t$0", "}"],
    "description": "test block"
  },
  "match statement": {
    "prefix": "match",
    "body": ["match ${1:value} {", "\t${2:_} => ${3:{}}", "}"],
    "description": "match statement"
  },
  "match expression": {
    "prefix": "matche",
    "body": ["match ${1:value} {", "\t${2:0} => ${3:1},", "\t_ => ${4:0},", "}"],
    "description": "match expression"
  },
  "if": {
    "prefix": "if",
    "body": ["if (${1:cond}) {", "\t$0", "}"],
    "description": "if"
  },
  "if else": {
    "prefix": "ife",
    "body": ["if (${1:cond}) {", "\t$2", "} else {", "\t$0", "}"],
    "description": "if else"
  },
  "for range": {
    "prefix": "for",
    "body": ["for (auto ${1:i} : ${2:0}..${3:n}) {", "\t$0", "}"],
    "description": "range loop"
  },
  "for each": {
    "prefix": "fore",
    "body": ["for (auto [${1:i}, ${2:x}] : ${3:items}) {", "\t$0", "}"],
    "description": "loop over a slice with an index"
  },
  "while": {
    "prefix": "while",
    "body": ["while (${1:cond}) {", "\t$0", "}"],
    "description": "while loop"
  },
  "closure": {
    "prefix": "clo",
    "body": ["[&${1:x}](${2:i64} ${3:a}) -> ${4:i64} {", "\t$0", "}"],
    "description": "closure with captures"
  },
  "import": {
    "prefix": "import",
    "body": ["import \"${1:std/fs}\" as ${2:fs};"],
    "description": "namespaced import"
  },
  "println": {
    "prefix": "pl",
    "body": ["println(\"{$1}\");"],
    "description": "println with interpolation"
  },
  "list": {
    "prefix": "list",
    "body": ["auto ${1:l} = List<${2:i64}>::init(${3:c_allocator()});", "defer ${1:l}.deinit();", "$0"],
    "description": "List with a deferred deinit"
  },
  "map": {
    "prefix": "map",
    "body": ["auto ${1:m} = Map<${2:str}, ${3:i64}>::init(${4:c_allocator()});", "defer ${1:m}.deinit();", "$0"],
    "description": "Map with a deferred deinit"
  },
  "arena": {
    "prefix": "arena",
    "body": ["auto ${1:arena} = Arena::init(${2:c_allocator()});", "defer ${1:arena}.deinit();", "$0"],
    "description": "Arena allocator with a deferred deinit"
  },
  "orelse": {
    "prefix": "orelse",
    "body": ["${1:opt} orelse ${2:return}"],
    "description": "orelse"
  },
  "comptime": {
    "prefix": "ct",
    "body": ["comptime ${1:expression}"],
    "description": "compile-time expression"
  }
}
