{
  "main": { "prefix": "main", "body": ["void main() {", "\t$0", "}"], "description": "main function" },
  "fn": { "prefix": "fn", "body": ["${3:i64} ${1:name}(${2}) {", "\t$0", "}"], "description": "function" },
  "fnerr": { "prefix": "fne", "body": ["!${3:i64} ${1:name}(${2}) {", "\t$0", "}"], "description": "function returning an error union" },
  "template": { "prefix": "tmpl", "body": ["template<${1:T}> ${2:T} ${3:name}(${4:T a}) {", "\t$0", "}"], "description": "generic function" },
  "struct": { "prefix": "struct", "body": ["struct ${1:Name} {", "\t${2:i64} ${3:field};", "}"], "description": "struct" },
  "enum": { "prefix": "enum", "body": ["enum ${1:Name} { ${2:A}, ${3:B} }"], "description": "enum" },
  "union": { "prefix": "union", "body": ["union ${1:Name} {", "\t${2:i64} ${3:A};", "\t${4:B};", "}"], "description": "tagged union" },
  "method": { "prefix": "method", "body": ["${1:i64} ${2:method}() {", "\t$0", "}"], "description": "method inside a struct" },
  "test": { "prefix": "test", "body": ["test \"${1:name}\" {", "\tassert(${2:true});", "\t$0", "}"], "description": "test block" },
  "match": { "prefix": "match", "body": ["match ${1:value} {", "\t${2:_} => ${3:{}}", "}"], "description": "match statement" },
  "matche": { "prefix": "matche", "body": ["match ${1:value} {", "\t${2:0} => ${3:1},", "\t_ => ${4:0},", "}"], "description": "match expression" },
  "for": { "prefix": "for", "body": ["for (auto ${1:i} : ${2:0}..${3:n}) {", "\t$0", "}"], "description": "range loop" },
  "foreach": { "prefix": "fore", "body": ["for (auto [${1:i}, ${2:x}] : ${3:items}) {", "\t$0", "}"], "description": "loop over a slice with index" },
  "while": { "prefix": "while", "body": ["while (${1:cond}) {", "\t$0", "}"], "description": "while loop" },
  "if": { "prefix": "if", "body": ["if (${1:cond}) {", "\t$0", "}"], "description": "if" },
  "ife": { "prefix": "ife", "body": ["if (${1:cond}) {", "\t$2", "} else {", "\t$0", "}"], "description": "if else" },
  "println": { "prefix": "pl", "body": ["println(\"${1:{x}}\");"], "description": "println" },
  "closure": { "prefix": "clo", "body": ["[&${1}](${2:i64} ${3:x}) -> ${4:i64} {", "\t$0", "}"], "description": "closure with captures" },
  "orelse": { "prefix": "orelse", "body": ["${1:opt} orelse ${2:return}"], "description": "orelse" },
  "import": { "prefix": "import", "body": ["import \"${1:file}.zk\" as ${2:name};"], "description": "namespaced import" }
}
