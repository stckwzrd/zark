{
  "name": "zark-lang",
  "displayName": "Zark",
  "description": "Zark language support through the zark language server",
  "version": "0.2.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:zark"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zark",
        "aliases": [
          "Zark",
          "zark"
        ],
        "extensions": [
          ".zk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zark",
        "scopeName": "source.zk",
        "path": "./syntaxes/zark.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zark",
        "path": "./snippets/zark.json"
      }
    ],
    "configurationDefaults": {
      "[zark]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "local.zk-lang"
      }
    },
    "configuration": {
      "title": "Zark",
      "properties": {
        "zark.path": {
          "type": "string",
          "default": "zark",
          "description": "Path to the zark compiler."
        },
        "zark.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication with the language server."
        }
      }
    },
    "commands": [
      {
        "command": "zark.run",
        "title": "Zark: Run File",
        "icon": "$(play)"
      },
      {
        "command": "zark.test",
        "title": "Zark: Test File",
        "icon": "$(beaker)"
      },
      {
        "command": "zark.build",
        "title": "Zark: Build File"
      },
      {
        "command": "zark.restartServer",
        "title": "Zark: Restart Language Server"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "zark.run",
          "when": "resourceLangId == zark",
          "group": "navigation"
        },
        {
          "command": "zark.test",
          "when": "resourceLangId == zark",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zark.run",
        "key": "ctrl+alt+r",
        "when": "editorLangId == zark"
      },
      {
        "command": "zark.test",
        "key": "ctrl+alt+t",
        "when": "editorLangId == zark"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
