{
  "name": "zark-lang",
  "displayName": "Zark",
  "description": "Syntax highlighting, snippets, diagnostics, formatting and run/test/build commands for the Zark language",
  "version": "0.3.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "zark",
    "zk",
    "systems",
    "language"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:zark"
  ],
  "scripts": {
    "package": "python3 pack.py",
    "check": "node --check extension.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "zark",
        "aliases": [
          "Zark",
          "zark"
        ],
        "extensions": [
          ".zk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zark",
        "scopeName": "source.zk",
        "path": "./syntaxes/zark.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zark",
        "path": "./snippets/zark.json"
      }
    ],
    "configurationDefaults": {
      "[zark]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "local.zark-lang",
        "editor.quickSuggestions": {
          "comments": false,
          "strings": false,
          "other": true
        },
        "editor.suggest.showKeywords": true
      }
    },
    "configuration": {
      "title": "Zark",
      "properties": {
        "zark.path": {
          "type": "string",
          "default": "zark",
          "description": "Path to the zark compiler. The default searches the workspace's build/zark, PATH and ~/.local/bin."
        },
        "zark.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication with the language server."
        }
      }
    },
    "commands": [
      {
        "command": "zark.run",
        "title": "Zark: Run File",
        "icon": "$(play)"
      },
      {
        "command": "zark.test",
        "title": "Zark: Test File",
        "icon": "$(beaker)"
      },
      {
        "command": "zark.build",
        "title": "Zark: Build File",
        "icon": "$(gear)"
      },
      {
        "command": "zark.format",
        "title": "Zark: Format Document",
        "icon": "$(symbol-color)"
      },
      {
        "command": "zark.restartServer",
        "title": "Zark: Restart Language Server"
      },
      {
        "command": "zark.showOutput",
        "title": "Zark: Show Output"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "zark.run",
          "when": "resourceLangId == zark",
          "group": "navigation"
        },
        {
          "command": "zark.test",
          "when": "resourceLangId == zark",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "zark.run",
          "when": "editorLangId == zark",
          "group": "zark@1"
        },
        {
          "command": "zark.test",
          "when": "editorLangId == zark",
          "group": "zark@2"
        },
        {
          "command": "zark.build",
          "when": "editorLangId == zark",
          "group": "zark@3"
        },
        {
          "command": "zark.format",
          "when": "editorLangId == zark",
          "group": "zark@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "zark.run",
        "key": "ctrl+alt+r",
        "when": "editorLangId == zark"
      },
      {
        "command": "zark.test",
        "key": "ctrl+alt+t",
        "when": "editorLangId == zark"
      },
      {
        "command": "zark.build",
        "key": "ctrl+alt+b",
        "when": "editorLangId == zark"
      },
      {
        "command": "zark.format",
        "key": "ctrl+alt+shift+f",
        "when": "editorLangId == zark"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
