{
  "name": "Zark",
  "scopeName": "source.zk",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#test-block"
    },
    {
      "include": "#types-and-declarations"
    },
    {
      "include": "#errors"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#namespaces"
    },
    {
      "include": "#namespace-separator"
    },
    {
      "include": "#fields"
    },
    {
      "include": "#enum-literal"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.zk",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.zk",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zk",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.zk",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.zk",
          "match": "\\\\."
        },
        {
          "name": "constant.character.escape.zk",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.zk",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.zk"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.zk"
            }
          },
          "patterns": [
            {
              "include": "#interpolation-braces"
            },
            {
              "name": "constant.other.format-spec.zk",
              "match": ":(?:[-+#0-9]*)(?:\\.\\d+)?[a-zA-Z]?(?=\\})"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.zk",
      "match": "'(?:\\\\.|[^'\\\\])'"
    },
    "numbers": {
      "name": "constant.numeric.zk",
      "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|(?:[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?|\\.[0-9][0-9_]*)(?:[eE][+-]?[0-9]+)?)\\b"
    },
    "test-block": {
      "match": "^\\s*(test)\\s+(\"[^\"]*\")",
      "captures": {
        "1": {
          "name": "keyword.other.test.zk"
        },
        "2": {
          "name": "entity.name.function.test.zk"
        }
      }
    },
    "types-and-declarations": {
      "patterns": [
        {
          "match": "\\b(owned)\\s+(struct|union|enum|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.zk"
            },
            "2": {
              "name": "storage.type.zk"
            },
            "3": {
              "name": "entity.name.type.zk"
            }
          }
        },
        {
          "match": "\\b(struct|union|enum|interface|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.zk"
            },
            "2": {
              "name": "entity.name.type.zk"
            }
          }
        },
        {
          "begin": "\\btemplate\\b\\s*<",
          "end": ">",
          "beginCaptures": {
            "0": {
              "name": "storage.type.zk"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.end.zk"
            }
          },
          "patterns": [
            {
              "include": "#types"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#operators"
            }
          ]
        },
        {
          "match": "^\\s*(?!(?:if|else|while|for|return|break|continue|match|defer|errdefer|catch|test|await|comptime|import|as|is|sizeof|alignof|true|false|null|nullptr|error)\\b)(?:(async|extern|export|static)\\s+)?(!?)((?:fn\\[[^\\]]*\\]\\([^)]*\\)\\s*->\\s*[^\\s{;]+|\\*?[A-Za-z_][A-Za-z0-9_.]*(?:<[^<>{};]*>)?(?:\\s*\\*)*(?:\\[[^\\]{};]*\\])?|\\[[^\\]{};]*\\]))\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "storage.modifier.zk"
            },
            "2": {
              "name": "keyword.operator.zk"
            },
            "3": {
              "name": "storage.type.zk"
            },
            "4": {
              "name": "entity.name.function.zk"
            }
          }
        }
      ]
    },
    "errors": {
      "match": "\\b(error)\\.([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.other.error.zk"
        },
        "2": {
          "name": "constant.other.error.zk"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zk",
          "match": "\\b(if|else|while|for|return|break|continue|match|defer|errdefer|catch|orelse|is|await)\\b"
        },
        {
          "name": "keyword.other.zk",
          "match": "\\b(import|as|sizeof|alignof|comptime)\\b"
        },
        {
          "name": "storage.type.zk",
          "match": "\\b(fn|const|static|template|struct|union|enum|interface|type|owned|auto|async|extern|export|volatile|packed)\\b"
        },
        {
          "name": "storage.modifier.zk",
          "match": "\\b(move|borrows|invalidates)\\b"
        },
        {
          "name": "constant.language.zk",
          "match": "\\b(true|false|null|nullptr|this)\\b"
        },
        {
          "name": "keyword.other.test.zk",
          "match": "\\btest\\b"
        },
        {
          "name": "keyword.other.error.zk",
          "match": "\\berror\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.zk",
          "match": "\\b(print|println|eprint|eprintln|sprint|bprint|panic|assert|embed|asm)\\b(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)::([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.zk"
            },
            "2": {
              "name": "constant.other.enum-member.zk"
            }
          }
        },
        {
          "name": "storage.type.primitive.zk",
          "match": "\\b(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|bool|void|str)\\b"
        },
        {
          "name": "support.type.self.zk",
          "match": "\\bSelf\\b"
        },
        {
          "name": "entity.name.type.zk",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.other.zk",
      "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
    },
    "namespaces": {
      "name": "entity.name.namespace.zk",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=::)"
    },
    "namespace-separator": {
      "name": "punctuation.separator.namespace.zk",
      "match": "::"
    },
    "fields": {
      "patterns": [
        {
          "name": "variable.other.property.zk",
          "match": "\\.[A-Za-z_][A-Za-z0-9_]*(?=\\s*=)"
        },
        {
          "name": "variable.other.property.zk",
          "match": "(?<=[A-Za-z0-9_\\)\\]])\\.[A-Za-z_][A-Za-z0-9_]*(?![A-Za-z0-9_])(?!\\s*\\()"
        },
        {
          "match": "->\\s*([A-Za-z_][A-Za-z0-9_]*)(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "variable.other.property.zk"
            }
          }
        }
      ]
    },
    "enum-literal": {
      "name": "constant.other.enum-member.zk",
      "match": "(?<![A-Za-z0-9_\\)\\]])\\.[A-Za-z_][A-Za-z0-9_]*"
    },
    "calls": {
      "name": "entity.name.function.call.zk",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "operators": {
      "name": "keyword.operator.zk",
      "match": "=>|->|==|!=|<=|>=|&&|\\|\\||<<=?|>>=?|\\.\\.\\.|\\.\\.|[-+*/%&|^]=?|[~!<>=?]"
    }
  }
}
