// A compiler-shaped workload: tokenizer -> recursive-descent parser -> AST (unions) -> interpreter.
// Language:  let x = expr;  print expr;  fn name(a, b) = expr;   expressions: + - * / ( ) calls, if c then a else b

union Node {
    i64 Num;
    str Var;
    BinOp Bin;
    CallNode Call;
    IfNode If;
}
struct BinOp { u8 op; Node* l; Node* r; }
struct CallNode { str name; List<Node*> args; }
struct IfNode { Node* cond; Node* then; Node* els; }

struct FnDef { List<str> params; Node* body; }

struct P {
    str src;
    i64 i;
    Allocator a;

    void skip_ws() {
        while (this->i < this->src.len && (this->src[this->i] == ' ' || this->src[this->i] == '\n')) { this->i += 1; }
    }
    u8 peek() {
        this->skip_ws();
        if (this->i < this->src.len) { return this->src[this->i]; }
        return 0;
    }
    bool eat(u8 c) {
        if (this->peek() == c) { this->i += 1; return true; }
        return false;
    }
    !void expect(u8 c) {
        if (!this->eat(c)) {
            eprintln("parse error at {this->i}: expected '{c as i64}'");
            return error.Parse;
        }
    }
    !str ident() {
        this->skip_ws();
        const auto start = this->i;
        while (this->i < this->src.len && (is_alnum(this->src[this->i]) || this->src[this->i] == '_')) { this->i += 1; }
        if (start == this->i) { return error.Parse; }
        return this->src[start..this->i];
    }
    bool keyword(str kw) {
        this->skip_ws();
        if (str_starts_with(this->src[this->i..], kw)) {
            this->i += kw.len;
            return true;
        }
        return false;
    }
    !Node* node(Node n) {
        const auto p = this->a.create<Node>()?;
        *p = n;
        return p;
    }

    !Node* primary() {
        const auto c = this->peek();
        if (c == '(') {
            this->i += 1;
            const auto e = this->expr()?;
            this->expect(')')?;
            return e;
        }
        if (is_digit(c)) {
            auto v = 0;
            while (this->i < this->src.len && is_digit(this->src[this->i])) {
                v = v * 10 + (this->src[this->i] - '0') as i64;
                this->i += 1;
            }
            return this->node(.Num(v));
        }
        if (this->keyword("if ")) {
            const auto cond = this->expr()?;
            if (!this->keyword("then")) { return error.Parse; }
            const auto t = this->expr()?;
            if (!this->keyword("else")) { return error.Parse; }
            const auto e = this->expr()?;
            return this->node(.If(IfNode{ .cond = cond, .then = t, .els = e }));
        }
        const auto name = this->ident()?;
        if (this->eat('(')) {
            auto args = List<Node*>::init(this->a);
            if (!this->eat(')')) {
                while (true) {
                    args.push(this->expr()?)?;
                    if (this->eat(')')) { break; }
                    this->expect(',')?;
                }
            }
            return this->node(.Call(CallNode{ .name = name, .args = args }));
        }
        return this->node(.Var(name));
    }

    !Node* term() {
        auto l = this->primary()?;
        while (this->peek() == '*' || this->peek() == '/') {
            const auto op = this->src[this->i];
            this->i += 1;
            const auto r = this->primary()?;
            l = this->node(.Bin(BinOp{ .op = op, .l = l, .r = r }))?;
        }
        return l;
    }

    !Node* expr() {
        auto l = this->term()?;
        while (this->peek() == '+' || this->peek() == '-' || this->peek() == '<') {
            const auto op = this->src[this->i];
            this->i += 1;
            const auto r = this->term()?;
            l = this->node(.Bin(BinOp{ .op = op, .l = l, .r = r }))?;
        }
        return l;
    }
}

struct Interp {
    Map<i64> globals;
    Map<FnDef*> fns;
    Allocator a;

    !i64 eval(Node* n, Map<i64>*env) {
        match *n {
            .Num(v) => return v;
            .Var(name) => {
                if (env.has(name)) { return env.get(name); }
                return this->globals.get(name) catch |e| {
                    eprintln("undefined variable '{name}'");
                    return e;
                }
            }
            .Bin(b) => {
                const auto x = this->eval(b.l, env)?;
                const auto y = this->eval(b.r, env)?;
                match b.op {
                    '+' => return x + y;
                    '-' => return x - y;
                    '*' => return x * y;
                    '<' => { if (x < y) { return 1; } return 0; }
                    '/' => {
                        if (y == 0) { return error.DivByZero; }
                        return x / y;
                    }
                }
                return error.BadOp;
            }
            .If(f) => {
                if (this->eval(f.cond, env)? != 0) { return this->eval(f.then, env); }
                return this->eval(f.els, env);
            }
            .Call(c) => {
                const auto def = this->fns.get(c.name)?;
                if (def.params.len != c.args.len) { return error.Arity; }
                auto local = Map<i64>::init(this->a);
                defer local.deinit();
                for (auto [i, p] : def.params) { local.put(p, this->eval(c.args.get(i), env)?)?; }
                return this->eval(def.body, &local);
            }
        }
        return error.Unreachable;
    }

    !void run(str src) {
        auto p = P{ .src = src, .i = 0, .a = this->a };
        auto empty = Map<i64>::init(this->a);
        while (p.peek() != 0) {
            if (p.keyword("let ")) {
                const auto name = p.ident()?;
                p.expect('=')?;
                const auto e = p.expr()?;
                this->globals.put(name, this->eval(e, &empty)?)?;
            } else if (p.keyword("print ")) {
                const auto e = p.expr()?;
                println(this->eval(e, &empty)?);
            } else if (p.keyword("fn ")) {
                const auto name = p.ident()?;
                p.expect('(')?;
                const auto def = this->a.create<FnDef>()?;
                def.params = List<str>::init(this->a);
                if (!p.eat(')')) {
                    while (true) {
                        def.params.push(p.ident()?)?;
                        if (p.eat(')')) { break; }
                        p.expect(',')?;
                    }
                }
                p.expect('=')?;
                def.body = p.expr()?;
                this->fns.put(name, def)?;
            } else {
                eprintln("unknown statement at {p.i}");
                return error.Parse;
            }
            p.expect(';')?;
        }
    }
}

!void main() {
    u8[262144] arena_mem;
    auto arena = FixedBuf::init(arena_mem[..]);
    const auto a = arena.allocator();
    auto it = Interp{ .globals = Map<i64>::init(a), .fns = Map<FnDef*>::init(a), .a = a };
    it.run("
        let x = 6;
        let y = x * 7;
        print y;
        fn sq(n) = n * n;
        fn fib(n) = if n < 2 then n else fib(n - 1) + fib(n - 2);
        fn fact(n) = if n < 1 then 1 else n * fact(n - 1);
        print sq(x) + 1;
        print fib(20);
        print fact(10);
        print (1 + 2) * (3 + 4) - 10 / 2;
    ")?;
    println("arena used: {arena.used} bytes");
    it.run("print 1 / 0;") catch |e| println("runtime error: {e}");
    it.run("print nope;") catch |e| println("runtime error: {e}");
}
