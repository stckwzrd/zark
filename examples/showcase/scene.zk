import "std/json" as json;
import "vec.zk";

struct Ray { Vec3 origin; Vec3 dir; }

union Material {
    Vec3 Diffuse;
    Vec3 Mirror;
    Vec3 Emissive;
}

struct Hit { f32 t; Vec3 point; Vec3 normal; Material mat; }

interface Shape {
    ?Hit intersect(Ray r);
}

struct Sphere {
    Vec3 center;
    f32 radius;
    Material mat;

    ?Hit intersect(Ray r) {
        const auto oc = r.origin - center;
        const auto b = oc.dot(r.dir);
        const auto c = oc.dot(oc) - radius * radius;
        const auto disc = b * b - c;
        if (disc < 0.0) { return null; }
        const auto root = sqrt(disc as f64) as f32;
        auto t = -b - root;
        if (t < 0.001) { t = -b + root; }
        if (t < 0.001) { return null; }
        const auto p = r.origin + r.dir * t;
        return Hit{ .t = t, .point = p, .normal = (p - center).normalized(), .mat = mat };
    }
}

struct Plane {
    f32 y;
    Material mat;

    ?Hit intersect(Ray r) {
        if (r.dir.y() > -0.0001 && r.dir.y() < 0.0001) { return null; }
        const auto t = (y - r.origin.y()) / r.dir.y();
        if (t < 0.001) { return null; }
        const auto p = r.origin + r.dir * t;
        return Hit{ .t = t, .point = p, .normal = Vec3(0.0, 1.0, 0.0), .mat = mat };
    }
}

struct Scene {
    i64 width;
    i64 height;
    Vec3 light;
    List<Shape> shapes;
    Allocator a;

    ?Hit closest(Ray r) {
        ?Hit best = null;
        f32 nearest = 1.0e30;
        for (auto s : shapes) {
            const auto h = s.intersect(r) orelse continue;
            if (h.t < nearest) {
                nearest = h.t;
                best = h;
            }
        }
        return best;
    }
}

!Vec3 read_vec(json::Value* v) {
    if (v.len() != 3) { return error.BadVector; }
    return Vec3(v.at(0).as_f64()? as f32, v.at(1).as_f64()? as f32, v.at(2).as_f64()? as f32);
}

!Material read_material(json::Value* m) {
    const auto kind = m.get("kind").as_str()?;
    const auto color = read_vec(m.get("color"))?;
    if (kind == "diffuse") { return Material::Diffuse(color); }
    if (kind == "mirror") { return Material::Mirror(color); }
    if (kind == "emissive") { return Material::Emissive(color); }
    return error.UnknownMaterial;
}

!Scene load_scene(Allocator a, str text) {
    const auto root = json::parse(a, text)?;
    auto sc = Scene{ .a = a, .shapes = List<Shape>::init(a) };
    sc.width = root.get("width").int_or(64);
    sc.height = root.get("height").int_or(32);
    sc.light = read_vec(root.get("light"))?;
    for (auto o : root.get("objects").items()) {
        const auto kind = o.get("type").as_str()?;
        const auto mat = read_material(o.get("material"))?;
        if (kind == "sphere") {
            const auto s = a.create<Sphere>()?;
            *s = Sphere{ .center = read_vec(o.get("center"))?, .radius = o.get("radius").as_f64()? as f32, .mat = mat };
            sc.shapes.push(s)?;
        } else if (kind == "plane") {
            const auto p = a.create<Plane>()?;
            *p = Plane{ .y = o.get("y").as_f64()? as f32, .mat = mat };
            sc.shapes.push(p)?;
        } else {
            return error.UnknownShape;
        }
    }
    return sc;
}
