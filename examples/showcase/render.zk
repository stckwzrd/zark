import "std/thread" as thread;
import "scene.zk";

struct Grid<T> {
    T[] cells;
    i64 w;
    i64 h;

    static !Grid<T> make(Allocator a, i64 w, i64 h) {
        return Grid<T>{ .cells = a.alloc<T>(w * h)?, .w = w, .h = h };
    }

    T get(i64 x, i64 y) const { return cells[y * w + x]; }
    void set(i64 x, i64 y, T v) { cells[y * w + x] = v; }
}

Vec3 sky(Ray r) {
    const auto t = clamp(0.5 * (r.dir.y() + 1.0), 0.0, 1.0);
    return Vec3(0.34, 0.36, 0.42) * (1.0 - t) + Vec3(0.02, 0.05, 0.18) * t;
}

Vec3 shade(Scene* sc, Ray r, i64 depth) {
    const auto hit = sc.closest(r) orelse return sky(r);
    match hit.mat {
        .Emissive(c) => return c;
        .Mirror(c) => {
            if (depth >= 3) { return c * 0.2; }
            const auto bounce = Ray{ .origin = hit.point, .dir = r.dir.reflect(hit.normal) };
            return shade(sc, bounce, depth + 1).mul(c);
        }
        .Diffuse(c) => {
            const auto to_light = sc.light - hit.point;
            const auto dist = to_light.length();
            const auto dir = to_light * (1.0 / dist);
            auto lit = clamp(hit.normal.dot(dir), 0.0, 1.0);
            const auto blocker = sc.closest(Ray{ .origin = hit.point, .dir = dir });
            if (blocker is .Some && (blocker orelse hit).t < dist) { lit = 0.0; }
            return c * (0.12 + 0.88 * lit);
        }
    }
    return Vec3(0.0, 0.0, 0.0);
}

Vec3 trace(Scene* sc, i64 x, i64 y) {
    const auto aspect = (sc.width as f32 / sc.height as f32) * 0.5;
    const auto u = (2.0 * (x as f32 + 0.5) / sc.width as f32 - 1.0) * aspect;
    const auto v = 1.0 - 2.0 * (y as f32 + 0.5) / sc.height as f32;
    const auto ray = Ray{ .origin = Vec3(0.0, 0.3, 0.0), .dir = Vec3(u, v - 0.1, 1.2).normalized() };
    return shade(sc, ray, 0);
}

!void render(Scene* sc, Grid<Vec3>* img, i64 workers) {
    auto next_row = thread::AtomicI64{};
    auto wg = thread::WaitGroup{};
    thread::Thread[8] pool;
    wg.add(workers);
    for (auto i : 0..workers) {
        pool[i] = thread::spawn([&sc, &img, &next_row, &wg]() -> void {
            while (true) {
                const auto y = next_row.add(1);
                if (y >= img.h) { break; }
                for (auto x : 0..img.w) { img.set(x, y, trace(sc, x, y)); }
            }
            wg.done();
        })?;
    }
    wg.wait();
    for (auto i : 0..workers) { pool[i].join(); }
}

u8 to_byte(f32 c) { return (clamp(c, 0.0, 1.0) * 255.0 + 0.5) as u8; }

u64 checksum(Grid<Vec3>* img) {
    u64 h = 14695981039346656037;
    for (auto c : img.cells) {
        h = (h ^ to_byte(c.x()) as u64) *% 1099511628211;
        h = (h ^ to_byte(c.y()) as u64) *% 1099511628211;
        h = (h ^ to_byte(c.z()) as u64) *% 1099511628211;
    }
    return h;
}

!void ascii(Grid<Vec3>* img, Writer* out) {
    const auto ramp = " .:-=+*#%@";
    for (auto y : 0..img.h) {
        for (auto x : 0..img.w) {
            const auto c = img.get(x, y);
            const auto lum = 0.299 * c.x() + 0.587 * c.y() + 0.114 * c.z();
            const auto idx = clamp((lum * 9.99) as i64, 0, 9);
            out.put(ramp[idx..idx + 1])?;
        }
        out.put("\n")?;
    }
}
