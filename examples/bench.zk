i64 fib(i64 n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

!i64 sieve(Allocator a, i64 n) {
    const auto flags = a.alloc<bool>(n + 1)?;
    defer a.free(flags);
    auto count = 0;
    for (auto i : 2..n + 1) {
        if (!flags[i]) {
            count += 1;
            auto j = i * i;
            while (j <= n) { flags[j] = true; j += i; }
        }
    }
    return count;
}

!void main() {
    const auto t0 = clock();
    const auto f = fib(38);
    const auto t1 = clock();
    const auto p = sieve(c_allocator(), 50_000_000)?;
    const auto t2 = clock();
    println("fib(38) = {f}  in {(t1 - t0) as f64 / 1000.0} ms");
    println("primes < 50M = {p}  in {(t2 - t1) as f64 / 1000.0} ms");
}
