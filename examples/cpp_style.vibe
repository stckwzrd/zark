import "cpp_style_lib.vibe" as lib;

const i64 LIMIT = 4;
i64 counter = 0;

struct Point {
    i64 x;
    i64 y;

    i64 len2() const { return x * x + y * y; }
    void move(i64 dx, i64 dy) { x += dx; this->y += dy; }
    static Point origin() { return Point{}; }
}

union Shape {
    f64 Circle;
    i64 Rect;
    Empty;
}

enum Color { Red, Green }

struct Pair<A, B> {
    A first;
    B second;
    A get_first() { return first; }
}

template<T: Ord> T largest(T a, T b) {
    if (a > b) { return a; }
    return b;
}

i64 sum(i64[] xs) {
    i64 total = 0;
    for (i64 x : xs) { total += x; }
    return total;
}

!i64 parse(str s) {
    if (s.len == 0) { return error.Empty; }
    return parse_int(s);
}

?i64 find(i64[] xs, i64 want) {
    for (i64 i = 0; i < xs.len; i++) {
        if (xs[i] == want) { return i; }
    }
    return nullptr;
}

i32 main() {
    auto p = Point{ .x = 3, .y = 4 };
    p.move(1, 1);
    println("len2 = {p.len2()} {p}");
    const i64 n = 10;
    i64 acc = 0;
    for (i64 i = 0; i < n; i++) {
        if (i % 2 == 0) { continue; }
        acc += i;
    }
    acc <<= 1;
    acc |= 1;
    println(acc, LIMIT, largest(3, 9), largest<f64>(2.5, 1.5));
    i64[4] arr = [1, 2, 3, 4];
    println(sum(arr[..]), find(arr[..], 3) orelse -1);
    auto add = [&n](i64 x) -> i64 { return x + n; };
    println(add(5));
    auto q = Pair<i64, str>{ .first = 7, .second = "seven" };
    println(q.get_first(), q);
    Shape s = Shape::Circle(2.0);
    Color c = Color::Green;
    println(s, c, Point::origin());
    i64* ptr = &counter;
    *ptr = 5;
    counter++;
    println(counter, parse("12") catch -1, lib::twice(21));
    return 0;
}
