// A tiny expression evaluator: tagged unions + match, the shape of a compiler AST.
union Expr {
    i64 Num;
    Expr* Neg;
    Bin Add;
    Bin Mul;
    Var;
}

struct Bin { Expr* l; Expr* r; }

i64 eval(Expr* e, i64 x) {
    match *e {
        .Num(n) => return n;
        .Neg(inner) => return -eval(inner, x);
        .Add(b) => return eval(b.l, x) + eval(b.r, x);
        .Mul(b) => return eval(b.l, x) * eval(b.r, x);
        .Var => return x;
    }
    return 0;
}

void show(Expr* e) {
    match *e {
        .Num(n) => print(n);
        .Var => print("x");
        .Neg(inner) => { print("-"); show(inner); }
        .Add(b) => { print("("); show(b.l); print(" + "); show(b.r); print(")"); }
        .Mul(b) => { show(b.l); print(" * "); show(b.r); }
    }
}

!Expr* node(Allocator a, Expr e) {
    const auto p = a.create<Expr>()?;
    *p = e;
    return p;
};

!void main() {
    u8[4096] mem;
    auto fb = FixedBuf::init(mem[..]);
    const auto a = fb.allocator();

    // 3 * (x + -2)
    const auto x = node(a, Expr::Var)?;
    const auto two = node(a, .Num(2))?;
    const auto neg = node(a, .Neg(two))?;
    const auto sum = node(a, .Add(Bin{ .l = x, .r = neg }))?;
    const auto three = node(a, .Num(3))?;
    const auto root = node(a, .Mul(Bin{ .l = three, .r = sum }))?;

    show(root);
    println("");
    for (auto v : [0, 1, 5]) { println("  x = {v} -> {eval(root, v)}"); }
    println("as value: {*two}");

    const auto some = Option<i64>::Some(42);
    const Option<i64> none = .None;
    println("{some} {none} unwrap_or: {some.unwrap_or(0)} {none.unwrap_or(-1)}");
}
