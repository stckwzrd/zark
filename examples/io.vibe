fn main() !void {
    let a = c_allocator()
    var out = List[u8].init(a)
    defer out.deinit()
    for i in 0..3 { sprint(&out, "line {i}: {i * i}\n")? }
    sprint(&out, "pi={PI} ok={true}\n")?
    write_file(".vibe-cache/vibe_io.txt", out.slice())?
    let back = read_file(a, ".vibe-cache/vibe_io.txt")?
    defer a.free(back)
    print(back)
    println("exists: {file_exists(".vibe-cache/vibe_io.txt")} {file_exists("/nope")}")
    let code = run(a, ["sh", "-c", "echo hello from child; exit 3"])?
    println("child exit = {code}")
    let missing = read_file(a, "/nope/x") catch |e| { println("read missing: {e}"); "" }
    println(missing.len, "\x41\x42")
}
