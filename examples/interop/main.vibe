import "ffi.vibe";

export i64 vibe_square(i64 x) { return x * x; }

void main() {
    println("gcd(84, 36) = {c_gcd(84, 36)}");
    println("sum of squares 1..10 via C->Vibe callback = {c_sum_squares(10)}");

    const auto e = engine_new("demo");
    defer engine_free(e);
    for (auto x : [5.0, 1.0, 9.0, 3.0, 7.0]) { engine_push(e, x); }
    engine_hello(e);
    println("median = {engine_median(e)}");

    auto a = Vec3{ .x = 1.0, .y = 2.0, .z = 3.0 };
    auto b = Vec3{ .x = 4.0, .y = 5.0, .z = 6.0 };
    println("dot = {vec3_dot(&a, &b)}");
}
