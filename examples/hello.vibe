struct Point { f64 x; f64 y;
    f64 len() { return sqrt(this->x * this->x + this->y * this->y); }
    void scale(f64 k) { this->x *= k; this->y *= k; }
}

enum Color { Red, Green, Blue }

!i64 div(i64 a, i64 b) {
    if (b == 0) { return error.DivByZero; }
    return a / b;
}

!void main() {
    defer println("bye!");
    auto p = Point{ .x = 3.0, .y = 4.0 };
    println("p = {p}, len = {p.len()}");
    p.scale(2.0);
    println("scaled: {p}");

    auto sum = 0;
    for (auto i : 0..10) { sum += i; }
    println("sum = {sum}");

    const auto q = div(10, 2)?;
    const auto r = div(1, 0) catch |e| {
        println("caught {e}");
        -1;
    };
    println("q={q} r={r}");

    const auto c = Color::Green;
    match c {
        .Red => println("red");
        .Green, .Blue => println("not red: {c}");
    }

    auto xs = List<i64>::init(c_allocator());
    defer xs.deinit();
    for (auto i : 0..5) { xs.push(i * i)?; }
    println("xs = {xs.slice()}, max = {max(3, 7)}");
    const auto arr = [5, 1, 4];
    println(arr, arr.len);
}
