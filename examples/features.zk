const auto N = 4 * 2;
auto counter = 0;

struct Pair<A, B> { A first; B second;
    Pair<B, A> swap() { return Pair<B, A>{ .first = this->second, .second = this->first } }
}

i64 bump() { counter += 1; return counter; }

!i64 open(str name) {
    if (name == "bad") { return error.NotFound; }
    return name.len;
}

!i64 work(str name) {
    defer println("  defer: leaving work({name})");
    errdefer println("  errdefer: work({name}) failed");
    const auto n = open(name)?;
    return n * 10;
}

!i64 work2(str name) {
    errdefer println("  errdefer runs for a runtime error too: {name}");
    return open(name);
}

!void main() {
    i32[N] grid;
    for (auto i : 0..N) { grid[i] = (i * i) as i32; }
    println("grid = {grid}");

    const auto p = Pair<i64, str>{ .first = 42, .second = "zark" };
    println("{p} -> {p.swap()}");

    const auto heap = c_allocator();
    auto xs = List<i64>::init(heap);
    defer xs.deinit();
    for (auto x : [9, 3, 7, 1, 8, 2]) { xs.push(x)?; }
    xs.sort();
    println("sorted: {xs.slice()}");
    xs.reverse();
    println("reversed: {xs.slice()} contains 7? {xs.contains(7)}");
    const auto last = xs.pop()?;
    println("popped {last}, len now {xs.len}");

    auto m = Map<i64>::init(heap);
    defer m.deinit();
    for (auto w : ["a", "bb", "a", "ccc", "bb", "a"]) {
        const auto c = m.get(w) catch 0;
        m.put(w, c + 1)?;
    }
    println("a={m.get("a") catch 0} bb={m.get("bb") catch 0} zz={m.get("zz") catch -1}");

    auto sb = List<u8>::init(heap);
    defer sb.deinit();
    sb.append("hello")?;
    sb.push(',')?;
    sb.append(" world")?;
    const auto s = sb.slice();
    println("sb = '{s}' len={s.len} find(world)={str_find(s, "world")}");
    println("trim='{str_trim("   hi  ")}' starts={str_starts_with(s, "hell")}");

    const auto v = parse_int(" -123 ")?;
    println("parsed {v}, bad -> {parse_int("12x") catch |e| { println("  err {e}"); 0 }}");

    println("work ok = {work("hello")?}");
    const auto r = work("bad") catch -1;
    println("work bad = {r}");
    _ = work2("bad") catch 0;

    // loops with break / continue / defer
    auto i = 0;
    while (true) {
        defer counter += 100;
        i += 1;
        if (i % 2 == 0) { continue; }
        if (i > 6) { break; }
        print("{i} ");
    }
    println("| counter={counter} bump={bump()}");

    u8[32] lb;
    const auto label = bprint(lb[..], "count: {xs.len} items")?;
    println(label, label.len);
    println("min={min(3.5, 2.25)} abs={abs(-9)} pi={PI}");
    const u8 u = 250;
    const auto w = u as i64 + 10;
    println("u8 -> i64: {w}, sizeof(Pair[i64, str]) = {sizeof(Pair<i64, str>)}");
    return error.Boom;
}
