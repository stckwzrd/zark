const u16 COM1 = 0x3F8;

struct Serial {
    static void init() {
        Port::out8(COM1 + 1, 0);
        Port::out8(COM1 + 3, 0x80);
        Port::out8(COM1 + 0, 1);
        Port::out8(COM1 + 1, 0);
        Port::out8(COM1 + 3, 3);
        Port::out8(COM1 + 2, 0xC7);
        Port::out8(COM1 + 4, 0x0B);
    }

    static void put(u8 c) {
        while ((Port::in8(COM1 + 5) & 0x20) == 0) { Cpu::pause(); }
        Port::out8(COM1, c);
    }
}

!void serial_write(void* ctx, str s) {
    for (auto c : s) { Serial::put(c); }
}

void kprintln(Fmt f) {
    auto w = Writer{ .ctx = null, .write_fn = serial_write };
    _ = w.put(f);
    Serial::put('\n');
}

void qemu_exit(u8 code) {
    Port::out8(0xF4, code);
}

export void kmain() {
    Serial::init();
    kprintln("Hello from Vibe on bare metal!");
    const auto cr0 = Cpu::cr0();
    const auto cr3 = Cpu::cr3();
    kprintln("protected mode = {Bits::get(cr0, 0, 0)}, paging = {Bits::get(cr0, 31, 31)}");
    kprintln("page table aligned = {(cr3 & 0xFFF) == 0}, 4 * 5 = {4 * 5}");
    u64[8] fib;
    fib[0] = 0;
    fib[1] = 1;
    for (auto i : 2..8) { fib[i] = fib[i - 1] + fib[i - 2]; }
    kprintln("fib = {fib}");
    qemu_exit(0);
    while (true) { Cpu::halt(); }
}

export void* memset(void* dst, i32 c, u64 n) {
    auto p = dst as *u8;
    for (auto i : 0..n) { p[i] = c as u8; }
    return dst;
}

export void* memcpy(void* dst, void* src, u64 n) {
    auto d = dst as *u8;
    auto s = src as *u8;
    for (auto i : 0..n) { d[i] = s[i]; }
    return dst;
}
