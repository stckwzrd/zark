i64 add(i64 a, i64 b) { return a + b; }
i64 mul(i64 a, i64 b) { return a * b; }

i64 fold(i64[] xs, i64 init, fn(i64, i64) -> i64 f) {
    auto acc = init;
    for (auto x : xs) { acc = f(acc, x); }
    return acc;
}

struct Button {
    str label;
    fn(str) on_click;
}

void hello(str who) { println("  clicked: {who}"); }

// C qsort with a Zark comparator
extern void qsort(void* base, u64 n, u64 size, fn(void*, void*) -> i32 cmp);
i32 cmp_i64(void* a, void* b) {
    const auto x = *(a as *i64);
    const auto y = *(b as *i64);
    if (x < y) { return -1; }
    if (x > y) { return 1; }
    return 0;
}

void main() {
    const i64[] xs = [1, 2, 3, 4, 5];
    println("sum = {fold(xs, 0, add)}, product = {fold(xs, 1, mul)}");
    fn(i64, i64) -> i64 op = add;
    println("op(2, 3) = {op(2, 3)}");
    op = mul;
    println("op(2, 3) = {op(2, 3)}");

    const auto b = Button{ .label = "OK", .on_click = hello };
    b.on_click(b.label);

    auto arr = [9, 4, 7, 1, 8];
    qsort(&arr, arr.len as u64, sizeof(i64), cmp_i64);
    println("qsort: {arr}");
}
