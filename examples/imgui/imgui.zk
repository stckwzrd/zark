struct ImVec2 { f32 x; f32 y; }
struct ImVec4 { f32 x; f32 y; f32 z; f32 w; }

struct ImGuiIO {
    i32 ConfigFlags;
    i32 BackendFlags;
    ImVec2 DisplaySize;
    ImVec2 DisplayFramebufferScale;
    f32 DeltaTime;
    f32 IniSavingRate;
    u8* IniFilename;
}

