import "SDL2/SDL.h" as sdl;
import "GL/gl.h" as gl;
import "imgui_all.hpp" as ig;

struct App {
    bool show_demo;
    bool paused;
    f32 freq;
    f32 amp;
    f32[3] clear;
    f64 phase;
    i64 clicks;
    u8[64] name;
}

f32 wave(void* data, i32 i) {
    App* app = data;
    return app->amp * sin(app->phase + i as f64 * app->freq as f64 * 0.1) as f32;
}

!void panel(App* app, f32 dt) {
    u8[96] line;
    ig::ImGui::SetNextWindowPos(ig::ImVec2(24.0, 24.0), ig::ImGuiCond_FirstUseEver, ig::ImVec2(0.0, 0.0));
    ig::ImGui::SetNextWindowSize(ig::ImVec2(440.0, 0.0), ig::ImGuiCond_FirstUseEver);
    ig::ImGui::Begin("Zark + Dear ImGui", null, 0);

    const auto version = bprint(line[..], "Dear ImGui {cstr(ig::ImGui::GetVersion())} driven from Zark") catch "";
    ig::ImGui::Text(version.ptr);
    const auto timing = bprint(line[..], "{1.0 / dt as f64:.1} FPS, frame {dt as f64 * 1000.0:.2} ms") catch "";
    ig::ImGui::Text(timing.ptr);

    ig::ImGui::SeparatorText("Widgets");
    if (ig::ImGui::Button_1("Click me")) { app->clicks += 1; }
    ig::ImGui::SameLine(0.0, 8.0);
    const auto label = bprint(line[..], "clicked {app->clicks} times") catch "";
    ig::ImGui::Text(label.ptr);
    ig::ImGui::InputText("name", &app->name[0], 64, 0, null, null);
    const auto hello = bprint(line[..], "hello, {cstr(&app->name[0])}!") catch "";
    ig::ImGui::Text(hello.ptr);

    ig::ImGui::SeparatorText("Plot driven by a Zark callback");
    ig::ImGui::SliderFloat("frequency", &app->freq, 0.1, 5.0, "%.2f", 0);
    ig::ImGui::SliderFloat("amplitude", &app->amp, 0.1, 1.0, "%.2f", 0);
    ig::ImGui::Checkbox("pause", &app->paused);
    ig::ImGui::PlotLines_u8p_fnp_voidp_i32_i32_u8p_f32_f32_ImVec2("wave", wave, app, 120, 0, null, -1.0, 1.0, ig::ImVec2(0.0, 80.0));
    ig::ImGui::ProgressBar((app->phase / 6.2831853) as f32, ig::ImVec2(-1.0, 0.0), null);

    ig::ImGui::SeparatorText("Draw list");
    const auto dl = ig::ImGui::GetWindowDrawList();
    const auto p = ig::ImGui::GetCursorScreenPos();
    dl.AddLine(ig::ImVec2(p.x, p.y), ig::ImVec2(p.x + 240.0, p.y + 24.0), 0xFF00FFFF, 2.0);

    ig::ImGui::SeparatorText("Owned object");
    auto clipper = ig::ImGuiListClipper::create(c_allocator())?;
    defer clipper.deinit();
    clipper.get().Begin(1000, -1.0);
    while (clipper.get().Step()) {
        const auto row = bprint(line[..], "row {clipper.get().DisplayStart}") catch "";
        ig::ImGui::Text(row.ptr);
    }

    ig::ImGui::SeparatorText("Window");
    ig::ImGui::ColorEdit3("background", &app->clear[0], 0);
    ig::ImGui::Checkbox("show the ImGui demo window", &app->show_demo);
    ig::ImGui::End();
    if (app->show_demo) { ig::ImGui::ShowDemoWindow(&app->show_demo); }
    if (app->clicks > 0) {
        if (ig::ImGui::Begin_1("clicks")) {
            const auto count = bprint(line[..], "you clicked {app->clicks} times") catch "";
            ig::ImGui::Text(count.ptr);
        }
        ig::ImGui::End();
    }
}

!void main() {
    if (sdl::SDL_Init(sdl::SDL_INIT_VIDEO) != 0) {
        eprintln("SDL_Init: {cstr(sdl::SDL_GetError())}");
        return error.SdlFailed;
    }
    defer sdl::SDL_Quit();
    sdl::SDL_GL_SetAttribute(sdl::SDL_GL_CONTEXT_PROFILE_MASK, sdl::SDL_GL_CONTEXT_PROFILE_CORE);
    sdl::SDL_GL_SetAttribute(sdl::SDL_GL_CONTEXT_MAJOR_VERSION, 3);
    sdl::SDL_GL_SetAttribute(sdl::SDL_GL_CONTEXT_MINOR_VERSION, 3);
    sdl::SDL_GL_SetAttribute(sdl::SDL_GL_DOUBLEBUFFER, 1);
    const auto win = sdl::SDL_CreateWindow("Zark + Dear ImGui", sdl::SDL_WINDOWPOS_CENTERED_MASK, sdl::SDL_WINDOWPOS_CENTERED_MASK, 1100, 700, sdl::SDL_WINDOW_OPENGL | sdl::SDL_WINDOW_RESIZABLE | sdl::SDL_WINDOW_ALLOW_HIGHDPI);
    if (win == null) {
        eprintln("SDL_CreateWindow: {cstr(sdl::SDL_GetError())}");
        return error.SdlFailed;
    }
    defer sdl::SDL_DestroyWindow(win);
    const auto ctx = sdl::SDL_GL_CreateContext(win);
    if (ctx == null) {
        eprintln("SDL_GL_CreateContext: {cstr(sdl::SDL_GetError())}");
        return error.SdlFailed;
    }
    defer sdl::SDL_GL_DeleteContext(ctx);
    sdl::SDL_GL_SetSwapInterval(1);

    ig::ImGui::CreateContext(null);
    const auto io = ig::ImGui::GetIO();
    io->IniFilename = null;
    ig::ImGui::StyleColorsDark(null);
    ig::ImGui_ImplSDL2_InitForOpenGL(win as *ig::SDL_Window, ctx);
    ig::ImGui_ImplOpenGL3_Init("#version 130");
    defer ig::ImGui_ImplOpenGL3_Shutdown();
    defer ig::ImGui_ImplSDL2_Shutdown();

    auto app = App{ .freq = 1.0, .amp = 0.8, .clear = [0.08, 0.09, 0.12] };
    app.name[0] = 'Z';
    app.name[1] = 'a';
    app.name[2] = 'r';
    app.name[3] = 'k';

    auto max_frames = -1;
    if (arg_count() > 1) { max_frames = parse_int(arg(1)) catch -1; }

    auto frames = 0;
    auto running = true;
    while (running) {
        auto ev = sdl::SDL_Event{};
        while (sdl::SDL_PollEvent(&ev) != 0) {
            ig::ImGui_ImplSDL2_ProcessEvent(&ev as *ig::SDL_Event);
            if (*ev.as_type() == sdl::SDL_QUIT) { running = false; }
        }
        ig::ImGui_ImplOpenGL3_NewFrame();
        ig::ImGui_ImplSDL2_NewFrame();
        ig::ImGui::NewFrame();
        const auto dt = io->DeltaTime;
        if (!app.paused) { app.phase += dt as f64 * app.freq as f64 * 2.0; }
        if (app.phase > 6.2831853) { app.phase -= 6.2831853; }
        panel(&app, dt)?;
        ig::ImGui::Render();

        i32 w = 0;
        i32 h = 0;
        sdl::SDL_GL_GetDrawableSize(win, &w, &h);
        gl::glViewport(0, 0, w, h);
        gl::glClearColor(app.clear[0], app.clear[1], app.clear[2], 1.0);
        gl::glClear(gl::GL_COLOR_BUFFER_BIT);
        ig::ImGui_ImplOpenGL3_RenderDrawData(ig::ImGui::GetDrawData());
        sdl::SDL_GL_SwapWindow(win);

        frames += 1;
        if (max_frames >= 0 && frames >= max_frames) { running = false; }
    }
}
